    "BRUserPassword": "Z9DFQqbapr+TQsNUI33x7ahse2ZnI6S0Qgy9LY6FuZM=",
    "ValidIssuer": "www.example.com",
    "ValidAudience": "www.example.com",
    "CORS": "http://172.16.2.110:4200,http://172.17.40.52:3306,http://172.17.40.52:3306/",
