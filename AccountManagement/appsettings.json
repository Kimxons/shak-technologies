{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\AccountManagement_.txt",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss}  [{Level:u3}] ({Application}/{MachineName}) {Message}{NewLine:1}{Exception:1}",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "Application": "AccountManagement"
    }
  },
  "SwaggerSettings": {
    "RoutePrefix": "Account",
    "Info": {
      "Title": "Account Management v1",
      "Description": "Maintain Account management details",
      "TermsOfService": "",
      "Contact": {
        "Name": "Account Management API",
        "Email": "demo@craftsilicon.com",
        "Url": "www.craftsilicon.com"
      },
      "License": {
        "Name": "Craft Silicon Ltd",
        "Url": "www.craftsilicon.com"
      },
      "Version": "v1"
    },
    "securitySchemes": {
      "oAuth2": {
        "type": "oauth2",
        "Description": "JWT Authorization header using the Bearer scheme. \r\n\r\n Enter 'Bearer' [space] and then your token in the text input below.\r\n\r\nExample: \"Bearer 12345abcdef\"",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://localhost:44324/Login",
            "scopes": {}
          }
        }
      }
    }
  },
  "AppSettings": {
    "AppName": "AccountManagement",
    "DBType": "SQLSERVER",
    "DBServerName": "172.16.2.42, 3020",
    "DatabaseName": "BRNET_TSEDEY",
