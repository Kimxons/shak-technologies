{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "kairo_ui.Services.ApiService": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/kairo-ui-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Properties} {Message:lj}{NewLine}{Exception}",
          "shared": true
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    "IdentityAccessManagentBaseUrl": "http://172.17.50.15:3309/api",
    "SystemCoreBaseUrl": "https://localhost:7175/api",
    "ClientManagementBaseUrl": "https://localhost:7261/api",
    "AccountManagementBaseUrl": "https://localhost:7361/api",
    "HttpClientTimeoutSeconds": 30,
    "ApiLogPath": "ApplicationLogs",
    "AppName": "kairo-ui"
  },
  "Session": {
    "IdleTimeoutMinutes": 30
  },
  "OAuth": {
    "ClientId": "kairoUI",
    "ClientSecret": "WSh6nbAVPqd1g6ayUqZtvJ73Y4tgnGMliK5Q5pAppvw=",
    "AuthorizeEndpoint": "http://172.17.50.15:3309/authorize",
    "TokenEndpoint": "http://172.17.50.15:3309/api/auth/token",
    "RedirectUri": "http://localhost:5005/login/callback",
    "Scope": "openid profile email offline_access",
    "ResponseType": "code"
  }
}
