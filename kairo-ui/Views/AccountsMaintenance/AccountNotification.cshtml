@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_ApplicationLayout";
    var frequencyOptions = ViewData["FrequencyOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- AccountNotification Submodule -->
<main class="main-container main-container--with-panel">
<div class="form-content">
<div class="form-card" data-main-form>
  <div class="form-section" data-section="notification-settings">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-bell me-1"></i>Notification Settings</span>
      <button type="button" class="section-toggle-btn" aria-label="Toggle Notification Settings" aria-expanded="true">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="section-content" data-section-content>
      <form autocomplete="off">
        <div class="form-row two-col">
          <div class="col">
            <label class="label-blue" for="frequency">Notification Frequency</label>
            <select id="frequency" name="frequency" class="bs-select" disabled>
              <option value="">--Select--</option>
              @foreach (var option in frequencyOptions)
              {
                  <option value="@option.Value">@option.Text</option>
              }
            </select>
          </div>
          <div class="col">
            <label class="label-blue" for="dayOfMonth">No. of Days</label>
            <input id="dayOfMonth" name="dayOfMonth" type="number" min="1" max="365" class="bs-input-text" disabled />
          </div>
        </div>
        <div class="form-row two-col">
          <div class="col">
            <label class="label-blue" for="executionDate">Execution Date</label>
            <input id="executionDate" name="executionDate" type="date" class="bs-input-text" disabled />
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Notifications Table Section -->
  <div class="form-section" data-section="notifications-list">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-list-ul me-1"></i>Notifications</span>
      <span class="de-record-count ms-auto me-3" id="recordCount">0 records</span>
      <button type="button" class="section-toggle-btn" aria-label="Toggle Notifications" aria-expanded="true">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="section-content table-responsive" data-section-content>
      <table class="table table-sm table-bordered table-hover" id="notificationsTable">
        <thead class="table-light">
          <tr>
            <th style="width:40px;"><input type="checkbox" id="selectAll" aria-label="Select all" disabled /></th>
            <th>Notification ID</th>
            <th>Notification Type</th>
            <th>Notification Message</th>
          </tr>
        </thead>
        <tbody>
          <tr class="table__empty"><td colspan="4">No records to display.</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Behind the Scene Section -->
  <div class="form-section" data-section="behind-scene">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-gear me-1"></i>Behind the Scene</span>
      <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="section-content" data-section-content>
      <div class="audit-section audit-section--summary">
        <div class="audit-item"><label>Created By</label><span class="audit-value" id="MakerID">-</span></div>
        <div class="audit-item"><label>Created On</label><span class="audit-value" id="MakerDT">-</span></div>
        <div class="audit-item"><label>Checked By</label><span class="audit-value" id="CheckerID">-</span></div>
        <div class="audit-item"><label>Checked On</label><span class="audit-value" id="CheckerDT">-</span></div>
        <div class="audit-item"><label>Modified By</label><span class="audit-value" id="ModifierID">-</span></div>
        <div class="audit-item"><label>Modified On</label><span class="audit-value" id="ModifierDT">-</span></div>
      </div>
    </div>
  </div>
</div>
</div>
@await Html.PartialAsync("_SubmoduleActionPanel", new ViewDataDictionary(ViewData) { { "PanelType", "notification" } })
</main>

<div id="loadingOverlay" hidden style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.6);z-index:10;">
  <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
</div>

<script type="text/javascript" src="~/js/modules/accountsmaintenance/account-notification.js"></script>
