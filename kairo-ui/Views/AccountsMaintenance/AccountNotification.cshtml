@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Migrated from: account-notification.html
    var frequencyOptions = ViewData["FrequencyOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- AccountNotification Submodule -->
<div class="window">
    <div class="am-header__right" role="toolbar" aria-label="Window controls">
        <button class="am-btn" type="button" data-action="refresh" title="Refresh" aria-label="Refresh data"><i class="bi bi-arrow-clockwise"></i></button>
        <button class="am-btn" type="button" data-action="maximize" title="Maximize" aria-label="Maximize window"><i class="bi bi-square"></i></button>
        <button class="am-btn am-btn--close" type="button" data-action="close" title="Close" aria-label="Close window"><i class="bi bi-x-lg"></i></button>
      </div>
    </div>

    <main class="main-container">
      <div class="form-content" role="region" aria-label="Account Notification form">
        <div class="form-card" data-main-form>
          <div class="form-section" data-section="notification-settings">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title"><i class="bi bi-bell"></i>Notification Settings</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Notification Settings" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <form autocomplete="off">
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="label-blue" for="frequency">Notification Frequency</label>
                    <select id="frequency" name="frequency" class="bs-select form-control">
                      <option value="">--Select--</option>
                      @foreach (var option in frequencyOptions)
                      {
                          <option value="@option.Value">@option.Text</option>
                      }
                    </select>
                  </div>
                  <div class="col-6">
                    <label class="label-blue" for="dayOfMonth">No. of Days</label>
                    <input id="dayOfMonth" name="dayOfMonth" type="number" min="1" max="365" class="bs-input-text form-control" />
                  </div>
                </div>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="label-blue" for="executionDate">Execution Date</label>
                    <input id="executionDate" name="executionDate" type="date" class="bs-input-text form-control" />
                  </div>
                </div>
              </form>
            </div>
          </div>

          <!-- Notifications Table Section -->
          <div class="form-section" data-section="notifications-list">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title"><i class="bi bi-list-ul"></i>Notifications</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Notifications" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <div class="table-responsive">
                <table class="table table-sm table-bordered table-hover" id="notificationsTable">
                  <thead class="table-light">
                    <tr>
                      <th class="col-checkbox"><input type="checkbox" id="selectAll" aria-label="Select all" disabled /></th>
                      <th>Notification ID</th>
                      <th>Notification Type</th>
                      <th>Notification Message</th>
                    </tr>
                  </thead>
                  <tbody id="notificationsBody">
                    <!-- Notification rows will be populated dynamically -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Behind the Scene Section -->
          <div class="form-section" data-section="behind-scene">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title"><i class="bi bi-gear"></i>Behind the Scene</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <div class="audit-section audit-section--summary">
                <div class="audit-cell">
                  <span class="audit-label">Modified By</span>
                  <span class="audit-value" id="ModifierID">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Modified On</span>
                  <span class="audit-value" id="ModifierDT">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Supervised By</span>
                  <span class="audit-value" id="SupervisedBy">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Supervised On</span>
                  <span class="audit-value" id="SupervisedOn">-</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Panel -->
      <div class="action-panel" aria-label="Form actions">
        <div class="action-buttons">
          <button class="btn-action" type="button" data-action="edit" title="Edit">
            <i class="bi bi-pencil-square"></i>Edit
          </button>
          <button class="btn-action" type="button" data-action="save" title="Save" disabled>
            <i class="bi bi-check-lg"></i>Save
          </button>
          <button class="btn-action btn-cancel" type="button" data-action="cancel" title="Cancel" disabled>
            <i class="bi bi-x-lg"></i>Cancel
          </button>
        </div>
      </div>
    </main>

    <div class="am-message-panel" role="alert" aria-live="polite">
      <i class="bi bi-info-circle"></i>
      <span></span>
    </div>

    <div class="loading-overlay" id="loadingOverlay" hidden>
      <div class="loading-spinner">
        <i class="bi bi-arrow-repeat"></i>
        <span>Loading notifications...</span>
      </div>
    </div>
  </div>

  <!-- Service Scripts -->
  <script src="../../../assets/js/config.js"></script>
  <script src="../../../assets/js/environment.js"></script>
  <script src="../../../assets/js/services/shared/coreApi.js"></script>
  <script src="../../../assets/js/services/shared/lookupService.js"></script>
  <script src="../../../assets/js/services/Account/AccountService.js"></script>
  <script src="../../../assets/js/services/Account/AccountNotificationService.js"></script>
  <script src="dataentry-base.js?v=20250128"></script>
  <script src="dataentry-utils.js"></script>
  <script src="account-notification.js?v=20250128"></script>

<script>
document.addEventListener('submodule:loaded', function(e) {
    if (e.detail.submoduleName === 'AccountNotification') {
        console.log('[AccountNotification] Submodule loaded');
    }
});
</script>
