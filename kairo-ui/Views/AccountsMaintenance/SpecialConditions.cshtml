@{
    Layout = "_ApplicationLayout";
    // Migrated from: account-special-conditions.html
}

<!-- SpecialConditions Submodule -->
<main class="main-container main-container--with-panel">
<div class="form-content">
<div class="form-card" data-main-form>
  <div class="form-section" data-section="special-conditions">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-list-check me-1"></i>General Conditions</span>
      <span class="de-record-count ms-auto me-3" id="recordCount">0 records</span>
      <button type="button" class="section-toggle-btn" aria-label="Toggle General Conditions" aria-expanded="true">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="section-content" data-section-content>
      <!-- Search Bar -->
      <div class="mb-3">
        <div class="d-flex align-items-center gap-2">
          <div class="flex-grow-1 position-relative">
            <i class="bi bi-search position-absolute start-0 top-50 translate-middle-y ms-3 text-muted" aria-hidden="true"></i>
            <input type="text" id="searchInput" class="bs-input-text ps-5" placeholder="Search conditions..." />
          </div>
          <button type="button" id="clearSearch" class="btn btn-sm btn-outline-secondary d-none" title="Clear search">
            <i class="bi bi-x-circle"></i>
          </button>
        </div>
      </div>
      
      <!-- Grid -->
      <div class="table-responsive">
        <table class="table table-sm table-hover" id="conditionsGrid">
          <thead>
            <tr>
              <th style="width: 5%">Apply</th>
              <th style="width: 50%">Description</th>
              <th style="width: 5%">Set</th>
              <th style="width: 40%">Value</th>
            </tr>
          </thead>
          <tbody>
            <tr class="table__empty"><td colspan="4">No records to display.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Behind the Scene Section -->
  <div class="form-section" data-section="behind-scene">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-gear me-1"></i>Behind The Scene</span>
      <button type="button" class="section-toggle-btn" aria-label="Toggle Behind The Scene" aria-expanded="true">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="section-content" data-section-content>
      <div class="audit-section audit-section--summary">
        <div class="audit-item"><label>Created By</label><span class="audit-value" id="MakerID">-</span></div>
        <div class="audit-item"><label>Created On</label><span class="audit-value" id="MakerDT">-</span></div>
        <div class="audit-item"><label>Checked By</label><span class="audit-value" id="CheckerID">-</span></div>
        <div class="audit-item"><label>Checked On</label><span class="audit-value" id="CheckerDT">-</span></div>
        <div class="audit-item"><label>Modified By</label><span class="audit-value" id="ModifierID">-</span></div>
        <div class="audit-item"><label>Modified On</label><span class="audit-value" id="ModifierDT">-</span></div>
      </div>
    </div>
  </div>
</div>
</div>
@await Html.PartialAsync("_SubmoduleActionPanel", new ViewDataDictionary(ViewData) { { "PanelType", "notification" } })
</main>

<script type="text/javascript" src="~/js/modules/accountsmaintenance/account-special-conditions.js" asp-append-version="true"></script>
