@* Signature / Photo Submodule - Loaded as Partial View *@
@* Migrated from: signature-photo.html *@
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var operatingModeOptions = ViewData["OperatingModeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<form id="signaturePhotoForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Form Content -->
<div class="form-content" role="region" aria-label="Signature / Photo" data-submodule-content>
    <div class="form-card" data-submodule-form>
        <!-- Signatories Section -->
        <div class="form-section" data-section="signatories">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-people"></i> SIGNATORIES</span>
                <span class="de-record-count" id="spn_signatoriesRecordCount">(0 records)</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Signatories" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="table-responsive" data-signature-list>
                    <table class="table table-sm table-hover" id="tbl_signatoriesGrid">
                        <thead class="table-light">
                            <tr>
                                <th>Signatory ID</th>
                                <th>Signatory Name</th>
                                <th>Signatory Type</th>
                                <th class="text-end">Limit</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No records to display.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="form-row two-col mt-3">
                    <div class="col">
                        <label class="label-blue" for="ddl_operatingMode">Operating Mode</label>
                        <select id="ddl_operatingMode" name="operatingMode" class="bs-select">
                            <option value="">--Select--</option>
                            @foreach (var option in operatingModeOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label for="txt_operatingInstruction">Operating Instruction</label>
                        <input id="txt_operatingInstruction" name="operatingInstruction" type="text" class="bs-input-text" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Signature and Photo Section -->
        <div class="row g-3 mb-3">
            <div class="col-6">
                <div class="form-section" data-section="signature">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-pen"></i> SIGNATURE</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-action="zoom-sig" title="Zoom"><i class="bi bi-zoom-in"></i></button>
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-action="download-sig" title="Download"><i class="bi bi-download"></i></button>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Signature" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="text-center p-4 border rounded bg-light d-flex align-items-center justify-content-center overflow-hidden" id="div_signatureImage" data-image-container style="min-height: 200px; max-height: 300px;">
                            <span class="text-muted">No signature available</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="form-section" data-section="photo">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-camera"></i> PHOTO</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-action="zoom-photo" title="Zoom"><i class="bi bi-zoom-in"></i></button>
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-action="download-photo" title="Download"><i class="bi bi-download"></i></button>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Photo" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="text-center p-4 border rounded bg-light d-flex align-items-center justify-content-center overflow-hidden" id="div_photoImage" data-image-container style="min-height: 200px; max-height: 300px;">
                            <span class="text-muted">No photo available</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Audit Section -->
        <div class="audit-section audit-section--summary">
            <div class="audit-cell">
                <span class="audit-label">Created By</span>
                <span class="audit-value" id="spn_createdBy">-</span>
            </div>
            <div class="audit-cell">
                <span class="audit-label">Modified By</span>
                <span class="audit-value" id="spn_modifiedBy">-</span>
            </div>
            <div class="audit-cell">
                <span class="audit-label">Supervised By</span>
                <span class="audit-value" id="spn_supervisedBy">-</span>
            </div>
            <div class="audit-cell">
                <span class="audit-label">Created On</span>
                <span class="audit-value" id="spn_createdOn">-</span>
            </div>
            <div class="audit-cell">
                <span class="audit-label">Modified On</span>
                <span class="audit-value" id="spn_modifiedOn">-</span>
            </div>
            <div class="audit-cell">
                <span class="audit-label">Supervised On</span>
                <span class="audit-value" id="spn_supervisedOn">-</span>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div class="loading-overlay" id="div_loadingOverlay" style="display:none;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Message Panel -->
<div class="message-panel" id="div_messagePanel" style="display:none;"></div>

<script src="/js/modules/accountsmaintenance/signature-photo.js"></script>
