@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Migrated from: account-interest-rates.html
    var interestRateTypeOptions = ViewData["InterestRateTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- InterestRates Submodule -->
<div class="form-card" data-main-form id="interestRateForm">
  <!-- Rate Details Section -->
  <div class="form-section" data-section="rate-details">
      <div class="section-header" data-section-toggle>
          <span class="section-header__title"><i class="bi bi-percent me-1"></i>Rate Details</span>
          <button type="button" class="section-toggle-btn" aria-label="Toggle Rate Details" aria-expanded="true">
              <i class="bi bi-chevron-up"></i>
          </button>
      </div>
      <div class="section-content" data-section-content>
          <!-- Row 1: Rate Type, Base Rate -->
          <div class="form-row two-col">
              <div class="col">
                  <label class="label-blue" for="rateType">Rate Type<span class="text-danger">*</span></label>
                  <select id="rateType" name="rateType" class="bs-select">
                      <option value="">--Select--</option>
                      @foreach (var option in interestRateTypeOptions)
                      {
                          <option value="@option.Value">@option.Text</option>
                      }
                  </select>
              </div>
              <div class="col">
                  <label class="label-blue" for="baseRate">Base Rate</label>
                  <input id="baseRate" name="baseRate" type="text" class="bs-input-text text-end" value="0.0000" readonly />
              </div>
          </div>

          <!-- Row 2: Effective Date, Expiry Date -->
          <div class="form-row two-col">
              <div class="col">
                  <label class="label-blue" for="effectiveDate">Effective Date</label>
                  <input type="date" id="effectiveDate" name="effectiveDate" class="bs-input-text">
              </div>
              <div class="col">
                  <label class="label-blue" for="expiryDate">Expiry Date</label>
                  <input type="date" id="expiryDate" name="expiryDate" class="bs-input-text">
              </div>
          </div>

          <!-- Row 3: Ref ID -->
          <div class="form-row two-col">
              <div class="col">
                  <label class="label-blue" for="refId">Ref ID</label>
                  <input id="refId" name="refId" type="text" class="bs-input-text" />
              </div>
              <div class="col"></div>
          </div>
      </div>
  </div>

  <!-- Interest Rate Slabs Section -->
  <div class="form-section" data-section="rate-slabs">
      <div class="section-header" data-section-toggle>
          <span class="section-header__title"><i class="bi bi-table me-1"></i>Amount Slab Wise Rate Of Interest</span>
          <button type="button" class="section-toggle-btn" aria-label="Toggle Rate Slabs" aria-expanded="true">
              <i class="bi bi-chevron-up"></i>
          </button>
      </div>
      <div class="section-content" data-section-content style="padding:0;">
          <div style="max-height:260px; overflow-y:auto; overflow-x:auto; padding:16px;">
              <table style="width:100%; border-collapse:collapse; font-size:13px; table-layout:fixed; min-width:1080px;">
                  <colgroup>
                      <col style="width:12%;">
                      <col style="width:18%;">
                      <col style="width:18%;">
                      <col style="width:16%;">
                      <col style="width:15%;">
                      <col style="width:10%;">
                      <col style="width:15%;">
                  </colgroup>
                  <thead>
                      <tr>
                          <th style="text-align:left; padding:8px; background:#e8f4f8; border:1px solid #b8d4e0; font-weight:600; color:#2c5f7d;"></th>
                          <th style="text-align:left; padding:8px; background:#e8f4f8; border:1px solid #b8d4e0; font-weight:600; color:#2c5f7d;">From</th>
                          <th style="text-align:left; padding:8px; background:#e8f4f8; border:1px solid #b8d4e0; font-weight:600; color:#2c5f7d;">To</th>
                          <th style="text-align:left; padding:8px; background:#e8f4f8; border:1px solid #b8d4e0; font-weight:600; color:#2c5f7d;"></th>
                          <th style="text-align:left; padding:8px; background:#e8f4f8; border:1px solid #b8d4e0; font-weight:600; color:#2c5f7d;">Mark Up / Down</th>
                          <th style="text-align:left; padding:8px; background:#e8f4f8; border:1px solid #b8d4e0; font-weight:600; color:#2c5f7d;">%</th>
                          <th style="text-align:left; padding:8px; background:#e8f4f8; border:1px solid #b8d4e0; font-weight:600; color:#2c5f7d;">Effective Rate</th>
                      </tr>
                  </thead>
                  <tbody>
                      <tr style="background:white;">
                          <td style="padding:6px 8px; border:1px solid #d0d0d0; text-align:center; font-weight:600; color:#333;">Amount</td>
                          <td style="padding:3px; border:1px solid #d0d0d0;"><input type="text" id="amountFrom" name="amountFrom" class="bs-input-text bg-light" style="height:28px; font-size:13px; width:100%;" readonly /></td>
                          <td style="padding:3px; border:1px solid #d0d0d0;"><input type="text" id="amountTo" name="amountTo" class="bs-input-text" style="height:28px; font-size:13px; width:100%;" /></td>
                          <td style="padding:3px; border:1px solid #d0d0d0;"><select id="markUpDown" name="markUpDown" class="bs-select" style="height:28px; font-size:13px; width:100%;"><option value="">--Select--</option></select></td>
                          <td style="padding:3px; border:1px solid #d0d0d0;"><input type="text" id="markValue" name="markValue" class="bs-input-text" style="height:28px; font-size:13px; width:100%;" /></td>
                          <td style="padding:3px; border:1px solid #d0d0d0;"><input type="text" id="effectiveRate" name="effectiveRate" class="bs-input-text text-end" style="height:28px; font-size:13px; width:100%;" /></td>
                          <td style="padding:3px; border:1px solid #d0d0d0;"></td>
                      </tr>
                      @for (var i = 2; i <= 5; i++)
                      {
                          <tr style="background:white;">
                              <td style="padding:6px 8px; border:1px solid #d0d0d0; text-align:center; font-weight:600; color:#333;">@i.</td>
                              <td style="padding:3px; border:1px solid #d0d0d0;"><input type="text" id="amount@(i)From" name="amount@(i)From" class="bs-input-text bg-light" style="height:28px; font-size:13px; width:100%;" readonly /></td>
                              <td style="padding:3px; border:1px solid #d0d0d0;"><input type="text" id="amount@(i)To" name="amount@(i)To" class="bs-input-text" style="height:28px; font-size:13px; width:100%;" /></td>
                              <td style="padding:3px; border:1px solid #d0d0d0;"><select id="markUpDown@(i)" name="markUpDown@(i)" class="bs-select" style="height:28px; font-size:13px; width:100%;"><option value="">--Select--</option></select></td>
                              <td style="padding:3px; border:1px solid #d0d0d0;"><input type="text" id="markValue@(i)" name="markValue@(i)" class="bs-input-text" style="height:28px; font-size:13px; width:100%;" /></td>
                              <td style="padding:3px; border:1px solid #d0d0d0;"><input type="text" id="effectiveRate@(i)" name="effectiveRate@(i)" class="bs-input-text text-end" style="height:28px; font-size:13px; width:100%;" /></td>
                              <td style="padding:3px; border:1px solid #d0d0d0;"></td>
                          </tr>
                      }
                      <tr style="background:white;">
                          <td></td>
                          <td></td>
                          <td></td>
                          <td style="text-align:right; font-weight:600; color:#2c5f7d; padding:6px 8px;">Penalty Rate</td>
                          <td style="padding:3px; border:1px solid #d0d0d0;"><select id="penaltyRate" name="penaltyRate" class="bs-select" style="height:28px; font-size:13px; width:100%;"><option value="">--Select--</option><option value="+">+</option><option value="-">-</option></select></td>
                          <td></td>
                          <td></td>
                      </tr>
                  </tbody>
              </table>
          </div>
      </div>
  </div>

  <div class="form-section" data-section="rate-list">
      <div class="section-content" data-section-content style="padding:0;">
          <div style="display:flex; border-bottom:2px solid #b8d4e0; background:#f5f5f5; overflow-x:auto; white-space:nowrap;">
              <div class="rate-tab active" data-tab="reference" style="padding:8px 16px; font-size:13px; font-weight:600; color:#2c5f7d; cursor:pointer; border-right:1px solid #d0d0d0; background:white;">Reference No.</div>
              <div class="rate-tab" data-tab="amount1" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer; border-right:1px solid #d0d0d0;">Amount 1</div>
              <div class="rate-tab" data-tab="rate1" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer; border-right:1px solid #d0d0d0;">Rate 1</div>
              <div class="rate-tab" data-tab="amount2" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer; border-right:1px solid #d0d0d0;">Amount 2</div>
              <div class="rate-tab" data-tab="rate2" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer; border-right:1px solid #d0d0d0;">Rate 2</div>
              <div class="rate-tab" data-tab="amount3" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer; border-right:1px solid #d0d0d0;">Amount 3</div>
              <div class="rate-tab" data-tab="rate3" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer; border-right:1px solid #d0d0d0;">Rate 3</div>
              <div class="rate-tab" data-tab="amount4" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer; border-right:1px solid #d0d0d0;">Amount 4</div>
              <div class="rate-tab" data-tab="rate4" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer; border-right:1px solid #d0d0d0;">Rate 4</div>
              <div class="rate-tab" data-tab="amount5" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer; border-right:1px solid #d0d0d0;">Amount 5</div>
              <div class="rate-tab" data-tab="rate5" style="padding:8px 16px; font-size:13px; font-weight:600; color:#666; cursor:pointer;">Rate 5</div>
          </div>
          <div id="rateListContent" style="max-height:240px; overflow-y:auto; overflow-x:auto; background:white;">
              <table style="width:100%; min-width:1220px; border-collapse:collapse; font-size:12px; table-layout:fixed;">
                  <colgroup>
                      <col style="width:120px;">
                      <col style="width:150px;">
                      <col style="width:100px;">
                      <col style="width:150px;">
                      <col style="width:100px;">
                      <col style="width:150px;">
                      <col style="width:100px;">
                      <col style="width:150px;">
                      <col style="width:100px;">
                      <col style="width:150px;">
                      <col style="width:100px;">
                  </colgroup>
                  <tbody>
                      <tr>
                          <td colspan="11" style="padding:10px 12px; color:#000; border:1px solid #d0d0d0; vertical-align:top; height:200px;">No records to display.</td>
                      </tr>
                  </tbody>
              </table>
          </div>
      </div>
  </div>

  <!-- Behind the Scene Section -->
  <div class="form-section" data-section="behind-scene">
      <div class="section-header" data-section-toggle>
          <span class="section-header__title"><i class="bi bi-gear me-1"></i>Behind the Scene</span>
          <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
              <i class="bi bi-chevron-up"></i>
          </button>
      </div>
      <div class="section-content" data-section-content>
          <div class="audit-section audit-section--summary">
              <div class="audit-item"><label>Created By</label><span class="audit-value" id="CreatedBy">-</span></div>
              <div class="audit-item"><label>Created On</label><span class="audit-value" id="CreatedOn">-</span></div>
              <div class="audit-item"><label>Supervised By</label><span class="audit-value" id="SupervisedBy">-</span></div>
              <div class="audit-item"><label>Supervised On</label><span class="audit-value" id="SupervisedOn">-</span></div>
              <div class="audit-item"><label>Modified By</label><span class="audit-value" id="ModifiedBy">-</span></div>
              <div class="audit-item"><label>Modified On</label><span class="audit-value" id="ModifiedOn">-</span></div>
          </div>
      </div>
  </div>
</div>

<script type="text/javascript" src="~/js/modules/accountsmaintenance/account-interest-rates.js" asp-append-version="true"></script>
