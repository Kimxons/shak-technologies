@* Loan Repayment Details Submodule - Loaded as Partial View *@
@* Migrated from: loan-repayment-details.html *@

<form id="loanRepaymentForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Form Content -->
<div class="form-content" role="region" aria-label="Loan Repayment Details" data-submodule-content>
    <div class="form-card" data-submodule-form>
        <!-- Loan Repayment Schedule Section -->
        <div class="form-section form-section--grid" data-section="repayment-schedule">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-cash-coin"></i> LOAN REPAYMENT SCHEDULE</span>
                <span class="de-record-count" id="spn_recordCount">(0 records)</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Repayment Schedule" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content section-content--grid" data-section-content>
                <div class="table-responsive">
                    <table class="table table-sm table-hover" id="tbl_repaymentGrid">
                        <thead class="table-light">
                            <tr>
                                <th class="de-table-check"><input type="checkbox" id="chk_selectAll" /></th>
                                <th>Due Date</th>
                                <th>Value Date</th>
                                <th>Particulars</th>
                                <th class="text-end">Principal</th>
                                <th class="text-end">Interest</th>
                                <th class="text-end">Total Due</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No records to display.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div class="loading-overlay" id="div_loadingOverlay" style="display:none;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Message Panel -->
<div class="message-panel" id="div_messagePanel" style="display:none;"></div>

<script src="/js/modules/accountsmaintenance/loan-repayment-details.js"></script>
