@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Migrated from: account-stop-payment-void.html
    Layout = null;
    var stopPaymentReasonOptions = ViewData["StopPaymentReasonOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- StopPaymentVoid Submodule Content -->
<div class="form-content" role="region" aria-label="Stop Payment / Void form">
    <div class="form-card" data-main-form>
        <!-- Account Identification Section -->
        <div class="form-section">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-building me-1"></i>Account Identification</span>
                <button type="button" class="section-toggle-btn" aria-expanded="true"><i class="bi bi-chevron-up"></i></button>
            </div>
            <div class="section-content" data-section-content>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="branchId">Branch</label>
                        <div class="kairo-account-control" data-kairo-account-control>
                            <input type="text" id="branchId" name="branchId" class="kairo-account-control__id form-control am-input" readonly />
                            <input type="text" id="branchName" class="kairo-account-control__name form-control am-input" readonly />
                            <button class="btn-lookup kairo-account-control__lookup" type="button" data-lookup="Branch"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="accountId">Account</label>
                        <div class="kairo-account-control" data-kairo-account-control>
                            <input type="text" id="accountId" name="accountId" class="kairo-account-control__id form-control am-input" readonly />
                            <input type="text" id="accountName" class="kairo-account-control__name form-control am-input" readonly />
                            <button class="btn-lookup kairo-account-control__lookup" type="button" data-lookup="Account"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="requestRef">Request Ref No</label>
                        <div class="input-group">
                            <input id="requestRef" name="requestRef" type="text" class="form-control am-input" />
                            <button class="btn btn-secondary btn-lookup" type="button" data-lookup="RequestRef" style="border-radius: 0 4px 4px 0;"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stop Payment Details Section -->
        <div class="form-section">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-slash-circle me-1"></i>Stop Payment Details</span>
                <button type="button" class="section-toggle-btn" aria-expanded="true"><i class="bi bi-chevron-up"></i></button>
            </div>
            <div class="section-content" data-section-content>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="chequeNoStart">Cheque No Start</label>
                        <input id="chequeNoStart" name="chequeNoStart" type="text" class="form-control am-input" />
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="chequeNoEnd">Cheque No End</label>
                        <input id="chequeNoEnd" name="chequeNoEnd" type="text" class="form-control am-input" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="chequeDate">Cheque Date</label>
                        <select id="chequeDate" name="chequeDate" class="form-select am-input">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="chequeAmount">Cheque Amount</label>
                        <input id="chequeAmount" name="chequeAmount" type="text" class="form-control am-input text-end" data-type="amount" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="reasonId">Reason</label>
                        <select id="reasonId" name="reasonId" class="form-select am-input">
                            <option value="">--Select--</option>
                            @foreach (var option in stopPaymentReasonOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="voidDate">Void Date</label>
                        <input id="voidDate" name="voidDate" type="text" class="form-control am-input" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Stop Payment Records Grid Section -->
        <div class="form-section">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-list-ul me-1"></i>Stop Payment Records</span>
                <span class="record-count badge bg-secondary ms-2" id="recordCount">0 records</span>
                <button type="button" class="section-toggle-btn" aria-expanded="true"><i class="bi bi-chevron-up"></i></button>
            </div>
            <div class="section-content" data-section-content>
                <div class="kairo-simple-grid-container" style="max-height: 200px; overflow-y: auto;">
                    <table class="table table-sm table-bordered table-hover am-grid" id="stopPaymentGrid">
                        <thead class="sticky-top bg-light">
                            <tr>
                                <th>Cheque Start</th>
                                <th>Cheque End</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Reason</th>
                                <th>Void Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="grid-empty-row">
                                <td colspan="6" class="text-center py-3 text-muted italic">No records to display.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Audit Section (Behind the Scene) -->
        <div class="form-section">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-gear me-1"></i>Behind The Scene</span>
                <button type="button" class="section-toggle-btn" aria-expanded="false"><i class="bi bi-chevron-down"></i></button>
            </div>
            <div class="section-content" data-section-content style="display: none;">
                <div class="row g-2 mb-2">
                    <div class="col-md-2">
                        <label class="am-label">Created By</label>
                        <input id="MakerID" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="am-label">Created On</label>
                        <input id="MakerDT" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="am-label">Checked By</label>
                        <input id="CheckerID" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="am-label">Checked On</label>
                        <input id="CheckerDT" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="am-label">Modified By</label>
                        <input id="ModifierID" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="am-label">Modified On</label>
                        <input id="ModifierDT" class="form-control am-input" readonly />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/modules/accountsmaintenance/account-stop-payment.js?v=@DateTime.Now.Ticks"></script>
