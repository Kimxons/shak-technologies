@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Migrated from: account-cancel-stop-payment.html
    Layout = null;
    var cancelStopPaymentReasonOptions = ViewData["CancelStopPaymentReasonOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- CancelStopPayment Submodule Content -->
<div class="form-content" role="region" aria-label="Cancel Stop Payment form">
    <div class="form-card" data-main-form>
        <!-- Account Identification Section -->
        <div class="form-section">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-building me-1"></i>Account Identification</span>
                <button type="button" class="section-toggle-btn" aria-expanded="true"><i class="bi bi-chevron-up"></i></button>
            </div>
            <div class="section-content" data-section-content>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="branchId">Branch</label>
                        <div class="kairo-account-control" data-kairo-account-control>
                            <input type="text" id="branchId" name="branchId" class="kairo-account-control__id form-control am-input" readonly />
                            <input type="text" id="branchName" class="kairo-account-control__name form-control am-input" readonly />
                            <button class="btn-lookup kairo-account-control__lookup" type="button" data-lookup="Branch"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="accountId">Account</label>
                        <div class="kairo-account-control" data-kairo-account-control>
                            <input type="text" id="accountId" name="accountId" class="kairo-account-control__id form-control am-input" readonly />
                            <input type="text" id="accountName" class="kairo-account-control__name form-control am-input" readonly />
                            <button class="btn-lookup kairo-account-control__lookup" type="button" data-lookup="Account"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="requestRef">Request Ref No</label>
                        <div class="input-group">
                            <input id="requestRef" name="requestRef" type="text" class="form-control am-input" />
                            <button class="btn btn-secondary btn-lookup" type="button" data-lookup="RequestRef" style="border-radius: 0 4px 4px 0;"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cancel Stop Payment Details Section -->
        <div class="form-section">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-x-circle me-1"></i>Cancel Stop Payment Details</span>
                <button type="button" class="section-toggle-btn" aria-expanded="true"><i class="bi bi-chevron-up"></i></button>
            </div>
            <div class="section-content" data-section-content>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="chequeNoStart">Cheque No Start</label>
                        <input id="chequeNoStart" name="chequeNoStart" type="text" class="form-control am-input" />
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="chequeNoEnd">Cheque No End</label>
                        <input id="chequeNoEnd" name="chequeNoEnd" type="text" class="form-control am-input" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="chequeDate">Cheque Date</label>
                        <input id="chequeDate" name="chequeDate" type="date" class="form-control am-input" />
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="chequeAmount">Cheque Amount</label>
                        <input id="chequeAmount" name="chequeAmount" type="text" class="form-control am-input text-end" data-type="amount" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label required" for="reasonId">Reason ID</label>
                        <select id="reasonId" name="reasonId" class="form-select am-input">
                            <option value="">--Select--</option>
                            @foreach (var option in cancelStopPaymentReasonOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="reasonText">Reason</label>
                        <input id="reasonText" name="reasonText" type="text" class="form-control am-input" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="cancellationDate">Cancellation Date</label>
                        <input id="cancellationDate" name="cancellationDate" type="date" class="form-control am-input" />
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="instructionGivenBy">Instruction Given By</label>
                        <input id="instructionGivenBy" name="instructionGivenBy" type="text" class="form-control am-input" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Stop Payment Records Grid Section -->
        <div class="form-section">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-list-ul me-1"></i>Stop Payment Records</span>
                <span class="record-count badge bg-secondary ms-2" id="recordCount">0 records</span>
                <button type="button" class="section-toggle-btn" aria-expanded="true"><i class="bi bi-chevron-up"></i></button>
            </div>
            <div class="section-content" data-section-content>
                <div class="kairo-simple-grid-container" style="max-height: 200px; overflow-y: auto;">
                    <table class="table table-sm table-bordered table-hover am-grid" id="stopPaymentGrid">
                        <thead class="sticky-top bg-light">
                            <tr>
                                <th>Prefix</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Cheque Date</th>
                                <th>Reason</th>
                                <th>Cancel Date</th>
                                <th>Amount</th>
                                <th>Instruction By</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="grid-empty-row">
                                <td colspan="8" class="text-center py-3 text-muted italic">No records to display.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Account Details Section -->
        <div class="form-section">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-info-circle me-1"></i>Account Details</span>
                <button type="button" class="section-toggle-btn" aria-expanded="false"><i class="bi bi-chevron-down"></i></button>
            </div>
            <div class="section-content" data-section-content style="display: none;">
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="clientId">Client</label>
                        <div class="kairo-account-control">
                            <input id="clientId" type="text" class="form-control am-input" readonly style="width: 100px; flex: none;" />
                            <input id="clientName" type="text" class="form-control am-input" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="productId">Product</label>
                        <div class="kairo-account-control">
                            <input id="productId" type="text" class="form-control am-input" readonly style="width: 100px; flex: none;" />
                            <input id="productName" type="text" class="form-control am-input" readonly />
                        </div>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="address1">Address 1</label>
                        <input id="address1" type="text" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="address2">Address 2</label>
                        <input id="address2" type="text" class="form-control am-input" readonly />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-3">
                        <label class="label-blue am-label" for="city">City</label>
                        <input id="city" type="text" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="label-blue am-label" for="country">Country</label>
                        <input id="country" type="text" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="label-blue am-label" for="phoneHome">Phone (Home)</label>
                        <input id="phoneHome" type="text" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="label-blue am-label" for="phoneWork">Phone (Work)</label>
                        <input id="phoneWork" type="text" class="form-control am-input" readonly />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="faxNo">Fax No</label>
                        <input id="faxNo" type="text" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="mobile">Mobile</label>
                        <input id="mobile" type="text" class="form-control am-input" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Audit Section (Behind the Scene) -->
        <div class="form-section">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-gear me-1"></i>Behind The Scene</span>
                <button type="button" class="section-toggle-btn" aria-expanded="false"><i class="bi bi-chevron-down"></i></button>
            </div>
            <div class="section-content" data-section-content style="display: none;">
                <div class="row g-2 mb-2">
                    <div class="col-md-2">
                        <label class="am-label">Currency</label>
                        <input id="CurrencyID" class="form-control am-input text-center" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="am-label">Created By</label>
                        <input id="MakerID" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="am-label">Created On</label>
                        <input id="MakerDT" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="am-label">Supervised By</label>
                        <input id="SupervisorID" class="form-control am-input" readonly />
                    </div>
                    <div class="col-md-2">
                        <label class="am-label">Supervised On</label>
                        <input id="SupervisorDT" class="form-control am-input" readonly />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/js/modules/accountsmaintenance/account-cancel-stop-payment.js?v=@DateTime.Now.Ticks"></script>
