@{
    Layout = "_ApplicationLayout";
    // Migrated from: public/modules/account-maintenance/DataEntry/account-sweeping.html
}

<!-- AccountSweeping Submodule -->
<main class="main-container main-container--with-panel">
<div class="form-content" role="region" aria-label="Account Sweeping form">
    <div class="form-card" data-main-form>
        <div class="form-section" data-section="sweeping-config">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-arrow-left-right"></i> Sweeping Configuration</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Sweeping Configuration" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <form id="frmSweeping" autocomplete="off">
                    <!-- Row 1: Account Transfer -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="label-blue am-label">Account Transfer</label>
                            <div class="kairo-account-control" data-kairo-account-control>
                                <input type="text" id="accountTransferId" name="AccountTransferID" class="kairo-account-control__id form-control am-input" placeholder="Account ID" />
                                <input type="text" id="accountTransferName" name="AccountTransferName" class="kairo-account-control__name form-control am-input" placeholder="Account Name" readonly />
                                <button type="button" class="btn-lookup kairo-account-control__lookup" data-lookup="AccountTransfer" title="Lookup Account"><i class="bi bi-search"></i></button>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Min Threshold & Max Threshold -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="label-blue am-label" for="minThreshold">Min. Threshold</label>
                            <input type="number" id="minThreshold" name="MinThreshold" class="form-control am-input" step="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="label-blue am-label" for="maxThreshold">Max. Threshold</label>
                            <input type="number" id="maxThreshold" name="MaxThreshold" class="form-control am-input" step="0.01" />
                        </div>
                    </div>

                    <!-- Row 3: Sweeping Denomination -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="label-blue am-label" for="sweepingDenomination">Sweeping Denomination</label>
                            <input type="number" id="sweepingDenomination" name="SweepingDenomination" class="form-control am-input" step="0.01" />
                        </div>
                    </div>

                    <!-- Row 4: Start Date & End Date -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="label-blue am-label" for="startDate">Start Date</label>
                            <input type="date" id="startDate" name="StartDate" class="form-control am-input" />
                        </div>
                        <div class="col-md-6">
                            <label class="label-blue am-label" for="endDate">End Date</label>
                            <input type="date" id="endDate" name="EndDate" class="form-control am-input" />
                        </div>
                    </div>

                    <!-- Row 5: Last Sweeping Date -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="am-label" for="lastSweepingDate">Last Sweeping Date</label>
                            <input type="text" id="lastSweepingDate" name="LastSweepingDate" class="form-control am-input" readonly disabled />
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Behind the Scene Section -->
        <div class="form-section mt-3" data-section="behind-scene">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-gear"></i> Behind the Scene</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="audit-section audit-section--summary">
                    <div class="audit-cell">
                        <span class="audit-label">Created By</span>
                        <span class="audit-value" id="MakerID">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Created On</span>
                        <span class="audit-value" id="MakerDT">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Checked By</span>
                        <span class="audit-value" id="CheckerID">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Checked On</span>
                        <span class="audit-value" id="CheckerDT">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Modified By</span>
                        <span class="audit-value" id="ModifierID">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Modified On</span>
                        <span class="audit-value" id="ModifierDT">-</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_SubmoduleActionPanel", new ViewDataDictionary(ViewData) { { "PanelType", "standard" } })
</main>

<div class="loading-overlay" id="loadingOverlay" hidden>
    <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="loading-text">Loading sweeping configuration...</div>
    </div>
</div>

    <div class="am-message-panel" role="alert" aria-live="polite" hidden>
      <i class="bi bi-info-circle"></i>
      <span></span>
    </div>

    <div class="loading-overlay" id="loadingOverlay" hidden>
      <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
        <div class="loading-text">Loading sweeping configuration...</div>
      </div>
    </div>
  </div>

<script type="text/javascript" src="~/js/modules/accountsmaintenance/account-sweeping.js"></script>
<script>
    // Auto-initialize module when loaded
    document.addEventListener('DOMContentLoaded', function() {
        if (window.AccountSweepingModule) {
            window.AccountSweepingModule.init();
        }
    });
    // Also initialize if DOM is already ready
    if (document.readyState !== 'loading' && window.AccountSweepingModule) {
        window.AccountSweepingModule.init();
    }
</script>
