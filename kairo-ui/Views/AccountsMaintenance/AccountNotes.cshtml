@{
    Layout = "_ApplicationLayout";
}
@* Account Notes Submodule - Loaded as Partial View *@
@* This partial view includes BOTH the form content AND the action panel *@
@* It replaces the parent's form-content and action-panel when loaded *@

<form id="accountNotesForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Form Content -->
<main class="main-container main-container--with-panel">
<div class="form-content" role="region" aria-label="Account Notes form" data-submodule-content>
    <div class="form-card" data-submodule-form>
        <!-- Note Details Section -->
        <div class="form-section" data-section="note-details">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-journal-text"></i> NOTE DETAILS</span>
            </div>
            <div class="section-content" data-section-content>
                <div class="form-row">
                    <div class="col">
                        <label class="label-blue">Notes</label>
                        <textarea id="accountNotesTextarea" 
                                  name="notes" 
                                  class="bs-textarea" 
                                  rows="8" 
                                  placeholder="Enter account notes..." 
                                  disabled></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Behind the Scene Section -->
        <div class="form-section" data-section="behind-scene">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-gear"></i> BEHIND THE SCENE</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="audit-section">
                    <div class="audit-item">
                        <label>Created By</label>
                        <span class="audit-value" id="notesCreatedBy">-</span>
                    </div>
                    <div class="audit-item">
                        <label>Created On</label>
                        <span class="audit-value" id="notesCreatedOn">-</span>
                    </div>
                    <div class="audit-item">
                        <label>Modified By</label>
                        <span class="audit-value" id="notesModifiedBy">-</span>
                    </div>
                    <div class="audit-item">
                        <label>Modified On</label>
                        <span class="audit-value" id="notesModifiedOn">-</span>
                    </div>
                    <div class="audit-item">
                        <label>Supervised By</label>
                        <span class="audit-value" id="notesSupervisedBy">-</span>
                    </div>
                    <div class="audit-item">
                        <label>Supervised On</label>
                        <span class="audit-value" id="notesSupervisedOn">-</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_SubmoduleActionPanel", new ViewDataDictionary(ViewData) { { "PanelType", "standard" } })
</main>

<!-- Loading Overlay -->
<div class="loading-overlay" id="notesLoadingOverlay" hidden>
    <div class="loading-spinner">
        <i class="bi bi-arrow-repeat"></i>
        <span>Loading notes...</span>
    </div>
</div>

<!-- Message Panel -->
<div class="submodule-message-panel" id="notesMessagePanel" role="alert" aria-live="polite" hidden>
    <i class="bi bi-info-circle"></i>
    <span></span>
</div>

<!-- Initialize Account Notes Module -->
<script type="text/javascript" src="/js/modules/accountsmaintenance/account-notes.js"></script>
