@{
    // Migrated from: account-activation.html
}

<!-- AccountActivation Submodule -->
<div class="window">
    <div class="am-header" role="banner" aria-label="Window title bar">
        <div class="am-header__left">
            <i class="bi bi-check-circle am-header__icon" aria-hidden="true"></i>
            <span class="am-header__title">Account Activation</span>
        </div>
        <div class="am-header__right" role="toolbar" aria-label="Window controls">
        <button class="am-btn" type="button" data-action="refresh" title="Refresh" aria-label="Refresh data"><i class="bi bi-arrow-clockwise"></i></button>
        <button class="am-btn" type="button" data-action="maximize" title="Maximize" aria-label="Maximize window"><i class="bi bi-square"></i></button>
        <button class="am-btn am-btn--close" type="button" data-action="close" title="Close" aria-label="Close window"><i class="bi bi-x-lg"></i></button>
      </div>
    </div>

    <main class="main-container main-container--with-panel">
      <div class="form-content" role="region" aria-label="Account Activation form">
        <div class="form-card" data-main-form>

          <!-- ACCOUNT IDENTIFICATION SECTION -->
          <div class="form-section">
            <div class="section-header">
              <span class="section-header__title"><i class="bi bi-building"></i>Account Identification</span>
            </div>
            <div class="section-content">
              <div class="form-row">
                <div class="col">
                  <label class="label-blue">Branch ID</label>
                  <div class="kairo-branch-control" data-kairo-branch-control>
                    <input type="text" id="branchId" name="branchId" class="kairo-branch-control__id" aria-label="Branch ID" />
                    <input type="text" id="branchName" class="kairo-branch-control__name" aria-label="Branch Name" placeholder="Branch Name" readonly />
                    <button type="button" class="btn-lookup kairo-branch-control__lookup" aria-label="Search branch"><i class="bi bi-search"></i></button>
                  </div>
                </div>
                <div class="col">
                  <label class="label-blue">Account ID</label>
                  <div class="kairo-account-control" data-kairo-account-control>
                    <input type="text" id="accountId" name="accountId" class="kairo-account-control__id" aria-label="Account ID" />
                    <input type="text" id="accountName" class="kairo-account-control__name" aria-label="Account Name" placeholder="Account Name" readonly />
                    <button type="button" class="btn-lookup kairo-account-control__lookup" aria-label="Search account"><i class="bi bi-search"></i></button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ACTIVATION DETAILS SECTION -->
          <div class="form-section">
            <div class="section-header">
              <span class="section-header__title"></span>
            </div>
            <div class="section-content">
              <div class="form-row">
                <div class="col">
                  <label class="label-blue" for="instructedBy">Instructed By</label>
                  <input id="instructedBy" name="instructedBy" type="text" class="bs-input-text form-control" />
                </div>
              </div>
              <div class="form-row">
                <div class="col">
                  <label class="label-blue" for="comments">Comments</label>
                  <textarea id="comments" name="comments" class="bs-textarea form-control" rows="3"></textarea>
                </div>
              </div>
            </div>
          </div>

          <!-- BEHIND THE SCENE SECTION (COLLAPSIBLE) -->
          <div class="form-section form-section--bts">
            <div class="section-header" role="button" data-section-toggle aria-expanded="true">
              <span class="section-header__title"><i class="bi bi-gear"></i>Behind The Scene</span>
              <button class="section-toggle-btn" type="button" aria-label="Toggle audit information"><i class="bi bi-chevron-up"></i></button>
            </div>
            <div class="section-content">
              <div class="form-row four-col">
                <div class="col">
                  <label for="dormantDate">Dormant Date</label>
                  <input id="dormantDate" name="dormantDate" type="text" class="bs-input-text" readonly />
                </div>
                <div class="col">
                  <label for="originalProductId">Original Product ID</label>
                  <input id="originalProductId" name="originalProductId" type="text" class="bs-input-text" readonly />
                </div>
                <div class="col">
                  <label for="dormantProductId">Dormant Product ID</label>
                  <input id="dormantProductId" name="dormantProductId" type="text" class="bs-input-text" readonly />
                </div>
                <div class="col">
                  <label for="balance">Balance</label>
                  <input id="balance" name="balance" type="text" class="bs-input-text" readonly />
                </div>
              </div>
              <div class="form-row four-col">
                <div class="col">
                  <label for="fixedAmount">Fixed Amount</label>
                  <input id="fixedAmount" name="fixedAmount" type="text" class="bs-input-text" readonly />
                </div>
                <div class="col">
                  <label for="lastCreditDate">Last Credit Date</label>
                  <input id="lastCreditDate" name="lastCreditDate" type="text" class="bs-input-text" readonly />
                </div>
                <div class="col">
                  <label for="lastDebitDate">Last Debit Date</label>
                  <input id="lastDebitDate" name="lastDebitDate" type="text" class="bs-input-text" readonly />
                </div>
                <div class="col">
                  <label for="fixedAmountId">Fixed Amount ID</label>
                  <input id="fixedAmountId" name="fixedAmountId" type="text" class="bs-input-text" readonly />
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- ACTION PANEL -->
      <aside class="action-panel">
        <div class="d-flex flex-column gap-2 mt-auto">
          <button class="btn-action" type="button" data-action="view" title="View record"><i class="bi bi-eye"></i><span>View</span></button>
          <button class="btn-action" type="button" data-action="edit" title="Edit activation"><i class="bi bi-pencil-square"></i><span>Edit</span></button>
          <button class="btn-action" type="button" data-action="save" title="Save changes"><i class="bi bi-check-lg"></i><span>Save</span></button>
          <button class="btn-action" type="button" data-action="cancel" title="Cancel changes"><i class="bi bi-x-circle"></i><span>Cancel</span></button>
        </div>
      </aside>
    </main>

    <div class="de-loading-overlay" id="loadingOverlay" hidden><div class="de-loading-spinner"><i class="bi bi-arrow-repeat"></i><span>Loading...</span></div></div>
  </div>

  <script src="../../../assets/js/config.js"></script>
  <script src="../../../assets/js/environment.js"></script>
  <script src="../../../assets/js/utils/global-utils.js"></script>
  <script src="../../../assets/js/services/shared/coreApi.js"></script>
  <script src="../../../assets/js/services/shared/lookupService.js"></script>
  <script src="../../../assets/js/services/shared/searchService.js"></script>
  <script src="../../../assets/js/shared/search-modal.js"></script>
  <script src="../../../assets/js/services/account/accountservice.js"></script>
  <script src="dataentry-base.js?v=20250128"></script>
  <script src="dataentry-utils.js"></script>
  <script src="account-activation.js?v=20250128"></script>
  <script>
function notifyParentFormOpened(){window.parent.postMessage({action:'submoduleOpened',source:'Activation'},'*');}
function closeChildForm(){
  console.log('[Window Control] Closing child form');
  // Send message to parent to close this submodule
  window.parent.postMessage({action:'submoduleClosed', source:'Activation'},'*');
  // Also try to close the window directly
  setTimeout(() => {
    try {
      window.close();
    } catch(e) {
      console.log('[Window Control] Could not close window:', e.message);
    }
  }, 100);
}
  </script>

<script>
document.addEventListener('submodule:loaded', function(e) {
    if (e.detail.submoduleName === 'AccountActivation') {
        console.log('[AccountActivation] Submodule loaded');
    }
});
</script>
