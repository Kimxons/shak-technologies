@{
    // Migrated from: account-activation.html
}

<!-- AccountActivation Submodule -->
<div class="form-content" role="region" aria-label="Account Activation form">
  <div class="form-card" data-main-form>

    <!-- ACCOUNT IDENTIFICATION SECTION -->
    <div class="form-section" data-section="account-identification">
      <div class="section-header" data-section-toggle>
        <span class="section-header__title"><i class="bi bi-building me-1"></i>Account Identification</span>
        <button type="button" class="section-toggle-btn" aria-label="Toggle Section" aria-expanded="true">
          <i class="bi bi-chevron-up"></i>
        </button>
      </div>
      <div class="section-content" data-section-content>
        <div class="row g-2 mb-2">
          <div class="col-md-6">
            <label class="label-blue am-label required" for="branchId">Branch</label>
            <div class="kairo-account-control" data-kairo-account-control>
              <input type="text" id="branchId" name="branchId" class="kairo-account-control__id form-control am-input" placeholder="ID" readonly />
              <input type="text" id="branchName" class="kairo-account-control__name form-control am-input" placeholder="Branch Name" readonly />
              <button type="button" class="btn-lookup kairo-account-control__lookup" data-lookup="Branch" title="Lookup Branch"><i class="bi bi-search"></i></button>
            </div>
          </div>
          <div class="col-md-6">
            <label class="label-blue am-label required" for="accountId">Account</label>
            <div class="kairo-account-control" data-kairo-account-control>
              <input type="text" id="accountId" name="accountId" class="kairo-account-control__id form-control am-input" placeholder="ID" readonly />
              <input type="text" id="accountName" class="kairo-account-control__name form-control am-input" placeholder="Account Name" readonly />
              <button type="button" class="btn-lookup kairo-account-control__lookup" data-lookup="Account" title="Lookup Account"><i class="bi bi-search"></i></button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ACTIVATION DETAILS SECTION -->
    <div class="form-section">
      <div class="section-header" data-section-toggle>
        <span class="section-header__title"><i class="bi bi-check2-circle me-1"></i>Activation Details</span>
        <button type="button" class="section-toggle-btn" aria-label="Toggle Section" aria-expanded="true">
          <i class="bi bi-chevron-up"></i>
        </button>
      </div>
      <div class="section-content" data-section-content>
        <div class="row g-2 mb-2">
          <div class="col-md-12">
            <label class="label-blue am-label required" for="instructedBy">Instructed By</label>
            <input id="instructedBy" name="instructedBy" type="text" class="form-control am-input" />
          </div>
        </div>
        <div class="row g-2 mb-2">
          <div class="col-md-12">
            <label class="label-blue am-label" for="comments">Comments</label>
            <textarea id="comments" name="comments" class="form-control am-input" rows="2"></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- BEHIND THE SCENE SECTION (matching legacy) -->
    <div class="form-section">
      <div class="section-header" data-section-toggle>
        <span class="section-header__title"><i class="bi bi-gear me-1"></i>Behind The Scene</span>
        <button class="section-toggle-btn" type="button" aria-expanded="true"><i class="bi bi-chevron-up"></i></button>
      </div>
      <div class="section-content" data-section-content>
        <div class="row g-2 mb-2">
          <div class="col-md-3">
            <label class="am-label" for="createdOn">Created On</label>
            <input id="createdOn" name="createdOn" type="text" class="form-control am-input" readonly />
          </div>
          <div class="col-md-6">
            <label class="am-label" for="productId">Product ID</label>
            <div class="d-flex gap-2">
              <input id="productId" name="productId" type="text" class="form-control am-input" style="max-width:100px" readonly />
              <input id="productName" name="productName" type="text" class="form-control am-input" readonly />
            </div>
          </div>
          <div class="col-md-3">
            <label class="am-label" for="availableBalance">Available Balance</label>
            <input id="availableBalance" name="availableBalance" type="text" class="form-control am-input text-end" readonly />
          </div>
        </div>
        <div class="row g-2 mb-2">
          <div class="col-md-3">
            <label class="am-label" for="lastCreditDate">Last Credit Date</label>
            <input id="lastCreditDate" name="lastCreditDate" type="text" class="form-control am-input" readonly />
          </div>
          <div class="col-md-3">
            <label class="am-label" for="fixedAmount">Fixed Amount</label>
            <input id="fixedAmount" name="fixedAmount" type="text" class="form-control am-input text-end" readonly />
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<div class="de-loading-overlay" id="loadingOverlay" hidden><div class="de-loading-spinner"><i class="bi bi-arrow-repeat"></i><span>Loading...</span></div></div>

<script type="text/javascript" src="~/js/modules/accountsmaintenance/account-activation.js"></script>
