@{
    // No layout - this is a partial view
}

<!-- {SUBMODULE_NAME} Submodule Placeholder -->
<div class="form-card">
    <div class="form-section">
        <div class="section-header">
            <span class="section-header__title">
                <i class="bi bi-wrench"></i>{SUBMODULE_TITLE}
            </span>
        </div>
        <div class="section-content">
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                <strong>{SUBMODULE_TITLE}</strong> module is under development.
            </div>
            <p class="text-muted">This submodule will contain {SUBMODULE_DESCRIPTION}.</p>
            
            <!-- Placeholder content -->
            <div class="text-center py-5">
                <i class="bi bi-tools" style="font-size: 4rem; color: var(--color-border);"></i>
                <h5 class="mt-3">Coming Soon</h5>
                <p class="text-muted">This feature is currently being developed.</p>
            </div>
        </div>
    </div>
</div>
