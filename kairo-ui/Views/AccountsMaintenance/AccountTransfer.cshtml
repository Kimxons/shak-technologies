@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Migrated from: account-transfer.html
    var transferTypeOptions = ViewData["TransferTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var transferReasonOptions = ViewData["TransferReasonOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- AccountTransfer Submodule -->
<div class="form-content" role="region" aria-label="Account Transfer form">
    <div class="form-card" data-main-form>
        <!-- Transfer Details Section -->
        <div class="form-section" data-section="transfer-details">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-arrow-repeat me-1"></i>Transfer Details</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Transfer Details" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="branchId">To Branch</label>
                        <div class="kairo-account-control" data-kairo-account-control>
                            <input id="branchId" name="branchId" type="text" class="form-control am-input kairo-account-control__id" readonly />
                            <input id="branchName" type="text" class="form-control am-input kairo-account-control__name" readonly />
                            <button class="btn-lookup kairo-account-control__lookup" type="button" data-lookup="branchId"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="productId">To Product</label>
                        <div class="kairo-account-control" data-kairo-account-control>
                            <input id="productId" name="productId" type="text" class="form-control am-input kairo-account-control__id" readonly />
                            <input id="productName" type="text" class="form-control am-input kairo-account-control__name" readonly />
                            <button class="btn-lookup kairo-account-control__lookup" type="button" data-lookup="productId"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check">
                            <input id="retainAccountId" name="retainAccountId" type="checkbox" class="form-check-input" />
                            <label class="form-check-label am-label" for="retainAccountId">Retain Account ID</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="reason">Transfer Reason</label>
                        <select id="reason" name="reason" class="form-select am-input">
                            <option value="">--Select--</option>
                            @foreach (var option in transferReasonOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-12">
                        <label class="label-blue am-label" for="remarks">Remarks / Narrative</label>
                        <textarea id="remarks" name="remarks" class="form-control am-input" rows="2" placeholder="Enter transfer remarks..."></textarea>
                    </div>
                </div>

                <!-- Financial Details Section (BTS Style) -->
                <div class="row g-2 mb-2 mt-3 pt-2 border-top">
                    <div class="col-md-4">
                        <label class="am-label" for="balance">Current Balance</label>
                        <input id="balance" name="balance" type="text" class="form-control am-input text-end" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="am-label" for="debitInterestReceivable">Dr Int Receivable</label>
                        <input id="debitInterestReceivable" name="debitInterestReceivable" type="text" class="form-control am-input text-end" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="am-label" for="creditInterestPayable">Cr Int Payable</label>
                        <input id="creditInterestPayable" name="creditInterestPayable" type="text" class="form-control am-input text-end" readonly />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="am-label" for="penalInterestReceivable">Penal Int Receivable</label>
                        <input id="penalInterestReceivable" name="penalInterestReceivable" type="text" class="form-control am-input text-end" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="am-label" for="transferCharges">Transfer Charges</label>
                        <input id="transferCharges" name="transferCharges" type="text" class="form-control am-input text-end" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="am-label fw-bold" for="netPayable">NET PAYABLE</label>
                        <input id="netPayable" name="netPayable" type="text" class="form-control am-input text-end fw-bold text-primary" readonly />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="de-loading-overlay" id="loadingOverlay" hidden><div class="de-loading-spinner"><i class="bi bi-arrow-repeat"></i><span>Loading...</span></div></div>

<script src="~/js/modules/accountsmaintenance/account-transfer.js"></script>
