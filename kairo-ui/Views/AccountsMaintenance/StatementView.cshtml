@{
    // Migrated from: statement-view.html
}

<!-- StatementView Submodule -->
<div class="window">
    <div class="am-header" role="banner" aria-label="Window title bar">
        <div class="am-header__left">
            <i class="bi bi-receipt am-header__icon" aria-hidden="true"></i>
            <span class="am-header__title">Statement View</span>
        </div>
        <div class="am-header__right" role="toolbar" aria-label="Window controls">
        <button class="de-title-btn am-btn am-btn-secondary" type="button" data-action="refresh" title="Refresh" aria-label="Refresh data"><i class="bi bi-arrow-clockwise"></i></button>
        <button class="de-title-btn am-btn am-btn-secondary" type="button" data-action="maximize" title="Maximize" aria-label="Maximize window"><i class="bi bi-square"></i></button>
        <button class="de-title-btn am-btn am-btn-secondary" type="button" data-action="close" title="Close" aria-label="Close window"><i class="bi bi-x-lg"></i></button>
      </div>
    </div>

    <main class="main-container">
      <div class="form-content" role="region" aria-label="Statement View">
        <div class="form-card" data-main-form>
          <!-- Filters Section -->
          <div class="form-section" data-section="filters">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title"><i class="bi bi-funnel"></i>Filters</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Filters" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <form autocomplete="off">
                <!-- Row 1: Statement For, From Date, To Date -->
                <div class="row g-3 mb-3">
                  <div class="col-4">
                    <label class="label-blue" for="statementFor">Statement For</label>
                    <select id="statementFor" name="statementFor" class="bs-select">
                      <option value="0">Select Period</option>
                      <option value="1">Current Month</option>
                      <option value="2">Current and Previous Month</option>
                      <option value="3">Date Range</option>
                    </select>
                  </div>
                  <div class="col-4">
                    <label class="label-blue" for="fromDate">From Date</label>
                    <div class="input-group">
                      <input id="fromDate" name="fromDate" type="text" class="bs-input-text form-control" placeholder="dd-mmm-yyyy" autocomplete="off" />
                      <button id="fromDatePicker" type="button" class="btn btn-outline-secondary" title="Pick Date"><i class="bi bi-calendar"></i></button>
                    </div>
                  </div>
                  <div class="col-4">
                    <label class="label-blue" for="toDate">To Date</label>
                    <div class="input-group">
                      <input id="toDate" name="toDate" type="text" class="bs-input-text form-control" placeholder="dd-mmm-yyyy" autocomplete="off" />
                      <button id="toDatePicker" type="button" class="btn btn-outline-secondary" title="Pick Date"><i class="bi bi-calendar"></i></button>
                    </div>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <!-- Statement Grid Section -->
          <div class="form-section" data-section="statement-grid">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title"><i class="bi bi-table"></i>Statement Grid</span>
              <span class="de-record-count" id="recordCount">(0 records)</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Statement Grid" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content table-responsive" data-section-content>
              <table class="table table-sm table-hover mb-0" id="statementGrid">
                <thead class="table-light">
                  <tr>
                    <th class="col-checkbox"><input type="checkbox" id="selectAll" /></th>
                    <th>Date</th>
                    <th>Value Date</th>
                    <th>Particulars</th>
                    <th class="text-end">Debit</th>
                    <th class="text-end">Credit</th>
                    <th class="text-end">Closing</th>
                    <th class="d-none">BatchID</th>
                    <th class="d-none">RowID</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td colspan="8" class="text-center text-muted py-4">No records to display.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Panel -->
      <aside class="action-panel">
        <div class="d-flex flex-column gap-2 mt-auto">
          <button class="btn-action" type="button" data-action="view" title="View"><i class="bi bi-eye"></i><span>View</span></button>
          <button class="btn-action" type="button" data-action="print" title="Print"><i class="bi bi-printer"></i><span>Print</span></button>
          <button class="btn-action" type="button" data-action="reverse" title="Reverse"><i class="bi bi-arrow-counterclockwise"></i><span>Reverse</span></button>
          <button class="btn-action" type="button" data-action="refresh" title="Refresh"><i class="bi bi-arrow-clockwise"></i><span>Refresh</span></button>
          <button class="btn-action btn-cancel" type="button" data-action="close" title="Close"><i class="bi bi-x-lg"></i><span>Close</span></button>
        </div>
      </aside>
    </main>
  </div>
  <script src="../../../assets/js/config.js"></script>
  <script src="../../../assets/js/environment.js"></script>
  <script src="../../../assets/js/services/shared/coreApi.js"></script>
  <script src="../../../assets/js/services/account/AccountService.js"></script>
  <script src="view-base.js?v=20250128"></script>
  <script src="statement-view.js?v=20250128"></script>
  <script>
    // Window control handlers
    document.querySelectorAll('.de-title-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const action = btn.dataset.action;
        if (action === 'refresh') {
          location.reload();
        } else if (action === 'maximize') {
          const windowEl = document.querySelector('.window');
          windowEl.classList.toggle('maximized');
          window.parent.postMessage({ action: 'toggleSidebarForMaximize', isMaximized: windowEl.classList.contains('maximized') }, '*');
        } else if (action === 'close') {
          window.parent.postMessage({ action: 'submoduleClosed' }, '*');
        }
      });
    });
    // Notify parent when form opens
    window.parent.postMessage({ action: 'submoduleOpened' }, '*');
  </script>

<script>
document.addEventListener('submodule:loaded', function(e) {
    if (e.detail.submoduleName === 'StatementView') {
        console.log('[StatementView] Submodule loaded');
    }
});
</script>
