@{
    // Migrated from: account-classification.html
}

<!-- AccountClassification Submodule -->
<div class="window">
    <div class="am-header" role="banner" aria-label="Window title bar">
      <div class="am-header__left">
        <i class="bi bi-tags am-header__icon" aria-hidden="true"></i>
        <span class="am-header__title">Account Classification</span>
      </div>
      <div class="am-header__right" role="toolbar" aria-label="Window controls">
        <button class="am-btn" type="button" data-action="refresh" title="Refresh" aria-label="Refresh data"><i class="bi bi-arrow-clockwise"></i></button>
        <button class="am-btn" type="button" data-action="maximize" title="Maximize" aria-label="Maximize window"><i class="bi bi-square"></i></button>
        <button class="am-btn am-btn--close" type="button" data-action="close" title="Close" aria-label="Close window"><i class="bi bi-x-lg"></i></button>
      </div>
    </div>

    <main class="main-container">
      <div class="form-content" role="region" aria-label="Account Classification form">
        <div class="form-card" data-main-form>
          <div class="form-section" data-section="classification-selection">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title">Classification Selection</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Classification Selection" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <form autocomplete="off">
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="label-blue" for="classificationCode">Classification Code</label>
                    <select id="classificationCode" name="classificationCode" class="bs-select form-control">
                      <option>--Select--</option>
                    </select>
                  </div>
                  <div class="col-6">
                    <label class="label-blue" for="classificationSubCode">Classification Sub Code</label>
                    <select id="classificationSubCode" name="classificationSubCode" class="bs-select form-control">
                      <option></option>
                    </select>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <div class="form-section" data-section="classification-list">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title">Classification List</span>
              <span class="de-record-count" id="recordCount">0 records</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Classification List" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content table-responsive" data-section-content>
              <table class="table table-sm table-hover" id="classificationGrid">
                <thead>
                  <tr><th>Class</th><th>Sub Class</th></tr>
                </thead>
                <tbody>
                  <tr class="de-table__empty"><td colspan="2">No records to display.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="form-section" data-section="behind-scene">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title"><i class="bi bi-gear"></i>Behind the Scene</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle BTS" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <div class="audit-section audit-section--summary">
                <div class="audit-cell"><span class="audit-label">Created By</span><span class="audit-value" id="MakerID">-</span></div>
                <div class="audit-cell"><span class="audit-label">Created On</span><span class="audit-value" id="MakerDT">-</span></div>
                <div class="audit-cell"><span class="audit-label">Checked By</span><span class="audit-value" id="CheckerID">-</span></div>
                <div class="audit-cell"><span class="audit-label">Checked On</span><span class="audit-value" id="CheckerDT">-</span></div>
                <div class="audit-cell"><span class="audit-label">Modified By</span><span class="audit-value" id="ModifierID">-</span></div>
                <div class="audit-cell"><span class="audit-label">Modified On</span><span class="audit-value" id="ModifierDT">-</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Action Panel Sidebar -->
        <div class="action-panel">
          <div class="action-buttons">
            <button class="btn-action" type="button" data-action="add" title="Add New">
              <i class="bi bi-plus-circle me-1"></i>Add
            </button>
            <button class="btn-action" type="button" data-action="edit" title="Edit">
              <i class="bi bi-pencil-square me-1"></i>Edit
            </button>
            <button class="btn-action" type="button" data-action="save" title="Save">
              <i class="bi bi-check-lg me-1"></i>Save
            </button>
            <button class="btn-action" type="button" data-action="delete" title="Delete">
              <i class="bi bi-trash3 me-1"></i>Delete
            </button>
            <button class="btn-action btn-cancel" type="button" data-action="cancel" title="Cancel">
              <i class="bi bi-x-circle me-1"></i>Cancel
            </button>
            <button class="btn-action" type="button" data-action="back" title="Back">
              <i class="bi bi-arrow-left me-1"></i>Back
            </button>
          </div>
        </div>
      </div>
    </main>

    <div class="am-message-panel" role="alert" aria-live="polite"><i class="bi bi-info-circle"></i><span></span></div>
    <div class="loading-overlay" id="loadingOverlay" hidden>
      <div class="loading-spinner"><i class="bi bi-arrow-repeat"></i><span>Loading...</span></div>
    </div>
  </div>

  <script src="../../../assets/js/config.js"></script>
  <script src="../../../assets/js/environment.js"></script>
  <script src="../../../assets/js/services/shared/coreApi.js"></script>
  <script src="../../../assets/js/services/account/accountClassificationService.js?v=20260209"></script>
  <script src="../../../assets/js/services/Account/AccountService.js"></script>
  <script src="dataentry-base.js?v=20250128"></script>
  <script src="dataentry-utils.js"></script>
  <script src="account-classification.js?v=20260209"></script>

<script>
document.addEventListener('submodule:loaded', function(e) {
    if (e.detail.submoduleName === 'AccountClassification') {
        console.log('[AccountClassification] Submodule loaded');
    }
});
</script>
