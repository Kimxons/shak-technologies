@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Migrated from: card-maintenance.html
    var cardProviderOptions = ViewData["CardProviderOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var cardTypeOptions = ViewData["CardTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var cardDeactivationReasonOptions = ViewData["CardDeactivationReasonOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var cardStatusOptions = ViewData["CardStatusOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- CardMaintenance Submodule -->
<div class="form-card" data-main-form>
  <!-- Card Search Section -->
  <div class="form-section" data-section="card-search">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-search me-1"></i>Card Search</span>
      <button type="button" class="section-toggle-btn" aria-label="Toggle Card Search" aria-expanded="true">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="section-content" data-section-content>
      <form autocomplete="off">
        <div class="form-row four-col">
          <div class="col">
            <label class="label-blue">TrackingID</label>
            <input id="trackingId" type="text" class="bs-input-text" placeholder="TrackingID" />
          </div>
          <div class="col">
            <label class="label-blue">Card Provider</label>
            <select id="cardProvider" class="bs-select">
              <option value="">--Select--</option>
              @foreach (var option in cardProviderOptions)
              {
                  <option value="@option.Value">@option.Text</option>
              }
            </select>
          </div>
          <div class="col">
            <label class="label-blue">CardName <small class="text-muted">(from Account)</small></label>
            <input id="cardName" type="text" class="bs-input-text bg-light" placeholder="Auto-populated from Account" readonly />
          </div>
          <div class="col">
            <label class="label-blue">CardType</label>
            <select id="cardType" class="bs-select">
              <option value="">--Select--</option>
              @foreach (var option in cardTypeOptions)
              {
                  <option value="@option.Value">@option.Text</option>
              }
            </select>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Cards List Section -->
  <div class="form-section" data-section="cards-list">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-list-ul me-1"></i>Card List</span>
      <span class="de-record-count ms-auto me-3" id="recordCount">0 records</span>
      <button type="button" class="section-toggle-btn" aria-label="Toggle Cards List" aria-expanded="true">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="section-content table-responsive" data-section-content>
      <table class="table table-sm table-bordered table-hover" id="cardsListTable">
        <thead class="table-light">
          <tr>
            <th>TrackingID</th>
            <th>Card ID</th>
            <th>Account ID</th>
            <th>Card Provider</th>
            <th>Remarks</th>
          </tr>
        </thead>
        <tbody>
          <tr class="table__empty"><td colspan="5">No records to display.</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Card Details Section -->
  <div class="form-section" data-section="card-details">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-credit-card me-1"></i>Card Details</span>
      <button type="button" class="section-toggle-btn" aria-label="Toggle Card Details" aria-expanded="true">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="section-content" data-section-content>
      <form autocomplete="off">
        <!-- Row 1 -->
        <div class="form-row four-col">
          <div class="col">
            <label class="label-blue">Card ID <small class="text-muted">(optional)</small></label>
            <input id="cardId" type="text" class="bs-input-text bg-light" placeholder="Card ID" readonly />
          </div>
          <div class="col">
            <label class="label">Card Remarks</label>
            <textarea id="cardRemarks" class="bs-input-text" rows="1" placeholder="Card Remarks"></textarea>
          </div>
          <div class="col">
            <label class="label">Is Approved</label>
            <div class="form-check pt-1">
              <input id="isApproved" type="checkbox" class="form-check-input" />
              <label class="form-check-label" for="isApproved">Approved</label>
            </div>
          </div>
          <div class="col">
            <label class="label">Approved Date</label>
            <input id="approvedDate" type="date" class="bs-input-text" />
          </div>
        </div>

        <!-- Row 2 -->
        <div class="form-row four-col">
          <div class="col">
            <label class="label">Is Exported</label>
            <div class="form-check pt-1">
              <input id="isExported" type="checkbox" class="form-check-input" />
              <label class="form-check-label" for="isExported">Exported</label>
            </div>
          </div>
          <div class="col">
            <label class="label">Exported Date</label>
            <input id="exportedDate" type="date" class="bs-input-text" />
          </div>
          <div class="col">
            <label class="label">Is Active</label>
            <div class="form-check pt-1">
              <input id="isActive" type="checkbox" class="form-check-input" checked />
              <label class="form-check-label" for="isActive">Active</label>
            </div>
          </div>
          <div class="col">
            <label class="label">Activated Date</label>
            <input id="activatedDate" type="date" class="bs-input-text" />
          </div>
        </div>

        <!-- Row 3 -->
        <div class="form-row four-col">
          <div class="col">
            <label class="label">Start Date</label>
            <input id="startDate" type="date" class="bs-input-text" />
          </div>
          <div class="col">
            <label class="label">Expiry Date</label>
            <input id="expiryDate" type="date" class="bs-input-text" />
          </div>
          <div class="col">
            <label class="label">Collected</label>
            <div class="form-check pt-1">
              <input id="collected" type="checkbox" class="form-check-input" />
              <label class="form-check-label" for="collected">Collected</label>
            </div>
          </div>
          <div class="col">
            <label class="label">Collection Date</label>
            <input id="collectionDate" type="date" class="bs-input-text" />
          </div>
        </div>

        <!-- Row 4 -->
        <div class="form-row four-col">
          <div class="col">
            <label class="label">Deactivation Date</label>
            <input id="deactivationDate" type="date" class="bs-input-text" />
          </div>
          <div class="col">
            <label class="label">Reason</label>
            <select id="reason" class="bs-select">
              <option value="">--Select--</option>
              @foreach (var option in cardDeactivationReasonOptions)
              {
                  <option value="@option.Value">@option.Text</option>
              }
            </select>
          </div>
          <div class="col">
            <label class="label">Reactivation Date</label>
            <input id="reactivationDate" type="date" class="bs-input-text" />
          </div>
          <div class="col">
            <label class="label">Reactivation Remarks</label>
            <input id="reactivationRemarks" type="text" class="bs-input-text" placeholder="Reactivation Remarks" />
          </div>
        </div>

        <!-- Row 5 -->
        <div class="form-row four-col">
          <div class="col">
            <label class="label">Status</label>
            <select id="status" class="bs-select">
              <option value="">--Select--</option>
              @foreach (var option in cardStatusOptions)
              {
                  <option value="@option.Value">@option.Text</option>
              }
            </select>
          </div>
          <div class="col">
            <label class="label">Initial Transaction</label>
            <input id="initialTransaction" type="text" class="bs-input-text" placeholder="Initial Transaction" />
          </div>
          <div class="col"></div>
          <div class="col"></div>
        </div>
      </form>
    </div>
  </div>

  <!-- Behind the Scene Section -->
  <div class="form-section" data-section="behind-scene">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-gear me-1"></i>Behind The Scene</span>
      <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
        <i class="bi bi-chevron-up"></i>
      </button>
    </div>
    <div class="section-content" data-section-content>
      <div class="audit-section audit-section--summary">
        <div class="audit-item"><label>Created By</label><span class="audit-value" id="MakerID">-</span></div>
        <div class="audit-item"><label>Created On</label><span class="audit-value" id="MakerDT">-</span></div>
        <div class="audit-item"><label>Checked By</label><span class="audit-value" id="CheckerID">-</span></div>
        <div class="audit-item"><label>Checked On</label><span class="audit-value" id="CheckerDT">-</span></div>
        <div class="audit-item"><label>Modified By</label><span class="audit-value" id="ModifierID">-</span></div>
        <div class="audit-item"><label>Modified On</label><span class="audit-value" id="ModifierDT">-</span></div>
      </div>
    </div>
  </div>
</div>

<script src="~/js/modules/accountsmaintenance/card-maintenance.js" asp-append-version="true"></script>
