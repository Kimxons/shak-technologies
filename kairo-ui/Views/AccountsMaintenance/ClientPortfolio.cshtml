@* Client Portfolio Submodule - Loaded as Partial View *@
@* Migrated from: client-portfolio.html *@
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_ApplicationLayout";
    var portfolioTypeOptions = ViewData["PortfolioTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<form id="clientPortfolioForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Form Content -->
<main class="main-container main-container--with-panel">
<div class="form-content" role="region" aria-label="Client Portfolio" data-submodule-content>
    <div class="form-card" data-submodule-form>
        <!-- Portfolio Type Section -->
        <div class="form-section" data-section="portfolio-type">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-briefcase"></i> PORTFOLIO TYPE</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Portfolio Type" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="form-row two-col">
                    <div class="col">
                        <label class="label-blue" for="ddl_portfolioType">Client Portfolio Type</label>
                        <select id="ddl_portfolioType" name="portfolioType" class="bs-select">
                            <option value="">--Select--</option>
                            @foreach (var option in portfolioTypeOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col"></div>
                </div>
            </div>
        </div>
        
        <!-- Portfolio Grid Section -->
        <div class="form-section" data-section="portfolio-grid">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-table"></i> PORTFOLIO GRID</span>
                <span class="de-record-count" id="spn_portfolioRecordCount">(0 records)</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Portfolio Grid" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="table-responsive">
                    <table class="table table-sm table-hover" id="tbl_portfolioGrid">
                        <thead class="table-light">
                            <tr>
                                <th>Branch ID</th>
                                <th>Account ID</th>
                                <th class="text-end">Deposit</th>
                                <th class="text-end">Advance</th>
                                <th class="text-end">Non Fund Advance</th>
                                <th class="text-end">Interest Receivable</th>
                                <th class="text-end">Interest Payable</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No records to display.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Consolidated Values Section -->
        <div class="form-section" data-section="consolidated-values">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-calculator"></i> CONSOLIDATED VALUES</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Consolidated Values" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="form-row four-col">
                    <div class="col">
                        <label class="label-blue" for="txt_totalInterestReceivable">Interest Receivable</label>
                        <input type="text" id="txt_totalInterestReceivable" class="bs-input-text text-end" value="0.00" readonly />
                    </div>
                    <div class="col">
                        <label class="label-blue" for="txt_totalInterestPayable">Interest Payable</label>
                        <input type="text" id="txt_totalInterestPayable" class="bs-input-text text-end" value="0.00" readonly />
                    </div>
                    <div class="col">
                        <label class="label-blue" for="txt_totalAdvances">Advances</label>
                        <input type="text" id="txt_totalAdvances" class="bs-input-text text-end" value="0.00" readonly />
                    </div>
                    <div class="col">
                        <label class="label-blue" for="txt_totalDeposits">Total Deposits</label>
                        <input type="text" id="txt_totalDeposits" class="bs-input-text text-end" value="0.00" readonly />
                    </div>
                </div>
                <input type="hidden" id="hdn_totalNonFund" value="0.00" />
                <input type="hidden" id="hdn_netFundsUsed" value="0.00" />
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_SubmoduleActionPanel", new ViewDataDictionary(ViewData) { { "PanelType", "viewonly" } })
</main>

<!-- Loading Overlay -->
<div class="loading-overlay" id="portfolioLoadingOverlay" hidden>
    <div class="loading-spinner">
        <i class="bi bi-arrow-repeat"></i>
        <span>Loading portfolio...</span>
    </div>
</div>

<!-- Message Panel -->
<div class="submodule-message-panel" id="portfolioMessagePanel" role="alert" aria-live="polite" hidden>
    <i class="bi bi-info-circle"></i>
    <span></span>
</div>

<!-- Initialize Client Portfolio Module -->
<script src="/js/modules/accountsmaintenance/client-portfolio.js"></script>
