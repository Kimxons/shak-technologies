@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Migrated from: client-portfolio.html
    var portfolioTypeOptions = ViewData["PortfolioTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- ClientPortfolio Submodule -->
<div class="window de-window" data-ktb-window>
    <div data-kairo-titlebar data-title="Client Portfolio" data-icon="bi-briefcase"></div>
    <main class="main-container main-container--with-panel">
      <div class="form-content" role="region">
        <div class="form-card" data-main-form>
        <!-- Portfolio Type Section -->
        <div class="form-section cp-type-section">
          <div class="section-header"><span class="section-header__title">Portfolio Type</span></div>
          <div class="section-content cp-type-body">
            <div class="cp-type-field">
              <label class="label" for="portfolioType">Client Portfolio Type</label>
              <select id="portfolioType" name="portfolioType" class="bs-select form-control">
                <option value="">--Select--</option>
                @foreach (var option in portfolioTypeOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
              </select>
            </div>
          </div>
        </div>
        
        <!-- Portfolio Grid -->
        <div class="form-section form-section form-section--grid">
          <div class="section-header"><span class="section-header__title">Portfolio Grid</span><span class="de-record-count" id="recordCount">0 records</span></div>
          <div class="section-content section-content section-content--grid">
            <div class="table table-sm table-hover-wrap">
              <table class="table table-sm table-hover" id="portfolioGrid">
                <thead><tr><th>Branch ID</th><th>Account ID</th><th>Deposit</th><th>Advance</th><th>Non Fund Advance</th><th>Interest Receivable</th><th>Interest Payable</th></tr></thead>
                <tbody><tr class="table table-sm table-hover__empty"><td colspan="7">No records to display.</td></tr></tbody>
              </table>
            </div>
          </div>
        </div>
        
        <!-- Consolidated Values - Four columns, right-aligned amounts -->
        <div class="form-section">
          <div class="section-header"><span class="section-header__title">Consolidated Values</span></div>
          <div class="section-content">
            <div class="form-row four-col cp-consolidated-row">
              <div class="col">
                <label class="label-blue" for="totalInterestReceivable">Interest</label>
                <input type="text" id="totalInterestReceivable" class="bs-input-text form-control text-end" value="0.00" readonly aria-readonly="true" />
              </div>
              <div class="col">
                <label class="label-blue" for="totalInterestPayable">Payable</label>
                <input type="text" id="totalInterestPayable" class="bs-input-text form-control text-end" value="0.00" readonly aria-readonly="true" />
              </div>
              <div class="col">
                <label class="label-blue" for="totalAdvances">Advances</label>
                <input type="text" id="totalAdvances" class="bs-input-text form-control text-end" value="0.00" readonly aria-readonly="true" />
              </div>
              <div class="col">
                <label class="label-blue" for="totalDeposits">Total Deposits</label>
                <input type="text" id="totalDeposits" class="bs-input-text form-control text-end" value="0.00" readonly aria-readonly="true" />
              </div>
            </div>
            <input type="hidden" id="totalNonFund" value="0.00" />
            <input type="hidden" id="netFundsUsed" value="0.00" />
          </div>
        </div>
        </div>
      </div>
      <aside class="action-panel">
        <div class="d-flex flex-column gap-2 mt-auto">
          <button class="btn-action" type="button" data-action="print"><i class="bi bi-printer"></i><span>Print</span></button>
          <button class="btn-action" type="button" data-action="export"><i class="bi bi-download"></i><span>Export</span></button>
          <button class="btn-action" type="button" data-action="refresh"><i class="bi bi-arrow-clockwise"></i><span>Refresh</span></button>
          <button class="btn-action btn-cancel" type="button" data-action="close"><i class="bi bi-x-lg"></i><span>Close</span></button>
        </div>
      </aside>
    </main>
    <footer class="de-status-bar" role="status">Ready</footer>
    <div class="de-loading-overlay" id="loadingOverlay" hidden><div class="de-loading-spinner"><i class="bi bi-arrow-repeat"></i><span>Loading...</span></div></div>
  </div>
  <script src="../../../assets/js/config.js"></script>
  <script src="../../../assets/js/environment.js"></script>
  <script src="../../../assets/js/services/shared/coreApi.js"></script>
  <script src="../../../assets/js/services/shared/lookupService.js"></script>
  <script src="../../../assets/js/services/account/AccountService.js"></script>
  <script src="../../../assets/js/components/TitleBar.js"></script>
  <script src="view-base.js?v=20250129"></script>
  <script src="client-portfolio.js?v=20250129b"></script>

<script>
document.addEventListener('submodule:loaded', function(e) {
    if (e.detail.submoduleName === 'ClientPortfolio') {
        console.log('[ClientPortfolio] Submodule loaded');
    }
});
</script>
