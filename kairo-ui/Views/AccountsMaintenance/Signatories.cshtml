@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // No layout - partial view loaded dynamically into #submodule-container
    // Migrated from: public/modules/account-maintenance/DataEntry/account-signatories.html
    var signatoryTypeOptions = ViewData["SignatoryTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var mandatesOptions = ViewData["MandatesOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- ======================================================================
     Account Signatories Submodule
     Action panel buttons (Signature/Photo/Both/Add/Edit/Save/Cancel) are
     rendered by the PARENT page's updateActionPanelForSubmodule().
     This view only contains the form + grid + modal.
     ====================================================================== -->
<div class="window">
  <!-- HEADER -->
  <div class="am-header" role="banner">
    <div class="am-header__left">
      <i class="bi bi-people am-header__icon"></i>
      <span class="am-header__title">Account Signatories</span>
    </div>
    <div class="am-header__right" role="toolbar" aria-label="Window controls">
      <button class="am-btn" type="button" data-action="refresh" title="Refresh" aria-label="Refresh data"><i class="bi bi-arrow-clockwise"></i></button>
      <button class="am-btn" type="button" data-action="maximize" title="Maximize" aria-label="Maximize window"><i class="bi bi-square"></i></button>
      <button class="am-btn am-btn--close" type="button" data-action="close" title="Close" aria-label="Close window"><i class="bi bi-x-lg"></i></button>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <main class="main-container main-container--with-panel">
    <div class="form-content" role="region" aria-label="Signatories form">
      <div class="form-card" data-main-form>

        <!-- Message Bar -->
        <div class="de-message-bar" role="alert" aria-live="polite">
          <i class="bi bi-check-circle"></i><span></span>
        </div>

        <!-- ============================================================
             SIGNATORY DETAILS SECTION
             ============================================================ -->
        <div class="form-section">
          <div class="section-header">
            <span class="section-header__title"><i class="bi bi-person-badge"></i> Signatory Details</span>
          </div>
          <div class="section-content">

            <!-- Row 1: Signatory ID + Group ID -->
            <div class="form-row">
              <div class="col">
                <label class="label-blue" for="signatoryId">Signatory ID</label>
                <div class="d-flex gap-1">
                  <input id="signatoryId" name="signatoryId" type="text" class="bs-input-text form-control" />
                  <button class="btn-lookup" type="button" data-lookup="signatoryId" title="Search signatory"><i class="bi bi-search"></i></button>
                </div>
                <input id="signatoryName" name="signatoryName" type="hidden" />
              </div>
              <div class="col">
                <label for="groupId">Group ID</label>
                <div class="d-flex gap-1">
                  <input id="groupId" name="groupId" type="text" class="bs-input-text form-control" />
                  <button class="btn-lookup" type="button" data-lookup="groupId" title="Search group"><i class="bi bi-search"></i></button>
                </div>
              </div>
            </div>

            <!-- Row 2: Signatory Type + Sequence No -->
            <div class="form-row">
              <div class="col">
                <label class="label-blue" for="signatoryType">Signatory Type</label>
                <select id="signatoryType" name="signatoryType" class="bs-select form-control">
                  <option value="">Select...</option>
                  @foreach (var opt in signatoryTypeOptions)
                  {
                    <option value="@opt.Value">@opt.Text</option>
                  }
                </select>
              </div>
              <div class="col">
                <label for="sequenceNo">Sequence No</label>
                <input id="sequenceNo" name="sequenceNo" type="text" class="bs-input-text form-control" />
              </div>
            </div>

            <!-- Row 3: Limit + Mandates -->
            <div class="form-row">
              <div class="col">
                <label for="limit">Limit</label>
                <input id="limit" name="limit" type="text" class="bs-input-text form-control" />
              </div>
              <div class="col">
                <label for="mandatesDropdown">Mandates</label>
                <div class="dropdown">
                  <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button"
                          id="mandatesDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    Select Mandates
                  </button>
                  <div class="dropdown-menu w-100 p-2" id="mandatesDropdownMenu"
                       aria-labelledby="mandatesDropdown" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var opt in mandatesOptions)
                    {
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="mandates"
                               value="@opt.Value" id="mandate-@opt.Value">
                        <label class="form-check-label" for="mandate-@opt.Value">@opt.Text</label>
                      </div>
                    }
                  </div>
                </div>
              </div>
            </div>

            <!-- Row 4: Is Mandatory -->
            <div class="form-row">
              <div class="col">
                <label class="form-check-label">
                  <input id="isMandatory" name="isMandatory" type="checkbox" class="form-check-input" />
                  Is Mandatory
                </label>
              </div>
            </div>

            <!-- Action Buttons (New / Alter / Remove / Update / Clear / Close) -->
            <div class="form-row mt-3">
              <div class="col-12">
                <div class="d-flex gap-2 justify-content-center">
                  <button class="btn btn-primary btn-sm" type="button" data-action="new" title="Add new signatory">
                    <i class="bi bi-plus-circle"></i> New
                  </button>
                  <button class="btn btn-warning btn-sm" type="button" data-action="alter" title="Edit selected signatory">
                    <i class="bi bi-pencil"></i> Alter
                  </button>
                  <button class="btn btn-danger btn-sm" type="button" data-action="remove" title="Remove selected signatory">
                    <i class="bi bi-trash"></i> Remove
                  </button>
                  <button class="btn btn-success btn-sm" type="button" data-action="update" title="Update form data">
                    <i class="bi bi-arrow-repeat"></i> Update
                  </button>
                  <button class="btn btn-secondary btn-sm" type="button" data-action="clear" title="Clear form fields">
                    <i class="bi bi-x-circle"></i> Clear
                  </button>
                  <button class="btn btn-outline-secondary btn-sm" type="button" data-action="close-form" title="Close form">
                    <i class="bi bi-box-arrow-right"></i> Close
                  </button>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- ============================================================
             SIGNATORIES LIST SECTION
             ============================================================ -->
        <div class="form-section">
          <div class="section-header">
            <span class="section-header__title"><i class="bi bi-list-ul"></i> Signatories List</span>
            <div class="section-header__actions">
              <button class="btn-icon" type="button" data-action="refresh-list" title="Refresh list">
                <i class="bi bi-arrow-clockwise"></i>
              </button>
            </div>
          </div>
          <div class="section-content">
            <div class="mb-2"><strong>Current Signatories</strong></div>
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th scope="col">Signatory Id</th>
                    <th scope="col">Signatory Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Limit</th>
                    <th scope="col">Ref</th>
                    <th scope="col">Mandatory</th>
                  </tr>
                </thead>
                <tbody id="signatoryTableBody">
                  <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                      <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                      <span>No signatories found</span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ============================================================
             BEHIND THE SCENE SECTION
             ============================================================ -->
        <div class="form-section">
          <div class="section-header" role="button" data-section-toggle aria-expanded="true">
            <span class="section-header__title"><i class="bi bi-gear"></i> Behind The Scene</span>
            <button class="section-toggle-btn" type="button" aria-label="Toggle section">
              <i class="bi bi-chevron-up"></i>
            </button>
          </div>
          <div class="section-content">
            <div class="behind-scene">
              <div class="behind-scene-grid">
                <div class="behind-scene-item">
                  <label>Operating Mode</label>
                  <div class="value-row"><span class="behind-scene-value" id="operatingMode">-</span></div>
                </div>
                <div class="behind-scene-item">
                  <label>Operating Instruction</label>
                  <div class="value-row"><span class="behind-scene-value" id="operatingInstruction">-</span></div>
                </div>
              </div>
            </div>
            <div class="audit-section">
              <div class="audit-block">
                <div class="audit-item">
                  <label>Created By</label>
                  <span class="audit-value" id="createdBy">-</span>
                </div>
                <div class="audit-item">
                  <label>Created On</label>
                  <span class="audit-value" id="createdOn">-</span>
                </div>
              </div>
              <div class="audit-block">
                <div class="audit-item">
                  <label>Modified By</label>
                  <span class="audit-value" id="modifiedBy">-</span>
                </div>
                <div class="audit-item">
                  <label>Modified On</label>
                  <span class="audit-value" id="modifiedOn">-</span>
                </div>
              </div>
              <div class="audit-block">
                <div class="audit-item">
                  <label>Supervised By</label>
                  <span class="audit-value" id="supervisedBy">-</span>
                </div>
                <div class="audit-item">
                  <label>Supervised On</label>
                  <span class="audit-value" id="supervisedOn">-</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /.form-card -->
    </div><!-- /.form-content -->
  </main>

  <!-- ====================================================================
       SIGNATURE / PHOTO MODAL
       ==================================================================== -->
  <div class="modal fade" id="signaturePhotoModal" tabindex="-1"
       aria-labelledby="signaturePhotoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header py-2">
          <h6 class="modal-title" id="signaturePhotoModalLabel">
            <i class="bi bi-person-badge me-2"></i>Signature / Photo
          </h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <!-- Signatory Info -->
          <div class="row g-3 mb-3">
            <div class="col-4">
              <label class="label-blue small">Signatory ID</label>
              <input id="modalSignatoryId" type="text" class="form-control form-control-sm" readonly />
            </div>
            <div class="col-8">
              <label class="small">Signatory Name</label>
              <input id="modalSignatoryName" type="text" class="form-control form-control-sm" readonly />
            </div>
          </div>
          <!-- Signature and Photo -->
          <div class="row g-3" id="imageDisplayRow">
            <div class="col-6" id="signatureCol">
              <div class="card">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                  <span class="small fw-semibold"><i class="bi bi-pen me-1"></i>Signature</span>
                  <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-action="zoom-sig" title="Zoom"><i class="bi bi-zoom-in"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-action="download-sig" title="Download"><i class="bi bi-download"></i></button>
                  </div>
                </div>
                <div class="card-body text-center p-3" id="signatureImage"
                     style="min-height: 180px; display: flex; align-items: center; justify-content: center; background: #f8f9fa;">
                  <span class="text-muted"><i class="bi bi-pen fs-1 d-block mb-2"></i>No signature available</span>
                </div>
              </div>
            </div>
            <div class="col-6" id="photoCol">
              <div class="card">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                  <span class="small fw-semibold"><i class="bi bi-camera me-1"></i>Photo</span>
                  <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-action="zoom-photo" title="Zoom"><i class="bi bi-zoom-in"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-action="download-photo" title="Download"><i class="bi bi-download"></i></button>
                  </div>
                </div>
                <div class="card-body text-center p-3" id="photoImage"
                     style="min-height: 180px; display: flex; align-items: center; justify-content: center; background: #f8f9fa;">
                  <span class="text-muted"><i class="bi bi-person-bounding-box fs-1 d-block mb-2"></i>No photo available</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Close
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- STATUS BAR & LOADING -->
  <footer class="de-status-bar" role="status">Ready</footer>
  <div class="de-loading-overlay" id="loadingOverlay" hidden>
    <div class="de-loading-spinner"><i class="bi bi-arrow-repeat"></i><span>Loading...</span></div>
  </div>
</div>

<!-- Module Script -->
<script src="~/js/modules/accountsmaintenance/account-signatories.js"></script>
