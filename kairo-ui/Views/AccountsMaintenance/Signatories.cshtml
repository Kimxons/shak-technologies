          <button class="btn-action" type="button" data-action="edit" title="Edit"><i class="bi bi-pencil-square"></i><span>Edit</span></button>
          <button class="btn-action" type="button" data-action="save" title="Save changes"><i class="bi bi-check-lg"></i><span>Save</span></button>
          <button class="btn-action" type="button" data-action="cancel" title="Cancel changes"><i class="bi bi-x-circle"></i><span>Cancel</span></button>
