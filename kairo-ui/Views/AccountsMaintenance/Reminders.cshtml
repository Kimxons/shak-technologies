@{
    // Migrated from: account-reminders.html
}

<!-- REMINDERS FORM -->
<div class="form-card" data-main-form>

  <!-- ACCOUNT IDENTIFICATION SECTION -->
  <div class="form-section">
    <div class="section-header">
      <span class="section-header__title"><i class="bi bi-building"></i>Account Identification</span>
    </div>
    <div class="section-content">
      <div class="form-row">
        <div class="col">
          <label class="label-blue">Branch ID</label>
          <div class="kairo-branch-control" data-kairo-branch-control>
            <input type="text" id="branchId" name="branchId" class="kairo-branch-control__id" aria-label="Branch ID" />
            <input type="text" id="branchName" class="kairo-branch-control__name" aria-label="Branch Name" placeholder="Branch Name" readonly />
            <button type="button" class="btn-lookup kairo-branch-control__lookup" data-lookup="branchId" aria-label="Search branch"><i class="bi bi-search"></i></button>
          </div>
        </div>
        <div class="col">
          <label class="label-blue">Account ID</label>
          <div class="kairo-account-control" data-kairo-account-control>
            <input type="text" id="accountId" name="accountId" class="kairo-account-control__id" aria-label="Account ID" />
            <input type="text" id="accountName" class="kairo-account-control__name" aria-label="Account Name" placeholder="Account Name" readonly />
            <button type="button" class="btn-lookup kairo-account-control__lookup" data-lookup="accountId" aria-label="Search account"><i class="bi bi-search"></i></button>
          </div>
        </div>
      </div>
      <div class="form-row">
        <div class="col">
          <label class="label-blue" for="reminderId">Reminder ID</label>
          <div class="d-flex gap-1">
            <input id="reminderId" name="reminderId" type="text" class="bs-input-text form-control" />
            <button class="btn-lookup" type="button" data-lookup="reminderId" title="Search reminder"><i class="bi bi-search"></i></button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- REMINDER DETAILS SECTION -->
  <div class="form-section">
    <div class="section-header">
      <span class="section-header__title"><i class="bi bi-chat-left-text"></i>Reminder Details</span>
    </div>
    <div class="section-content">
      <div class="form-row">
        <div class="col">
          <label class="label-blue" for="reminder">Reminder Text</label>
          <textarea id="reminder" name="reminder" class="bs-textarea form-control" rows="1" placeholder="Enter reminder details..."></textarea>
        </div>
      </div>
      <div class="form-row">
        <div class="col">
          <label class="label-blue" for="reminderColor">Reminder Color</label>
          <select id="reminderColor" name="reminderColor" class="bs-select form-control">
            <option>--Select Color--</option>
            <option value="red">Red</option>
            <option value="yellow">Yellow</option>
            <option value="green">Green</option>
            <option value="blue">Blue</option>
          </select>
        </div>
        <div class="col">
          <label class="label-blue" for="reminderPriority">Priority</label>
          <select id="reminderPriority" name="reminderPriority" class="bs-select form-control">
            <option>--Select Priority--</option>
            <option value="1">High</option>
            <option value="2">Medium</option>
            <option value="3">Low</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="col">
          <label class="label-blue" for="fromDate">From Date</label>
          <div class="de-date-wrapper">
            <input id="fromDate" name="fromDate" type="text" class="bs-input-date form-control" placeholder="dd-mmm-yyyy" autocomplete="off" />
            <button class="de-date-btn" type="button" id="fromDatePicker" aria-label="Pick from date"><i class="bi bi-calendar-date"></i></button>
          </div>
        </div>
        <div class="col">
          <label class="label-blue" for="toDate">To Date</label>
          <div class="de-date-wrapper">
            <input id="toDate" name="toDate" type="text" class="bs-input-date form-control" placeholder="dd-mmm-yyyy" autocomplete="off" />
            <button class="de-date-btn" type="button" id="toDatePicker" aria-label="Pick to date"><i class="bi bi-calendar-date"></i></button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CLIENT DETAILS SECTION (COLLAPSIBLE) -->
  <div class="form-section form-section--collapsible">
    <div class="section-header" role="button" data-section-toggle aria-expanded="true">
      <span class="section-header__title"><i class="bi bi-person"></i>Client Details</span>
      <button class="section-toggle-btn" type="button" aria-label="Toggle section"><i class="bi bi-chevron-up"></i></button>
    </div>
    <div class="section-content">
      <div class="audit-section audit-section--summary">
        <div class="audit-cell">
          <span class="audit-label">Client ID</span>
          <span class="audit-value" id="clientId">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Client Name</span>
          <span class="audit-value" id="clientName">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Address 1</span>
          <span class="audit-value" id="address1">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Address 2</span>
          <span class="audit-value" id="address2">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">City</span>
          <span class="audit-value" id="city">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Country</span>
          <span class="audit-value" id="country">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Phone (Home)</span>
          <span class="audit-value" id="phoneHome">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Phone (Work)</span>
          <span class="audit-value" id="phoneWork">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Fax No</span>
          <span class="audit-value" id="faxNo">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Mobile</span>
          <span class="audit-value" id="mobile">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Email ID</span>
          <span class="audit-value" id="emailId">-</span>
        </div>
      </div>
    </div>
  </div>

  <!-- BEHIND THE SCENE SECTION (COLLAPSIBLE) -->
  <div class="form-section form-section--bts">
    <div class="section-header" role="button" data-section-toggle aria-expanded="true">
      <span class="section-header__title"><i class="bi bi-gear"></i>Behind The Scene</span>
      <button class="section-toggle-btn" type="button" aria-label="Toggle audit information"><i class="bi bi-chevron-up"></i></button>
    </div>
    <div class="section-content">
      <div class="audit-section audit-section--summary">
        <div class="audit-cell">
          <span class="audit-label">Created By</span>
          <span class="audit-value" id="MakerID">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Created On</span>
          <span class="audit-value" id="MakerDT">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Checked By</span>
          <span class="audit-value" id="CheckerID">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Checked On</span>
          <span class="audit-value" id="CheckerDT">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Modified By</span>
          <span class="audit-value" id="ModifierID">-</span>
        </div>
        <div class="audit-cell">
          <span class="audit-label">Modified On</span>
          <span class="audit-value" id="ModifierDT">-</span>
        </div>
      </div>
    </div>
  </div>

</div>

<script src="~/js/modules/accountsmaintenance/account-reminders.js" asp-append-version="true"></script>
