  <script>
function notifyParentFormOpened(){window.parent.postMessage({action:'submoduleOpened',source:'Reminders'},'*');}
function closeChildForm(){
  console.log('[Window Control] Closing child form');
  // Send message to parent to close this submodule
  window.parent.postMessage({action:'submoduleClosed', source:'Reminders'},'*');
  // Also try to close the window directly
  setTimeout(() => {
    try {
      window.close();
    } catch(e) {
      console.log('[Window Control] Could not close window:', e.message);
    }
  }, 100);
}
function handleWindowAction(action){
  console.log('[Window Control] Handling action:', action);
  if(action==='refresh'){
    console.log('[Window Control] Refreshing page');
    location.reload();
  }else if(action==='maximize'){
    console.log('[Window Control] Toggling maximize');
    window.parent.postMessage({type:'toggleSidebarForMaximize'},'*');
  }else if(action==='close'){
    console.log('[Window Control] Closing form');
    closeChildForm();
  }
}
function initWindowControls(){
  console.log('[Window Control] Initializing window controls');
  const buttons = document.querySelectorAll('[data-action]');
  console.log('[Window Control] Found buttons:', buttons.length);
  buttons.forEach(btn=>{
    const action=btn.getAttribute('data-action');
    console.log('[Window Control] Processing button with action:', action);
    if(['refresh','maximize','close'].includes(action)){
      // Force remove disabled attribute from window control buttons
      btn.removeAttribute('disabled');
      btn.addEventListener('click',()=>{
        console.log('[Window Control] Button clicked:', action);
        handleWindowAction(action);
      });
      console.log('[Window Control] Wired button for action:', action);
    }
  });
}

// DATE PICKER FUNCTIONALITY
function pickDate(inputId, buttonEl) {
  const input = document.getElementById(inputId);
  if (!input || input.disabled) return;
  
  const picker = document.createElement('input');
  picker.type = 'date';
  picker.style.position = 'absolute';
  picker.style.opacity = '0';
  picker.style.pointerEvents = 'none';
  
  // Position near the button element
  if (buttonEl) {
    const rect = buttonEl.getBoundingClientRect();
    picker.style.left = rect.left + 'px';
    picker.style.top = (rect.bottom + window.scrollY) + 'px';
  }
  
  picker.onchange = function () {
    if (picker.value) {
      const date = new Date(picker.value + 'T00:00:00');
      const day = String(date.getDate()).padStart(2, '0');
      const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      const month = monthNames[date.getMonth()];
      const year = date.getFullYear();
      input.value = day + '-' + month + '-' + year;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }
    picker.remove();
  };
  
  picker.onblur = function() {
    setTimeout(function() { picker.remove(); }, 200);
  };
  
  document.body.appendChild(picker);
  if (picker.showPicker) {
    picker.showPicker();
  } else {
    picker.click();
  }
}

function initDatePickers() {
  const fromBtn = document.getElementById('fromDatePicker');
  const toBtn = document.getElementById('toDatePicker');
  if (fromBtn) {
    fromBtn.addEventListener('click', function(e) {
      e.preventDefault();
      pickDate('fromDate', e.currentTarget);
    });
  }
  if (toBtn) {
    toBtn.addEventListener('click', function(e) {
      e.preventDefault();
      pickDate('toDate', e.currentTarget);
    });
  }
}

window.addEventListener('DOMContentLoaded',()=>{initWindowControls();initDatePickers();notifyParentFormOpened();});
  </script>

