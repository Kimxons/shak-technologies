@{
    Layout = "_ApplicationLayout";
    // Migrated from: public/modules/account-maintenance/DataEntry/user-defined-fields.html
}

<!-- UserDefinedFields Submodule -->
<main class="main-container main-container--with-panel">
<div class="form-content">
<div class="form-card">
    <div class="form-section" data-section="user-defined-fields">
        <div class="section-header" data-section-toggle>
            <span class="section-header__title"><i class="bi bi-sliders me-1"></i>User Defined Fields</span>
            <button type="button" class="section-toggle-btn" aria-label="Toggle User Defined Fields" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
            </button>
        </div>
        <div class="section-content" data-section-content>
            <form id="frm_UserDefinedFields" autocomplete="off" novalidate>
                <div class="form-row two-col">
                    <div class="col">
                        <label class="label-blue" for="udf1">UDF 1</label>
                        <input id="udf1" name="udf1" type="text" class="bs-input-text">
                    </div>
                    <div class="col">
                        <label class="label-blue" for="udf2">UDF 2</label>
                        <input id="udf2" name="udf2" type="text" class="bs-input-text">
                    </div>
                </div>
                <div class="form-row two-col">
                    <div class="col">
                        <label class="label-blue" for="udf3">UDF 3</label>
                        <input id="udf3" name="udf3" type="text" class="bs-input-text">
                    </div>
                    <div class="col">
                        <label class="label-blue" for="udf4">UDF 4</label>
                        <input id="udf4" name="udf4" type="text" class="bs-input-text">
                    </div>
                </div>
                <div class="form-row two-col">
                    <div class="col">
                        <label class="label-blue" for="udf5">UDF 5</label>
                        <input id="udf5" name="udf5" type="text" class="bs-input-text">
                    </div>
                    <div class="col">
                        <label class="label-blue" for="udf6">UDF 6</label>
                        <input id="udf6" name="udf6" type="text" class="bs-input-text">
                    </div>
                </div>
                <div class="form-row two-col">
                    <div class="col">
                        <label class="label-blue" for="udf7">UDF 7</label>
                        <input id="udf7" name="udf7" type="text" class="bs-input-text">
                    </div>
                    <div class="col">
                        <label class="label-blue" for="udf8">UDF 8</label>
                        <input id="udf8" name="udf8" type="text" class="bs-input-text">
                    </div>
                </div>
                <div class="form-row two-col">
                    <div class="col">
                        <label class="label-blue" for="udf9">UDF 9</label>
                        <input id="udf9" name="udf9" type="text" class="bs-input-text">
                    </div>
                    <div class="col">
                        <label class="label-blue" for="udf10">UDF 10</label>
                        <input id="udf10" name="udf10" type="text" class="bs-input-text">
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Behind The Scene -->
    <div class="form-section" data-section="behind-scene">
        <div class="section-header" data-section-toggle>
            <span class="section-header__title"><i class="bi bi-gear me-1"></i>Behind The Scene</span>
            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind The Scene" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
            </button>
        </div>
        <div class="section-content" data-section-content>
            <div class="audit-section audit-section--summary">
                <div class="audit-item">
                    <label>Created By</label>
                    <span class="audit-value" id="MakerID">-</span>
                </div>
                <div class="audit-item">
                    <label>Created On</label>
                    <span class="audit-value" id="MakerDT">-</span>
                </div>
                <div class="audit-item">
                    <label>Checked By</label>
                    <span class="audit-value" id="CheckerID">-</span>
                </div>
                <div class="audit-item">
                    <label>Checked On</label>
                    <span class="audit-value" id="CheckerDT">-</span>
                </div>
                <div class="audit-item">
                    <label>Modified By</label>
                    <span class="audit-value" id="ModifierID">-</span>
                </div>
                <div class="audit-item">
                    <label>Modified On</label>
                    <span class="audit-value" id="ModifierDT">-</span>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
@await Html.PartialAsync("_SubmoduleActionPanel", new ViewDataDictionary(ViewData) { { "PanelType", "standard" } })
</main>

<script type="text/javascript" src="~/js/modules/accountsmaintenance/user-defined-fields.js" asp-append-version="true"></script>
