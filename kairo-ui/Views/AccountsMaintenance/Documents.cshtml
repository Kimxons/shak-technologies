@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Migrated from: public/modules/account-maintenance/DataEntry/account-documents.html
    // Rendered inside parent #submodule-container; parent provides window shell + action panel
    var documentClassOptions = ViewData["DocumentClassOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- Documents Submodule -->
<div class="form-card">

    <!-- Document Details Section -->
    <div class="form-section" data-section="document-details">
      <div class="section-header" data-section-toggle>
        <span class="section-header__title"><i class="bi bi-file-earmark-text me-1"></i>Document Details</span>
        <button type="button" class="section-toggle-btn" aria-label="Toggle Document Details" aria-expanded="true">
          <i class="bi bi-chevron-up"></i>
        </button>
      </div>
      <div class="section-content" data-section-content>

        <div class="row g-2 mb-2">
          <div class="col-md-6">
            <label class="label-blue am-label">Document ID</label>
            <div class="kairo-account-control" data-kairo-account-control>
              <input type="text" id="documentId" name="documentId" class="kairo-account-control__id form-control am-input" placeholder="ID">
              <input type="text" id="documentDesc_lookup" name="documentDesc_lookup" class="kairo-account-control__name form-control am-input" placeholder="Description" readonly>
              <button type="button" class="btn-lookup kairo-account-control__lookup" data-lookup="DocumentID" title="Search Documents">
                <i class="bi bi-search"></i>
              </button>
            </div>
          </div>
          <div class="col-md-6">
            <label class="label-blue am-label">Document Type</label>
            <select id="documentType" name="documentType" class="form-select am-input">
              <option value="">--Select--</option>
              <option value="O">Original</option>
              <option value="C">Copy</option>
            </select>
          </div>
        </div>

        <div class="row g-2 mb-2">
          <div class="col-md-4">
            <label class="label-blue am-label">Document Class</label>
            <div class="kairo-multiselect" id="documentClassMultiselect">
              <div class="kairo-multiselect__display am-input" id="documentClassDisplay">--Select-- <i class="bi bi-chevron-down small"></i></div>
              <div class="kairo-multiselect__dropdown"></div>
              <input type="hidden" id="documentClass" name="documentClass">
            </div>
          </div>
          <div class="col-md-4">
            <label class="label-blue am-label">Received By</label>
            <input type="text" id="receivedBy" name="receivedBy" class="form-control am-input" placeholder="Received By">
          </div>
          <div class="col-md-4">
            <label class="label-blue am-label">Received Date</label>
            <div class="kairo-date-control">
              <input type="text" id="receivedDate" name="receivedDate" class="form-control am-input" placeholder="DD/MMM/YYYY" readonly>
              <input type="date" id="receivedDate_picker" class="visually-hidden" aria-hidden="true">
              <button type="button" id="receivedDate_btn" class="btn-lookup" title="Calendar">
                <i class="bi bi-calendar-event"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="row g-2 mb-2">
          <div class="col-md-6">
            <label class="label-blue am-label">Location</label>
            <select id="location" name="location" class="form-select am-input">
              <option value="">--Select--</option>
              <option value="B">Document Located in Bank</option>
              <option value="C">Documents with Customers</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="label-blue am-label" for="documentImage_file">Document Image</label>
            <input class="form-control am-input" type="file" id="documentImage_file" name="documentImage_file">
          </div>
        </div>

        <div class="row g-2 mb-2">
          <div class="col-md-12">
            <label class="label-blue am-label">Remarks</label>
            <textarea id="remarks" name="remarks" class="form-control am-input" rows="1" placeholder="Enter remarks..."></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Audit Trail Section -->
    <div class="form-section transition-all" data-section="audit-trail">
      <div class="section-header" data-section-toggle>
        <span class="section-header__title"><i class="bi bi-clock-history me-1"></i>Audit & Behind The Scene</span>
        <button type="button" class="section-toggle-btn" aria-label="Toggle Audit Section">
          <i class="bi bi-chevron-down"></i>
        </button>
      </div>
      <div class="section-content" data-section-content style="display:none;">
        <div class="row g-2 mb-2">
          <div class="col-md-2">
            <label class="am-label">Created By</label>
            <input id="createdBy" class="form-control am-input" readonly />
          </div>
          <div class="col-md-2">
            <label class="am-label">Created On</label>
            <input id="createdOn" class="form-control am-input" readonly />
          </div>
          <div class="col-md-2">
            <label class="am-label">Modified By</label>
            <input id="modifiedBy" class="form-control am-input" readonly />
          </div>
          <div class="col-md-2">
            <label class="am-label">Modified On</label>
            <input id="modifiedOn" class="form-control am-input" readonly />
          </div>
          <div class="col-md-2">
            <label class="am-label">Supervised By</label>
            <input id="supervisedBy" class="form-control am-input" readonly />
          </div>
          <div class="col-md-2">
            <label class="am-label">Supervised On</label>
            <input id="supervisedOn" class="form-control am-input" readonly />
          </div>
        </div>
      </div>
    </div>

</div>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay" hidden>
  <div class="loading-spinner">
    <i class="bi bi-arrow-repeat"></i>
    <span>Loading documents...</span>
  </div>
</div>

<script>
    window.__documentClassOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        documentClassOptions.Select(o => new { ID = o.Value, Description = o.Text })
    ));
</script>
<script type="text/javascript" src="~/js/modules/accountsmaintenance/account-documents.js" asp-append-version="true"></script>
