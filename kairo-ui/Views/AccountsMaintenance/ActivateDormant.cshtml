  <script>
function notifyParentFormOpened(){window.parent.postMessage({action:'submoduleOpened',source:'ActivateDormant'},'*');}
function closeChildForm(){
  console.log('[Window Control] Closing child form');
  // Send message to parent to close this submodule
  window.parent.postMessage({action:'submoduleClosed', source:'ActivateDormant'},'*');
  // Also try to close the window directly
  setTimeout(() => {
    try {
      window.close();
    } catch(e) {
      console.log('[Window Control] Could not close window:', e.message);
    }
  }, 100);
}
  </script>

<script>
document.addEventListener('submodule:loaded', function(e) {
    if (e.detail.submoduleName === 'ActivateDormant') {
        console.log('[ActivateDormant] Submodule loaded');
    }
});
</script>
