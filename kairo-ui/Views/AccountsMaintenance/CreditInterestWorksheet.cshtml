@{
    Layout = "_ApplicationLayout";
}
@* Credit Interest Worksheet Submodule - Loaded as Partial View *@
@* Migrated from: credit-interest-worksheet.html *@

<form id="creditInterestWorksheetForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Form Content -->
<main class="main-container main-container--with-panel">
<div class="form-content" role="region" aria-label="Credit Interest Worksheet" data-submodule-content>
    <div class="form-card" data-submodule-form>
        <!-- Filters Section -->
        <div class="form-section" data-section="filters">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-funnel"></i> FILTERS</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Filters" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="form-row three-col">
                    <div class="col">
                        <label class="label-blue" for="ddl_periodSelect">Period</label>
                        <select id="ddl_periodSelect" name="periodSelect" class="bs-select">
                            <option value="0">Select Period</option>
                            <option value="1">Current Month</option>
                            <option value="2">Current and Previous Month</option>
                            <option value="3">Date Range</option>
                        </select>
                    </div>
                    <div class="col">
                        <label class="label-blue" for="txt_fromDate">From Date</label>
                        <div class="de-date-wrapper">
                            <input id="txt_fromDate" name="fromDate" type="text" class="bs-input-date" placeholder="dd-mmm-yyyy" autocomplete="off" />
                            <button class="de-date-btn" type="button" id="btn_fromDatePicker" aria-label="Pick from date"><i class="bi bi-calendar-date"></i></button>
                        </div>
                    </div>
                    <div class="col">
                        <label class="label-blue" for="txt_toDate">To Date</label>
                        <div class="de-date-wrapper">
                            <input id="txt_toDate" name="toDate" type="text" class="bs-input-date" placeholder="dd-mmm-yyyy" autocomplete="off" />
                            <button class="de-date-btn" type="button" id="btn_toDatePicker" aria-label="Pick to date"><i class="bi bi-calendar-date"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Worksheet Grid Section -->
        <div class="form-section form-section--grid" data-section="worksheet-grid">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-calculator"></i> CREDIT INTEREST WORKSHEET</span>
                <span class="de-record-count" id="spn_recordCount">(0 records)</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Worksheet Grid" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content section-content--grid" data-section-content>
                <div class="table-responsive">
                    <table class="table table-sm table-hover" id="tbl_worksheetGrid">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th class="text-end">Balance</th>
                                <th class="text-end">Interest</th>
                                <th class="text-end">Excess Amount</th>
                                <th class="text-end">Cumulative</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No records to display.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_SubmoduleActionPanel", new ViewDataDictionary(ViewData) { { "PanelType", "worksheet" } })
</main>

<!-- Loading Overlay -->
<div class="loading-overlay" id="div_loadingOverlay" style="display:none;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Message Panel -->
<div class="message-panel" id="div_messagePanel" style="display:none;"></div>

<script src="/js/modules/accountsmaintenance/credit-interest-worksheet.js"></script>
