@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Account Maintenance";
    Layout = "_ApplicationLayout";

    var cityOptions = ViewData["CityOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var countryOptions = ViewData["CountryOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var operatingModeOptions = ViewData["OperatingModeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var accountClassOptions = ViewData["AccountClassOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var accountOfficerOptions = ViewData["AccountOfficerOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

@section Styles {
    <style>
        /* Account Maintenance specific styles */

        /* Hide legacy headers and action panels in loaded submodules to prevent duplication */
        #submodule-container .am-header,
        #submodule-container .submodule-header,
        #submodule-container .action-panel,
        #submodule-container .am-header__right, /* AccountNotification case */
        #submodule-container aside.action-panel { 
            display: none !important; 
        }

        /* Reset legacy container styles that might conflict */
        #submodule-container .window {
            height: auto !important;
            width: 100% !important;
            position: static !important;
            background: transparent !important;
            box-shadow: none !important;
        }

        #submodule-container .main-container {
            height: auto !important;
            padding: 0 !important;
        }

        /* Ensure the persistent alert stays at the top of the form content area */
        #accountMaintenanceAlertContainer {
            position: sticky;
            top: 0;
            z-index: 100;
            background: inherit;
            width: 100%;
        }
    </style>
}

<form id="accountMaintenanceForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

    <!-- Reminder Modal Popup - System Theme Styled -->
    <div id="reminderModal" class="reminder-modal" role="dialog" aria-labelledby="reminderModalTitle" aria-modal="true" hidden>
      <div class="reminder-modal__backdrop"></div>
      <div class="reminder-modal__content">
        <div class="reminder-modal__header">
          <div class="reminder-modal__header-left">
            <div class="reminder-modal__icon-circle">
              <i class="bi bi-exclamation-triangle-fill reminder-modal__icon"></i>
            </div>
            <h2 id="reminderModalTitle" class="reminder-modal__title">Account Reminders</h2>
          </div>
          <button type="button" class="reminder-modal__close" aria-label="Close" onclick="document.getElementById('reminderModal').hidden = true;">
            <i class="bi bi-x"></i>
          </button>
        </div>
        <div class="reminder-modal__body">
          <div class="reminder-modal__table">
            <div class="reminder-modal__table-header">
              <div class="reminder-modal__table-col reminder-modal__table-col--message">Message</div>
              <div class="reminder-modal__table-col reminder-modal__table-col--priority">Priority</div>
            </div>
            <div class="reminder-modal__table-body" id="reminderTableBody"></div>
          </div>
        </div>
        <div class="reminder-modal__footer">
          <div class="reminder-modal__footer-info">
            <i class="bi bi-list"></i>
            <span id="reminderCount">0 reminders</span>
          </div>
          <button type="button" class="reminder-modal__button-close" onclick="document.getElementById('reminderModal').hidden = true;">Close</button>
        </div>
      </div>
    </div>

    <!-- Blocking/Unblocking Confirmation Modal -->
    <div id="blockingConfirmModal" class="confirm-modal" role="dialog" aria-labelledby="blockingConfirmTitle" aria-modal="true" hidden>
      <div class="confirm-modal__backdrop"></div>
      <div class="confirm-modal__content">
        <div class="confirm-modal__header">
          <div class="confirm-modal__header-left">
            <div class="confirm-modal__icon-circle">
              <i class="bi bi-question-circle-fill confirm-modal__icon"></i>
            </div>
            <h2 id="blockingConfirmTitle" class="confirm-modal__title">Confirm</h2>
          </div>
          <button type="button" class="confirm-modal__close" id="blockingConfirmClose" aria-label="Close">
            <i class="bi bi-x"></i>
          </button>
        </div>
        <div class="confirm-modal__body">
          <p class="confirm-modal__message">Do you want to Block/Unblock this Account?</p>
          <p class="confirm-modal__account-info" id="blockingConfirmAccountInfo">[No: ]</p>
        </div>
        <div class="confirm-modal__footer">
          <button type="button" class="confirm-modal__btn confirm-modal__btn--yes" id="blockingConfirmYes">Yes</button>
          <button type="button" class="confirm-modal__btn confirm-modal__btn--no" id="blockingConfirmNo">No</button>
        </div>
      </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

    <!-- Original Subtle Message Panel -->
    <div class="am-message-panel" id="amMessagePanel">
        <i class="bi bi-info-circle"></i>
        <span id="messagePanelText"></span>
        <button type="button" class="am-message-panel__close" onclick="this.parentElement.classList.remove('show')" aria-label="Close">
            <i class="bi bi-x"></i>
        </button>
    </div>

    <!-- Page Loading Overlay -->
    <div id="pageLoadingOverlay" class="page-loading-overlay">
        <div class="page-loading-spinner">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
