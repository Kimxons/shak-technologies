                    <!-- Account Details Section - Collapsible -->
                    <div class="form-section" data-section="account-details">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-person-vcard"></i>Account Details</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Account Details" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                        <div class="form-row four-col">
                            <div class="col">
                                <label>Short Name</label>
                                <input type="text" id="ShortName" class="bs-input-text">
                            </div>
                        </div>

                        <div class="form-row four-col">
                            <div class="col">
                                <label class="label-blue">Address 1</label>
                                <input type="text" id="Address1" class="bs-input-text">
                            </div>
                            <div class="col">
                                <label>Address 2</label>
                                <input type="text" id="Address2" class="bs-input-text">
                            </div>
                            <div class="col">
                                <label>City</label>
                                <select id="CityID" class="bs-select">
                                    <option value="">Select City</option>
                                    @foreach (var option in cityOptions)
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <label>Country</label>
                                <select id="CountryID" class="bs-select">
                                    <option value="">Select Country</option>
                                    @foreach (var option in countryOptions)
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-row four-col">
                            <div class="col">
                                <label>Phone (Home)</label>
                                <input type="text" id="PhoneHome" class="bs-input-text">
                            </div>
                            <div class="col">
                                <label>Phone (Work)</label>
                                <input type="text" id="PhoneWork" class="bs-input-text">
                            </div>
                            <div class="col">
                                <label>Fax No</label>
                                <input type="text" id="FaxNo" class="bs-input-text">
                            </div>
                            <div class="col">
                                <label>Mobile</label>
                                <input type="text" id="Mobile" class="bs-input-text">
                            </div>
                        </div>

                        <div class="form-row four-col">
                            <div class="col">
                                <label>Email Address</label>
                                <input type="email" id="EmailID" class="bs-input-text" placeholder="example@email.com">
                            </div>
                            <div class="col">
                                <label>Contact Person</label>
                                <input type="text" id="ContactPerson" class="bs-input-text" placeholder="Enter contact name">
                            </div>
                            <div class="col">
                                <label class="label-blue">Operating Mode</label>
                                <select id="OperatingModeID" class="bs-select">
                                    <option value="">Select Operating Mode</option>
                                    @foreach (var option in operatingModeOptions)
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <label>Operating Instructions</label>
                                <input type="text" id="OperatingInstructions" class="bs-input-text">
                            </div>
                        </div>

                        <div class="form-row four-col">
                            <div class="col">
                                <label class="label-blue">Account Class</label>
                                <select id="AccountClassID" class="bs-select">
                                    <option value="">Select Account Class</option>
                                    @foreach (var option in accountClassOptions)
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <label class="label-blue">Account Officer</label>
                                <select id="AccountOfficerID" class="bs-select">
                                    <option value="">Select Account Officer</option>
                                    @foreach (var option in accountOfficerOptions)
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <label class="label-blue">Liquidation Account</label>
                                <div class="kairo-account-control" data-kairo-account-control>
                                    <input type="text" id="LiquidationAccountID" class="kairo-account-control__id" aria-label="Liquidation Account ID">
                                    <input type="text" id="LiquidationAccountName" class="kairo-account-control__name" aria-label="Liquidation Account Name" placeholder="Account Name" readonly>
                                    <button type="button" class="btn-lookup kairo-account-control__lookup" data-target-input="LiquidationAccountID" aria-label="Search Liquidation Account"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                            <div class="col">
                                <label class="label-blue">Sales Officer</label>
                                <div class="kairo-user-control" data-kairo-user-control>
                                    <input type="text" id="SalesOfficerID" class="kairo-user-control__id" aria-label="Sales Officer ID">
                                    <input type="text" id="SalesOfficerName" class="kairo-user-control__name" aria-label="Sales Officer Name" placeholder="Officer Name" readonly>
                                    <button type="button" class="btn-lookup kairo-user-control__lookup" data-target-input="SalesOfficerID" aria-label="Search Sales Officer"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>

                    <!-- Account Snapshot Section -->
                    <div class="form-section" data-section="balances">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-cash-stack"></i>Account Snapshot</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Account Snapshot" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="behind-scene">
                                <!-- Balances Group -->
                                <div class="bts-group mini-collapsible-card">
                                    <div class="mini-card-header" data-toggle-mini-card tabindex="0">
                                        <span class="mini-card-title"><i class="bi bi-wallet2"></i> Balances</span>
                                    </div>
                                    <div class="mini-card-content" data-mini-content>
                                        <div class="bts-group-grid account-snapshot-grid">
                                            <div class="behind-scene-item">
                                                <label>Clear Balance</label>
                                                <div class="value-row"><span class="behind-scene-value" id="ClearBalance" data-field="clearBalance">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label>Available Balance</label>
                                                <div class="value-row"><span class="behind-scene-value" id="AvailableBalance" data-field="availableBalance">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label>Total Balance</label>
                                                <div class="value-row"><span class="behind-scene-value" id="TotalBalance" data-field="totalBalance">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label><span>Unclear Balance</span><button class="bts-info-btn" aria-label="View Unclear Balance"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="UnclearBalance" data-field="unclearBalance">-</span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Holds & Controls -->
                                <div class="bts-group mini-collapsible-card">
                                    <div class="mini-card-header" data-toggle-mini-card tabindex="0">
                                        <span class="mini-card-title"><i class="bi bi-lock-fill"></i> Holds & Controls</span>
                                    </div>
                                    <div class="mini-card-content" data-mini-content>
                                        <div class="bts-group-grid account-snapshot-grid">
                                            <div class="behind-scene-item">
                                                <label><span>Frozen Amount</span><button class="bts-info-btn" aria-label="View Freezed Amount"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="FreezedAmount" data-field="freezedAmount">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label><span>System Lien</span><button class="bts-info-btn" aria-label="View System Lien"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="SystemLien" data-field="systemLien">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label><span>Drawing Power</span><button class="bts-info-btn" aria-label="View Drawing Power"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="DrawingPower" data-field="drawingPower">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label>Minimum Balance</label>
                                                <div class="value-row"><span class="behind-scene-value" id="MinimumBalance" data-field="minimumBalance">-</span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Rates & Interest -->
                                <div class="bts-group mini-collapsible-card">
                                    <div class="mini-card-header" data-toggle-mini-card tabindex="0">
                                        <span class="mini-card-title"><i class="bi bi-graph-up"></i> Rates & Interest</span>
                                    </div>
                                    <div class="mini-card-content" data-mini-content>
                                        <div class="bts-group-grid account-snapshot-grid">
                                            <div class="behind-scene-item">
                                                <label><span>Credit Rate</span><button class="bts-info-btn" aria-label="View Credit Rate"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="CreditRate" data-field="creditRate">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label><span>Debit Rate</span><button class="bts-info-btn" aria-label="View Debit Rate"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="DebitRate" data-field="debitRate">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label>Penalty Rate</label>
                                                <div class="value-row"><span class="behind-scene-value" id="PenaltyRate" data-field="penaltyRate">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label>Credit Interest</label>
                                                <div class="value-row"><span class="behind-scene-value" id="CreditInterest" data-field="creditInterest">-</span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Supervision & Status -->
                                <div class="bts-group mini-collapsible-card">
                                    <div class="mini-card-header" data-toggle-mini-card tabindex="0">
                                        <span class="mini-card-title"><i class="bi bi-eye-fill"></i> Supervision & Status</span>
                                    </div>
                                    <div class="mini-card-content" data-mini-content>
                                        <div class="bts-group-grid account-snapshot-grid">
                                            <div class="behind-scene-item">
                                                <label><span>Status</span><button class="bts-info-btn" aria-label="View Status"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="Status" data-field="status">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label><span>Un Supervised Credits</span><button class="bts-info-btn" aria-label="View Un Supervised Credits"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="UnSupervisedCredits" data-field="unSupervisedCredits">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label><span>Un Supervised Debits</span><button class="bts-info-btn" aria-label="View Un Supervised Debits"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="UnSupervisedDebits" data-field="unSupervisedDebits">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label><span>Pending Charges</span><button class="bts-info-btn" aria-label="View Pending Charges"><i class="bi bi-info-square-fill"></i></button></label>
                                                <div class="value-row"><span class="behind-scene-value" id="PendingCharges" data-field="pendingCharges">-</span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Account Metadata -->
                                <div class="bts-group mini-collapsible-card">
                                    <div class="mini-card-header" data-toggle-mini-card tabindex="0">
                                        <span class="mini-card-title"><i class="bi bi-folder-fill"></i> Account Metadata</span>
                                    </div>
                                    <div class="mini-card-content" data-mini-content>
                                        <div class="bts-group-grid account-snapshot-grid">
                                            <div class="behind-scene-item">
                                                <label>Open Date</label>
                                                <div class="value-row"><span class="behind-scene-value" id="OpenDate" data-field="openDate">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label>Currency ID</label>
                                                <div class="value-row"><span class="behind-scene-value" id="CurrencyID" data-field="currencyId">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label>Deposit Balance</label>
                                                <div class="value-row"><span class="behind-scene-value" id="DepositBalance" data-field="depositBalance">-</span></div>
                                            </div>
                                            <div class="behind-scene-item">
                                                <label>Debit Interest</label>
                                                <div class="value-row"><span class="behind-scene-value" id="DebitInterest" data-field="debitInterest">-</span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Behind the Scene - Audit Trail Only -->
                    <div class="form-section" data-section="behind-scene">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-gear"></i>Behind the Scene</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="audit-section">
                                <div class="audit-item">
                                    <label>Created By</label>
                                    <span class="audit-value" id="CreatedBy" data-field="createdBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Created On</label>
                                    <span class="audit-value" id="CreatedOn" data-field="createdOn">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Modified By</label>
                                    <span class="audit-value" id="ModifiedBy" data-field="modifiedBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Modified On</label>
                                    <span class="audit-value" id="ModifiedOn" data-field="modifiedOn">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Supervised By</label>
                                    <span class="audit-value" id="SupervisedBy" data-field="supervisedBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Supervised On</label>
                                    <span class="audit-value" id="SupervisedOn" data-field="supervisedOn">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    </div><!-- End default form-card -->
                </div><!-- End submodule-container -->
            </div><!-- End form-content -->

            <!-- Right Action Panel -->
            <div class="action-panel">
                <div class="nav-group">
                    <button class="btn-nav green" aria-label="Previous Client"><i class="bi bi-chevron-left"></i></button>
                    <span>Client</span>
                    <button class="btn-nav green" aria-label="Next Client"><i class="bi bi-chevron-right"></i></button>
                </div>

                <div class="nav-group">
                    <button class="btn-nav green" aria-label="Previous Account"><i class="bi bi-chevron-left"></i></button>
                    <span>Account</span>
                    <button class="btn-nav green" aria-label="Next Account"><i class="bi bi-chevron-right"></i></button>
                </div>

                <div class="action-buttons">
                    <button class="btn-action btn-view" type="button" id="submoduleBtnView" data-action="view"><i class="bi bi-eye me-1"></i>View</button>
                    <button class="btn-action btn-add" type="button" id="submoduleBtnAdd" data-action="add"><i class="bi bi-plus-circle me-1"></i>Add</button>
                    <button class="btn-action btn-edit" type="button" id="submoduleBtnEdit" data-action="edit" disabled><i class="bi bi-pencil-square me-1"></i>Edit</button>
                    <button class="btn-action btn-delete" type="button" id="submoduleBtnDelete" data-action="delete" disabled><i class="bi bi-trash me-1"></i>Delete</button>
                    <button class="btn-action btn-save" type="button" id="submoduleBtnSave" data-action="save" disabled><i class="bi bi-check-lg me-1"></i>Save</button>
                    <button class="btn-action btn-cancel" type="button" id="submoduleBtnCancel" data-action="cancel" disabled><i class="bi bi-x-circle me-1"></i>Cancel</button>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <!-- Core dependencies -->
    <script src="~/js/app/app-core.js" asp-append-version="true"></script>
    <script src="~/js/modules/shared/searchModal.js" asp-append-version="true"></script>

    <!-- Service dependencies -->
    <script src="~/js/services/shared/serviceLoader.js" asp-append-version="true"></script>

    <!-- Account Maintenance Core -->
    <script src="~/js/modules/accounts/modern-account-maintenance.js" asp-append-version="true"></script>
}

