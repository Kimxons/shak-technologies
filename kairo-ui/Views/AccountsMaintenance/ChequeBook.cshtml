@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Migrated from: account-cheque-book.html
    var bookTypeOptions = ViewData["BookTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- ChequeBook Submodule -->
<div class="form-content submodule-cheque-book" role="region" aria-label="Cheque Book form">
    <div class="form-card" data-main-form>

        <!-- ACCOUNT IDENTIFICATION SECTION -->
        <div class="form-section" data-section="account-identification">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-person-vcard me-2"></i>Account Identification</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Account Identification" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="form-row">
                    <div class="col">
                        <label class="label-blue">Branch</label>
                        <div class="d-flex gap-2">
                            <input id="branchId" type="text" class="bs-input-text form-control w-25" readonly />
                            <input id="branchName" type="text" class="bs-input-text form-control flex-grow-1" readonly />
                        </div>
                    </div>
                    <div class="col">
                        <label class="label-blue">Account</label>
                        <div class="d-flex gap-2">
                            <input id="accountId" type="text" class="bs-input-text form-control w-25" readonly />
                            <input id="accountName" type="text" class="bs-input-text form-control flex-grow-1" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHEQUE REQUEST SECTION -->
        <div class="form-section" data-section="cheque-request">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-file-earmark-text me-2"></i>Cheque Request</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Cheque Request" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="form-row">
                    <div class="col">
                        <label class="label-blue" for="issueDate">Issue Date</label>
                        <input id="issueDate" type="text" class="bs-input-text form-control" readonly />
                    </div>
                    <div class="col">
                        <label class="label-blue" for="bookType">Book Type</label>
                        <select id="bookType" class="bs-select form-control">
                            <option value="">-- Select Book Type --</option>
                            @foreach (var option in bookTypeOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col">
                        <label class="label-blue" for="noOfLeaves">No Of Leaves</label>
                        <input id="noOfLeaves" type="number" class="bs-input-text form-control" readonly />
                    </div>
                    <div class="col">
                        <label class="label-blue" for="chequePrefix">Cheque Prefix</label>
                        <input id="chequePrefix" type="text" class="bs-input-text form-control" readonly />
                    </div>
                </div>
                <div class="form-row">
                    <div class="col">
                        <label class="label-blue" for="chequeStart">Cheque Start</label>
                        <input id="chequeStart" type="number" class="bs-input-text form-control" />
                    </div>
                    <div class="col">
                        <label class="label-blue" for="chequeEnd">Cheque End</label>
                        <input id="chequeEnd" type="number" class="bs-input-text form-control" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- CHEQUE BOOKS / REQUESTS TABS SECTION -->
        <div class="form-section" data-section="cheque-tabs">
            <div class="section-header">
                <span class="section-header__title"><i class="bi bi-journal-bookmark me-2"></i>Cheque Management</span>
                <div class="de-tabs ms-auto" role="tablist">
                    <button class="de-tab is-active" type="button" role="tab" data-tab="books" aria-selected="true">Cheque Books</button>
                    <button class="de-tab" type="button" role="tab" data-tab="requests" aria-selected="false">Cheque Requests</button>
                </div>
            </div>
            <div class="section-content">
                <!-- Cheque Books Tab -->
                <div class="de-tab-panel" data-panel="books">
                    <div class="table-responsive" style="max-height: 250px;">
                        <table class="table table-sm table-hover align-middle mb-0" id="chequeBookGrid">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th>Start No</th>
                                    <th>End No</th>
                                    <th>Prefix</th>
                                    <th>Leaves</th>
                                    <th>Issue Date</th>
                                    <th>Paid</th>
                                    <th>Stopped</th>
                                    <th>Returned</th>
                                </tr>
                            </thead>
                            <tbody id="chequeBookTableBody"></tbody>
                        </table>
                    </div>
                </div>
                <!-- Cheque Requests Tab -->
                <div class="de-tab-panel d-none" data-panel="requests">
                    <div class="table-responsive" style="max-height: 250px;">
                        <table class="table table-sm table-hover align-middle mb-0" id="chequeRequestGrid">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th>Leaves</th>
                                    <th>Start No</th>
                                    <th>End No</th>
                                    <th>Issue Date</th>
                                    <th>Approved By</th>
                                    <th>Approved On</th>
                                    <th>Dispatched By</th>
                                </tr>
                            </thead>
                            <tbody id="chequeRequestTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ACCOUNT DETAILS SECTION -->
        <div class="form-section" data-section="account-details">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-card-list me-2"></i>Account Details</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Account Details" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="form-row">
                    <div class="col">
                        <label>Client</label>
                        <div class="d-flex gap-1">
                            <input id="clientId" type="text" class="bs-input-text form-control w-25" readonly />
                            <input id="clientName" type="text" class="bs-input-text form-control flex-grow-1" readonly />
                        </div>
                    </div>
                    <div class="col">
                        <label>Product</label>
                        <div class="d-flex gap-1">
                            <input id="productId" type="text" class="bs-input-text form-control w-25" readonly />
                            <input id="productName" type="text" class="bs-input-text form-control flex-grow-1" readonly />
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col"><label>Address 1</label><input id="address1" type="text" class="bs-input-text form-control" readonly /></div>
                    <div class="col"><label>Address 2</label><input id="address2" type="text" class="bs-input-text form-control" readonly /></div>
                </div>
                <div class="two-col mt-2">
                    <div class="col"><label>City</label><input id="city" type="text" class="bs-input-text form-control" readonly /></div>
                    <div class="col"><label>Country</label><input id="country" type="text" class="bs-input-text form-control" readonly /></div>
                </div>
                <div class="two-col mt-2">
                    <div class="col"><label>Phone (Home)</label><input id="phoneHome" type="text" class="bs-input-text form-control" readonly /></div>
                    <div class="col"><label>Phone (Work)</label><input id="phoneWork" type="text" class="bs-input-text form-control" readonly /></div>
                </div>
                <div class="two-col mt-2">
                    <div class="col"><label>Fax No</label><input id="faxNo" type="text" class="bs-input-text form-control" readonly /></div>
                    <div class="col"><label>Mobile</label><input id="mobile" type="text" class="bs-input-text form-control" readonly /></div>
                </div>
            </div>
        </div>

        <!-- BEHIND THE SCENE SECTION -->
        <div class="form-section" data-section="behind-scene">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-gear me-2"></i>Behind The Scene</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Behind The Scene" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="behind-scene">
                    <div class="behind-scene-grid">
                        <div class="behind-scene-item">
                            <label>Currency</label>
                            <span class="behind-scene-value" id="currencyId">-</span>
                        </div>
                        <div class="behind-scene-item">
                            <label>Approved By</label>
                            <span class="behind-scene-value" id="approvedBy">-</span>
                        </div>
                        <div class="behind-scene-item">
                            <label>Approved On</label>
                            <span class="behind-scene-value" id="approvedOn">-</span>
                        </div>
                        <div class="behind-scene-item">
                            <label>Dispatched By</label>
                            <span class="behind-scene-value" id="dispatchedBy">-</span>
                        </div>
                        <div class="behind-scene-item">
                            <label>Dispatched On</label>
                            <span class="behind-scene-value" id="dispatchedOn">-</span>
                        </div>
                    </div>
                </div>

                <div class="audit-section mt-3">
                    <div class="audit-block">
                        <div class="audit-item"><label>Created By</label><span class="audit-value" id="MakerID">-</span></div>
                        <div class="audit-item"><label>Created On</label><span class="audit-value" id="MakerDT">-</span></div>
                    </div>
                    <div class="audit-block border-start px-3">
                        <div class="audit-item"><label>Modified By</label><span class="audit-value" id="ModifierID">-</span></div>
                        <div class="audit-item"><label>Modified On</label><span class="audit-value" id="ModifierDT">-</span></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="de-loading-overlay" id="loadingOverlay" hidden><div class="de-loading-spinner"><i class="bi bi-arrow-repeat"></i><span>Loading...</span></div></div>

<script src="~/js/modules/accountsmaintenance/account-cheque-book.js"></script>
