@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // No layout - this is a partial view loaded dynamically
    // Migrated from: public/modules/account-maintenance/DataEntry/account-blocking-unblocking.html
    var blockedReasonOptions = ViewData["BlockedReasonOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var unBlockedReasonOptions = ViewData["UnBlockedReasonOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- Blocking Submodule - Original HTML Preserved -->
<!-- Blocking Submodule -->
<div class="form-content" role="region" aria-label="Account Blocking / Unblocking form">
    <div class="form-card" data-main-form>
        <div class="form-section" data-section="blocking-details">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-ban"></i> Blocking / Unblocking Details</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Blocking / Unblocking Details" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="reason">Reason</label>
                        <select id="reason" name="ReasonID" class="form-select am-input">
                            <option value="">Select...</option>
                            @foreach (var option in blockedReasonOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="description">Description (Narration)</label>
                        <input id="description" name="Narration" type="text" class="form-control am-input" />
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-12">
                        <label class="label-blue am-label" for="instructionGivenBy">Instruction Given By</label>
                        <input id="instructionGivenBy" name="InstructionGivenBy" type="text" class="form-control am-input" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Behind the Scene Section -->
        <div class="form-section mt-3" data-section="behind-scene">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-gear"></i> Behind The Scene (Current Status)</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="previousStatus">Current Status</label>
                        <input id="previousStatus" type="text" class="form-control am-input" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="btsDate">Date Blocked</label>
                        <input id="btsDate" type="text" class="form-control am-input" disabled />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-12">
                        <label class="label-blue am-label" for="btsDescription">Prior Reason/Instruction</label>
                        <input id="btsDescription" type="text" class="form-control am-input" disabled />
                    </div>
                </div>
                <!-- Audit Trail -->
                <div class="audit-section audit-section--summary mt-3">
                    <div class="audit-cell">
                        <span class="audit-label">Created By</span>
                        <span class="audit-value" id="MakerID">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Created On</span>
                        <span class="audit-value" id="MakerDT">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Checked By</span>
                        <span class="audit-value" id="CheckerID">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Checked On</span>
                        <span class="audit-value" id="CheckerDT">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Modified By</span>
                        <span class="audit-value" id="ModifierID">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Modified On</span>
                        <span class="audit-value" id="ModifierDT">-</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="loading-overlay" id="loadingOverlay" hidden>
    <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="loading-text">Processing...</div>
    </div>
</div>
  </div>

  <script src="~/js/modules/accountsmaintenance/account-blocking.js"></script>
<script>
  // Auto-initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => window.AccountBlockingModule?.init());
  } else {
    window.AccountBlockingModule?.init();
  }
  console.log('✅ Account Blocking view loaded');
</script>
