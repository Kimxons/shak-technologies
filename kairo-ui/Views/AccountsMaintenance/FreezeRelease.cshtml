<!-- FreezeRelease Submodule -->
<div class="form-card" data-main-form>
  
  <!-- Account Identification Section -->
  <div class="form-section" data-section="account-identification">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-person-badge me-1"></i>Account Identification</span>
      <button type="button" class="section-toggle-btn"><i class="bi bi-chevron-up"></i></button>
    </div>
    <div class="section-content" data-section-content>
      <div class="form-row four-col">
        <div class="col">
          <label class="label-blue">Branch ID</label>
          <input id="branchId" type="text" class="bs-input-text bg-light" readonly />
        </div>
        <div class="col">
          <label class="label-blue">Branch Name</label>
          <input id="branchName" type="text" class="bs-input-text bg-light" readonly />
        </div>
        <div class="col">
          <label class="label-blue">Account ID</label>
          <input id="accountId" type="text" class="bs-input-text bg-light" readonly />
        </div>
        <div class="col">
          <label class="label-blue">Account Name</label>
          <input id="accountName" type="text" class="bs-input-text bg-light" readonly />
        </div>
      </div>
      <div class="form-row four-col pt-2">
        <div class="col">
          <label class="label">Reference ID</label>
          <input id="referenceId" type="text" class="bs-input-text bg-light" readonly />
        </div>
        <div class="col"></div><div class="col"></div><div class="col"></div>
      </div>
    </div>
  </div>

  <!-- Freeze Details Section -->
  <div class="form-section" data-section="freeze-details">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-snow me-1"></i>Freeze Details</span>
      
      <!-- Custom Actions for this submodule -->
      <div class="ms-auto me-3 d-flex gap-2">
         <button type="button" class="btn btn-sm btn-outline-info" data-action="history" title="History">
            <i class="bi bi-clock-history me-1"></i>History
         </button>
         <button type="button" class="btn btn-sm btn-outline-warning" data-action="release" id="btnRelease" title="Release">
            <i class="bi bi-unlock me-1"></i>Release Freeze
         </button>
      </div>

      <button type="button" class="section-toggle-btn"><i class="bi bi-chevron-up"></i></button>
    </div>
    <div class="section-content" data-section-content>
      <div class="form-row four-col">
        <div class="col">
          <label class="label-blue">Effective Date<span class="text-danger">*</span></label>
          <input id="effectiveDate" name="effectiveDate" type="date" class="bs-input-text form-control" required />
        </div>
        <div class="col">
          <label class="label-blue">Fixed Amount<span class="text-danger">*</span></label>
          <input id="fixedAmount" name="fixedAmount" type="number" class="bs-input-text text-end" required />
        </div>
        <div class="col">
          <label class="label-blue">Reason<span class="text-danger">*</span></label>
          <textarea id="reason" name="reason" class="bs-input-text" rows="1" required></textarea>
        </div>
        <div class="col"></div>
      </div>
    </div>
  </div>

  <!-- Behind the Scene Section -->
  <div class="form-section" data-section="behind-scene">
    <div class="section-header" data-section-toggle>
      <span class="section-header__title"><i class="bi bi-gear me-1"></i>Behind the Scene</span>
      <button type="button" class="section-toggle-btn"><i class="bi bi-chevron-up"></i></button>
    </div>
    <div class="section-content" data-section-content>
      <div class="form-row four-col mb-2">
        <div class="col">
          <label class="label">Released Reason</label>
          <input type="text" class="bs-input-text bg-light" id="releasedReason" readonly />
        </div>
        <div class="col">
          <label class="label">Released Date</label>
          <input type="text" class="bs-input-text bg-light" id="releasedDate" readonly />
        </div>
        <div class="col">
          <label class="label">Product</label>
          <input type="text" class="bs-input-text bg-light" id="productId" readonly />
        </div>
        <div class="col">
          <label class="label">Currency</label>
          <input type="text" class="bs-input-text bg-light" id="currencyId" readonly />
        </div>
      </div>

      <div class="form-row four-col mb-2">
        <div class="col">
          <label class="label">Clear Balance</label>
          <input type="text" class="bs-input-text bg-light text-end" id="clearBalance" readonly />
        </div>
        <div class="col">
          <label class="label">Unclear Balance</label>
          <input type="text" class="bs-input-text bg-light text-end" id="unclearBalance" readonly />
        </div>
        <div class="col">
          <label class="label">Available Balance</label>
          <input type="text" class="bs-input-text bg-light text-end" id="availableBalance" readonly />
        </div>
        <div class="col">
          <label class="label">Total Balance</label>
          <input type="text" class="bs-input-text bg-light text-end" id="totalBalance" readonly />
        </div>
      </div>

      <div class="form-row four-col mb-2">
        <div class="col">
          <label class="label">Drawing Power</label>
          <input type="text" class="bs-input-text bg-light text-end" id="drawingPower" readonly />
        </div>
        <div class="col">
          <label class="label">Minimum Balance</label>
          <input type="text" class="bs-input-text bg-light text-end" id="minimumBalance" readonly />
        </div>
        <div class="col">
          <label class="label">Freezed Amount</label>
          <input type="text" class="bs-input-text bg-light text-end" id="freezedAmount" readonly />
        </div>
        <div class="col">
          <label class="label">Loan Branch</label>
          <input type="text" class="bs-input-text bg-light" id="loanBranchId" readonly />
        </div>
      </div>

      <div class="form-row four-col mb-3">
        <div class="col">
          <label class="label">Loan Account</label>
          <input type="text" class="bs-input-text bg-light" id="loanAccountId" readonly />
        </div>
        <div class="col"></div><div class="col"></div><div class="col"></div>
      </div>

      <div class="audit-section audit-section--summary">
        <div class="audit-item"><label>Created By</label><span class="audit-value" id="MakerID">-</span></div>
        <div class="audit-item"><label>Created On</label><span class="audit-value" id="MakerDT">-</span></div>
        <div class="audit-item"><label>Supervised By</label><span class="audit-value" id="CheckerID">-</span></div>
        <div class="audit-item"><label>Supervised On</label><span class="audit-value" id="CheckerDT">-</span></div>
        <div class="audit-item"><label>Modified By</label><span class="audit-value" id="ModifierID">-</span></div>
        <div class="audit-item"><label>Modified On</label><span class="audit-value" id="ModifierDT">-</span></div>
      </div>
    </div>
  </div>
</div>

<!-- Modals -->
<!-- History Modal -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-clock-history me-2"></i>Transaction History</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="historyLoading" class="text-center py-4 d-none">
          <div class="spinner-border text-primary" role="status"></div>
          <p class="mt-2 text-muted">Loading transaction history...</p>
        </div>
        <div id="historyEmpty" class="text-center py-4 d-none">
          <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
          <p class="text-muted">No freeze/release history found for this account.</p>
        </div>
        <div class="table-responsive d-none" id="historyTableContainer">
          <table class="table table-sm table-bordered table-hover">
            <thead class="table-light">
              <tr>
                <th>Client ID</th>
                <th>Client Name</th>
                <th>Account Name</th>
                <th>Reference ID</th>
                <th>Effective Date</th>
                <th>Freezed Value</th>
                <th>Freeze Reason</th>
                <th>Released Date</th>
                <th>Released Value</th>
                <th>Released Reason</th>
              </tr>
            </thead>
            <tbody id="historyTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Release Modal -->
<div class="modal fade" id="releaseModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-unlock me-2 text-warning"></i>Release Freeze</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label for="releaseReason" class="form-label label-blue">Release Reason <span class="text-danger">*</span></label>
          <textarea id="releaseReason" class="bs-input-text form-control" rows="3" placeholder="Enter reason for releasing the freeze..." required></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning" id="btnConfirmRelease">
            <i class="bi bi-check-lg me-1"></i>Release
        </button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript" src="~/js/modules/accountsmaintenance/account-freeze-release.js" asp-append-version="true"></script>
