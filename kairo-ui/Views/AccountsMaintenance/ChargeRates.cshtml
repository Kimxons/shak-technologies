@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_ApplicationLayout";
    // Migrated from: public/modules/account-maintenance/DataEntry/account-charge-rates.html
    var ceilingAmountTypeOptions = ViewData["CeilingAmountTypeOptions"] as IEnumerable<SelectListItem> ??
Enumerable.Empty<SelectListItem>();
    var calculationMethodOptions = ViewData["CalculationMethodOptions"] as IEnumerable<SelectListItem> ??
Enumerable.Empty<SelectListItem>();
}

<!-- ChargeRates Submodule -->
<main class="main-container main-container--with-panel">
<div class="form-content" role="region" aria-label="Account Charge Rates form">
    <div class="form-card" data-main-form>
        <div class="form-section" data-section="charge-selection">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-currency-dollar"></i> Charge Selection</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Charge Selection"
                        aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="row g-2 mb-2">
                    <div class="col-md-12">
                        <label class="label-blue am-label">Charge ID / Name</label>
                        <div class="kairo-account-control" data-kairo-account-control>
                            <input id="chargeId" name="ChargeID" type="text"
                                   class="kairo-account-control__id form-control am-input" placeholder="Charge ID" />
                            <input id="chargeName" name="ChargeName" type="text"
                                class="kairo-account-control__name form-control am-input" placeholder="Charge Name" />
                                <button type="button" class="btn-lookup kairo-account-control__lookup" data-lookup="ChargeID"
                                    title="Lookup Charge"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="effectiveDate">Effective Date</label>
                        <input id="effectiveDate" name="EffectiveDate" type="date" class="form-control am-input" />
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="expiryDate">Expiry Date</label>
                        <input id="expiryDate" name="ExpiryDate" type="date" class="form-control am-input" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Charge Settings Section -->
        <div class="form-section mt-3" data-section="charge-settings">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-sliders"></i> Charge Settings</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Charge Settings"
                        aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="ceilingAmountType">Ceiling Amount Type</label>
                        <select id="ceilingAmountType" name="CeilingAmountTypeID" class="form-select am-input">
                            <option value="">--Select--</option>
                            @foreach (var option in ceilingAmountTypeOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="ceilingAmount">Ceiling Amount</label>
                        <input id="ceilingAmount" name="CeilingAmount" type="text" class="form-control am-input" />
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="calculationMethod">Calculation Method</label>
                        <select id="calculationMethod" name="CalculationMethodID" class="form-select am-input">
                            <option value="">--Select--</option>
                            @foreach (var option in calculationMethodOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="label-blue am-label" for="minCharge">Min Charge</label>
                        <input id="minCharge" name="MinimumCharge" type="text" class="form-control am-input" />
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="label-blue am-label" for="maximumCharge">Maximum Charge</label>
                        <input id="maximumCharge" name="MaximumCharge" type="text" class="form-control am-input" />
                    </div>
                    <div class="col-md-4">
                        <label class="label-blue am-label" for="value">Rate / Value</label>
                        <input id="value" name="Value" type="text" class="form-control am-input" />
                    </div>
                    <div class="col-md-4">
                        <label class="label-blue am-label" for="fixedAmount">Fixed Amount</label>
                        <input id="fixedAmount" name="FixedAmount" type="text" class="form-control am-input" />
                    </div>
                </div>

                <!-- Grid Action Buttons -->
                <div class="d-flex gap-2 mb-3 mt-3 justify-content-center">
                    <button class="btn btn-outline-primary btn-sm" type="button" data-grid-action="new">
                        <i class="bi bi-plus-lg"></i> New
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-grid-action="update">
                        <i class="bi bi-check-lg"></i> Update
                    </button>
                    <button class="btn btn-outline-danger btn-sm" type="button" data-grid-action="remove">
                        <i class="bi bi-trash"></i> Remove
                    </button>
                    <button class="btn btn-outline-info btn-sm" type="button" data-grid-action="clear">
                        <i class="bi bi-x-circle"></i> Clear
                    </button>
                </div>

                <!-- Charge Settings Grid -->
                <div class="table-responsive mt-2">
                    <table class="table table-sm table-hover am-table" id="chargeSettingsGrid">
                        <thead>
                            <tr>
                                <th>Ceiling Amt</th>
                                <th>Min Charge</th>
                                <th>Max Charge</th>
                                <th>Method</th>
                                <th>Value</th>
                                <th>Fixed Amt</th>
                            </tr>
                        </thead>
                        <tbody id="chargeSettingsBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted">No records to display.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Behind the Scene Section -->
        <div class="form-section mt-3" data-section="behind-scene">
            <div class="section-header" data-section-toggle>
                <span class="section-header__title"><i class="bi bi-gear"></i> Behind the Scene</span>
                <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene"
                        aria-expanded="true">
                    <i class="bi bi-chevron-up"></i>
                </button>
            </div>
            <div class="section-content" data-section-content>
                <div class="audit-section audit-section--summary">
                    <div class="audit-cell">
                        <span class="audit-label">Created By</span>
                        <span class="audit-value" id="MakerID">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Created On</span>
                        <span class="audit-value" id="MakerDT">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Checked By</span>
                        <span class="audit-value" id="CheckerID">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Checked On</span>
                        <span class="audit-value" id="CheckerDT">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Modified By</span>
                        <span class="audit-value" id="ModifierID">-</span>
                    </div>
                    <div class="audit-cell">
                        <span class="audit-label">Modified On</span>
                        <span class="audit-value" id="ModifierDT">-</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_SubmoduleActionPanel", new ViewDataDictionary(ViewData) { { "PanelType", "standard" } })
</main>

<div class="loading-overlay" id="loadingOverlay" hidden>
    <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="loading-text">Loading charge rates...</div>
    </div>
</div>

<div class="am-message-panel" role="alert" aria-live="polite">
    <i class="bi bi-info-circle"></i>
    <span></span>
</div>

<script src="~/js/modules/accountsmaintenance/account-charge-rates.js"></script>
