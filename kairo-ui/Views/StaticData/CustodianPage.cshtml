@{
    ViewData["Title"] = "Custodian";
    Layout = "_ApplicationLayout";
}

<div class="window">
    <div class="main-container">

        <!-- ── FORM CONTENT ──────────────────────────────────────────────── -->
        <div class="form-content">
            @await Html.PartialAsync("Custodian")
        </div>

        <!-- ── RIGHT ACTION PANEL ────────────────────────────────────────── -->
        <div class="action-panel">
            <div class="action-buttons">
                <button class="btn-action btn-view" type="button" data-action="view" title="View">
                    <i class="bi bi-eye me-1"></i>View
                </button>
                <button class="btn-action btn-add" type="button" data-action="add" title="Add" disabled>
                    <i class="bi bi-plus-circle me-1"></i>Add
                </button>
                <button class="btn-action" type="button" data-action="edit" title="Edit" disabled>
                    <i class="bi bi-pencil-square me-1"></i>Edit
                </button>
                <button class="btn-action" type="button" data-action="delete" title="Delete" disabled>
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
                <button class="btn-action btn-save" type="button" data-action="save" title="Save" disabled>
                    <i class="bi bi-check-lg me-1"></i>Save
                </button>
                <button class="btn-action btn-cancel" type="button" data-action="cancel" title="Cancel" disabled>
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
            </div>
        </div>

    </div><!-- end main-container -->
</div><!-- end window -->

@section Scripts {
    <script src="~/js/app/app-core.js"></script>
    <script src="~/js/modules/staticdata/custodian.js"></script>
    <script>
    (function () {
        'use strict';

        var mod = window.StaticDataCustodianModule;

        // ── Sync action panel button states with Custodian module ──
        function syncActionPanel() {
            var container = document.querySelector('#custodianModule');
            var actionMap = {
                'view':   '[data-custodian-mode="View"]',
                'add':    '[data-custodian-mode="Add"]',
                'edit':   '[data-custodian-mode="Edit"]',
                'delete': '[data-custodian-action="delete"]',
                'save':   '[data-custodian-action="save"]',
                'cancel': '[data-custodian-action="cancel"]'
            };

            ['view', 'add', 'edit', 'delete', 'save', 'cancel'].forEach(function (action) {
                var parentBtn = document.querySelector('.action-panel .action-buttons [data-action="' + action + '"]');
                if (!parentBtn) return;

                var subBtn = container ? container.querySelector(actionMap[action]) : null;
                if (subBtn) {
                    parentBtn.disabled = subBtn.disabled;
                } else {
                    parentBtn.disabled = (action !== 'view');
                }
            });
        }

        // ── Parent action buttons delegate to Custodian module ──
        document.querySelectorAll('.action-panel .action-buttons [data-action]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!mod) return;
                var action = this.dataset.action;
                switch (action) {
                    case 'view':   if (mod.view)   mod.view();   break;
                    case 'add':    if (mod.add)    mod.add();    break;
                    case 'edit':   if (mod.edit)   mod.edit();   break;
                    case 'delete': if (mod.delete) mod.delete(); break;
                    case 'save':   if (mod.save)   mod.save();   break;
                    case 'cancel': if (mod.cancel) mod.cancel(); break;
                }
                setTimeout(syncActionPanel, 150);
            });
        });

        // ── Re-sync when Custodian module changes mode ──
        document.addEventListener('custodian-mode-changed', syncActionPanel);

        // ── Initial sync ──
        syncActionPanel();

    })();
    </script>
}
