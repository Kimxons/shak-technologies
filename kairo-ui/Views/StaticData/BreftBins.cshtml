@{
    ViewData["Title"] = "Bin Maintenance";
    Layout = "_ApplicationLayout";
}

<div class="window">
    <main class="main-container main-container--with-panel" aria-label="Bin Maintenance form">
        <div class="form-content" role="region" aria-label="Bin details">
            <div class="form-card" data-main-form>
                <form id="breft-bins-form" autocomplete="off" novalidate>
                    <div class="form-section">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-credit-card"></i> Bin Details</span>
                            <button type="button" class="section-toggle-btn" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="alert alert-danger d-none" role="alert" data-inline-alert hidden>
                                <div class="d-flex align-items-center justify-content-between gap-3">
                                    <span data-inline-alert-text></span>
                                    <button type="button" class="btn-close" aria-label="Close" data-inline-alert-close></button>
                                </div>
                            </div>

                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_binId">Bin</label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input type="text" id="txt_binId" class="kairo-control__id" data-always-enabled aria-label="Bin id">
                                        <input type="text" id="txt_binSummary" class="kairo-control__name" placeholder="Loaded bin" readonly>
                                        <button type="button" class="btn-lookup kairo-control__lookup" id="btn_viewBin" data-always-enabled aria-label="Load bin"><i class="bi bi-search"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_payableGlId">Payable GL</label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input type="text" id="txt_payableGlId" class="kairo-control__id" aria-label="Payable GL id">
                                        <input type="text" id="txt_payableGlName" class="kairo-control__name" placeholder="Payable GL Name" readonly>
                                        <button type="button" class="btn-lookup kairo-control__lookup" id="btn_searchPayableGl" aria-label="Search payable GL"><i class="bi bi-search"></i></button>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="txt_receivableGlId">Receivable GL</label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input type="text" id="txt_receivableGlId" class="kairo-control__id" aria-label="Receivable GL id">
                                        <input type="text" id="txt_receivableGlName" class="kairo-control__name" placeholder="Receivable GL Name" readonly>
                                        <button type="button" class="btn-lookup kairo-control__lookup" id="btn_searchReceivableGl" aria-label="Search receivable GL"><i class="bi bi-search"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-clock-history"></i> Behind The Scene</span>
                            <button type="button" class="section-toggle-btn" aria-expanded="false">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content hidden>
                            <div class="audit-section audit-section--summary">
                                <div class="audit-cell"><span class="audit-label">Created By</span><span class="audit-value" id="spn_binCreatedBy">-</span></div>
                                <div class="audit-cell"><span class="audit-label">Created On</span><span class="audit-value" id="spn_binCreatedOn">-</span></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <aside class="action-panel" aria-label="Bin actions">
            <div class="action-buttons">
                <button class="btn-action" id="btn_binView" type="button"><i class="bi bi-eye me-1"></i>View</button>
                <button class="btn-action" id="btn_binAdd" type="button"><i class="bi bi-plus-circle me-1"></i>Add</button>
                <button class="btn-action" id="btn_binEdit" type="button"><i class="bi bi-pencil-square me-1"></i>Edit</button>
                <button class="btn-action" id="btn_binSave" type="button"><i class="bi bi-save me-1"></i>Save</button>
                <button class="btn-action btn-cancel" id="btn_binCancel" type="button"><i class="bi bi-x-circle me-1"></i>Cancel</button>
            </div>
        </aside>
    </main>

    <div class="am-message-panel" role="alert" aria-live="polite">
        <i class="bi bi-info-circle"></i>
        <span class="message-text"></span>
    </div>
</div>

@section Scripts {
    <script src="~/js/environment.js" asp-append-version="true"></script>
    <script src="~/js/config.js" asp-append-version="true"></script>
    <script src="~/js/auth/auth.config.js" asp-append-version="true"></script>
    <script src="~/js/auth/auth.service.js" asp-append-version="true"></script>
    <script src="~/js/services/shared/coreApi.js" asp-append-version="true"></script>
    <script src="~/js/services/static-data/staticDataCore.js" asp-append-version="true"></script>
    <script src="~/js/services/static-data/breftBinsStaticDataService.js" asp-append-version="true"></script>
    <script src="~/js/modules/static-data/breft-bins.js" asp-append-version="true"></script>
}