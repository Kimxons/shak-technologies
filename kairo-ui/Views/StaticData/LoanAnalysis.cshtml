@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Loan Analysis";
    Layout = "_ApplicationLayout";

    var operatorId = ViewData["OperatorId"]?.ToString() ?? string.Empty;
    var branchCode = ViewData["BranchCode"]?.ToString() ?? string.Empty;
    var bankId = ViewData["BankId"]?.ToString() ?? string.Empty;
    var analysisTypeOptions = ViewData["AnalysisTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="window">
    <div class="main-container">
        <section class="form-content" aria-label="Loan Analysis Content">
            <form id="loan-analysis-form" autocomplete="off" novalidate>
                <!-- Context hidden fields -->
                <input type="hidden" id="moduleId_loanAnalysis" value="@ViewData["ModuleId"]" />
                <input type="hidden" id="OperatorID" value="@operatorId" />
                <input type="hidden" id="hdn_BranchCode" value="@branchCode" />
                <input type="hidden" id="hdn_BankId" value="@bankId" />

                <div class="form-card">

                    <!-- Loan Analysis Section -->
                    <div class="form-section" data-section="loan-analysis">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-diagram-3"></i> Loan Analysis</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Loan Analysis" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="LoanAnalysisId">Loan Analysis ID</label>
                                    <div class="kairo-control kairo-control--single">
                                        <input type="text" id="LoanAnalysisId" name="LoanAnalysisId" class="kairo-control__id" aria-label="Loan Analysis ID" data-always-enabled />
                                        <button type="button" id="btnLoanAnalysisLookup" class="btn-lookup kairo-control__lookup" aria-label="Search Loan Analysis" data-la-action="search" data-always-enabled>
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="NoOfSlabs">No Of Slabs</label>
                                    <input type="text" class="bs-input-text" id="NoOfSlabs" name="NoOfSlabs" readonly />
                                </div>
                            </div>

                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="Description">Description</label>
                                    <input type="text" class="bs-input-text" id="Description" name="Description" aria-label="Description" />
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="AnalysisTypeId">Analysis Type</label>
                                    <select class="bs-select" id="AnalysisTypeId" name="AnalysisTypeId"
                                            asp-items="@analysisTypeOptions.Where(x => !string.IsNullOrWhiteSpace(x.Value))">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Analysis Details Section -->
                    <div class="form-section" data-section="analysis-details">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-table"></i> Analysis Details</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Analysis Details" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row">
                                <label class="label-blue" for="DetailDescription">Description</label>
                                <input type="text" class="bs-input-text" id="DetailDescription" name="DetailDescription" aria-label="Detail Description" />
                            </div>

                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="FromValue">From Value</label>
                                    <input type="text" class="bs-input-text" id="FromValue" name="FromValue" aria-label="From Value" />
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="ToValue">To Value</label>
                                    <input type="text" class="bs-input-text" id="ToValue" name="ToValue" aria-label="To Value" />
                                </div>
                            </div>

                            <div class="d-flex gap-2 mb-3">
                                <button type="button" class="btn-action" data-la-grid-action="new" disabled>
                                    <i class="bi bi-plus-circle me-1"></i>New
                                </button>
                                <button type="button" class="btn-action" data-la-grid-action="alter" disabled>
                                    <i class="bi bi-pencil-square me-1"></i>Alter
                                </button>
                                <button type="button" class="btn-action" data-la-grid-action="remove" disabled>
                                    <i class="bi bi-trash me-1"></i>Remove
                                </button>
                                <button type="button" class="btn-action" data-la-grid-action="update" disabled>
                                    <i class="bi bi-arrow-clockwise me-1"></i>Update
                                </button>
                                <button type="button" class="btn-action" data-la-grid-action="clear" disabled>
                                    <i class="bi bi-x-circle me-1"></i>Clear
                                </button>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0" id="slabsTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">Description</th>
                                            <th scope="col">Analysis From</th>
                                            <th scope="col">Analysis To</th>
                                        </tr>
                                    </thead>
                                    <tbody id="slabsTableBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Behind The Scene Section -->
                    <div class="form-section" data-section="behind-scene">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-eye"></i> Behind The Scene</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind The Scene" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="audit-section">
                                <div class="audit-block">
                                    <div class="audit-item">
                                        <label>Created By</label>
                                        <span class="audit-value" id="CreatedBy" data-la-audit></span>
                                    </div>
                                    <div class="audit-item">
                                        <label>Created On</label>
                                        <span class="audit-value" id="CreatedOn" data-la-audit></span>
                                    </div>
                                </div>
                                <div class="audit-block">
                                    <div class="audit-item">
                                        <label>Modified By</label>
                                        <span class="audit-value" id="ModifiedBy" data-la-audit></span>
                                    </div>
                                    <div class="audit-item">
                                        <label>Modified On</label>
                                        <span class="audit-value" id="ModifiedOn" data-la-audit></span>
                                    </div>
                                </div>
                                <div class="audit-block">
                                    <div class="audit-item">
                                        <label>Supervised By</label>
                                        <span class="audit-value" id="SupervisedBy" data-la-audit></span>
                                    </div>
                                    <div class="audit-item">
                                        <label>Supervised On</label>
                                        <span class="audit-value" id="SupervisedOn" data-la-audit></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </form>
        </section>

        <aside class="action-panel" aria-label="Actions">
            <div class="action-buttons">
                <button type="button" class="btn-action btn-view" data-shell-mode="View"><i class="bi bi-eye me-1"></i>View</button>
                <button type="button" class="btn-action" data-shell-mode="Add"><i class="bi bi-plus-circle me-1"></i>Add</button>
                <button type="button" class="btn-action" data-shell-mode="Update"><i class="bi bi-pencil-square me-1"></i>Edit</button>
                <button type="button" class="btn-action" data-la-action="delete"><i class="bi bi-trash me-1"></i>Delete</button>
                <button type="button" class="btn-action" data-la-action="save" disabled><i class="bi bi-check-lg me-1"></i>Save</button>
                <button type="button" class="btn-action btn-cancel" data-la-action="cancel"><i class="bi bi-x-circle me-1"></i>Cancel</button>
            </div>
        </aside>
    </div>

    <div class="am-message-panel" id="dv_messagePanel" role="alert" aria-live="polite">
        <i class="bi bi-info-circle" id="icn_messageIcon"></i>
        <span id="spn_messageText"></span>
    </div>

    <!-- Loan Analysis Search Modal -->
    <div class="modal fade" id="loanAnalysisSearchModal" tabindex="-1" aria-labelledby="loanAnalysisSearchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-0 small">Loan Analysis</p>
                        <h5 class="modal-title" id="loanAnalysisSearchModalLabel">Find Loan Analysis</h5>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <button type="button" class="btn btn-sm btn-outline-light" id="btnSearchRefreshLoanAnalysis" aria-label="Refresh">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <form class="row g-3 align-items-end mb-3" id="loanAnalysisSearchForm">
                        <div class="col-md-4">
                            <label class="form-label">Loan Analysis ID</label>
                            <div class="input-group input-group-sm">
                                <select class="form-select" id="searchLoanAnalysisIdMode">
                                    <option value="Like">Contains</option>
                                    <option value="Equal">Exact</option>
                                    <option value="StartsWith">Starts With</option>
                                </select>
                                <input type="text" class="form-control" id="searchLoanAnalysisId" placeholder="e.g. 01" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Description</label>
                            <div class="input-group input-group-sm">
                                <select class="form-select" id="searchDescriptionMode">
                                    <option value="Like">Contains</option>
                                    <option value="Equal">Exact</option>
                                </select>
                                <input type="text" class="form-control" id="searchDescription" placeholder="Description" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Analysis Type</label>
                            <select class="form-select form-select-sm" id="searchAnalysisTypeId">
                                <option value="">--All--</option>
                                @foreach (var item in analysisTypeOptions.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 text-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnSearchResetLoanAnalysis">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                            </button>
                            <button type="submit" class="btn btn-primary btn-sm" id="btnSearchLoanAnalysis">
                                <i class="bi bi-search me-1"></i>Search
                            </button>
                        </div>
                    </form>

                    <div class="position-relative">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0" id="loanAnalysisSearchTable">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Loan Analysis ID</th>
                                        <th scope="col">Description</th>
                                        <th scope="col">Analysis Type</th>
                                    </tr>
                                </thead>
                                <tbody id="loanAnalysisSearchResults"></tbody>
                            </table>
                        </div>
                        <div id="loanAnalysisSearchEmpty" class="text-center py-5 text-muted d-none">
                            Enter at least one filter above and click Search.
                        </div>
                        <div id="loanAnalysisSearchLoader" class="d-none position-absolute top-50 start-50 translate-middle">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <small class="text-muted me-auto">Double-click a row to select record.</small>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Close
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnSearchOk">
                        <i class="bi bi-check-lg me-1"></i>OK
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/environment.js" asp-append-version="true"></script>
    <script src="~/js/config.js" asp-append-version="true"></script>
    <script src="~/js/auth/auth.config.js" asp-append-version="true"></script>
    <script src="~/js/auth/auth.service.js" asp-append-version="true"></script>
    <script src="~/js/sweetalert2.min.js" asp-append-version="true"></script>
    <script src="~/js/modules/static-data/loan-analysis.js" asp-append-version="true"></script>
}
