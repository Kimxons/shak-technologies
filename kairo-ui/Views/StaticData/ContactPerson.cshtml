@{
    Layout = null;
}

<form id="contactPersonFormToken" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div id="contactPersonModule">
    <!-- Loading Overlay -->
    <div id="contactPersonLoadingOverlay" class="page-loading-overlay" hidden>
        <div class="page-loading-spinner">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>

    <!-- Mode Pill -->
    <div class="d-flex justify-content-end px-2 pt-1">
        <span class="badge bg-secondary" data-page-function-pill>Mode &middot; View</span>
    </div>

    <form id="contact-person-form" autocomplete="off" novalidate>
                <div class="form-card">
                    <div class="form-section" data-section="contact-person-info">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-person-lines-fill"></i> Contact Person Information</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Contact Person Information" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="ContactPersonID">Contact Person ID</label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input type="text" id="ContactPersonID" class="kairo-control__id" aria-label="Contact Person ID" data-always-enabled>
                                        <input type="text" id="ContactPersonDesc" class="kairo-control__name" aria-label="Contact Person Name" placeholder="Contact Person Name" readonly>
                                        <button type="button" class="btn-lookup kairo-control__lookup" data-contactperson-action="search" aria-label="Search Contact Person"><i class="bi bi-search"></i></button>
                                    </div>
                                </div>
                                <div class="col">
                                    <label for="Title">Title</label>
                                    <select class="bs-select" id="Title" name="Title">
                                        <option value="">-- Select Title --</option>
                                        <option value="Mr">Mr</option>
                                        <option value="Mrs">Mrs</option>
                                        <option value="Ms">Ms</option>
                                        <option value="Dr">Dr</option>
                                        <option value="Prof">Prof</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-row two-col">
                                <div class="col">
                                    <label for="Phone">Phone</label>
                                    <input type="text" class="bs-input" id="Phone" name="Phone" placeholder="Phone number">
                                </div>
                                <div class="col">
                                    <label for="Email">Email</label>
                                    <input type="email" class="bs-input" id="Email" name="Email" placeholder="Email address">
                                </div>
                            </div>

                            <div class="form-row two-col">
                                <div class="col">
                                    <label for="IsActive">Active</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="checkbox" class="bs-checkbox" id="IsActive" name="IsActive">
                                        <span class="small text-muted">Mark as Active</span>
                                    </div>
                                </div>
                                <div class="col"></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section" data-section="behind-scene">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-eye"></i> Behind The Scene</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind The Scene" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="audit-section">
                                <div class="audit-block">
                                    <div class="audit-item">
                                        <label>Created By</label>
                                        <span class="audit-value" id="cpCreatedBy"></span>
                                    </div>
                                    <div class="audit-item">
                                        <label>Created On</label>
                                        <span class="audit-value" id="cpCreatedOn"></span>
                                    </div>
                                </div>
                                <div class="audit-block">
                                    <div class="audit-item">
                                        <label>Modified By</label>
                                        <span class="audit-value" id="cpModifiedBy"></span>
                                    </div>
                                    <div class="audit-item">
                                        <label>Modified On</label>
                                        <span class="audit-value" id="cpModifiedOn"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

    <div class="am-message-panel" role="alert" aria-live="polite" id="contactPersonMessagePanel">
        <i class="bi bi-info-circle"></i>
        <span></span>
    </div>

    <!-- Hidden proxy buttons for parent action panel sync -->
    <div hidden aria-hidden="true">
        <button data-contactperson-mode="View"></button>
        <button data-contactperson-mode="Add" disabled></button>
        <button data-contactperson-mode="Edit" disabled></button>
        <button data-contactperson-action="delete" disabled></button>
        <button data-contactperson-action="save" disabled></button>
        <button data-contactperson-action="cancel" disabled></button>
    </div>
</div>
