@{
    Layout = "_ApplicationLayout";
    ViewBag.Title = "Statement View";
}

<!-- Module-specific CSS (use local reference) -->
<link rel="stylesheet" href="~/css/search-modal.css" />

<div class="window">
    <main class="main-container">
        <div class="form-content" role="region" aria-label="Statement View">
            <div class="form-card" data-main-form>
                <!-- Filters Section -->
                <div id="dv_filtersSection" class="form-section" data-section="filters">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-funnel"></i>Filters</span>
                        <button id="btn_toggleFilters" type="button" class="section-toggle-btn" aria-label="Toggle Filters" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <form id="frm_statementFilters" autocomplete="off">
                            <!-- Row 1: Statement For, From Date, To Date -->
                            <div class="row g-3 mb-3">
                                <div class="col-4">
                                    <label class="label-blue" for="ddl_statementFor" id="lbl_statementFor">Statement For</label>
                                    <select id="ddl_statementFor" name="statementFor" class="bs-select">
                                        <option value="0">Select Period</option>
                                        <option value="1">Current Month</option>
                                        <option value="2">Current and Previous Month</option>
                                        <option value="3">Date Range</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="label-blue" for="txt_fromDate" id="lbl_fromDate">From Date</label>
                                    <div class="input-group">
                                        <input id="txt_fromDate" name="fromDate" type="text" class="bs-input-text form-control" placeholder="dd-mmm-yyyy" autocomplete="off" />
                                        <button id="btn_fromDatePicker" type="button" class="btn btn-outline-secondary" title="Pick Date" aria-label="Pick From Date"><i class="bi bi-calendar"></i></button>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <label class="label-blue" for="txt_toDate" id="lbl_toDate">To Date</label>
                                    <div class="input-group">
                                        <input id="txt_toDate" name="toDate" type="text" class="bs-input-text form-control" placeholder="dd-mmm-yyyy" autocomplete="off" />
                                        <button id="btn_toDatePicker" type="button" class="btn btn-outline-secondary" title="Pick Date" aria-label="Pick To Date"><i class="bi bi-calendar"></i></button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Statement Grid Section -->
                <div id="dv_statementGridSection" class="form-section" data-section="statement-grid">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-table"></i>Statement Grid</span>
                        <span class="de-record-count" id="spn_recordCount">(0 records)</span>
                        <button id="btn_toggleStatementGrid" type="button" class="section-toggle-btn" aria-label="Toggle Statement Grid" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content style="overflow-x: auto;">
                        <table class="table table-sm table-hover" id="tbl_statementGrid" style="margin-bottom: 0;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px;"><input type="checkbox" id="chk_selectAll" aria-label="Select all rows" /></th>
                                    <th>Date</th>
                                    <th>Value Date</th>
                                    <th>Particulars</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <th class="text-end">Closing</th>
                                    <th style="display:none;">BatchID</th>
                                    <th style="display:none;">RowID</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-4">No records to display.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Panel -->
        <aside class="action-panel">
            <div class="d-flex flex-column gap-2 mt-auto">
                <button id="btn_view" class="btn-action" type="button" data-action="view" title="View" aria-label="View selected statement"><i class="bi bi-eye"></i><span>View</span></button>
                <div id="dv_printExport" class="sv-print-export">
                    <button id="btn_print" class="btn-action" type="button" data-action="print" title="Print" aria-label="Print statement"><i class="bi bi-printer"></i><span>Print</span></button>
                </div>
                <div id="dv_exportPopover" aria-label="Export options">
                    <button id="btn_exportExcel" class="sv-export-btn sv-excel-btn" type="button" data-action="exportExcel" title="Export to Excel" aria-label="Export to Excel"><i class="bi bi-file-earmark-excel"></i><span>Excel</span></button>
                    <button id="btn_exportPdf" class="sv-export-btn sv-pdf-btn" type="button" data-action="exportPdf" title="Export to PDF" aria-label="Export to PDF"><i class="bi bi-file-earmark-pdf"></i><span>PDF</span></button>
                </div>
                <button id="btn_reverse" class="btn-action" type="button" data-action="reverse" title="Reverse" aria-label="Reverse transaction"><i class="bi bi-arrow-counterclockwise"></i><span>Reverse</span></button>
                <button id="btn_refresh" class="btn-action" type="button" data-action="refresh" title="Refresh" aria-label="Refresh statement data"><i class="bi bi-arrow-clockwise"></i><span>Refresh</span></button>
                <button id="btn_close" class="btn-action btn-cancel" type="button" data-action="close" title="Close" aria-label="Close window"><i class="bi bi-x-lg"></i><span>Close</span></button>
            </div>
        </aside>
    </main>
</div>

<style>
    .sv-print-export {
        position: relative;
    }

    #dv_exportPopover {
        position: fixed;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 8px;
        min-width: 140px;
        background: var(--am-bg-card, #fff);
        border: 1px solid var(--am-border-light, #e2e8f0);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.08);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        z-index: 99999;
        transform: translateY(4px) scale(0.96);
        transform-origin: right center;
        transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

        #dv_exportPopover.is-visible {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0) scale(1);
        }

        #dv_exportPopover::before {
            content: '';
            position: absolute;
            right: -6px;
            top: 50%;
            transform: translateY(-50%) rotate(45deg);
            width: 12px;
            height: 12px;
            background: var(--am-bg-card, #fff);
            border-right: 1px solid var(--am-border-light, #e2e8f0);
            border-top: 1px solid var(--am-border-light, #e2e8f0);
        }

        #dv_exportPopover .sv-export-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            padding: 10px 14px;
            border: none;
            border-radius: 6px;
            background: transparent;
            color: var(--am-text-primary, #1e293b);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
            text-align: left;
        }

            #dv_exportPopover .sv-export-btn i {
                font-size: 18px;
                flex-shrink: 0;
            }

            #dv_exportPopover .sv-export-btn:hover {
                background: rgba(74, 124, 149, 0.08);
            }

            #dv_exportPopover .sv-export-btn.sv-excel-btn {
                color: #217346;
            }

                #dv_exportPopover .sv-export-btn.sv-excel-btn:hover {
                    background: rgba(33, 115, 70, 0.12);
                    color: #1a5c38;
                }

            #dv_exportPopover .sv-export-btn.sv-pdf-btn {
                color: #dc2626;
            }

                #dv_exportPopover .sv-export-btn.sv-pdf-btn:hover {
                    background: rgba(220, 38, 38, 0.12);
                    color: #b91c1c;
                }
</style>

<script>
    // Store Statement View parameters from controller
    window.StatementViewState = {
        ModuleID: '@ViewBag.ModuleID',
      BranchID: '@ViewBag.BranchID',
        AccountID: '@ViewBag.AccountID'
    };
</script>

<!-- Module JavaScript -->
<script src="~/js/modules/shared/statement-view.js"></script>

