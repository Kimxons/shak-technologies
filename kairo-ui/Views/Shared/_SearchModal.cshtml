@model kairo_ui.Models.Shared.SearchModalViewModel
@{
    Layout = null;
}

<link rel="stylesheet" href="/css/search-modal.css" />

<!-- Search Modal HTML -->
<div id="search-modal" class="search-modal-themed"
     style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index: 9999; justify-content: center; align-items: center;">
    <div class="search-modal-themed__panel">
        <div class="search-modal-themed__header">
            <h5 id="search-modal-title" class="search-modal-themed__title">@(Model.SearchTitle ?? "Search Results")</h5>
            <button type="button" id="search-modal-close" class="search-modal-themed__close"
                    aria-label="Close">&times;</button>
        </div>
        <div class="search-modal-themed__criteria-wrap">
            <form id="search-modal-form" class="search-modal-themed__criteria">
                @Html.AntiForgeryToken()
                @if (Model.SearchConfig?.SearchFields != null)
                {
                    foreach (var field in Model.SearchConfig.SearchFields.OrderBy(f => f.FieldOrder))
                    {
                        <div class="search-modal-themed__field">
                            <label class="search-modal-themed__label">@field.DisplayName</label>
                            <div class="search-modal-themed__input-row">
                                <select class="search-modal-themed__select" data-field="@field.FieldName"
                                        aria-label="@field.DisplayName Filter Type">
                                    <option value="like" selected>Like</option>
                                    <option value="equals">Equals</option>
                                    <option value="startswith">Starts</option>
                                    <option value="endswith">Ends</option>
                                </select>
                                <input type="text"                                 class="search-modal-themed__input"                       data-field="@field.FieldName"
                                       placeholder="@field.DisplayName"                        autocomplete="off" />
                            </div>
                        </div>
                    }
                }
            </form>
            <div class="search-modal-themed__actions">
                <button type="button" id="search-modal-search-btn"
                        class="search-modal-themed__btn search-modal-themed__btn--secondary">Search</button>
            </div>
        </div>
        <div class="search-modal-themed__body">
            <div id="search-modal-loading" class="search-modal-themed__loading" style="display:none;">Loading...</div>
            <div id="search-modal-results" class="search-modal-themed__results" style="display:none;"></div>
            <div id="search-modal-empty" class="search-modal-themed__empty" style="display:none;">No records found</div>
        </div>
        <div class="search-modal-themed__footer">
            <div class="search-modal-themed__footer-left">
                <button type="button" id="search-modal-nav-prev"
                        class="search-modal-themed__btn search-modal-themed__btn--secondary" title="Previous record">
                    <i class="bi bi-chevron-left"></i> Previous
                </button>
            </div>
            <div class="search-modal-themed__footer-center">
                <h5 class="search-modal-themed__footer-label">Page Size:</h5>
                <select id="search-page-size" class="search-modal-themed__select" aria-label="Page Size"
                        style="flex: 0 0 auto; padding: 4px 8px;">
                    <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>
                    <option value="1000" selected="@(Model.PageSize == 1000 ? "selected" : null)">1000</option>
                </select>
                <button type="button" id="search-modal-ok"
                        class="search-modal-themed__btn search-modal-themed__btn--secondary">OK</button>
            </div>
            <div class="search-modal-themed__footer-right">
                <button type="button" id="search-modal-nav-next"
                        class="search-modal-themed__btn search-modal-themed__btn--secondary" title="Next record">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden data for JavaScript -->
<input type="hidden" id="search-table-id" value="@Model.TableID" />
<input type="hidden" id="search-where-stmt" value="@Model.WhereStmt" />
<input type="hidden" id="search-adv-filter" value="@Model.AdvFilterString" />
<input type="hidden" id="search-module-id" value="@Model.ModuleID" />
<input type="hidden" id="search-key-for-nav" value="@(Model.SearchConfig?.KeyForNavigation ?? "")" />
<input type="hidden" id="search-ref-id" value="" />
<input type="hidden" id="search-prev-or-next" value="0" />

<script>
    // Store modal state and configuration for JavaScript
    window.SearchModalState = {
        tableID: '@Model.TableID',
        whereStmt: '@Model.WhereStmt',
        advFilterString: '@Model.AdvFilterString',
        moduleID: '@Model.ModuleID',
        searchKey: '@Model.SearchKey',
        prevOrNext: '@Model.PrevOrNext',
        pageSize: '@Model.PageSize',
        keyForNavigation: '@(Model.SearchConfig?.KeyForNavigation ?? "")',
        searchConfig: @Html.Raw(Json.Serialize(Model.SearchConfig))
    };
</script>