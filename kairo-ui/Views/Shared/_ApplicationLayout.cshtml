<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Enterprise Core Banking</title>

    <!-- Stylesheets -->
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/flatpickr/flatpickr.min.css" />
    <link rel="stylesheet" type="text/css" href="~/css/maincss.css" />
    <link rel="stylesheet" type="text/css" href="/css/styles.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

    <!-- Original Subtle Message Panel -->
    <div class="am-message-panel" id="amMessagePanel">
        <i class="bi bi-info-circle"></i>
        <span id="messagePanelText"></span>
        <button type="button" class="am-message-panel__close" onclick="this.parentElement.classList.remove('show')" aria-label="Close">
            <i class="bi bi-x"></i>
        </button>
    </div>

    <!-- Core Scripts (must load before RenderBody so submodule JS can use AppCore, SearchModal etc.) -->
    <script type="text/javascript" src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="/lib/flatpickr/flatpickr.min.js"></script>
    <script type="text/javascript" src="/js/app/global-utils.js"></script>
    <script type="text/javascript" src="/js/app/app-core.js"></script>
    <script type="text/javascript" src="/js/app/notificationService.js"></script>

    <!-- Session Expiry Monitor - Handles session re-authentication -->
    <script type="text/javascript" src="/js/session-monitor.js"></script>

    <!-- Sidebar Manager - Required for all identity module views -->
    <script type="text/javascript" src="/js/modules/shared/sidebar.js"></script>

    <!-- Shared Search Modal -->
    <script type="text/javascript" src="/js/modules/shared/searchModal.js"></script>

    @RenderBody()

    <!-- Session Expiry Re-Authentication Modal -->
    @await Html.PartialAsync("_SessionExpiredModal")

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
