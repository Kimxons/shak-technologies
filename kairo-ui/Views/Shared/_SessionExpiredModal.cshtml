<!-- Session Expiry Re-Authentication Modal -->
<div id="sessionExpiredModal" class="session-expired-modal" style="display: none;">
    <div class="session-expired-overlay"></div>
    <div class="session-expired-container">
        <div class="session-expired-header">
            <h2>Session Expired</h2>
            <button id="sessionExpiredClose" class="session-expired-close" aria-label="Close modal">
                <i class="bi bi-x"></i>
            </button>
        </div>

        <div class="session-expired-body">
            <div class="session-expired-icon">
                <i class="bi bi-exclamation-circle-fill"></i>
            </div>

            <p class="session-expired-message">
                Your session has expired due to inactivity. 
            </p>

            <p class="session-expired-user-info">
                Please re-authenticate to continue working.
            </p>

            <div id="sessionExpiredError" class="session-expired-error" style="display: none;"></div>

            <form id="sessionExpiredForm" class="session-expired-form" onsubmit="return false;">
                <div class="form-group">
                    <label for="sessionExpiredUsername" class="form-label">Logged in as:</label>
                    <div class="session-expired-username-display">
                        <span id="sessionExpiredUsername">User</span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="sessionExpiredPassword" class="form-label">
                        <i class="bi bi-lock-fill"></i> Password
                    </label>
                    <input 
                        type="password" 
                        id="sessionExpiredPassword" 
                        name="password" 
                        class="form-control session-expired-password-input" 
                        placeholder="Enter your password" 
                        required 
                        autocomplete="current-password"
                    />
                </div>
            </form>
        </div>

        <div class="session-expired-footer">
            <button id="sessionExpiredCancel" class="btn btn-secondary session-expired-cancel-btn">
                Logout
            </button>
            <button id="sessionExpiredSubmit" class="btn btn-primary session-expired-submit-btn">
                <i class="bi bi-check-lg"></i> Re-Authenticate
            </button>
        </div>
    </div>
</div>

<style>
    /* Session Expired Modal Styles */
    .session-expired-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 10000;
        display: none;
        align-items: center;
        justify-content: center;
    }

    .session-expired-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
    }

    .session-expired-container {
        position: relative;
        background: white;
        border-radius: 8px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        width: 90%;
        max-width: 420px;
        animation: slideIn 0.3s ease-out;
        z-index: 10001;
        overflow: hidden;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .session-expired-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px;
        border-bottom: 1px solid #e0e0e0;
        background: linear-gradient(135deg, #f5f7fa 0%, #f0f2f5 100%);
    }

    .session-expired-header h2 {
        margin: 0;
        color: #1a1a1a;
        font-size: 20px;
        font-weight: 600;
    }

    .session-expired-close {
        background: none;
        border: none;
        font-size: 24px;
        color: #666;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: all 0.2s ease;
    }

    .session-expired-close:hover {
        background-color: #e0e0e0;
        color: #1a1a1a;
    }

    .session-expired-body {
        padding: 32px 24px;
    }

    .session-expired-icon {
        text-align: center;
        margin-bottom: 20px;
    }

    .session-expired-icon i {
        font-size: 48px;
        color: #f59e0b;
    }

    .session-expired-message {
        text-align: center;
        color: #333;
        font-size: 16px;
        margin: 0 0 12px 0;
        font-weight: 500;
    }

    .session-expired-user-info {
        text-align: center;
        color: #666;
        font-size: 14px;
        margin: 0 0 20px 0;
    }

    .session-expired-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        color: #333;
        font-size: 14px;
        font-weight: 500;
    }

    .session-expired-username-display {
        padding: 12px;
        background-color: #f5f7fa;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        color: #0f4083;
        font-weight: 500;
        font-size: 14px;
    }

    .session-expired-password-input {
        padding: 10px 12px;
        border: 1px solid #d0d0d0;
        border-radius: 4px;
        font-size: 14px;
        font-family: inherit;
        transition: border-color 0.2s;
    }

    .session-expired-password-input:focus {
        outline: none;
        border-color: #0f4083;
        box-shadow: 0 0 0 3px rgba(15, 64, 131, 0.1);
    }

    .session-expired-error {
        padding: 12px;
        background-color: #fee;
        border: 1px solid #fcc;
        border-radius: 4px;
        color: #c33;
        font-size: 13px;
        margin-bottom: 8px;
        display: none;
    }

    .session-expired-footer {
        display: flex;
        gap: 12px;
        padding: 16px 24px;
        border-top: 1px solid #e0e0e0;
        background-color: #f9f9f9;
    }

    .session-expired-cancel-btn,
    .session-expired-submit-btn {
        flex: 1;
        padding: 10px 16px;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .session-expired-cancel-btn {
        background-color: #e0e0e0;
        color: #333;
    }

    .session-expired-cancel-btn:hover {
        background-color: #d0d0d0;
    }

    .session-expired-cancel-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .session-expired-submit-btn {
        background-color: #0f4083;
        color: white;
    }

    .session-expired-submit-btn:hover:not(:disabled) {
        background-color: #0a3060;
        box-shadow: 0 4px 12px rgba(15, 64, 131, 0.3);
    }

    .session-expired-submit-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .session-expired-submit-btn i {
        font-size: 16px;
    }

    /* Responsive */
    @@media (max-width: 480px) {
        .session-expired-container {
            max-width: calc(100% - 20px);
            margin: 10px;
        }

        .session-expired-body {
            padding: 20px;
        }

        .session-expired-header {
            padding: 16px;
        }

        .session-expired-footer {
            padding: 12px;
            flex-direction: column;
        }

        .session-expired-cancel-btn,
        .session-expired-submit-btn {
            width: 100%;
        }
    }

    /* Prevent page scrolling when modal is open */
    body.session-expired-open {
        overflow: hidden;
    }
</style>

<script>
    // Make modal visible when needed
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('sessionExpiredModal');
        if (modal) {
            const originalDisplay = modal.style.display;
            
            // Observer for when modal is shown
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.attributeName === 'style') {
                        const display = modal.style.display;
                        if (display === 'flex' || display === 'block') {
                            document.body.classList.add('session-expired-open');
                        } else {
                            document.body.classList.remove('session-expired-open');
                        }
                    }
                });
            });

            observer.observe(modal, { attributes: true, attributeFilter: ['style'] });
        }
    });
</script>
