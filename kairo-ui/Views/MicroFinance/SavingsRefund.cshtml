@{
    ViewData["Title"] = "Savings Refund";
    Layout = "_ApplicationLayout";
}

<!-- Toast Container -->
<div class="kairo-toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

<div class="window">
    <!-- Main Container -->
    <div class="main-container">

        <!-- Form Content -->
        <div class="form-content form-content-without-leftbar">
            <div class="form-card" data-main-form>
                <div id="statusMsg" class="status-msg hidden" role="status" aria-live="polite">
                    <span class="status-text"></span>
                </div>

                <!-- Client Details Section -->
                <div class="form-section" data-section="client-details">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-person"></i>Client Details</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Client Details" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="form-row two-col">
                            <div class="col">
                                <label class="label-blue" for="CenterId">Center ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="CenterId" class="kairo-control__id" aria-label="Center ID" placeholder="Center ID">
                                    <input type="text" id="CenterName" class="kairo-control__name" aria-label="Center Name" placeholder="Center Name" readonly>
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-sr-lookup="center" aria-label="Search Center"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                            <div class="col">
                                <label class="label-blue" for="GroupId">Group ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="GroupId" class="kairo-control__id" aria-label="Group ID" placeholder="Group ID">
                                    <input type="text" id="GroupName" class="kairo-control__name" aria-label="Group Name" placeholder="Group Name" readonly>
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-sr-lookup="group" aria-label="Search Group"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="form-row two-col">
                            <div class="col">
                                <label class="label-blue" for="ClientId">Client ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="ClientId" class="kairo-control__id" aria-label="Client ID" placeholder="Client ID">
                                    <input type="text" id="ClientName" class="kairo-control__name" aria-label="Client Name" placeholder="Client Name" readonly>
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-sr-lookup="client" aria-label="Search Client"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                            <div class="col"></div>
                        </div>
                    </div>
                </div>

                <!-- Exit History Section -->
                <div class="form-section" data-section="exit-history">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-clock-history"></i>Exit History</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Exit History" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="form-row two-col">
                            <div class="col">
                                <label class="label-blue" for="ExitDate">Exit Date</label>
                                <input type="text" id="ExitDate" class="form-control" placeholder="Exit Date" readonly>
                            </div>
                            <div class="col">
                                <label class="label-blue" for="ExitReason">Exit Reason</label>
                                <input type="text" id="ExitReason" class="form-control" placeholder="Exit Reason" readonly>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-12 col-lg-4">
                                <label class="label-blue" for="NextOfKin">Next Of Kin</label>
                                <input type="text" id="NextOfKin" class="form-control" placeholder="Next Of Kin" readonly>
                            </div>
                            <div class="col-12 col-lg-4">
                                <label class="label-blue" for="UnclaimedAmount">Unclaimed Amount</label>
                                <input type="number" id="UnclaimedAmount" class="form-control" placeholder="0.00" readonly>
                            </div>
                            <div class="col-12 col-lg-4">
                                <label class="label-blue" for="OsUnclaimed">O/S Unclaimed</label>
                                <input type="number" id="OsUnclaimed" class="form-control" placeholder="0.00" readonly>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transaction Details Section -->
                <div class="form-section" data-section="transaction-details">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-cash-stack"></i>Transaction Details</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Transaction Details" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="form-row two-col">
                            <div class="col">
                                <label class="label-blue" for="TransactionType">Transaction Type</label>
                                <select id="TransactionType" class="form-select" disabled>
                                    <option value="">Select Type</option>
                                    <option value="transfer">Transfer</option>
                                    <option value="cash">Cash</option>
                                    <option value="adjustment">Adjustment</option>
                                </select>
                            </div>
                            <div class="col">
                                <label class="label-blue" for="AccountType">Account Type</label>
                                <select id="AccountType" class="form-select" disabled>
                                    <option value="">Select Type</option>
                                    <option value="customer">Customer</option>
                                    <option value="gl">GL</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row two-col">
                            <div class="col">
                                <label class="label-blue" for="AccountId">Account ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="AccountId" class="kairo-control__id" placeholder="Account ID" readonly aria-label="Account ID">
                                    <input type="text" id="AccountName" class="kairo-control__name" placeholder="Account Name" readonly aria-label="Account Name">
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-sr-lookup="account" aria-label="Search Account" disabled><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                            <div class="col">
                                <label class="label-blue" for="Narration">Narration</label>
                                <input type="text" id="Narration" class="form-control" placeholder="Enter narration" readonly>
                            </div>
                        </div>
                        <div class="form-row two-col">
                            <div class="col">
                                <label class="label-blue" for="TransactionAmount">Transaction Amount</label>
                                <input type="number" id="TransactionAmount" class="form-control" placeholder="0.00" step="any" readonly>
                            </div>
                            <div class="col"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Action Panel -->
        <div class="action-panel">
            <div class="nav-group">
                <button class="btn-nav green" id="btnPrevClient" aria-label="Previous Client"><i class="bi bi-chevron-left"></i></button>
                <span>Client</span>
                <button class="btn-nav green" id="btnNextClient" aria-label="Next Client"><i class="bi bi-chevron-right"></i></button>
            </div>

            <div class="action-buttons">
                <button class="btn-action" id="btnIdentification" type="button" data-sr-action="identification" title="Identification" disabled><i class="bi bi-person-badge me-1"></i>Identification</button>
                <button class="btn-action underline" id="btnView" type="button" data-sr-action="view" title="View"><i class="bi bi-eye me-1"></i>View</button>
                <button class="btn-action" id="btnAdd" type="button" data-sr-action="add" title="Add" disabled><i class="bi bi-plus-circle me-1"></i>Add</button>
                <button class="btn-action" id="btnSave" type="button" data-sr-action="save" title="Save" disabled><i class="bi bi-floppy me-1"></i>Save</button>
                <button class="btn-action btn-cancel" id="btnCancel" type="button" data-sr-action="cancel" title="Cancel" disabled><i class="bi bi-x-circle me-1"></i>Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Search Modal -->
<div class="modal fade cls-search-modal" id="searchModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 900px; width: 90%;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="searchModalTitle">Search</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="searchModalFrame" title="Search" src="about:blank" style="width: 100%; height: 500px; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Prevent form-card and sections from stretching to fill viewport */
        .form-card[data-main-form] {
            flex: 0 0 auto !important;
        }
        .form-card[data-main-form] .form-section {
            flex: 0 0 auto !important;
        }
        /* Ensure section content is not clipped */
        [data-section="exit-history"] .section-content,
        [data-section="exit-history"] [data-section-content],
        [data-section="transaction-details"] .section-content,
        [data-section="transaction-details"] [data-section-content] {
            overflow: visible !important;
            max-height: none !important;
        }
    </style>
}

@section Scripts {
    <script src="@Url.Content("~/js/modules/shared/searchModal.js")"></script>
    <script src="@Url.Content("~/js/modules/microfinance/savings-refund.js")" asp-append-version="true"></script>
}
