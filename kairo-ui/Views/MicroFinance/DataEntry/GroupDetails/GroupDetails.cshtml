@{
    Layout = null;
    var moduleId = ViewData["ModuleId"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Group Details</title>
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="/css/maincss.css" />
    <link rel="stylesheet" type="text/css" href="/css/styles.css" />
</head>
<body data-page="group-details">
    <input type="hidden" id="moduleId_group_details" value="@moduleId" />

    <div class="window">
        <main class="main-container" aria-label="Group Details form">
            <div class="form-content" role="region" aria-label="Group Details form">
                <div class="form-card" data-main-form>
                    <div class="form-section" data-section="group-information">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-people-fill"></i>Group Information</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Group Information" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <form autocomplete="off">
                                <div class="row g-2 mb-2">
                                    <div class="col-4">
                                        <label class="label-blue" for="SubGroupId">Sub Group ID</label>
                                        <div class="kairo-control" data-kairo-control>
                                            <input id="SubGroupId" name="SubGroupId" type="text" class="kairo-control__id" autocomplete="off" />
                                            <input id="GroupDescription" name="GroupDescription" type="text" class="kairo-control__name" placeholder="Description" />
                                            <button type="button" class="btn-lookup kairo-control__lookup" data-lookup="SubGroup" title="Lookup Sub Group ID" aria-label="Lookup Sub Group ID">
                                                <i class="bi bi-search" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="form-section" data-section="behind-scene">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-gear"></i>Behind the Scene</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="audit-section audit-section--summary">
                                <div class="audit-cell">
                                    <span class="audit-label">No. Of Members</span>
                                    <span class="audit-value" id="NoOfMembers">-</span>
                                </div>
                                <div class="audit-cell">
                                    <span class="audit-label">Loan Cycle Required</span>
                                    <span class="audit-value" id="LoanCycleRequired">-</span>
                                </div>
                                <div class="audit-cell">
                                    <span class="audit-label">Created By</span>
                                    <span class="audit-value" id="CreatedBy">-</span>
                                </div>
                                <div class="audit-cell">
                                    <span class="audit-label">Created On</span>
                                    <span class="audit-value" id="CreatedOn">-</span>
                                </div>
                                <div class="audit-cell">
                                    <span class="audit-label">Modified By</span>
                                    <span class="audit-value" id="ModifiedBy">-</span>
                                </div>
                                <div class="audit-cell">
                                    <span class="audit-label">Modified On</span>
                                    <span class="audit-value" id="ModifiedOn">-</span>
                                </div>
                                <div class="audit-cell">
                                    <span class="audit-label">Supervised By</span>
                                    <span class="audit-value" id="SupervisedBy">-</span>
                                </div>
                                <div class="audit-cell">
                                    <span class="audit-label">Supervised On</span>
                                    <span class="audit-value" id="SupervisedOn">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="action-panel" aria-label="Form actions">
                <div class="action-buttons">
                    <button class="btn-action btn-view" type="button" data-action="view" title="View">
                        <i class="bi bi-eye"></i>View
                    </button>
                    <button class="btn-action" type="button" data-action="add" title="Add">
                        <i class="bi bi-plus-circle"></i>Add
                    </button>
                    <button class="btn-action" type="button" data-action="edit" title="Edit" disabled>
                        <i class="bi bi-pencil-square"></i>Edit
                    </button>
                    <button class="btn-action" type="button" data-action="delete" title="Delete" disabled>
                        <i class="bi bi-trash3"></i>Delete
                    </button>
                    <button class="btn-action" type="button" data-action="save" title="Save" disabled>
                        <i class="bi bi-check-lg"></i>Save
                    </button>
                    <button class="btn-action btn-cancel" type="button" data-action="cancel" title="Cancel">
                        <i class="bi bi-x-lg"></i>Cancel
                    </button>
                    <button class="btn-action" type="button" data-action="close" id="btnClose" title="Close">
                        <i class="bi bi-box-arrow-right"></i>Close
                    </button>
                </div>
            </div>
        </main>

        <div class="loading-overlay" id="loadingOverlay" hidden>
            <div class="loading-spinner">
                <i class="bi bi-arrow-repeat"></i>
                <span>Loading...</span>
            </div>
        </div>
    </div>

    <script type="text/javascript" src="@Url.Content("~/js/services/shared/serviceLoader.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/environment.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/services/shared/coreApi.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/services/microfinance/groupService.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/modules/shared/searchModal.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/modules/microfinance/dataEntry/group-details.js")"></script>
</body>
</html>
