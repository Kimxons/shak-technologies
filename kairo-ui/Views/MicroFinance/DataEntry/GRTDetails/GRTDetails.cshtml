@{
    Layout = null;
    var moduleId = ViewData["ModuleId"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GRT Details</title>
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="/css/maincss.css" />
    <link rel="stylesheet" type="text/css" href="/css/styles.css" />
    <style>
        /* Keep GRT Details aligned with Group Bank Details layout sizing */
        body[data-page="grt-details"] .form-card,
        body[data-page="grt-details"] .form-section {
            flex: 0 0 auto !important;
        }

        body[data-page="grt-details"] .form-section {
            overflow: visible !important;
        }

        body[data-page="grt-details"] .form-content {
            overflow-y: auto !important;
        }

        body[data-page="grt-details"] .form-row.three-col {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
            margin-top: 12px;
            margin-bottom: 12px;
        }

        body[data-page="grt-details"] .form-row.three-col .col {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 4px;
            min-width: 0;
        }

        body[data-page="grt-details"] .form-row.three-col .col label {
            min-width: 0;
            text-align: left;
            margin-bottom: 4px;
        }

        body[data-page="grt-details"] .form-row.three-col .col input,
        body[data-page="grt-details"] .form-row.three-col .col select,
        body[data-page="grt-details"] .form-row.three-col .col textarea {
            width: 100%;
            max-width: none;
        }
    </style>
</head>
<body data-page="grt-details">
    <input type="hidden" id="moduleId_grt_details" value="@moduleId" />

    <div class="window">
        <div class="am-header" role="banner" aria-label="Window title bar">
            <div class="am-header__left">
                <i class="bi bi-card-list am-header__icon" aria-hidden="true"></i>
                <span class="am-header__title">GRT Details</span>
            </div>
            <div class="am-header__right" role="toolbar" aria-label="Window controls">
                <button class="am-btn" type="button" data-action="refresh" title="Refresh" aria-label="Refresh data" id="btnRefresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button class="am-btn am-btn--close" type="button" data-action="close" title="Close" aria-label="Close window" id="btnClose">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <main class="main-container" aria-label="GRT Details form">
            <div class="form-content" role="region" aria-label="GRT Details form">
                <div class="form-card" data-main-form>
                    <div class="form-section form-section--bts" data-section="grt-information">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-card-list"></i>GRT Information</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle GRT Information" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <form autocomplete="off">
                                <div class="form-row three-col">
                                    <div class="col">
                                        <label class="label-blue" for="SchemeId">Scheme ID</label>
                                        <div class="kairo-control" data-kairo-control>
                                            <input type="text" id="SchemeId" class="kairo-control__id" aria-label="Scheme ID" readonly>
                                            <input type="text" id="SchemeName" class="kairo-control__name" aria-label="Scheme Name" placeholder="Scheme Name" readonly>
                                            <button type="button" class="btn-lookup kairo-control__lookup" data-lookup="Scheme" aria-label="Search Scheme"><i class="bi bi-search"></i></button>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="LoanCycleNo">Loan Cycle No.</label>
                                        <input id="LoanCycleNo" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label for="ReferenceNo">Reference No.</label>
                                        <input id="ReferenceNo" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="form-row three-col">
                                    <div class="col">
                                        <label for="GrtDate">GRT Date</label>
                                        <input id="GrtDate" type="date" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="GroupDisbursementDate">Group Disbursement Date</label>
                                        <input id="GroupDisbursementDate" type="date" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="ValueDate">Value Date</label>
                                        <input id="ValueDate" type="date" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="form-row three-col">
                                    <div class="col">
                                        <label class="label-blue" for="GroupDisbursementTime">Disbursement Time</label>
                                        <input id="GroupDisbursementTime" type="text" class="bs-input-text" placeholder="HH:MM or HH:MM:SS" />
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="InstallmentStartDate">Installment Start Date</label>
                                        <input id="InstallmentStartDate" type="date" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="GrtExpiryDate">GRT Expiry Date</label>
                                        <input id="GrtExpiryDate" type="date" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="form-row three-col">
                                    <div class="col">
                                        <label for="MinLoanAmount">Min. Loan Amount</label>
                                        <input id="MinLoanAmount" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label for="MaxLoanAmount">Max. Loan Amount</label>
                                        <input id="MaxLoanAmount" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label for="LoanAmount">Loan Amount</label>
                                        <input id="LoanAmount" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="form-row three-col">
                                    <div class="col">
                                        <label for="LoanTerm">Loan Term</label>
                                        <input id="LoanTerm" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label for="InstallmentGracePeriod">Installment Grace Period</label>
                                        <input id="InstallmentGracePeriod" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                    </div>
                                </div>

                                <div class="form-row three-col">
                                    <div class="col span-3">
                                        <label for="Remarks">Remarks</label>
                                        <textarea id="Remarks" class="bs-input-text" rows="3" maxlength="255" placeholder="Max 255 characters"></textarea>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="form-section form-section--bts" data-section="behind-scene">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-gear"></i>Behind the Scene</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="audit-section">
                                <div class="audit-item">
                                    <label>Created By</label>
                                    <span class="audit-value" id="CreatedBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Created On</label>
                                    <span class="audit-value" id="CreatedOn">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Modified By</label>
                                    <span class="audit-value" id="ModifiedBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Modified On</label>
                                    <span class="audit-value" id="ModifiedOn">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Supervised By</label>
                                    <span class="audit-value" id="SupervisedBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Supervised On</label>
                                    <span class="audit-value" id="SupervisedOn">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="action-panel" aria-label="Form actions">
                <div class="nav-group">
                    <button type="button" class="btn-nav green" data-nav="cycle-prev" aria-label="Previous Cycle"><i class="bi bi-chevron-left"></i></button>
                    <span>Cycle</span>
                    <button type="button" class="btn-nav green" data-nav="cycle-next" aria-label="Next Cycle"><i class="bi bi-chevron-right"></i></button>
                </div>
                <div class="nav-group">
                    <button type="button" class="btn-nav green" data-nav="ref-prev" aria-label="Previous Reference"><i class="bi bi-chevron-left"></i></button>
                    <span>Reference</span>
                    <button type="button" class="btn-nav green" data-nav="ref-next" aria-label="Next Reference"><i class="bi bi-chevron-right"></i></button>
                </div>

                <div class="action-buttons">
                    <button class="btn-action btn-view" type="button" data-action="view" title="View" aria-label="View"><i class="bi bi-eye me-1"></i>View</button>
                    <button class="btn-action" type="button" data-action="add" title="Add" aria-label="Add"><i class="bi bi-plus-circle me-1"></i>Add</button>
                    <button class="btn-action" type="button" data-action="edit" title="Edit" aria-label="Edit" disabled><i class="bi bi-pencil-square me-1"></i>Edit</button>
                    <button class="btn-action" type="button" data-action="delete" title="Delete" aria-label="Delete" disabled><i class="bi bi-trash me-1"></i>Delete</button>
                    <button class="btn-action" type="button" data-action="save" title="Save" aria-label="Save" disabled><i class="bi bi-check-lg me-1"></i>Save</button>
                    <button class="btn-action btn-cancel" type="button" data-action="cancel" title="Cancel" aria-label="Cancel"><i class="bi bi-x-circle me-1"></i>Cancel</button>
                </div>
            </div>
        </main>

        <div class="am-message-panel" role="alert" aria-live="polite">
            <i class="bi bi-info-circle"></i>
            <span></span>
        </div>

        <div class="loading-overlay" id="loadingOverlay" hidden>
            <div class="loading-spinner">
                <i class="bi bi-arrow-repeat"></i>
                <span>Loading...</span>
            </div>
        </div>
    </div>

    <script type="text/javascript" src="@Url.Content("~/js/services/shared/serviceLoader.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/environment.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/services/shared/coreApi.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/services/microfinance/groupService.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/modules/shared/searchModal.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/modules/microfinance/dataEntry/grt-details.js")"></script>
</body>
</html>
