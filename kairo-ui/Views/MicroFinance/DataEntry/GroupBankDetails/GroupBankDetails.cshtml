@using CBS.Entities.SystemCore
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = null;
    var accountTypeOptions = ViewData["AccountTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var institutionTypeOptions = ViewData["InstitutionTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var moduleId = Context.Request.Query["ModuleID"].FirstOrDefault() ?? "100";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Group Bank Details</title>
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="/css/maincss.css" />
    <link rel="stylesheet" type="text/css" href="/css/styles.css" />
</head>
<body>
    <input type="hidden" id="moduleId_group_bank_details" value="@moduleId" />

    <div class="window">
        <div class="am-header" role="banner" aria-label="Window title bar">
            <div class="am-header__left">
                <i class="bi bi-bank am-header__icon" aria-hidden="true"></i>
                <span class="am-header__title">Group Bank Details</span>
            </div>
            <div class="am-header__right" role="toolbar" aria-label="Window controls">
                <button class="am-btn" type="button" data-action="refresh" title="Refresh" aria-label="Refresh data" id="btnRefresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button class="am-btn am-btn--close" type="button" data-action="close" title="Close" aria-label="Close window" id="btnClose">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <main class="main-container" aria-label="Group Bank Details form">
            <div class="form-content" role="region" aria-label="Group Bank Details form">
                <div class="form-card" data-main-form>
                    <div class="form-section" data-section="bank-account-details">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-bank"></i>Bank Account Details</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Bank Account Details" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <form autocomplete="off">
                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <label class="label-blue" for="AccountType">Account Type</label>
                                        <select id="AccountType" class="bs-select">
                                            <option value="">--Select--</option>
                                            @foreach (var opt in accountTypeOptions)
                                            {
                                                <option value="@opt.Value">@opt.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="label-blue" for="InstitutionType">Institution Type</label>
                                        <select id="InstitutionType" class="bs-select">
                                            <option value="">--Select--</option>
                                            @foreach (var opt in institutionTypeOptions)
                                            {
                                                <option value="@opt.Value">@opt.Text</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <label class="label-blue" for="BankId">Bank ID</label>
                                        <div class="d-flex gap-2">
                                            <input id="BankId" type="text" class="bs-input-text flex-grow-1" />
                                            <button class="btn-lookup" type="button" data-lookup="Bank" title="Lookup bank">
                                                <i class="bi bi-search" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="label-blue" for="InstitutionName">Institution Name</label>
                                        <input id="InstitutionName" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <label class="label-blue" for="BranchId">Branch ID</label>
                                        <div class="d-flex gap-2">
                                            <input id="BranchId" type="text" class="bs-input-text flex-grow-1" />
                                            <button class="btn-lookup" type="button" data-lookup="Branch" title="Lookup branch">
                                                <i class="bi bi-search" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="label-blue" for="BranchName">Branch Name</label>
                                        <input id="BranchName" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-12">
                                        <label class="label-blue" for="TitleOfAccount">Title Of Account</label>
                                        <input id="TitleOfAccount" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <label class="label-blue" for="AccountId">Account ID</label>
                                        <input id="AccountId" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col-6">
                                        <label class="label-blue" for="Signatory">Signatory</label>
                                        <input id="Signatory" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <label class="label-blue" for="Balance">Balance</label>
                                        <input id="Balance" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label" for="AdvanceAmount">Advance Amount</label>
                                        <input id="AdvanceAmount" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <label class="form-label" for="Terms">Terms</label>
                                        <input id="Terms" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label" for="MonthlyPayment">Monthly Payment</label>
                                        <input id="MonthlyPayment" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-12">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-cbd-inline="new" disabled>
                                                <i class="bi bi-plus-circle" aria-hidden="true"></i> New
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-cbd-inline="alter" disabled>
                                                <i class="bi bi-pencil" aria-hidden="true"></i> Alter
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-cbd-inline="remove" disabled>
                                                <i class="bi bi-trash" aria-hidden="true"></i> Remove
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-success" data-cbd-inline="update" disabled>
                                                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Update
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-warning" data-cbd-inline="clear" disabled>
                                                <i class="bi bi-x-circle" aria-hidden="true"></i> Clear
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="form-section" data-section="bank-accounts-list">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-table"></i>Bank Accounts List</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Bank Accounts List" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover table-striped">
                                    <thead>
                                        <tr>
                                            <th>Account ID</th>
                                            <th>Institution Name</th>
                                            <th>Branch ID</th>
                                            <th>Branch Name</th>
                                            <th>Balance</th>
                                            <th>Title of Account</th>
                                            <th>Signatory</th>
                                        </tr>
                                    </thead>
                                    <tbody id="bankAccountsTableBody">
                                        <tr>
                                            <td colspan="7" class="text-center text-muted">No records to display.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="form-section" data-section="behind-scene">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-gear"></i>Behind the Scene</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="label-blue">Created By</label>
                                    <input type="text" class="bs-input-text" readonly />
                                </div>
                                <div class="col-6">
                                    <label class="label-blue">Created On</label>
                                    <input type="text" class="bs-input-text" readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="action-panel">
                <div class="nav-group">
                    <button class="btn-nav green" aria-label="Previous"><i class="bi bi-chevron-left"></i></button>
                    <span>Record</span>
                    <button class="btn-nav green" aria-label="Next"><i class="bi bi-chevron-right"></i></button>
                </div>

                <div class="action-buttons">
                    <button class="btn-action btn-view" type="button" onclick="window.groupBankDetailsActions?.view?.()" title="View"><i class="bi bi-eye me-1"></i>View</button>
                    <button class="btn-action" type="button" onclick="window.groupBankDetailsActions?.add?.()" title="Add"><i class="bi bi-plus-circle me-1"></i>Add</button>
                    <button class="btn-action" type="button" onclick="window.groupBankDetailsActions?.edit?.()" title="Edit"><i class="bi bi-pencil-square me-1"></i>Edit</button>
                    <button class="btn-action" type="button" onclick="window.groupBankDetailsActions?.delete?.()" title="Delete"><i class="bi bi-trash me-1"></i>Delete</button>
                    <button class="btn-action" type="button" onclick="window.groupBankDetailsActions?.save?.()" title="Save" data-action="save"><i class="bi bi-check-lg me-1"></i>Save</button>
                    <button class="btn-action btn-cancel" type="button" onclick="window.groupBankDetailsActions?.cancel?.()" title="Cancel" data-action="cancel"><i class="bi bi-x-circle me-1"></i>Cancel</button>
                </div>
            </div>
        </main>
    </div>

    <script type="text/javascript" src="@Url.Content("~/js/app/global-utils.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/services/shared/serviceLoader.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/environment.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/services/shared/coreApi.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/services/microfinance/groupService.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/modules/shared/searchModal.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/modules/microfinance/dataEntry/group-bank-details.js")"></script>
</body>
</html>
