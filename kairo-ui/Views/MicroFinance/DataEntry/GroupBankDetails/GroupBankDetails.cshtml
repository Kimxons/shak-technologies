@using CBS.Entities.SystemCore
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = null;
    var accountTypeOptions = ViewData["AccountTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var institutionTypeOptions = ViewData["InstitutionTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var moduleId = Context.Request.Query["ModuleID"].FirstOrDefault() ?? "100";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Group Bank Details</title>
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="/css/maincss.css" />
    <link rel="stylesheet" type="text/css" href="/css/styles.css" />
    <style>
        #bankAccountsTableBody tr.table-active {
            background-color: #e7f3ff;
            font-weight: 500;
        }
    </style>
</head>
<body data-page="group-bank-details">
    <input type="hidden" id="moduleId_group_bank_details" value="@moduleId" />

    <div class="window">
        <div class="am-header" role="banner" aria-label="Window title bar">
            <div class="am-header__left">
                <i class="bi bi-bank am-header__icon" aria-hidden="true"></i>
                <span class="am-header__title">Group Bank Details</span>
            </div>
            <div class="am-header__right" role="toolbar" aria-label="Window controls">
                <button class="am-btn" type="button" data-action="refresh" title="Refresh" aria-label="Refresh data" id="btnRefresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button class="am-btn am-btn--close" type="button" data-action="close" title="Close" aria-label="Close window" id="btnClose">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <main class="main-container" aria-label="Group Bank Details form">
            <div class="form-content" role="region" aria-label="Group Bank Details form">
                <div class="form-card" data-main-form>
                    <div class="form-section form-section--bts" data-section="bank-account-details">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-bank"></i>Bank Account Details</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Bank Account Details" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <form autocomplete="off">
                                <div class="form-row three-col">
                                    <div class="col">
                                        <label class="label-blue" for="AccountType">Account Type</label>
                                        <select id="AccountType" class="bs-select">
                                            <option value="">--Select--</option>
                                            @foreach (var opt in accountTypeOptions)
                                            {
                                                <option value="@opt.Value">@opt.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="InstitutionType">Institution Type</label>
                                        <select id="InstitutionType" class="bs-select">
                                            <option value="">--Select--</option>
                                            @foreach (var opt in institutionTypeOptions)
                                            {
                                                <option value="@opt.Value">@opt.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col">
                                        <label class="label-blue">Bank ID</label>
                                        <div class="kairo-control" data-kairo-control>
                                            <input type="text" id="BankId" class="kairo-control__id" aria-label="Bank ID" readonly>
                                            <input type="text" id="InstitutionName" class="kairo-control__name" aria-label="Institution Name" placeholder="Institution Name" readonly>
                                            <button type="button" class="btn-lookup kairo-control__lookup" data-lookup="Bank" aria-label="Search Bank"><i class="bi bi-search"></i></button>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-row three-col">
                                    <div class="col">
                                        <label class="label-blue">Branch ID</label>
                                        <div class="kairo-control" data-kairo-control>
                                            <input type="text" id="BranchId" class="kairo-control__id" aria-label="Branch ID" readonly>
                                            <input type="text" id="BranchName" class="kairo-control__name" aria-label="Branch Name" placeholder="Branch Name" readonly>
                                            <button type="button" class="btn-lookup kairo-control__lookup" data-lookup="Branch" aria-label="Search Branch"><i class="bi bi-search"></i></button>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="TitleOfAccount">Title Of Account</label>
                                        <input id="TitleOfAccount" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="AccountId">Account ID</label>
                                        <input id="AccountId" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="form-row three-col">
                                    <div class="col">
                                        <label class="label-blue" for="Signatory">Signatory</label>
                                        <input id="Signatory" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="Balance">Balance</label>
                                        <input id="Balance" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="AdvanceAmount">Advance Amount</label>
                                        <input id="AdvanceAmount" type="text" class="bs-input-text" />
                                    </div>
                                </div>

                                <div class="form-row three-col">
                                    <div class="col">
                                        <label class="label-blue" for="Terms">Terms</label>
                                        <input id="Terms" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                        <label class="label-blue" for="MonthlyPayment">Monthly Payment</label>
                                        <input id="MonthlyPayment" type="text" class="bs-input-text" />
                                    </div>
                                    <div class="col">
                                    </div>
                                </div>

                                <div class="form-row three-col">
                                    <div class="col span-3">
                                        <div class="d-flex gap-2 w-100">
                                            <button type="button" class="btn btn-sm btn-outline-primary flex-fill" data-cbd-inline="new" disabled>
                                                <i class="bi bi-plus-circle" aria-hidden="true"></i> New
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" data-cbd-inline="alter" disabled>
                                                <i class="bi bi-pencil" aria-hidden="true"></i> Alter
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger flex-fill" data-cbd-inline="remove" disabled>
                                                <i class="bi bi-trash" aria-hidden="true"></i> Remove
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-success flex-fill" data-cbd-inline="update" disabled>
                                                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Update
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-warning flex-fill" data-cbd-inline="clear" disabled>
                                                <i class="bi bi-x-circle" aria-hidden="true"></i> Clear
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="form-section form-section--bts" data-section="bank-accounts-list">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-table"></i>Bank Accounts List</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Bank Accounts List" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover table-striped">
                                    <thead>
                                        <tr>
                                            <th>Account ID</th>
                                            <th>Institution Name</th>
                                            <th>Branch ID</th>
                                            <th>Branch Name</th>
                                            <th>Balance</th>
                                            <th>Title of Account</th>
                                            <th>Signatory</th>
                                        </tr>
                                    </thead>
                                    <tbody id="bankAccountsTableBody">
                                        <tr>
                                            <td colspan="7" class="text-center text-muted">No records to display.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="form-section form-section--bts" data-section="behind-scene">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-gear"></i>Behind the Scene</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="audit-section">
                                <div class="audit-item">
                                    <label>Created By</label>
                                    <span class="audit-value" id="createdBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Created On</label>
                                    <span class="audit-value" id="createdOn">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Modified By</label>
                                    <span class="audit-value" id="modifiedBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Modified On</label>
                                    <span class="audit-value" id="modifiedOn">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Supervised By</label>
                                    <span class="audit-value" id="supervisedBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Supervised On</label>
                                    <span class="audit-value" id="supervisedOn">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="action-panel">
                <div class="action-buttons">
                    <button class="btn-action btn-view" type="button" onclick="window.groupBankDetailsActions?.view?.()" title="View" data-action="view"><i class="bi bi-eye me-1"></i>View</button>
                    <button class="btn-action" type="button" onclick="window.groupBankDetailsActions?.add?.()" title="Add" data-action="add"><i class="bi bi-plus-circle me-1"></i>Add</button>
                    <button class="btn-action" type="button" onclick="window.groupBankDetailsActions?.edit?.()" title="Edit" data-action="edit"><i class="bi bi-pencil-square me-1"></i>Edit</button>
                    <button class="btn-action" type="button" onclick="window.groupBankDetailsActions?.delete?.()" title="Delete" data-action="delete"><i class="bi bi-trash me-1"></i>Delete</button>
                    <button class="btn-action" type="button" onclick="window.groupBankDetailsActions?.save?.()" title="Save" data-action="save"><i class="bi bi-check-lg me-1"></i>Save</button>
                    <button class="btn-action btn-cancel" type="button" onclick="window.groupBankDetailsActions?.cancel?.()" title="Cancel" data-action="cancel"><i class="bi bi-x-circle me-1"></i>Cancel</button>
                </div>
            </div>
        </main>
    </div>

    <script src="@Url.Content("~/js/utils/global-utils.js")"></script>
    <script src="@Url.Content("~/js/services/shared/serviceLoader.js")"></script>
    <script src="@Url.Content("~/js/environment.js")"></script>
    <script src="@Url.Content("~/js/services/shared/coreApi.js")"></script>
    <script src="@Url.Content("~/js/services/shared/lookupService.js")"></script>
    <script src="@Url.Content("~/js/services/microfinance/groupService.js")"></script>
    <script src="@Url.Content("~/js/modules/shared/searchModal.js")"></script>
    <script src="@Url.Content("~/js/modules/microfinance/dataEntry/group-bank-details.js")"></script>
</body>
</html>
