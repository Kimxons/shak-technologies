@using CBS.Entities.SystemCore
@{
    ViewData["Title"] = "Center Loan Menu";
    Layout = "_ApplicationLayout";
    var schemeId = ViewData["SchemeId"]?.ToString() ?? string.Empty;
    var loanProductId = ViewData["LoanProductId"]?.ToString() ?? string.Empty;
    var slRecoveryTypeOptions = ViewData["SLRecoveryTypeOptions"] as IEnumerable<SystemCodeDetail> ?? Enumerable.Empty<SystemCodeDetail>();
    var savingsCollectionTypeOptions = ViewData["SavingsCollectionTypeOptions"] as IEnumerable<SystemCodeDetail> ?? Enumerable.Empty<SystemCodeDetail>();
}

<div class="kairo-toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

<input type="hidden" id="parentSchemeId" value="@schemeId" />
<input type="hidden" id="parentLoanProductId" value="@loanProductId" />

<div class="window">
    <main class="main-container" aria-label="Center Loan Menu form">
        <div class="form-content">
            <div class="form-card" data-main-form>

                <!-- Loan Cycle Details Section -->
                <div class="form-section" data-section="loan-cycle-details">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-arrow-repeat"></i>Loan Cycle Details</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Loan Cycle Details" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="row g-3 mb-3">
                            <div class="col-4">
                                <label class="label-blue" for="LoanCycleNo">Loan Cycle No.</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="LoanCycleNo" class="kairo-control__id bs-input-text" aria-label="Loan Cycle No" placeholder="Cycle No" inputmode="numeric">
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-mcs-lookup="loan-cycle" aria-label="Lookup loan cycle"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                            <div class="col-4">
                                <label class="label-blue" for="LoanLevelNo">Loan Level No</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="LoanLevelNo" class="kairo-control__id bs-input-text" aria-label="Loan Level No" placeholder="Level No" inputmode="numeric">
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-mcs-lookup="loan-level" aria-label="Lookup loan level"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                            <div class="col-4">
                                <label class="label-blue" for="EffectiveDate">Effective Date</label>
                                <input type="date" id="EffectiveDate" class="bs-input-text form-control" aria-label="Effective Date">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Menu Details Section -->
                <div class="form-section" data-section="menu-details">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-ui-checks-grid"></i>Menu Details</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Menu Details" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="label-blue" for="MinimumLoanAmount">Minimum Loan Amount</label>
                                <input id="MinimumLoanAmount" type="text" class="bs-input-text form-control" inputmode="decimal" placeholder="0.00" />
                            </div>
                            <div class="col-6">
                                <label class="label-blue" for="MaximumLoanAmount">Maximum Loan Amount</label>
                                <input id="MaximumLoanAmount" type="text" class="bs-input-text form-control" inputmode="decimal" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="label-blue" for="DefaultLoanAmount">Default Loan Amount</label>
                                <input id="DefaultLoanAmount" type="text" class="bs-input-text form-control" inputmode="decimal" placeholder="0.00" />
                            </div>
                            <div class="col-6">
                                <label class="label-blue" for="Term">Term</label>
                                <input id="Term" type="text" class="bs-input-text form-control" inputmode="numeric" />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="label-blue" for="InterestMenuId">Interest Menu ID</label>
                                <select id="InterestMenuId" class="bs-select form-select">
                                    <option value="" selected>--Select--</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label for="InstallmentGracePeriod">Installment Grace Period</label>
                                <input id="InstallmentGracePeriod" type="text" class="bs-input-text form-control" inputmode="numeric" />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label for="MaxAdjustmentDays">Max Adjustment Days</label>
                                <input id="MaxAdjustmentDays" type="text" class="bs-input-text form-control" inputmode="numeric" />
                            </div>
                            <div class="col-6"></div>
                        </div>
                    </div>
                </div>

                <!-- Collateral Details Section -->
                <div class="form-section" data-section="collateral-details">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-shield-check"></i>Collateral Details</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Collateral Details" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label for="MenuSavingToLoanRatio">Saving To Loan Ratio</label>
                                <input id="MenuSavingToLoanRatio" type="text" class="bs-input-text form-control" inputmode="decimal" />
                            </div>
                            <div class="col-6">
                                <label for="MenuSLRecoveryType">S/L Recovery Type</label>
                                <select id="MenuSLRecoveryType" class="bs-select form-select">
                                    <option value="" selected>--Select--</option>
                                    @foreach (var option in slRecoveryTypeOptions)
                                    {
                                        <option value="@option.SubCodeID">@(option.CodeDescription ?? option.SubCodeID)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="MenuCollectSavingWithInstallment">
                                    <label class="form-check-label" for="MenuCollectSavingWithInstallment">Collect Saving With Installment</label>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label for="MenuSavingsCollectionType">Savings Collection Type</label>
                                <select id="MenuSavingsCollectionType" class="bs-select form-select">
                                    <option value="" selected>--Select--</option>
                                    @foreach (var option in savingsCollectionTypeOptions)
                                    {
                                        <option value="@option.SubCodeID">@(option.CodeDescription ?? option.SubCodeID)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label for="MenuSavingsValue">Savings Value</label>
                                <input id="MenuSavingsValue" type="text" class="bs-input-text form-control" inputmode="decimal" placeholder="0.00" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Behind the Scene Section -->
                <div class="form-section" data-section="behind-scene">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-gear"></i>Behind the Scene</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Behind the Scene" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="audit-section">
                            <div class="audit-item">
                                <label>Loan Product ID</label>
                                <span class="audit-value" id="MenuLoanProductId">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Currency ID</label>
                                <span class="audit-value" id="MenuCurrencyId">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Term Excludes Grace Period</label>
                                <span class="audit-value" id="MenuTermExcludesGracePeriod">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Loan Period</label>
                                <span class="audit-value" id="MenuLoanPeriod">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Calculation Method</label>
                                <span class="audit-value" id="MenuCalculationMethod">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Created By</label>
                                <span class="audit-value" id="MenuCreatedBy">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Created On</label>
                                <span class="audit-value" id="MenuCreatedOn">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Modified By</label>
                                <span class="audit-value" id="MenuModifiedBy">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Modified On</label>
                                <span class="audit-value" id="MenuModifiedOn">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Supervised By</label>
                                <span class="audit-value" id="MenuSupervisedBy">-</span>
                            </div>
                            <div class="audit-item">
                                <label>Supervised On</label>
                                <span class="audit-value" id="MenuSupervisedOn">-</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Action Panel -->
        <div class="action-panel" aria-label="Form actions">
            <div class="action-buttons">
                <button class="btn-action btn-view" type="button" data-mcs-action="view" title="View"><i class="bi bi-eye me-1"></i>View</button>
                <button class="btn-action btn-add" type="button" data-mcs-action="add" title="Add"><i class="bi bi-plus-circle me-1"></i>Add</button>
                <button class="btn-action btn-edit" type="button" data-mcs-action="edit" title="Edit" disabled><i class="bi bi-pencil-square me-1"></i>Edit</button>
                <button class="btn-action btn-delete" type="button" data-mcs-action="delete" title="Delete" disabled><i class="bi bi-trash me-1"></i>Delete</button>
                <button class="btn-action btn-save" type="button" data-mcs-action="save" title="Save" disabled><i class="bi bi-check-lg me-1"></i>Save</button>
                <button class="btn-action btn-cancel" type="button" data-mcs-action="cancel" title="Cancel"><i class="bi bi-x-circle me-1"></i>Cancel</button>
                <button class="btn-action" type="button" data-window-action="close" title="Close"><i class="bi bi-box-arrow-right me-1"></i>Close</button>
            </div>
        </div>

        <!-- Search Modal -->
        <div class="modal fade cls-search-modal" id="searchModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 900px; width: 90%;">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="searchModalTitle">Search</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <iframe id="searchModalFrame" title="Search" src="about:blank" style="width: 100%; height: 500px; border: none;"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Styles {
    <style>
        /* Loan Cycle Details – inputs fill their col-4 width */
        [data-section="loan-cycle-details"] .kairo-control {
            display: flex !important;
            grid-template-columns: none !important;
        }

        [data-section="loan-cycle-details"] .kairo-control .kairo-control__id {
            flex: 1 1 auto !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            border-radius: 5px 0 0 5px !important;
            border-right: none !important;
        }

        [data-section="loan-cycle-details"] .kairo-control .btn-lookup {
            flex: 0 0 32px !important;
            border-radius: 0 5px 5px 0 !important;
        }

        [data-section="loan-cycle-details"] #EffectiveDate {
            width: 100% !important;
        }

        /* Tighter row spacing */
        .form-card .section-content .row.g-3.mb-3 {
            margin-bottom: 0.35rem !important;
        }

        .form-card .section-content .row.g-3 > [class*="col"] {
            padding-top: 0.15rem !important;
            padding-bottom: 0.15rem !important;
        }
    </style>
}

@section Scripts {
    <script src="/js/modules/microfinance/center-loan-menu.js"></script>
}
