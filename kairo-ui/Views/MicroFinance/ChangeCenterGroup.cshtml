@{
    ViewData["Title"] = "Change Center/Group";
    Layout = "_ApplicationLayout";
}

<!-- Toast Container -->
<div class="kairo-toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

<div class="window">
    <!-- Main Container -->
    <div class="main-container">

        <!-- Form Content -->
        <div class="form-content form-content-without-leftbar">
            <div class="form-card" data-main-form>
                <div id="statusMsg" class="status-msg hidden" role="status" aria-live="polite">
                    <span class="status-text"></span>
                </div>

                <!-- Center & Group Identifiers Section -->
                <div class="form-section" data-section="center-group-identifiers">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-diagram-3"></i>Center & Group Identifiers</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Center & Group Identifiers" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="form-row two-col">
                            <div class="col">
                                <label class="label-blue" for="CenterId">Center ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="CenterId" class="kairo-control__id" aria-label="Center ID" placeholder="Center ID">
                                    <input type="text" id="CenterName" class="kairo-control__name" aria-label="Center Name" placeholder="Center Name" readonly>
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-ccg-lookup="center" aria-label="Search Center"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                            <div class="col">
                                <label class="label-blue" for="GroupId">Group ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="GroupId" class="kairo-control__id" aria-label="Group ID" placeholder="Group ID">
                                    <input type="text" id="GroupName" class="kairo-control__name" aria-label="Group Name" placeholder="Group Name" readonly>
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-ccg-lookup="group" aria-label="Search Group"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Client List Section -->
                <div class="form-section" data-section="client-list">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-list-ul"></i>Client List</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Client List" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-hover" id="clientTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px;">
                                            <input type="checkbox" id="selectAll" class="form-check-input" aria-label="Select all" disabled>
                                        </th>
                                        <th>Client ID</th>
                                        <th>Client Name</th>
                                        <th>Client Type</th>
                                        <th>Registration Date</th>
                                        <th>Join Date</th>
                                    </tr>
                                </thead>
                                <tbody id="clientTableBody">
                                    <tr><td colspan="6" class="text-center text-muted">No records to display.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- New Group Section (Transfer To) - Hidden by default -->
                <div class="form-section d-none" id="newGroupSection" data-section="new-group">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-arrow-right-circle"></i>New Group (Transfer To)</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle New Group" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="form-row two-col">
                            <div class="col">
                                <label class="label-blue" for="NewCenterId">New Center ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="NewCenterId" class="kairo-control__id" aria-label="New Center ID" placeholder="Center ID">
                                    <input type="text" id="NewCenterName" class="kairo-control__name" aria-label="New Center Name" placeholder="Center Name" readonly>
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-ccg-lookup="newCenter" aria-label="Search New Center"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                            <div class="col">
                                <label class="label-blue" for="NewGroupId">New Group ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="NewGroupId" class="kairo-control__id" aria-label="New Group ID" placeholder="Group ID">
                                    <input type="text" id="NewGroupName" class="kairo-control__name" aria-label="New Group Name" placeholder="Group Name" readonly>
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-ccg-lookup="newGroup" aria-label="Search New Group"><i class="bi bi-search"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Action Panel -->
        <div class="action-panel">
            <div class="nav-group">
                <button class="btn-nav green" id="btnPrevCenter" aria-label="Previous Center"><i class="bi bi-chevron-left"></i></button>
                <span>Center</span>
                <button class="btn-nav green" id="btnNextCenter" aria-label="Next Center"><i class="bi bi-chevron-right"></i></button>
            </div>

            <div class="action-buttons">
                <button class="btn-action underline" id="btnView" type="button" data-ccg-action="view" title="View"><i class="bi bi-eye me-1"></i>View</button>
                <button class="btn-action" id="btnSelect" type="button" data-ccg-action="select" title="Select" disabled><i class="bi bi-check-square me-1"></i>Select</button>
                <button class="btn-action" id="btnNext" type="button" data-ccg-action="next" title="Next" disabled><i class="bi bi-arrow-right-circle me-1"></i>Next</button>
                <button class="btn-action" id="btnChange" type="button" data-ccg-action="change" title="Change" disabled><i class="bi bi-arrow-left-right me-1"></i>Change</button>
                <button class="btn-action btn-cancel" id="btnCancel" type="button" data-ccg-action="cancel" title="Cancel"><i class="bi bi-x-circle me-1"></i>Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Search Modal -->
<div class="modal fade cls-search-modal" id="searchModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 900px; width: 90%;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="searchModalTitle">Search</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="searchModalFrame" title="Search" src="about:blank" style="width: 100%; height: 500px; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Prevent form-card and sections from stretching to fill viewport */
        .form-card[data-main-form] {
            flex: 0 0 auto !important;
        }
        .form-card[data-main-form] .form-section {
            flex: 0 0 auto !important;
        }
        /* Ensure client list section content is not clipped */
        [data-section="client-list"] .section-content,
        [data-section="client-list"] [data-section-content] {
            overflow: visible !important;
            max-height: none !important;
        }
    </style>
}

@section Scripts {
    <script src="@Url.Content("~/js/modules/shared/searchModal.js")"></script>
    <script src="@Url.Content("~/js/modules/microfinance/change-center-group.js")" asp-append-version="true"></script>
}
