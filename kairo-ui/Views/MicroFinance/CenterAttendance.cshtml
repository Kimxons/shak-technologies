@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq
@{
    ViewData["Title"] = "Center Attendance";
    Layout = "_ApplicationLayout";

    var paymentTypeOptions = ViewData["PaymentTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var attendanceStatusOptions = ViewData["AttendanceStatusOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<!-- Toast Container -->
<div class="toast-container kairo-toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

<div class="window">
    <!-- Main Container -->
    <div class="main-container no-sidebar">

        <!-- Form Content -->
        <div class="form-content form-content-without-leftbar">
            <div class="validation-summary" id="ca_validationSummary" role="alert" aria-live="polite" aria-atomic="true">
                <i class="bi bi-exclamation-octagon validation-summary__icon" aria-hidden="true"></i>
                <div class="validation-summary__text"></div>
                <button type="button" class="validation-summary__close" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <form id="frm_centerAttendance" autocomplete="off" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="moduleId_centerAttendance" value="@ViewData["ModuleId"]" />
                <input type="hidden" id="hdn_updateCount" name="UpdateCount" value="0" />

            <div class="form-card" data-main-form>
                <!-- Attendance Details Section -->
                <div class="form-section" data-section="attendance-details">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-ui-checks-grid"></i>Attendance Details</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Attendance Details" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <!-- Row 1: CenterID, Meeting Date -->
                        <div class="form-row two-col">
                            <div class="form-group">
                                <label class="label-blue" for="txt_centerId">Center ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="txt_centerId" name="CenterID" class="kairo-control__id" aria-label="Center ID" />
                                    <input type="text" id="txt_centerName" name="CenterName" class="kairo-control__name" aria-label="Center Name" readonly />
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-ca-lookup="center" aria-label="Search Center">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="label-blue" for="txt_meetingDate">Meeting Date</label>
                                <div class="kairo-control kairo-control--single" data-kairo-control>
                                    <input type="text" id="txt_meetingDate" name="MeetingDate" class="kairo-control__id" aria-label="Meeting Date" placeholder="DD-MMM-YYYY" data-date-picker />
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-ca-lookup="meeting-date" aria-label="Search Meeting Date">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Row 2: Officer ID, Meeting Place -->
                        <div class="form-row two-col">
                            <div class="form-group">
                                <label class="label-blue" for="txt_officerId">Officer ID</label>
                                <div class="kairo-control" data-kairo-control>
                                    <input type="text" id="txt_officerId" name="OfficerID" class="kairo-control__id" aria-label="Officer ID" />
                                    <input type="text" id="txt_officerName" name="OfficerName" class="kairo-control__name" aria-label="Officer Name" readonly />
                                    <button type="button" class="btn-lookup kairo-control__lookup" data-ca-lookup="officer" aria-label="Search Officer">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="label-blue" for="txt_meetingPlace">Meeting Place</label>
                                <input type="text" id="txt_meetingPlace" name="MeetingPlace" class="bs-input-text" aria-label="Meeting Place" />
                            </div>
                        </div>

                        <!-- Row 3: Remarks -->
                        <div class="form-row">
                            <div class="col">
                                <label class="label-blue" for="txt_remarks">Remarks</label>
                                <textarea id="txt_remarks" name="Remarks" class="bs-textarea" aria-label="Remarks" rows="1"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Attendance List Section -->
                <div class="form-section" data-section="attendance-list">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-table"></i>Attendance List</span>
                        <button type="button" class="section-toggle-btn" aria-label="Toggle Attendance List" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Client ID</th>
                                        <th>Client Name</th>
                                        <th>Attendance Status</th>
                                        <th>Payment Type</th>
                                    </tr>
                                </thead>
                                <tbody id="attendanceTableBody">
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No records to display</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            </form>
        </div>

        <!-- Right Action Panel -->
        <div class="action-panel">
            <div class="action-buttons">
                <button type="button" class="btn-action btn-view" data-action="view" title="View"><i class="bi bi-eye me-1"></i>View</button>
                <button type="button" class="btn-action" data-action="edit" title="Edit"><i class="bi bi-pencil-square me-1"></i>Edit</button>
                <button type="button" class="btn-action" data-action="delete" title="Delete"><i class="bi bi-trash me-1"></i>Delete</button>
                <button type="button" class="btn-action" data-action="save" title="Save"><i class="bi bi-check-lg me-1"></i>Save</button>
                <button type="button" class="btn-action btn-cancel" data-action="cancel" title="Cancel"><i class="bi bi-x-circle me-1"></i>Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- PaymentType options JSON for JS consumption -->
<script id="paymentTypeOptionsData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(paymentTypeOptions.Skip(1).Select(o => new { value = o.Value, label = o.Text })))</script>
<script id="attendanceStatusOptionsData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(attendanceStatusOptions.Skip(1).Select(o => new { value = o.Value, label = o.Text })))</script>

<script src="~/js/ui/date-pickers.js"></script>
<script src="~/js/modules/microfinance/center-attendance.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Section toggles for form sections
        document.querySelectorAll('[data-section-toggle]').forEach(header => {
            header.addEventListener('click', function () {
                const section = this.closest('.form-section');
                const content = section.querySelector('[data-section-content]');
                const btn = this.querySelector('.section-toggle-btn');
                const icon = btn.querySelector('i');
                const isExpanded = btn.getAttribute('aria-expanded') === 'true';

                btn.setAttribute('aria-expanded', !isExpanded);
                content.hidden = isExpanded;
                icon.className = isExpanded ? 'bi bi-chevron-down' : 'bi bi-chevron-up';
            });
        });
    });
</script>
