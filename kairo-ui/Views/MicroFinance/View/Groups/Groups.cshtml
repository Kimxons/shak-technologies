@{
    Layout = null;
    var moduleId = ViewData["ModuleId"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Groups</title>
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" type="text/css" href="/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="/css/maincss.css" />
    <link rel="stylesheet" type="text/css" href="/css/styles.css" />
</head>
<body>
    <input type="hidden" id="moduleId_groups" value="@moduleId" />

    <div class="window">
        <div class="am-header" role="banner" aria-label="Window title bar">
            <div class="am-header__left">
                <i class="bi bi-collection am-header__icon" aria-hidden="true"></i>
                <span class="am-header__title">Groups</span>
            </div>
            <div class="am-header__right" role="toolbar" aria-label="Window controls">
                <button class="am-btn" type="button" data-action="refresh" title="Refresh" aria-label="Refresh data" id="btnRefresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button class="am-btn am-btn--close" type="button" data-action="close" title="Close" aria-label="Close window" id="btnClose">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <main class="main-container" aria-label="Groups view">
            <div class="form-content" role="region" aria-label="Groups view">
                <div class="form-card" data-main-form>
                    <div class="form-section" data-section="groups-list">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-collection"></i>Groups</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Groups" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="table-responsive table-scrollable-sm">
                                <table class="table table-sm table-hover table-striped table-bordered align-middle mb-0">
                                    <thead class="table-header-sticky">
                                        <tr>
                                            <th>Group ID</th>
                                            <th>Group Name</th>
                                            <th>Total Members In SubGroup</th>
                                            <th>Is Staggered</th>
                                        </tr>
                                    </thead>
                                    <tbody id="groupsTableBody">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">No records to display.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="form-section" data-section="summary-info">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-info-circle"></i>Summary Information</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Summary Information" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <form autocomplete="off">
                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <label class="label-blue" for="TotalMembers">Total Members</label>
                                        <input id="TotalMembers" name="TotalMembers" type="text" class="bs-input-text" readonly />
                                    </div>
                                    <div class="col-6"></div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="action-panel" aria-label="Form actions">
                <div class="action-buttons">
                    <button class="btn-action btn-view" type="button" data-action="view" title="View">
                        <i class="bi bi-eye"></i>View
                    </button>
                    <button class="btn-action btn-cancel" type="button" data-action="cancel" title="Cancel">
                        <i class="bi bi-x-lg"></i>Cancel
                    </button>
                </div>
            </div>
        </main>

        <div class="loading-overlay" id="loadingOverlay" hidden>
            <div class="loading-spinner">
                <i class="bi bi-arrow-repeat"></i>
                <span>Loading groups...</span>
            </div>
        </div>
    </div>

    <script type="text/javascript" src="@Url.Content("~/js/services/shared/serviceLoader.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/environment.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/services/shared/coreApi.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/services/microfinance/groupService.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/modules/microfinance/view/groups.js")"></script>
</body>
</html>
