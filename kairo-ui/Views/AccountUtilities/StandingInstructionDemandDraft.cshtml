@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Standing Instruction Demand Draft";
    Layout = "_ApplicationLayout";

    var cityOptions = ViewData["CityOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var siTransferTypeOptions = ViewData["SITransferTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var chargeRecoveryOptions = ViewData["ChargeRecoveryOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<form id="siDemandDraftForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="window" style="-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none;">
    <!-- Main Container -->
    <main class="main-container main-container--with-panel" aria-label="Standing Instruction Demand Draft form">
      <div class="form-content" role="region" aria-label="Form fields">
        <div class="form-card" data-main-form>

          <!-- Standing Instruction Details Section -->
          <div class="form-section" data-section="si-details">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title"><i class="bi bi-file-earmark-text"></i> Standing Instruction Details</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Standing Instruction Details" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <!-- Row 1: Branch ID | Account ID -->
              <div class="form-row two-col">
                <div class="col">
                  <label id="lbl_branchId" for="txt_branchId">Branch ID</label>
                  <div class="kairo-control" data-kairo-control>
                    <input type="text" id="txt_branchId" name="branchId" class="kairo-control__id" aria-label="Branch ID" readonly>
                    <input type="text" id="txt_branchName" class="kairo-control__name" aria-label="Branch Name" placeholder="Branch Name" readonly>
                    <button type="button" class="btn-lookup kairo-control__lookup" id="btn_searchBranch" data-open-search="branch" aria-label="Search Branch"><i class="bi bi-search"></i></button>
                  </div>
                </div>
                <div class="col">
                  <label class="label-blue" id="lbl_accountId" for="txt_accountId">Account ID <span class="text-danger">*</span></label>
                  <div class="kairo-control" data-kairo-control>
                    <input type="text" id="txt_accountId" name="accountId" class="kairo-control__id" aria-label="Account ID">
                    <input type="text" id="txt_accountName" class="kairo-control__name" aria-label="Account Name" placeholder="Account Name" readonly>
                    <button type="button" class="btn-lookup kairo-control__lookup" data-open-search="account" aria-label="Search Account"><i class="bi bi-search"></i></button>
                  </div>
                </div>
              </div>
              <!-- Row 2: Standing Instruction ID | Reference No -->
              <div class="form-row two-col">
                <div class="col">
                  <label class="label-blue" id="lbl_standingInstructionId" for="txt_standingInstructionId">Standing Instruction ID <span class="text-danger">*</span></label>
                  <div class="kairo-control kairo-control--single" data-kairo-control>
                    <input type="text" id="txt_standingInstructionId" name="standingInstructionId" class="kairo-control__id" aria-label="Standing Instruction ID" readonly>
                    <button type="button" class="btn-lookup kairo-control__lookup" data-open-search="standingInstruction" aria-label="Search Standing Instruction"><i class="bi bi-search"></i></button>
                  </div>
                </div>
                <div class="col">
                  <label id="lbl_referenceNo" for="txt_referenceNo">Reference No.</label>
                  <input type="text" id="txt_referenceNo" name="referenceNo" class="bs-input-text" aria-label="Reference No">
                </div>
              </div>
              <!-- Row 3: SI Transfer Type | Effective Date -->
              <div class="form-row two-col">
                <div class="col">
                  <label class="label-blue" id="lbl_siTransferType" for="ddl_siTransferType">SI Transfer Type <span class="text-danger">*</span></label>
                  <select id="ddl_siTransferType" name="siTransferType" class="bs-select">
                    <option value="">--Select--</option>
                    @foreach (var option in siTransferTypeOptions)
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                  </select>
                </div>
                <div class="col">
                  <label class="label-blue" id="lbl_effectiveDate" for="ddl_effectiveDate">Effective Date <span class="text-danger">*</span></label>
                  <select id="ddl_effectiveDate" name="effectiveDate" class="bs-select">
                    <option value="">--Select--</option>
                  </select>
                </div>
              </div>
              <!-- Row 4: Transfer Currency ID | Amount In -->
              <div class="form-row two-col">
                <div class="col">
                  <label class="label-blue" id="lbl_transferCurrencyId" for="txt_transferCurrencyId">Transfer Currency ID <span class="text-danger">*</span></label>
                  <div class="kairo-control" data-kairo-control>
                    <input type="text" id="txt_transferCurrencyId" name="transferCurrencyId" class="kairo-control__id" aria-label="Transfer Currency ID">
                    <input type="text" id="txt_transferCurrencyName" class="kairo-control__name" aria-label="Currency Name" placeholder="Currency Name" readonly>
                    <button type="button" class="btn-lookup kairo-control__lookup" data-open-search="currency" aria-label="Search Currency"><i class="bi bi-search"></i></button>
                  </div>
                </div>
                <div class="col">
                  <label class="label-blue" id="lbl_amountIn" for="ddl_amountIn">Amount In <span class="text-danger">*</span></label>
                  <select id="ddl_amountIn" name="amountIn" class="bs-select">
                    <option value="TransactionCurrencyID">Transaction CurrencyID</option>
                  </select>
                </div>
              </div>
              <!-- Row 5: Fixed Amount | Beneficiary Name -->
              <div class="form-row two-col">
                <div class="col">
                  <label class="label-blue" id="lbl_fixedAmount" for="txt_fixedAmount">Fixed Amount <span class="text-danger">*</span></label>
                  <input type="text" id="txt_fixedAmount" name="fixedAmount" class="bs-input-text" aria-label="Fixed Amount">
                </div>
                <div class="col">
                  <label class="label-blue" id="lbl_beneficiaryName" for="txt_beneficiaryName">Beneficiary Name <span class="text-danger">*</span></label>
                  <input type="text" id="txt_beneficiaryName" name="beneficiaryName" class="bs-input-text" aria-label="Beneficiary Name">
                </div>
              </div>
              <!-- Row 6: Account Payee | Payee Account ID | Payable At -->
              <div class="form-row three-col">
                <div class="col">
                  <label id="lbl_accountPayee" for="chk_accountPayee">Account Payee</label>
                  <div class="form-check">
                    <input type="checkbox" id="chk_accountPayee" name="accountPayee" class="form-check-input">
                  </div>
                </div>
                <div class="col">
                  <label id="lbl_payeeAccountId" for="txt_payeeAccountId">Payee Account ID</label>
                  <input type="text" id="txt_payeeAccountId" name="payeeAccountId" class="bs-input-text" aria-label="Payee Account ID">
                </div>
                <div class="col">
                  <label class="label-blue" id="lbl_payableAt" for="txt_payableAt">Payable At <span class="text-danger">*</span></label>
                  <input type="text" id="txt_payableAt" name="payableAt" class="bs-input-text" aria-label="Payable At">
                </div>
              </div>
              <!-- Row 7: Transfer Frequency | No Of Execution | Regular Execution Day -->
              <div class="form-row three-col">
                <div class="col">
                  <label class="label-blue" id="lbl_transferFrequency" for="ddl_transferFrequency">Transfer Frequency <span class="text-danger">*</span></label>
                  <select id="ddl_transferFrequency" name="transferFrequency" class="bs-select">
                    <option value="">--Select--</option>
                    <option value="daily">Daily</option>
                    <option value="weekly">Weekly</option>
                    <option value="biweekly">Bi-Weekly</option>
                    <option value="monthly">Monthly</option>
                    <option value="quarterly">Quarterly</option>
                    <option value="halfyearly">Half Yearly</option>
                    <option value="yearly">Yearly</option>
                  </select>
                </div>
                <div class="col">
                  <label id="lbl_noOfExecution" for="txt_noOfExecution">No Of Execution</label>
                  <input type="text" id="txt_noOfExecution" name="noOfExecution" class="bs-input-text" aria-label="No Of Execution">
                </div>
                <div class="col">
                  <label id="lbl_regularExecutionDay" for="txt_regularExecutionDay">Regular Execution Day</label>
                  <input type="text" id="txt_regularExecutionDay" name="regularExecutionDay" class="bs-input-text" aria-label="Regular Execution Day">
                </div>
              </div>
              <!-- Row 8: First Execution Date | Last Execution Date -->
              <div class="form-row two-col">
                <div class="col">
                  <label class="label-blue" id="lbl_firstExecutionDate" for="ddl_firstExecutionDate">First Execution Date <span class="text-danger">*</span></label>
                  <select id="ddl_firstExecutionDate" name="firstExecutionDate" class="bs-select">
                    <option value="">--Select--</option>
                  </select>
                </div>
                <div class="col">
                  <label id="lbl_lastExecutionDate" for="txt_lastExecutionDate">Last Execution Date</label>
                  <input type="text" id="txt_lastExecutionDate" name="lastExecutionDate" class="bs-input-text" aria-label="Last Execution Date" readonly>
                </div>
              </div>
              <!-- Row 9: Charge Recovery | Mailing Address -->
              <div class="form-row two-col">
                <div class="col">
                  <label class="label-blue" id="lbl_chargeRecovery" for="ddl_chargeRecovery">Charge Recovery <span class="text-danger">*</span></label>
                  <select id="ddl_chargeRecovery" name="chargeRecovery" class="bs-select">
                    <option value="">--Select--</option>
                    @foreach (var option in chargeRecoveryOptions)
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                  </select>
                </div>
                <div class="col">
                  <label id="lbl_mailingAddress" for="ddl_mailingAddress">Mailing Address</label>
                  <select id="ddl_mailingAddress" name="mailingAddress" class="bs-select">
                    <option value="ResidentialAddress">Residential Address</option>
                    <option value="OfficeAddress">Office Address</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Address Details Section -->
          <div class="form-section" data-section="address-details">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title"><i class="bi bi-geo-alt"></i> Address Details</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Address Details" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <!-- Row 1: Address 1 | Address 2 | City -->
              <div class="form-row three-col">
                <div class="col">
                  <label id="lbl_address1" for="txt_address1">Address 1</label>
                  <input type="text" id="txt_address1" name="address1" class="bs-input-text" aria-label="Address 1">
                </div>
                <div class="col">
                  <label id="lbl_address2" for="txt_address2">Address 2</label>
                  <input type="text" id="txt_address2" name="address2" class="bs-input-text" aria-label="Address 2">
                </div>
                <div class="col">
                  <label id="lbl_city" for="ddl_city">City</label>
                  <select id="ddl_city" name="city" class="bs-select">
                    <option value="">--Select--</option>
                    @foreach (var option in cityOptions)
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                  </select>
                </div>
              </div>
              <!-- Row 2: Zip Code | Phone | Land Mark -->
              <div class="form-row three-col">
                <div class="col">
                  <label id="lbl_zipCode" for="txt_zipCode">Zip Code</label>
                  <input type="text" id="txt_zipCode" name="zipCode" class="bs-input-text" aria-label="Zip Code">
                </div>
                <div class="col">
                  <label id="lbl_phone" for="txt_phone">Phone</label>
                  <input type="text" id="txt_phone" name="phone" class="bs-input-text" aria-label="Phone">
                </div>
                <div class="col">
                  <label id="lbl_landMark" for="txt_landMark">Land Mark</label>
                  <input type="text" id="txt_landMark" name="landMark" class="bs-input-text" aria-label="Land Mark">
                </div>
              </div>
            </div>
          </div>

          <!-- Behind The Scene Section -->
          <div class="form-section" data-section="behind-the-scene">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title"><i class="bi bi-gear"></i> Behind The Scene</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Behind The Scene" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <div class="audit-section audit-section--summary">
                <div class="audit-cell">
                  <span class="audit-label">Next Execution Date</span>
                  <span class="audit-value" id="spn_nextExecutionDate">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">SI Status</span>
                  <span class="audit-value" id="spn_standingInstructionStatus">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Last Run Date</span>
                  <span class="audit-value" id="spn_lastRunDate">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Last Run Status</span>
                  <span class="audit-value" id="spn_lastRunStatus">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Times Failed</span>
                  <span class="audit-value" id="spn_noOfTimesFailed">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Stopped Reason</span>
                  <span class="audit-value" id="spn_stoppedReason">-</span>
                </div>
              </div>
              <div class="audit-section audit-section--summary">
                <div class="audit-cell">
                  <span class="audit-label">Created By</span>
                  <span class="audit-value" id="spn_auditCreatedBy">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Created On</span>
                  <span class="audit-value" id="spn_auditCreatedOn">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Stopped By</span>
                  <span class="audit-value" id="spn_auditStoppedBy">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Stopped On</span>
                  <span class="audit-value" id="spn_auditStoppedOn">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Supervised By</span>
                  <span class="audit-value" id="spn_auditSupervisedBy">-</span>
                </div>
                <div class="audit-cell">
                  <span class="audit-label">Supervised On</span>
                  <span class="audit-value" id="spn_auditSupervisedOn">-</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Action Panel (right rail) -->
      <aside class="action-panel" aria-label="Form actions">
        <div class="nav-group">
          <button class="btn-nav" id="btn_prevRecord" type="button" data-nav="prev" aria-label="Previous Record" title="Previous Record">
            <i class="bi bi-chevron-left"></i>
          </button>
          <span>Record</span>
          <button class="btn-nav" id="btn_nextRecord" type="button" data-nav="next" aria-label="Next Record" title="Next Record">
            <i class="bi bi-chevron-right"></i>
          </button>
        </div>
        <div class="action-buttons">
          <button class="btn-action" id="btn_stop" type="button" data-action="stop" title="Stop">
            <i class="bi bi-stop-circle me-1"></i>Stop
          </button>
        </div>
        <div class="action-buttons">
          <button class="btn-action" id="btn_view" type="button" data-action="view" title="View">
            <i class="bi bi-eye me-1"></i>View
          </button>
          <button class="btn-action" id="btn_add" type="button" data-action="add" title="Add">
            <i class="bi bi-plus-circle me-1"></i>Add
          </button>
          <button class="btn-action" id="btn_edit" type="button" data-action="edit" title="Edit">
            <i class="bi bi-pencil-square me-1"></i>Edit
          </button>
          <button class="btn-action" id="btn_delete" type="button" data-action="delete" title="Delete">
            <i class="bi bi-trash me-1"></i>Delete
          </button>
          <button class="btn-action" id="btn_save" type="button" data-action="save" title="Save">
            <i class="bi bi-check-lg me-1"></i>Save
          </button>
          <button class="btn-action btn-cancel" id="btn_cancel" type="button" data-action="cancel" title="Cancel">
            <i class="bi bi-x-circle me-1"></i>Cancel
          </button>
        </div>
      </aside>
    </main>

    <!-- Message Panel -->
    <div class="am-message-panel" role="alert" aria-live="polite">
      <i class="bi bi-info-circle"></i>
      <span class="message-text"></span>
    </div>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="dv_loadingOverlay" hidden>
      <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
        <div class="loading-text">Loading...</div>
      </div>
    </div>

    <!-- Status Bar -->
    <footer class="de-status-bar" role="status">Ready</footer>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/modules/accountutilities/standing-instruction-demand-draft.js"></script>
}
