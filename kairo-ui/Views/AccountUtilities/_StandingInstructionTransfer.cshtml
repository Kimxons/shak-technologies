@{
    // ═══════════════════════════════════════════════════════════════════
    // Standing Instruction Transfer — Migrated from legacy HTML
    // Uses ONLY styles.css classes — no custom CSS added
    // ═══════════════════════════════════════════════════════════════════
    ViewData["Title"] = "Standing Instruction Transfer";
    Layout = "_ApplicationLayout";
}

<div class="window">
    <div class="main-container">
        <!-- Form Content -->
        <div class="form-content">
            <div class="form-card" data-main-form>
                <form id="frm_sit" autocomplete="off" novalidate>
                    <!-- Hidden fields for context -->
                    <input type="hidden" id="moduleId_sit" value="@ViewData["ModuleId"]" />
                    <input type="hidden" id="entityId_sit" value="@ViewData["EntityId"]" />
                    <input type="hidden" id="sessionBranchCode_sit" value="@ViewData["BranchCode"]" />
                    <input type="hidden" id="sessionBranchName_sit" value="@ViewData["BranchName"]" />
                    <input type="hidden" id="sessionOperatorId_sit" value="@ViewData["OperatorId"]" />

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SECTION: Account Details                                -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="form-section" data-section="account-details">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-person-vcard"></i> Account Details</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Account Details" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_branchId">Branch</label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input id="txt_branchId" name="BranchID" type="text" class="kairo-control__id" readonly data-always-readonly />
                                        <input id="txt_branchName" type="text" class="kairo-control__name" readonly data-always-readonly />
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="txt_accountId">Account ID <span class="text-danger">*</span></label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input id="txt_accountId" name="AccountID" type="text" class="kairo-control__id" placeholder="ID" />
                                        <input id="txt_accountName" type="text" class="kairo-control__name" placeholder="Account Name" readonly />
                                        <button type="button" class="btn-lookup kairo-control__lookup" data-lookup="AccountID" aria-label="Search Account">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SECTION: Standing Instruction Details                   -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="form-section" data-section="si-details">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-arrow-left-right"></i> Standing Instruction Details</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle SI Details" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_standingInstructionId">Standing Instruction ID <span class="text-danger">*</span></label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input id="txt_standingInstructionId" name="StandingInstructionID" type="text" class="kairo-control__id" placeholder="ID" />
                                        <input id="txt_standingInstructionName" type="text" class="kairo-control__name" placeholder="Name" readonly />
                                        <button type="button" class="btn-lookup kairo-control__lookup" data-lookup="StandingInstructionID" aria-label="Search SI">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="txt_referenceNo">Reference No.</label>
                                    <input id="txt_referenceNo" name="ReferenceNo" type="text" class="bs-input-text" maxlength="50" />
                                </div>
                            </div>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="ddl_siType">SI Type <span class="text-danger">*</span></label>
                                    <select id="ddl_siType" name="SIType" class="bs-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="txt_effectiveDate">Effective Date <span class="text-danger">*</span></label>
                                    <input id="txt_effectiveDate" name="EffectiveDate" type="date" class="bs-input-text" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SECTION: Transfer Details                               -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="form-section" data-section="transfer-details">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-cash-coin"></i> Transfer Details</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Transfer Details" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_transferCurrencyId">Transfer Currency ID <span class="text-danger">*</span></label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input id="txt_transferCurrencyId" name="TransferCurrencyID" type="text" class="kairo-control__id" placeholder="ID" />
                                        <input id="txt_transferCurrencyName" type="text" class="kairo-control__name" placeholder="Currency Name" readonly />
                                        <button type="button" class="btn-lookup kairo-control__lookup" data-lookup="TransferCurrencyID" aria-label="Search Currency">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="ddl_amountIn">Amount In</label>
                                    <select id="ddl_amountIn" name="AmountIn" class="bs-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_fixedAmount">Fixed Amount <span class="text-danger">*</span></label>
                                    <input id="txt_fixedAmount" name="FixedAmount" type="text" class="bs-input-text" />
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="ddl_chargeRecovery">Charge Recovery</label>
                                    <select id="ddl_chargeRecovery" name="ChargeRecovery" class="bs-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SECTION: Frequency & Execution                          -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="form-section" data-section="frequency-execution">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-calendar-event"></i> Frequency & Execution</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Frequency" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="ddl_transferFrequency">Transfer Frequency</label>
                                    <select id="ddl_transferFrequency" name="TransferFrequency" class="bs-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="txt_noOfExecution">No Of Executions</label>
                                    <input id="txt_noOfExecution" name="NoOfExecution" type="text" class="bs-input-text" />
                                </div>
                            </div>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_regularExecutionDay">Regular Execution Day</label>
                                    <input id="txt_regularExecutionDay" name="RegularExecutionDay" type="text" class="bs-input-text" />
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="txt_firstExecutionDate">First Execution Date</label>
                                    <input id="txt_firstExecutionDate" name="FirstExecutionDate" type="date" class="bs-input-text" />
                                </div>
                            </div>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_lastExecutionDate">Last Execution Date</label>
                                    <input id="txt_lastExecutionDate" type="text" class="bs-input-text" readonly data-always-readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SECTION: Beneficiary Account Details                    -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="form-section" data-section="beneficiary-details">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-piggy-bank"></i> Beneficiary Account Details</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Beneficiary Details" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_beneficiaryBranchId">Beneficiary Branch <span class="text-danger">*</span></label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input id="txt_beneficiaryBranchId" name="BeneficiaryBranchID" type="text" class="kairo-control__id" placeholder="ID" />
                                        <input id="txt_beneficiaryBranchName" type="text" class="kairo-control__name" placeholder="Branch Name" readonly />
                                        <button type="button" class="btn-lookup kairo-control__lookup" data-lookup="BeneficiaryBranchID" aria-label="Search Branch">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="label-blue" for="ddl_beneficiaryAccountType">Account Type</label>
                                    <select id="ddl_beneficiaryAccountType" name="BeneficiaryAccountType" class="bs-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue" for="txt_beneficiaryAccountId">Beneficiary Account ID <span class="text-danger">*</span></label>
                                    <div class="kairo-control" data-kairo-control>
                                        <input id="txt_beneficiaryAccountId" name="BeneficiaryAccountID" type="text" class="kairo-control__id" placeholder="ID" />
                                        <input id="txt_beneficiaryAccountName" type="text" class="kairo-control__name" placeholder="Account Name" readonly />
                                        <button type="button" class="btn-lookup kairo-control__lookup" data-lookup="BeneficiaryAccountID" aria-label="Search Account">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SECTION: Behind The Scene                               -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="form-section" data-section="behind-scene">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-gear"></i> Behind The Scene</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind The Scene" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue">Next Execution Date</label>
                                    <input id="txt_nextExecutionDate" type="text" class="bs-input-text" readonly data-always-readonly />
                                </div>
                                <div class="col">
                                    <label class="label-blue">Standing Instruction Status</label>
                                    <input id="txt_siStatus" type="text" class="bs-input-text" readonly data-always-readonly />
                                </div>
                            </div>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue">Last Run Date</label>
                                    <input id="txt_lastRunDate" type="text" class="bs-input-text" readonly data-always-readonly />
                                </div>
                                <div class="col">
                                    <label class="label-blue">Last Run Status</label>
                                    <input id="txt_lastRunStatus" type="text" class="bs-input-text" readonly data-always-readonly />
                                </div>
                            </div>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue">No Of Times Failed</label>
                                    <input id="txt_noOfTimesFailed" type="text" class="bs-input-text" readonly data-always-readonly />
                                </div>
                                <div class="col">
                                    <label class="label-blue">Stopped Reason</label>
                                    <input id="txt_stoppedReason" type="text" class="bs-input-text" readonly data-always-readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- AUDIT TRAIL (3×2 grid)                                  -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="form-section" data-section="audit-trail">
                        <div class="section-content" data-section-content>
                            <div class="form-row three-col">
                                <div class="col">
                                    <label class="label-blue">Created By</label>
                                    <input id="audit_createdBy" type="text" class="bs-input-text" readonly data-always-readonly value="-" />
                                </div>
                                <div class="col">
                                    <label class="label-blue">Stopped By</label>
                                    <input id="audit_stoppedBy" type="text" class="bs-input-text" readonly data-always-readonly value="-" />
                                </div>
                                <div class="col">
                                    <label class="label-blue">Supervised By</label>
                                    <input id="audit_supervisedBy" type="text" class="bs-input-text" readonly data-always-readonly value="-" />
                                </div>
                            </div>
                            <div class="form-row three-col">
                                <div class="col">
                                    <label class="label-blue">Created On</label>
                                    <input id="audit_createdOn" type="text" class="bs-input-text" readonly data-always-readonly value="-" />
                                </div>
                                <div class="col">
                                    <label class="label-blue">Stopped On</label>
                                    <input id="audit_stoppedOn" type="text" class="bs-input-text" readonly data-always-readonly value="-" />
                                </div>
                                <div class="col">
                                    <label class="label-blue">Supervised On</label>
                                    <input id="audit_supervisedOn" type="text" class="bs-input-text" readonly data-always-readonly value="-" />
                                </div>
                            </div>
                            <div class="form-row three-col">
                                <div class="col">
                                    <label class="label-blue">Modified By</label>
                                    <input id="audit_modifiedBy" type="text" class="bs-input-text" readonly data-always-readonly value="-" />
                                </div>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
        </div>

        <!-- Right Action Panel -->
        <div class="action-panel">
            <div class="nav-group">
                <button class="btn-nav green" type="button" data-action="series-prev" aria-label="Previous Series"><i class="bi bi-chevron-left"></i></button>
                <span>Series</span>
                <button class="btn-nav green" type="button" data-action="series-next" aria-label="Next Series"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="nav-group">
                <button class="btn-nav green" type="button" data-action="ref-prev" aria-label="Previous Reference"><i class="bi bi-chevron-left"></i></button>
                <span>Reference No.</span>
                <button class="btn-nav green" type="button" data-action="ref-next" aria-label="Next Reference"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="action-buttons">
                <button class="btn-action" type="button" data-action="stop"><i class="bi bi-stop-circle me-1"></i>Stop</button>
                <button class="btn-action" type="button" data-action="print"><i class="bi bi-printer me-1"></i>Print</button>
                <button class="btn-action btn-view" type="button" data-action="view"><i class="bi bi-eye me-1"></i>View</button>
                <button class="btn-action" type="button" data-action="add"><i class="bi bi-plus-circle me-1"></i>Add</button>
                <button class="btn-action" type="button" data-action="edit"><i class="bi bi-pencil-square me-1"></i>Edit</button>
                <button class="btn-action" type="button" data-action="delete"><i class="bi bi-trash me-1"></i>Delete</button>
                <button class="btn-action btn-save" type="button" data-action="save"><i class="bi bi-check-lg me-1"></i>Save</button>
                <button class="btn-action btn-cancel" type="button" data-action="cancel"><i class="bi bi-x-circle me-1"></i>Cancel</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modules/accountutilities/standing-instruction-transfer.js"></script>
}
