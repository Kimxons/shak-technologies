@{
    ViewData["Title"] = "Branch User Code";
    Layout = "_ApplicationLayout";
}

@section Styles {
    <style>
                #branchUserCodeModule {
                    padding: 10px;
                }

                #branchUserCodeModule .bruc-layout {
                    display: grid;
                    grid-template-columns: minmax(0, 1fr) 140px;
                    gap: 12px;
                    align-items: start;
                }

                #branchUserCodeModule .bruc-panel {
                    border: 1px solid var(--bs-border-color);
                    background: var(--bs-body-bg);
                }

                #branchUserCodeModule .bruc-panel-header {
                    background: var(--bs-primary);
                    color: var(--bs-white);
                    padding: 6px 10px;
                    font-weight: 600;
                    font-size: 13px;
                }

                #branchUserCodeModule .bruc-panel-body {
                    padding: 10px;
                    background: var(--bs-light-bg-subtle);
                }

                #branchUserCodeModule .bruc-grid {
                    border-top: 1px solid var(--bs-border-color);
                    background: var(--bs-body-bg);
                    max-height: 420px;
                    overflow: auto;
                }

                #branchUserCodeModule #subCodesTable {
                    margin-bottom: 0;
                    font-size: 12px;
                }

                #branchUserCodeModule #subCodesTable thead th {
                    position: sticky;
                    top: 0;
                    z-index: 1;
                }

                #branchUserCodeModule .bruc-actions {
                    border: 1px solid var(--bs-border-color);
                    background: var(--bs-body-bg);
                    padding: 10px;
                    position: sticky;
                    top: 12px;
                }

                #branchUserCodeModule .bruc-actions .btn {
                    width: 100%;
                }

                #branchUserCodeModule .kairo-toast-container {
                    position: fixed;
                    right: 18px;
                    top: 18px;
                    z-index: 1080;
                    display: grid;
                    gap: 10px;
                }

                #branchUserCodeModule .kairo-toast {
                    min-width: 280px;
                    max-width: 380px;
                    padding: 12px 14px;
                    border: 1px solid var(--bs-border-color);
                    background: var(--bs-body-bg);
                    opacity: 0;
                    transform: translateY(-8px);
                    transition: opacity 0.16s ease, transform 0.16s ease;
                }

                #branchUserCodeModule .kairo-toast.is-show {
                    opacity: 1;
                    transform: translateY(0);
                }

                #branchUserCodeModule .kairo-toast--success {
                    border-left: 4px solid var(--bs-success);
                }

                #branchUserCodeModule .kairo-toast--danger {
                    border-left: 4px solid var(--bs-danger);
                }

                #branchUserCodeModule .kairo-toast--warning {
                    border-left: 4px solid var(--bs-warning);
                }

                #branchUserCodeModule .kairo-toast--info {
                    border-left: 4px solid var(--bs-primary);
                }

                @@media (max-width: 991.98px) {
                    #branchUserCodeModule .bruc-layout {
                        grid-template-columns: 1fr;
                    }

                    #branchUserCodeModule .bruc-actions {
                        position: static;
                    }
                }
    </style>
}

<div id="branchUserCodeModule">
    <form id="branch-user-code-form" autocomplete="off" novalidate>
        <div class="bruc-layout">
            <section aria-label="Branch User Code Content">
                <div class="bruc-panel mb-2">
                    <div class="bruc-panel-header">Branch User Code</div>
                    <div class="bruc-panel-body">
                        <div class="row g-2 align-items-center mb-2">
                            <label for="CodeID" class="col-auto col-form-label col-form-label-sm fw-semibold">ID</label>
                            <div class="col-12 col-md-3">
                                <input type="text" id="CodeID" name="CodeID" class="form-control form-control-sm"
                                       data-always-enabled />
                            </div>
                            <div class="col-12 col-md">
                                <input type="text" id="CodeName" name="CodeName" class="form-control form-control-sm"
                                       placeholder="" readonly />
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Search"
                                        data-always-enabled data-bruc-action="search">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row g-2 align-items-center mb-2">
                            <label for="SubCode" class="col-auto col-form-label col-form-label-sm fw-semibold">Sub
                                Code</label>
                                <div class="col">
                                    <input type="text" id="SubCode" name="SubCode" class="form-control form-control-sm" />
                                </div>
                            </div>

                            <div class="row g-2 align-items-center">
                                <label for="Description"
                                       class="col-auto col-form-label col-form-label-sm fw-semibold">Description</label>
                                <div class="col">
                                    <input type="text" id="Description" name="Description"
                                           class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-2 mb-2 flex-wrap" aria-label="Sub Code Actions">
                        <button type="button" class="btn btn-light btn-sm" data-bruc-grid-action="new" disabled>New</button>
                        <button type="button" class="btn btn-light btn-sm" data-bruc-grid-action="alter"
                                disabled>Alter</button>
                        <button type="button" class="btn btn-light btn-sm" data-bruc-grid-action="remove"
                                disabled>Remove</button>
                        <button type="button" class="btn btn-light btn-sm" data-bruc-grid-action="update"
                                disabled>Update</button>
                        <button type="button" class="btn btn-light btn-sm" data-bruc-grid-action="clear"
                                disabled>Clear</button>
                    </div>

                    <div class="bruc-panel mb-2">
                        <div class="bruc-grid">
                            <table id="subCodesTable" class="table table-sm table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-nowrap" style="width: 160px;">Sub Code ID</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-4">No records to display.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="bruc-panel">
                        <div class="bruc-panel-header">Behind The Scene</div>
                        <div class="bruc-panel-body">
                            <div class="row g-3">
                                <div class="col-12 col-lg-6">
                                    <div class="row g-2 align-items-center mb-2">
                                        <label for="CreatedBy"
                                               class="col-4 col-form-label col-form-label-sm fw-semibold">Created By</label>
                                        <div class="col-8">
                                            <input type="text" id="CreatedBy" class="form-control form-control-sm" readonly
                                                   tabindex="-1" />
                                        </div>
                                    </div>
                                    <div class="row g-2 align-items-center">
                                        <label for="CreatedOn"
                                               class="col-4 col-form-label col-form-label-sm fw-semibold">Created On</label>
                                        <div class="col-8">
                                            <input type="text" id="CreatedOn" class="form-control form-control-sm" readonly
                                                   tabindex="-1" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <div class="row g-2 align-items-center mb-2">
                                        <label for="SupervisedBy"
                                               class="col-4 col-form-label col-form-label-sm fw-semibold">Supervised By</label>
                                        <div class="col-8">
                                            <input type="text" id="SupervisedBy" class="form-control form-control-sm"
                                                   readonly tabindex="-1" />
                                        </div>
                                    </div>
                                    <div class="row g-2 align-items-center">
                                        <label for="SupervisedOn"
                                               class="col-4 col-form-label col-form-label-sm fw-semibold">Supervised On</label>
                                        <div class="col-8">
                                            <input type="text" id="SupervisedOn" class="form-control form-control-sm"
                                                   readonly tabindex="-1" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <aside class="bruc-actions" aria-label="Actions">
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-light btn-sm" data-bruc-action="view">View</button>
                        <button type="button" class="btn btn-light btn-sm" data-bruc-action="add">Add</button>
                        <button type="button" class="btn btn-light btn-sm" data-bruc-action="edit">Edit</button>
                        <button type="button" class="btn btn-light btn-sm" data-bruc-action="save" disabled>Save</button>
                        <button type="button" class="btn btn-light btn-sm" data-bruc-action="cancel"
                                disabled>Cancel</button>
                    </div>
                </aside>
            </div>
        </form>

    @section Scripts {
        <script src="~/js/modules/staticdata/branch-user-code.js" asp-append-version="true"></script>
    }