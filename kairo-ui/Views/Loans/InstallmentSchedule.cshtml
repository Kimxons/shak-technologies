@{
    ViewData["Title"] = "Installment Schedule";
    Layout = "_ApplicationLayout";
}

<div data-page="installment-schedule">
  <!-- Page Loading Overlay -->
  <div id="pageLoadingOverlay" class="page-loading-overlay" hidden>
    <div class="page-loading-spinner">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
      <div id="pageLoadingText" class="page-loading-text">Loading installment schedule...</div>
    </div>
  </div>

  <div class="window">
    <div class="main-container">
      
      <!-- Form Content -->
      <div class="form-content">
        <div class="form-card" data-main-form>
          
          <!-- Installment Schedule Table Section -->
          <div class="form-section" data-section="installment-schedule">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title">
                <i class="bi bi-calendar-event"></i> Installment Schedule
              </span>
              <span class="de-record-count" id="recordCount">(0 records)</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Installment Schedule" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content style="overflow-x: auto;">
              <table class="table table-sm table-hover align-middle mb-0" id="installmentScheduleTable">
                <thead class="table-light">
                  <tr>
                    <th scope="col">Installment No</th>
                    <th scope="col">Due Date</th>
                    <th scope="col" class="text-end">Loan Balance</th>
                    <th scope="col" class="text-end">Principal Balance</th>
                    <th scope="col" class="text-end">Installment Amount</th>
                    <th scope="col" class="text-end">Principal Due</th>
                    <th scope="col" class="text-center">Interest Rate</th>
                    <th scope="col" class="text-end">Interest Due</th>
                    <th scope="col" class="text-end">Expected Interest</th>
                    <th scope="col" class="text-end">Tax</th>
                    <th scope="col" class="text-end">Others</th>
                    <th scope="col" class="text-center">Paid Status</th>
                  </tr>
                </thead>
                <tbody id="installmentScheduleBody">
                  <tr>
                    <td colspan="12" class="text-center text-muted py-3">No records to display.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>

      <!-- Action Panel -->
      <aside class="action-panel" aria-label="Actions">
        <div class="action-buttons">
          <button type="button" class="btn-action btn-view" data-action="view" aria-label="View details"><i class="bi bi-eye me-1"></i>View</button>
          <button type="button" class="btn-action" data-action="print" aria-label="Print schedule"><i class="bi bi-printer me-1"></i>Print</button>
          <button type="button" class="btn-action" data-action="refresh" aria-label="Refresh data"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
          <button type="button" class="btn-action btn-cancel" data-action="close" aria-label="Close"><i class="bi bi-x-circle me-1"></i>Close</button>
        </div>
      </aside>

    </div>
  </div>

  <!-- Hidden fields for context -->
  <input type="hidden" id="moduleId_installmentSchedule" value="@ViewData["ModuleId"]" />
  <input type="hidden" id="entityId_installmentSchedule" value="@ViewData["EntityId"]" />
  <input type="hidden" id="requestId_installmentSchedule" value="@ViewData["RequestId"]" />

</div>

@section Scripts {
  <script src="~/js/modules/loans/installment-schedule.js" asp-append-version="true"></script>
}
