                    <!-- Generated by C#-->
                    @foreach (var mainmodule in Model.StartMenu.MainModules)
                    {
                        var submenuJson = JsonSerializer.Serialize(Model.StartMenu.MenuItems.Where(m => m.ParentMenuModuleID is null && m.MainModuleID == mainmodule.MainModuleID).Select(mm => new
                        {
                            mm.MainModuleID,
                            mm.MenuDescription,
                            mm.MenuURL,
                            mm.ModuleIcon,
                            mm.ModuleID,
                            MainModuleDescription = mainmodule.Description
                        }));
                        <div class="module-card" data-module-id="@mainmodule.MainModuleID" onclick='javascript:return showSubmenu(@Html.Raw(submenuJson))'>
