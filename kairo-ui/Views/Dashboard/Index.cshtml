    <style>
        /* Demo Branch: Eliminate ghost sidebar and anchor group to bottom */
        .legacy-shell.nav-visible .legacy-workspace {
            margin-left: 0 !important;
        }

        [data-nav-panel] {
            background: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border: none !important;
            box-shadow: none !important;
            display: flex !important;
            flex-direction: column !important;
            justify-content: flex-end !important;
            height: 100vh !important;
            width: 0 !important;
            overflow: visible !important;
            pointer-events: none !important;
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            z-index: 1000 !important;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

            [data-nav-panel].is-visible {
                opacity: 1 !important;
                pointer-events: none !important;
                /* Keep none so top area doesn't block */
            }

        .nav-header {
            display: none !important;
        }

        .legacy-nav__layout {
            pointer-events: auto !important;
            display: flex !important;
            flex-direction: row !important;
            align-items: flex-end !important;
            justify-content: flex-start !important;
            padding: 0 0 18px 25px !important;
            /* Reduced bottom clearance to sit near Start button */
            gap: 25px !important;
            background: transparent !important;
            width: 850px !important;
        }

        .nav-tree {
            flex: 0 0 auto !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
            /* Clip hover effects to block shape */
            /* Block Styling - Unified */
            background: linear-gradient(145deg, rgba(15, 64, 131, 0.12), rgba(255, 255, 255, 0.95)) !important;
            backdrop-filter: blur(25px) saturate(200%) !important;
            -webkit-backdrop-filter: blur(25px) saturate(200%) !important;
            border: 1.5px solid rgba(15, 64, 131, 0.3) !important;
            min-width: 240px !important;
            max-height: calc(100vh - 140px) !important;
            /* Extend closer to bottom while staying safe */
            overflow-y: auto !important;
            overflow-x: hidden !important;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15), 0 10px 20px rgba(15, 64, 131, 0.08), inset 0 1px 1px rgba(255, 255, 255, 0.8) !important;
            scrollbar-width: thin !important;
            scrollbar-color: rgba(15, 64, 131, 0.2) transparent !important;
        }

            .nav-tree::-webkit-scrollbar {
                width: 4px !important;
            }

            .nav-tree::-webkit-scrollbar-thumb {
                background: rgba(15, 64, 131, 0.2) !important;
                border-radius: 10px !important;
            }

        .nav-item {
            font-weight: 800 !important;
            padding: 14px 24px !important;
            font-size: 14px !important;
            background: transparent !important;
            border: none !important;
            color: #0c3d6d !important;
            transition: all 0.3s ease !important;
            display: flex !important;
            align-items: center !important;
            justify-content: flex-start !important;
            gap: 12px !important;
            width: 100% !important;
            text-align: left !important;
            position: relative !important;
        }

            /* Internal Dividers */
            .nav-item:not(:first-child) {
                border-top: 1px solid rgba(15, 64, 131, 0.1) !important;
            }

            .nav-item i {
                font-size: 18px !important;
                color: #1a6fb3 !important;
                width: 24px !important;
                text-align: center !important;
            }

            .nav-item:hover,
            .nav-item.is-highlight {
                background: rgba(255, 255, 255, 0.7) !important;
                color: #084080 !important;
            }

                .nav-item.is-highlight::after {
                    content: '' !important;
                    position: absolute !important;
                    left: 0 !important;
                    top: 10% !important;
                    bottom: 10% !important;
                    width: 4px !important;
                    background: #4a90e2 !important;
                    border-radius: 0 4px 4px 0 !important;
                }

                .nav-item.is-highlight i {
                    color: #084080 !important;
                    transform: scale(1.1);
                }

        .nav-sub-panel {
            opacity: 0 !important;
            visibility: hidden !important;
            transform: translateX(-15px) !important;
            transition: all 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
            height: auto !important;
            max-height: 55vh !important;
            min-width: 380px !important;
            border-radius: 24px !important;
            box-shadow: 0 50px 100px rgba(0, 0, 0, 0.15) !important;
            background: rgba(255, 255, 255, 0.995) !important;
            border: 1px solid rgba(15, 64, 131, 0.2) !important;
            padding: 1.75rem !important;
            margin-left: 10px !important;
        }

            .legacy-nav__layout:hover .nav-sub-panel,
            .nav-sub-panel:hover {
                opacity: 1 !important;
                visibility: visible !important;
                transform: translateX(0) !important;
            }

        .nav-sub-list {
            display: flex !important;
            flex-direction: column !important;
            gap: 12px !important;
        }
    </style>
</head>

