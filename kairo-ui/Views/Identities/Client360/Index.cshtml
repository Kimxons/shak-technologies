                            <button type="button" class="section-toggle-btn" aria-label="Toggle Loans" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row"><div class="col"><div id="loansContent"></div></div></div>
                        </div>
                    </div>

                    <div class="form-section" id="blockedDetailsSection" data-section="blocked-details" style="display: none;">
