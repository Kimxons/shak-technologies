                        <div class="section-content" data-section-content>
                            <div class="form-row">
                                <div class="col">
                                    <label>Main Products</label>
                                    <div id="accountsContainer" class="client360-products" aria-label="Main Products"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section" id="otherAccountsSection" data-section="other-accounts" style="display: none;">
