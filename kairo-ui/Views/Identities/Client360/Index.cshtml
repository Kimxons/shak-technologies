@{
    ViewData["Title"] = "Client 360 View";
    Layout = "";
}
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Client 360 View</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <style>
        /* Ensure overlay can be positioned relative to the Client 360 window */
        .main-container {
            position: relative;
        }

        /* In-page overlay for statements (like Account Maintenance submodules) */
        .client360-overlay {
            position: absolute;
            top: 0;
            bottom: 0;
            left: var(--client360-overlay-left, 260px);
            right: 0;
            z-index: 5000;
        }

        .client360-overlay[hidden] {
            display: none !important;
        }

        .client360-overlay__backdrop {
            position: absolute;
            inset: 0;
            background: rgba(15, 23, 42, 0.10);
            backdrop-filter: blur(2px);
        }

        .client360-overlay__panel {
            position: absolute;
            inset: 10px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .client360-overlay__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            background: linear-gradient(120deg, #1b6ca8, #2b81c4);
            color: #ffffff;
        }

        .client360-overlay__title {
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.2px;
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

        .client360-overlay__title-text {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .client360-overlay__actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex: 0 0 auto;
        }

        .client360-overlay__icon-btn {
            width: 34px;
            height: 30px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.35);
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .client360-overlay__icon-btn:hover {
            background: rgba(255, 255, 255, 0.18);
        }

        .client360-overlay__body {
            position: relative;
            flex: 1 1 auto;
            background: #ffffff;
        }

        .client360-overlay__iframe {
            width: 100%;
            height: 100%;
            border: 0;
            display: block;
            background: #ffffff;
        }

        .client360-overlay__loading {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.75);
            z-index: 1;
        }

        .client360-overlay__loading[hidden] {
            display: none !important;
        }

        /* Search Section */
        .search-section-header {
            background: linear-gradient(135deg, #4a7a8c 0%, #2d5a6a 100%);
            color: white;
            padding: 12px 20px;
            border-radius: 6px 6px 0 0;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
        }

        .search-section-content {
            background: white;
            padding: 20px;
            border-radius: 0 0 6px 6px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-label {
            font-weight: 600;
            color: #1e3c72;
            font-size: 13px;
            margin-bottom: 6px;
        }

        .form-control {
            padding: 8px 12px;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            font-size: 14px;
            height: 36px;
        }

        .form-control:focus {
            border-color: #0c63e4;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        /* Details Section */
        .details-section {
            background: white;
            border-radius: 6px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            margin-top: 20px;
            overflow: hidden;
        }

        .details-header {
            background: linear-gradient(135deg, #4a7a8c 0%, #2d5a6a 100%);
            color: white;
            padding: 12px 20px;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
        }

        .details-content {
            padding: 20px;
        }

        .detail-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 15px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
        }

        .detail-label {
            font-weight: 600;
            color: #1e3c72;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .detail-value {
            padding: 8px 12px;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            min-height: 36px;
            display: flex;
            align-items: center;
            font-size: 14px;
        }

        .detail-remarks {
            padding: 8px 12px;
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            min-height: 80px;
            font-size: 14px;
            resize: none;
            font-family: inherit;
        }

        /* Accounts Section */
        .accounts-section {
            background: white;
            border-radius: 6px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            margin-top: 20px;
            overflow: hidden;
        }

        .accounts-header {
            background: linear-gradient(135deg, #4a7a8c 0%, #2d5a6a 100%);
            color: white;
            padding: 12px 20px;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .account-item {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            border-bottom: 1px solid #e9ecef;
            background: #f8f9fa;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .account-item:hover {
            background: #e9ecef;
        }

        .account-item:last-child {
            border-bottom: none;
        }

        .account-item-icon {
            font-size: 18px;
            margin-right: 12px;
            color: #4a7a8c;
            font-weight: bold;
            min-width: 20px;
        }

        .account-item-info {
            flex: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .account-item-name {
            font-weight: 500;
            color: #1e3c72;
            font-size: 14px;
        }

        .account-item-balance {
            font-weight: 600;
            color: #2d5a6a;
            font-size: 14px;
            min-width: 120px;
            text-align: right;
        }

        /* Sidebar */
        .sidebar-images {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 20px;
        }

        .image-placeholder {
            width: 100%;
            height: 150px;
            background: #f5f5f5;
            border: 2px solid #dee2e6;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
            font-size: 12px;
            text-align: center;
            flex-direction: column;
        }

        .image-placeholder i {
            font-size: 32px;
            margin-bottom: 5px;
        }

        .sidebar-buttons {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 20px;
        }

        .btn-sidebar {
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .btn-print {
            background: #5cb85c;
            color: white;
        }

        .btn-print:hover {
            background: #449d44;
        }

        .btn-cancel {
            background: #999;
            color: white;
        }

        .btn-cancel:hover {
            background: #777;
        }

        /* Quick Links */
        .quick-links-section {
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 12px;
        }

        .quick-links-title {
            font-weight: 600;
            color: #1e3c72;
            font-size: 12px;
            margin-bottom: 10px;
            text-transform: uppercase;
            padding-bottom: 8px;
            border-bottom: 2px solid #2d5a6a;
        }

        .quick-link-item {
            padding: 8px 10px;
            margin: 5px 0;
            background: #f8f9fa;
            border-left: 3px solid #2d5a6a;
            border-radius: 2px;
            cursor: pointer;
            font-size: 13px;
            color: #0066cc;
            transition: all 0.2s;
        }

        .quick-link-item:hover {
            background: #e3f2fd;
            transform: translateX(3px);
        }

        .quick-link-item i {
            margin-right: 6px;
        }

        /* Header */
        .client-360-header {
            background: #0066cc;
            color: white;
            padding: 15px 20px;
            border-radius: 6px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .client-360-header-info h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

        .client-360-header-info p {
            margin: 5px 0 0 0;
            font-size: 13px;
            opacity: 0.9;
        }

        @@media (max-width: 1200px) {
            .client-360-wrapper {
                flex-direction: column;
            }

            .client-360-sidebar {
                width: 100%;
            }

            .detail-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* Client 360 page-specific (design-system friendly) */
        .client360-products {
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            background: #fff;
            overflow: hidden;
        }

        .client360-products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 12px;
            padding: 12px;
        }

        .client360-product-card {
            border: 1px solid #eef2f7;
            border-radius: 10px;
            background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
            box-shadow: 0 2px 10px rgba(17, 24, 39, 0.06);
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .client360-product-card__header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
        }

        .client360-product-card__title {
            font-size: 13px;
            font-weight: 800;
            color: #0f172a;
            line-height: 1.2;
        }

        .client360-product-card__subtitle {
            font-size: 11px;
            color: #64748b;
            margin-top: 3px;
            font-variant-numeric: tabular-nums;
            word-break: break-all;
        }

        .client360-product-card__badge {
            flex: 0 0 auto;
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 999px;
            background: rgba(26, 82, 118, 0.10);
            color: #1a5276;
            font-weight: 800;
        }

        .client360-product-kv {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 6px 10px;
            font-size: 12px;
        }

        .client360-product-kv__k {
            color: #64748b;
        }

        .client360-product-kv__v {
            color: #0f172a;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .client360-product-actions {
            margin-top: 2px;
        }

        /* Card action buttons: when multiple actions exist, prefer a compact single-row layout */
        .client360-product-actions.d-flex > .btn,
        .client360-product-actions.d-flex > button {
            min-width: 0;
            padding: 6px 10px;
            font-size: 12px;
            line-height: 1.1;
            white-space: nowrap;
        }

        /* Two actions: keep on one row and allow buttons to shrink evenly */
        .client360-product-actions.d-flex.flex-nowrap > .btn,
        .client360-product-actions.d-flex.flex-nowrap > button {
            flex: 1 1 0;
        }

        /* Section header inline totals (visible even when collapsed) */
        .client360-section-summary {
            margin-left: auto;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 14px;
            font-size: 12px;
            font-weight: 700;
            opacity: 0.96;
            flex-wrap: wrap;
        }

        .client360-section-summary__item {
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }

        .client360-section-summary__label {
            opacity: 0.88;
            font-weight: 600;
        }

        /* Match 'View Statement' button to the modal title head blue */
        .client360-statement-btn {
            background: linear-gradient(120deg, #1b6ca8, #2b81c4) !important;
            border: 1px solid rgba(255, 255, 255, 0.35) !important;
            color: #ffffff !important;
            font-weight: 700;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(27, 108, 168, 0.22);
        }

        .client360-statement-btn:hover:not(:disabled) {
            background: linear-gradient(120deg, #195f95, #2677b7) !important;
            box-shadow: 0 6px 14px rgba(27, 108, 168, 0.28);
            transform: translateY(-1px);
        }

        .client360-statement-btn:active:not(:disabled) {
            transform: translateY(0);
            box-shadow: 0 3px 8px rgba(27, 108, 168, 0.22);
        }

        .client360-statement-btn:focus-visible {
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(27, 108, 168, 0.35), 0 4px 10px rgba(27, 108, 168, 0.22);
        }

        /* Signatories button (paired with View Statement) */
        .client360-signatories-btn {
            background: linear-gradient(120deg, #6b4ea3, #7b5cc7) !important;
            border: 1px solid rgba(255, 255, 255, 0.35) !important;
            color: #ffffff !important;
            font-weight: 700;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(107, 78, 163, 0.20);
        }

        .client360-signatories-btn:hover:not(:disabled) {
            background: linear-gradient(120deg, #604595, #7053b8) !important;
            box-shadow: 0 6px 14px rgba(107, 78, 163, 0.26);
            transform: translateY(-1px);
        }

        .client360-signatories-btn:active:not(:disabled) {
            transform: translateY(0);
            box-shadow: 0 3px 8px rgba(107, 78, 163, 0.20);
        }

        .client360-signatories-btn:focus-visible {
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(107, 78, 163, 0.35), 0 4px 10px rgba(107, 78, 163, 0.20);
        }

        .client360-product-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-bottom: 1px solid #eef2f7;
            font-size: 12px;
        }

        .client360-product-row:last-child {
            border-bottom: none;
        }

        .client360-product-icon {
            width: 16px;
            text-align: center;
            color: #1a5276;
            font-weight: 700;
            flex: 0 0 16px;
        }

        .client360-product-name {
            flex: 1;
            min-width: 0;
            color: #111827;
        }

        .client360-product-balance {
            flex: 0 0 120px;
            text-align: right;
            font-variant-numeric: tabular-nums;
            color: #111827;
            font-weight: 700;
        }

        .client360-action-images {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .client360-image-box {
            height: 120px;
            border: 1px dashed rgba(90, 108, 125, 0.55);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 8px;
            overflow: hidden;
        }

        .client360-image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            cursor: zoom-in;
        }

        /* Client 360 image zoom popout */
        .client360-zoom-modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.88);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 6500;
            cursor: pointer; /* click anywhere to close */
        }

        .client360-zoom-modal[hidden] {
            display: none !important;
        }

        .client360-zoom-content {
            max-width: 92vw;
            max-height: 92vh;
            background: #ffffff;
            border-radius: 10px;
            padding: 10px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        }

        .client360-zoom-title {
            font-size: 12px;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 8px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .client360-zoom-img {
            max-width: 90vw;
            max-height: 80vh;
            width: auto;
            height: auto;
            display: block;
            object-fit: contain;
        }

        /* Print header (Client ID/Name) */
        .client360-print-header {
            display: none;
            padding: 6px 0 10px 0;
            margin-bottom: 12px;
            border-bottom: 1px solid #e5e7eb;
        }

        .client360-print-title {
            text-align: center;
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
        }

        .client360-print-meta {
            text-align: center;
            font-size: 12px;
            color: #334155;
            margin: 4px 0 0 0;
        }

        /* Print header images (Photo + Signature) */
        .client360-print-images {
            display: none;
            margin-top: 10px;
            gap: 18px;
            align-items: flex-start;
            justify-content: center;
            page-break-inside: avoid;
        }

        .client360-print-image {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

        .client360-print-image-label {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            color: #64748b;
        }

        .client360-print-image-box {
            width: 120px;
            height: 140px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #f8fafc;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .client360-print-image-box--signature {
            width: 220px;
            height: 90px;
        }

        .client360-print-image-box img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

        .client360-print-image-box--signature img {
            object-fit: contain;
        }

        @@media print {
            .sidebar,
            .action-panel,
            [data-section="client-search"],
            .form-title-bar__actions,
            button,
            .btn,
            a,
            [role="button"],
            .client360-product-actions,
            .client360-statement-btn,
            .client360-signatories-btn {
                display: none !important;
            }

            .client360-print-header {
                display: block !important;
            }

            .client360-print-images {
                display: flex !important;
            }

            .window,
            .main-container,
            .form-content {
                min-height: auto !important;
                height: auto !important;
            }
        }

        /* Force Remarks to a compact 2-row display (override global bs-textarea min-height) */
        #remarks.bs-textarea {
            min-height: 60px !important;
            height: 60px !important;
        }

        /* Client Search: single composite control (no gap)
           Client ID = 25%, (Client Name + button) = 75% of the control width */
        .client360-client-lookup.kairo-client-control {
            display: grid !important;
            grid-template-columns: minmax(0, 25%) minmax(0, calc(75% - 32px)) 32px !important;
            width: 100% !important;
            min-width: 0;
            gap: 0 !important;
            align-items: stretch;
        }

        /* Override global fixed 120px ID width rules inside this specific control */
        .client360-client-lookup.kairo-client-control .kairo-client-control__id,
        .client360-client-lookup.kairo-client-control input:first-of-type {
            width: 100% !important;
            min-width: 0 !important;
            max-width: none !important;
            flex: initial !important;
        }

        .client360-client-lookup.kairo-client-control .kairo-client-control__name {
            width: 100% !important;
            min-width: 0 !important;
        }

        .client360-client-lookup.kairo-client-control .btn-lookup {
            width: 32px !important;
            min-width: 32px !important;
        }
    </style>
</head>

<body>
    <form id="client360Form" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
    <div class="window">
        <div class="main-container">
            <!-- Left Sidebar (Sub Modules / Quick Links area) -->
            <div class="sidebar" id="client360Sidebar">
                <div class="sidebar-header">
                    <span class="sidebar-header__title"><i class="bi bi-grid-3x3-gap-fill"></i>SUBMODULES</span>
                    <button type="button" class="sidebar-toggle" id="client360SidebarToggle" aria-label="Toggle sidebar" aria-expanded="true">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                <div class="sidebar-content">
                    <div class="nav-section nav-section--card" data-nav-section data-section-name="Quick Links">
                        <div class="nav-header nav-header--card" data-tooltip="Quick Links">
                            <div class="nav-header__content">
                                <i class="bi bi-link-45deg nav-header__icon"></i>
                                <span class="nav-label nav-label--card">Quick Links</span>
                            </div>
                            <div class="nav-header__badge">
                                <button type="button" class="nav-arrow nav-arrow--card" aria-label="Toggle Quick Links" aria-expanded="true" aria-controls="nav-quicklinks">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </div>
                        </div>
                        <div class="nav-items nav-items--card" id="nav-quicklinks">
                            <div id="quickLinksContainer" aria-label="Quick Links"></div>
                        </div>
                    </div>

                    <!-- Recent Activities Section (Last 10 Recently Viewed Clients) -->
                    <div class="nav-section nav-section--card" data-nav-section data-section-name="Recent Activities">
                        <div class="nav-header nav-header--card" data-tooltip="Recent Activities">
                            <div class="nav-header__content">
                                <i class="bi bi-clock-history nav-header__icon"></i>
                                <span class="nav-label nav-label--card">Recent Activities</span>
                            </div>
                            <div class="nav-header__badge">
                                <button type="button" class="nav-arrow nav-arrow--card" aria-label="Toggle Recent Activities" aria-expanded="false" aria-controls="nav-client360-recent">
