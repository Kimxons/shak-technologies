                                <span class="client360-section-summary__item"><span class="client360-section-summary__label">Outstanding Loan:</span> <span id="loansOutstandingTotal">0.00</span></span>
                                <span class="client360-section-summary__item"><span class="client360-section-summary__label">Amount Borrowed:</span> <span id="loansAmountBorrowedTotal">0.00</span></span>
