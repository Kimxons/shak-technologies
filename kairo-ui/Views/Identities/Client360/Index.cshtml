                                        <input type="text" id="clientIdSearch" class="kairo-client-control__id" aria-label="Client ID" placeholder="Client ID">
                                        <input type="text" id="clientNameSearch" class="kairo-client-control__name" aria-label="Client Name" placeholder="Client Name" readonly>
                                        <button type="button" class="btn-lookup" id="btnClientSearch" aria-label="Search Client"><i class="bi bi-search"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section" data-section="client-details">
