                                <div class="client360-print-image-box" id="clientPhotoPrint" aria-label="Client Photo (Print)"></div>
                            </div>
                            <div class="client360-print-image">
                                <div class="client360-print-image-label">Signature</div>
                                <div class="client360-print-image-box client360-print-image-box--signature" id="clientSignaturePrint" aria-label="Client Signature (Print)"></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section" data-section="client-search">
