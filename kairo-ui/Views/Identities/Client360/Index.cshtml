                </div>

                <div class="row-divider"></div>
                <div class="action-buttons">
                    <button id="btnPrint" class="btn-action" type="button"><i class="bi bi-printer me-1"></i>Print</button>
                    <button id="btnViewClient" class="btn-action" type="button"><i class="bi bi-eye me-1"></i>View</button>
                    <button id="btnCancel" class="btn-action" type="button"><i class="bi bi-x-circle me-1"></i>Cancel</button>
                </div>
