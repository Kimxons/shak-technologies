                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row four-col">
                                <div class="col">
                                    <label>Client Name</label>
                                    <input type="text" id="clientName" class="bs-input-text" readonly>
                                </div>
                                <div class="col">
                                    <label>Identification Type</label>
                                    <input type="text" id="identificationType" class="bs-input-text" readonly>
                                </div>
                                <div class="col">
                                    <label>Identification Number</label>
                                    <input type="text" id="identificationNumber" class="bs-input-text" readonly>
                                </div>
                                <div class="col">
                                    <label>Phone Number</label>
                                    <input type="text" id="phoneNumber" class="bs-input-text" readonly>
                                </div>
                            </div>

                            <div class="form-row four-col">
                                <div class="col">
                                    <label>Employer</label>
                                    <input type="text" id="employer" class="bs-input-text" readonly>
                                </div>
                                <div class="col">
                                    <label>Client Class</label>
                                    <input type="text" id="memberClass" class="bs-input-text" readonly>
                                </div>
                                <div class="col">
                                    <label>Age</label>
                                    <input type="text" id="age" class="bs-input-text" readonly>
                                </div>
                                <div class="col">
                                    <label>Payroll Number</label>
                                    <input type="text" id="payrollNumber" class="bs-input-text" readonly>
                                </div>
                            </div>

                            <div class="form-row four-col">
                                <div class="col">
                                    <label>Client Status</label>
                                    <input type="text" id="clientStatus" class="bs-input-text" readonly>
                                </div>
                                <div class="col">
                                    <label>Branch</label>
                                    <input type="text" id="branch" class="bs-input-text" readonly>
                                </div>
                                <div class="col">
                                    <label>TAN Status of Account</label>
                                    <input type="text" id="tanStatus" class="bs-input-text" readonly>
                                </div>
                                <div class="col">
                                    <label>Loan Status</label>
                                    <input type="text" id="loanStatus" class="bs-input-text" readonly>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="col">
                                    <label>Remarks</label>
                                    <textarea id="remarks" class="bs-textarea" rows="2" readonly></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section" data-section="accounts-details">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-piggy-bank"></i>Accounts Details</span>
                            <div class="client360-section-summary" id="accountsHeaderSummary" style="display:none;">
                                <span class="client360-section-summary__item"><span class="client360-section-summary__label">Clear Balance:</span> <span id="accountsClearTotal">0.00</span></span>
                                <span class="client360-section-summary__item"><span class="client360-section-summary__label">Available Balance:</span> <span id="accountsAvailableTotal">0.00</span></span>
                                <span class="client360-section-summary__item"><span class="client360-section-summary__label">Lien:</span> <span id="accountsLienTotal">0.00</span></span>
