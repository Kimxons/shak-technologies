            <!-- Statement / Submodule Overlay (opens inside Client 360) -->
            <div id="client360Overlay" class="client360-overlay" hidden aria-hidden="true">
                <div class="client360-overlay__backdrop" data-client360-overlay-close></div>
                <div class="client360-overlay__panel" role="dialog" aria-modal="true" aria-label="Client 360 Overlay">
                    <div class="client360-overlay__header">
                        <div class="client360-overlay__title">
                            <i class="bi bi-window"></i>
                            <span class="client360-overlay__title-text" id="client360OverlayTitle">Statement View</span>
                        </div>
                        <div class="client360-overlay__actions">
                            <button type="button" class="client360-overlay__icon-btn" id="client360OverlayPopout" aria-label="Open in new tab" title="Open in new tab">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </button>
                            <button type="button" class="client360-overlay__icon-btn" id="client360OverlayClose" aria-label="Close" title="Close">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="client360-overlay__body">
                        <div id="client360OverlayLoading" class="client360-overlay__loading" hidden>
