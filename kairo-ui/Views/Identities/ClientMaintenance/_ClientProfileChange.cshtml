@using CBS.Entities.SystemCore
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var titleOptions = ViewData["TitleOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var genderOptions = ViewData["GenderOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var clientTypeOptions = ViewData["ClientTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var changeReasonOptions = ViewData["ChangeReasonOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="form-card" data-section="client-profile-change" data-cm-module="profile-change">
    <div class="section-header" data-section-toggle>
        <span class="section-header__title"><i class="bi bi-person-lines-fill"></i> Client Profile Change</span>
        <button id="btn_toggleClientProfileChange" type="button" class="section-toggle-btn" aria-label="Toggle Profile Change" aria-expanded="true">
            <i class="bi bi-chevron-up"></i>
        </button>
    </div>
    <div class="section-content" data-section-content>
        <form id="frm_clientProfileChange" data-profilechange-form autocomplete="off" novalidate>
            <!-- Hidden fields for page context -->
            <input type="hidden" id="moduleIdProfileChange" value="@ViewData["ModuleId"]" />
            <input type="hidden" id="hdn_profileChangeId" name="profileChangeId" />

            <h5 class="mb-4">Client Information</h5>

            <div class="form-row four-col">
                <div class="col col-span-3">
                    <label class="label-blue" for="txt_clientName" id="lbl_clientName">Client Name</label>
                    <input type="text" id="txt_clientName" name="clientName" data-profilechange-field="ClientName" class="bs-input-text" readonly placeholder="Full Client Name" />
                </div>
                <div class="col">
                    <label class="label-blue" for="ddl_title" id="lbl_title">Title</label>
                    <select id="ddl_title" name="title" data-profilechange-field="TitleID" class="bs-select" asp-items="@titleOptions">
                        <option value="">Select...</option>
                    </select>
                </div>
            </div>

            <div class="form-row four-col">
                <div class="col">
                    <label class="label-blue" for="txt_firstName" id="lbl_firstName">First Name</label>
                    <input type="text" id="txt_firstName" name="firstName" data-profilechange-field="FirstName" class="bs-input-text" placeholder="First Name" />
                </div>
                <div class="col">
                    <label class="label-blue" for="txt_middleName" id="lbl_middleName">Middle Name</label>
                    <input type="text" id="txt_middleName" name="middleName" data-profilechange-field="MiddleName" class="bs-input-text" placeholder="Middle Name" />
                </div>
                <div class="col">
                    <label class="label-blue" for="txt_lastName" id="lbl_lastName">Last Name</label>
                    <input type="text" id="txt_lastName" name="lastName" data-profilechange-field="LastName" class="bs-input-text" placeholder="Last Name" />
                </div>
                <div class="col">
                    <label class="label-blue" for="ddl_gender" id="lbl_gender">Gender</label>
                    <select id="ddl_gender" name="gender" data-profilechange-field="GenderID" class="bs-select" asp-items="@genderOptions">
                        <option value="">Select...</option>
                    </select>
                </div>
            </div>

            <div class="form-row four-col">
                <div class="col">
                    <label class="label-blue" for="txt_dob" id="lbl_dob">Date Of Birth</label>
                    <input type="date" id="txt_dob" name="dob" data-profilechange-field="DateOfBirth" class="bs-input-text" />
                </div>
                <div class="col">
                    <label for="txt_age" id="lbl_age">Age</label>
                    <input type="text" id="txt_age" name="age" data-profilechange-field="Age" class="bs-input-text" readonly placeholder="Calculated Age" style="background: #f1f5f9;" />
                </div>
                <div class="col">
                    <label for="txt_ageAsOn" id="lbl_ageAsOn">Age As On</label>
                    <input type="date" id="txt_ageAsOn" name="ageAsOn" data-profilechange-field="AgeAsOn" class="bs-input-text" />
                </div>
                <div class="col">
                    <label class="label-blue" for="ddl_clientType" id="lbl_clientType">Client Type</label>
                    <select id="ddl_clientType" name="clientType" data-profilechange-field="ClientTypeID" class="bs-select" asp-items="@clientTypeOptions">
                        <option value="">Select...</option>
                    </select>
                </div>
            </div>

            <div class="form-row four-col">
                <div class="col">
                    <label for="txt_documentsReceived" id="lbl_documentsReceived">Documents Received</label>
                    <input type="text" id="txt_documentsReceived" name="documentsReceived" data-profilechange-field="DocumentsReceived" class="bs-input-text" placeholder="List received documents" />
                </div>
                <div class="col">
                    <label for="txt_receivedOn" id="lbl_receivedOn">Received On</label>
                    <input type="date" id="txt_receivedOn" name="receivedOn" data-profilechange-field="ReceivedOn" class="bs-input-text" />
                </div>
                <div class="col">
                    <label class="label-blue" for="ddl_changedReason" id="lbl_changedReason">Changed Reason</label>
                    <select id="ddl_changedReason" name="changedReason" data-profilechange-field="ChangeReasonID" class="bs-select" asp-items="@changeReasonOptions">
                        <option value="">Select...</option>
                    </select>
                </div>
                <div class="col">
                    <label for="txa_remarks" id="lbl_remarks">Remarks</label>
                    <textarea id="txa_remarks" name="remarks" data-profilechange-field="Remarks" class="bs-input-text" rows="1" placeholder="Nature of profile change..."></textarea>
                </div>
            </div>
        </form>

        <div class="d-flex justify-content-center gap-2 my-4">
            <button id="btn_editProfileChange" type="button" class="btn btn-sm btn-outline-primary" data-profilechange-action="edit"><i class="bi bi-pencil-square me-1"></i>Edit</button>
            <button id="btn_saveProfileChange" type="button" class="btn btn-sm btn-primary" data-profilechange-action="save"><i class="bi bi-check2-circle me-1"></i>Save</button>
            <button id="btn_cancelProfileChange" type="button" class="btn btn-sm btn-outline-secondary" data-profilechange-action="cancel">Cancel</button>
        </div>

        <div class="section-header py-1 mb-2 bg-light border">
            <span class="small fw-bold px-2">CHANGE HISTORY</span>
        </div>
        <div class="table-responsive border rounded bg-white mb-4">
            <table class="table table-sm table-hover mb-0" data-table="profile-changes">
                <thead class="table-light">
                    <tr>
                        <th class="ps-2">Changed Date</th>
                        <th>Name</th>
                        <th>Gender</th>
                        <th>DOB Given</th>
                        <th>Date of Birth</th>
                        <th>Age</th>
                        <th>Age As On</th>
                        <th>Created By</th>
                        <th>Supervised By</th>
                    </tr>
                </thead>
                <tbody data-profilechanges-body>
                    <tr>
                        <td colspan="9" class="text-center text-muted py-3">No profile change records</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/js/modules/identities/client-maintenance/client-profile-change.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const moduleRoot = document.querySelector('[data-section="client-profile-change"]');
        const moduleId = document.getElementById('moduleIdProfileChange')?.value;
        const autoLoad = '@ViewData["AutoLoad"]' === 'true';
        const clientId = '@ViewData["ClientId"]';

        if (moduleRoot && typeof window.initClientMaintenanceProfileChange === 'function') {
            window.initClientMaintenanceProfileChange(moduleRoot, moduleId);

            if (autoLoad && clientId) {
                setTimeout(() => {
                    if (moduleRoot._cmLoadData) {
                        moduleRoot._cmLoadData({ ClientID: clientId, ModuleID: moduleId });
                    }
                }, 100);
            }
        }
    });
</script>
