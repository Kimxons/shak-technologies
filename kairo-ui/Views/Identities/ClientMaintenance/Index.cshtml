@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Client Maintenance";
    Layout = "_ApplicationLayout";
    var moduleId = (ViewData["ModuleId"]?.ToString() ?? string.Empty);
    var clientTypeOptions = ViewData["ClientTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var clientGroupOptions = ViewData["ClientGroupOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="window" data-client-maintenance data-module-id="@moduleId">

    <div class="main-container">
        <!-- Left Sidebar (loaded via AJAX) -->
        <div id="sidebarContainer"></div>

        <!-- Main Form Content -->
        <div class="form-content">
            <!-- Inline Child Form (hidden by default) -->
            <div class="child-inline" data-child-inline hidden>
                <iframe class="child-iframe-inline" data-child-iframe title="DataEntry Submodule"></iframe>
            </div>

            <div class="form-card" data-main-form>
                <div class="section-header">
                    <span class="section-header__title"><i class="bi bi-person-vcard me-1"></i>Client Maintenance Workflow</span>
                </div>

                <div class="section-content">
                    <div class="form-row two-col mb-3" data-cm-main-search>
                        <div class="col">
                            <label class="label-blue" for="txt_mainClientId">Client ID</label>
                            <div class="kairo-client-control" data-kairo-client-control>
                                <input type="text" id="txt_mainClientId" placeholder="e.g. CSK00092" />
                                <input type="text" id="txt_mainClientName" placeholder="Client Name" readonly />
                                <button type="button" class="btn-lookup" data-main-client-search aria-label="Search client">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <label class="label-blue" for="ddl_mainClientType">Client Type</label>
                            <select id="ddl_mainClientType" name="ClientTypeID" class="bs-select" asp-items="@(clientTypeOptions.Skip(1))">
                                <option value="">Select type</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row two-col mb-3">
                        <div class="col">
                            <label class="label-blue" for="txt_mainApplicationId">Application ID</label>
                            <div class="kairo-control" data-kairo-control>
                                <input type="text" id="txt_mainApplicationId" placeholder="Workflow Request ID" />
                                <input type="text" id="txt_mainApplicationName" placeholder="Application Description" readonly />
                                <button type="button" class="btn-lookup" data-main-application-search aria-label="Search application">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <label for="ddl_mainClientGroup">Client Group</label>
                            <select id="ddl_mainClientGroup" name="ClientGroupID" class="bs-select" asp-items="@(clientGroupOptions.Skip(1))">
                                <option value="">Select group</option>
                            </select>
                        </div>
                    </div>

                    <!-- Horizontal Scrolling Tabs Container -->
                    <div class="cm-tabs-wrapper">
                        <button type="button" class="cm-tabs-scroll-btn cm-tabs-scroll-left" id="btn_tabsScrollLeft" aria-label="Scroll tabs left" disabled>
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <div class="cm-tabs-container">
                            <ul class="nav nav-tabs" id="nav_clientMaintenanceTabs" role="tablist"></ul>
                        </div>
                        <button type="button" class="cm-tabs-scroll-btn cm-tabs-scroll-right" id="btn_tabsScrollRight" aria-label="Scroll tabs right" disabled>
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>

                    <!-- Tab Content with Vertical Scroll -->
                    <div class="tab-content-wrapper">
                        <div class="tab-content border rounded p-3 bg-white" id="dv_clientMaintenanceTabContent">
                            <div class="text-muted py-2" data-cm-empty-stages>Select a client type to load workflow stages.</div>
                        </div>
                    </div>

                    <div class="cm-sticky-footer">
                        <!-- Navigation Buttons -->
                        <div class="cm-stepper__actions mt-1">
                            <button type="button" class="btn btn-outline-secondary" id="btn_cmPrevious" data-cm-nav="prev" disabled aria-label="Previous step">
                                <i class="bi bi-chevron-left me-2"></i>Back
                            </button>
                            <button type="button" class="btn btn-primary ms-auto" id="btn_cmNext" data-cm-nav="next" disabled aria-label="Next step">
                                Next<i class="bi bi-chevron-right ms-2"></i>
                            </button>
                        </div>
                    </div>
                    <!-- BEHIND THE SCENE Section - Now part of main form card -->
                    <div class="form-section" data-section="behind-scene">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-gear"></i> Behind The Scene</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Behind The Scene" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>

                        <div class="section-content" data-section-content>
                            <div class="audit-section">
                                <div class="audit-item">
                                    <label>Status</label>
                                    <span class="audit-value" id="auditStatus" data-field="status">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Open Date</label>
                                    <span class="audit-value" id="auditOpenDate" data-field="openDate">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Closed Date</label>
                                    <span class="audit-value" id="auditClosedDate" data-field="closedDate">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Created By</label>
                                    <span class="audit-value" id="auditCreatedBy" data-field="createdBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Created On</label>
                                    <span class="audit-value" id="auditCreatedOn" data-field="createdOn">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Modified By</label>
                                    <span class="audit-value" id="auditModifiedBy" data-field="modifiedBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Modified On</label>
                                    <span class="audit-value" id="auditModifiedOn" data-field="modifiedOn">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Supervised By</label>
                                    <span class="audit-value" id="auditSupervisedBy" data-field="supervisedBy">-</span>
                                </div>
                                <div class="audit-item">
                                    <label>Supervised On</label>
                                    <span class="audit-value" id="auditSupervisedOn" data-field="supervisedOn">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Behind the Scene Section -->

                </div>
            </div>
        </div>


        <!-- Right Action Panel -->
        <div class="action-panel" id="action-panel">
            <div class="nav-group">
                <button class="btn-nav green" type="button" data-record-nav="prev" id="btn_cmRecordPrev" disabled aria-label="Previous Record">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span>Client</span>
                <button class="btn-nav green" type="button" data-record-nav="next" id="btn_cmRecordNext" disabled aria-label="Next Record">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
            <div class="spacer"></div>
            <div class="action-buttons">
                <button class="btn-action btn-view" type="button" data-action-btn="view" data-shell-mode="View">
                    <i class="bi bi-eye me-1"></i>View
                </button>
                <button class="btn-action" type="button" data-action-btn="new" data-shell-mode="Add">
                    <i class="bi bi-plus-circle me-1"></i>Add
                </button>
                <button class="btn-action" type="button" data-action-btn="edit" data-shell-mode="Update" disabled>
                    <i class="bi bi-pencil-square me-1"></i>Edit
                </button>
                <button class="btn-action btn-supervision" type="button" data-action-btn="supervise" disabled>
                    <i class="bi bi-shield-check me-1"></i>Supervision
                </button>
                <button class="btn-action btn-cancel" type="button" data-submit-action="cancel" id="btn_cmCancel" disabled aria-label="Cancel workflow">
                    <i class="bi bi-x-circle me-1"></i><span data-action-label>Cancel</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/js/modules/identities/client-maintenance/validation-utils.js?v=20260313"></script>
<script type="text/javascript" src="~/js/modules/identities/client-maintenance/client-maintenance.js?v=20260313"></script>
