@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Client Approval";
    Layout = "_ApplicationLayout";
    var clientTypeOptions = ViewData["ClientTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}
<div class="window">
    <div class="am-header" role="banner">
        <div class="am-header__left">
            <i class="bi bi-check2-square am-header__icon"></i>
            <span class="am-header__title">Client Approval</span>
        </div>
        <div class="am-header__right" role="toolbar" aria-label="Window controls">
            <button class="am-btn" type="button" data-action="refresh" title="Refresh" aria-label="Refresh"><i class="bi bi-arrow-clockwise"></i></button>
            <button class="am-btn" type="button" data-action="minimize" title="Minimize" aria-label="Minimize"><i class="bi bi-dash-lg"></i></button>
            <button class="am-btn" type="button" data-action="maximize" title="Maximize" aria-label="Maximize"><i class="bi bi-square"></i></button>
            <button class="am-btn am-btn--close" type="button" data-action="close" title="Close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </div>
    </div>

    <div class="main-container main-container--with-panel">
        <main id="dv_clientApprovalMain" class="form-content" role="region" aria-label="Client Approval">
            <input type="hidden" id="moduleId" value="@ViewData["ModuleId"]" />
            <input type="hidden" id="hdn_defaultBranchId" value="@ViewData["DefaultBranchId"]" />
            <input type="hidden" id="hdn_defaultBranchName" value="@ViewData["DefaultBranchName"]" />

            <div class="am-message-panel d-none" id="dv_messagePanel" role="alert" aria-live="polite">
                <div class="am-message-panel__content">
                    <i class="bi bi-info-circle" id="icn_messageIcon"></i>
                    <span id="spn_messageText"></span>
                </div>
            </div>

            <div class="form-card" data-main-form>
                <div class="form-section" id="dv_filterSection" data-section="filter-criteria">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-funnel me-1"></i>Filter Criteria</span>
                        <button type="button" id="btn_toggleFilters" class="section-toggle-btn" aria-label="Toggle Filter Criteria" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <form id="frm_clientApprovalFilters" autocomplete="off">
                            <div class="form-row four-col">
                                <div class="form-group">
                                    <label class="label-blue" id="lbl_branchId" for="txt_branchId">Branch ID <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="text" id="txt_branchId" class="bs-input-text form-control" placeholder="Select..." readonly>
                                        <button class="btn btn-outline-secondary" type="button" id="btn_searchBranch" title="Search Branch" aria-label="Search Branch">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                    <input type="hidden" id="txt_branchIdValue" />
                                    <small id="spn_branchName" class="text-muted d-block mt-1"></small>
                                </div>

                                <div class="form-group">
                                    <label class="label-blue" id="lbl_clientType" for="ddl_clientType">Client Type <span class="text-danger">*</span></label>
                                    <select id="ddl_clientType" class="bs-select" asp-items="@(clientTypeOptions.Skip(1))">
                                        <option value="">Select Type</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label class="label-blue" id="lbl_applicationId" for="txt_applicationId">Application ID <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="text" id="txt_applicationId" class="bs-input-text form-control" placeholder="Select..." readonly>
                                        <button class="btn btn-outline-secondary" type="button" id="btn_searchApplication" title="Search Application" aria-label="Search Application">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                    <input type="hidden" id="txt_applicationIdValue" />
                                    <small id="spn_applicationName" class="text-muted d-block mt-1"></small>
                                </div>

                                <div class="form-group">
                                    <label class="label-blue invisible" aria-hidden="true">Load</label>
                                    <button id="btn_loadApprovals" type="button" class="btn btn-primary w-100">
                                        <i class="bi bi-search"></i><span>Load Approvals</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="form-section" id="dv_pendingApprovalsSection" data-section="pending-approvals">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-clock-history me-1"></i>Pending Approvals</span>
                        <span class="badge bg-primary ms-2" id="spn_recordCount">0 records</span>
                        <button type="button" id="btn_togglePendingApprovals" class="section-toggle-btn" aria-label="Toggle Pending Approvals" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-hover" id="tbl_approval">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px;"><input type="checkbox" id="chk_selectAll" class="form-check-input"></th>
                                        <th>Gender</th>
                                        <th>Date of Birth</th>
                                        <th>Nationality</th>
                                        <th>Identification No</th>
                                        <th>Marital Status</th>
                                        <th>Address</th>
                                        <th>Mobile</th>
                                        <th>Center ID</th>
                                        <th>Group ID</th>
                                        <th>Created By</th>
                                    </tr>
                                </thead>
                                <tbody id="tbl_approvalBody">
                                    <tr>
                                        <td colspan="11" class="text-muted">No records to display.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-section" id="dv_statusReasonsSection" data-section="status-reasons">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-list-check me-1"></i>Status Reasons</span>
                        <button type="button" id="btn_toggleStatusReasons" class="section-toggle-btn" aria-label="Toggle Status Reasons" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-hover" id="tbl_statusReasons">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px;"><input type="checkbox" id="chk_selectAllReasons" class="form-check-input"></th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody id="tbl_statusReasonsBody">
                                    <tr>
                                        <td colspan="2" class="text-muted">No records to display.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <aside id="dv_actionPanel" class="action-panel" role="complementary" aria-label="Client Approval Actions">
            <div class="action-buttons">
                <button type="button" id="btn_view" class="btn-action" disabled title="View Details" aria-label="View selected client" data-action="view">
                    <i class="bi bi-eye"></i><span>View</span>
                </button>
                <button type="button" id="btn_approve" class="btn-action btn-action--success" disabled title="Approve Clients" aria-label="Approve selected clients" data-action="approve">
                    <i class="bi bi-check-circle-fill"></i><span>Approve</span>
                </button>
                <button type="button" id="btn_reject" class="btn-action btn-delete" disabled title="Reject Clients" aria-label="Reject selected clients" data-action="reject">
                    <i class="bi bi-x-circle-fill"></i><span>Reject</span>
                </button>
                <button type="button" id="btn_cancel" class="btn-action" title="Close" aria-label="Close client approval" data-action="cancel">
                    <i class="bi bi-arrow-left"></i><span>Cancel</span>
                </button>
            </div>
        </aside>
    </div>

    <!-- Rejection Modal -->
    <div class="modal fade" id="mdl_rejection" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle"></i> Reject Clients
                    </h5>
                    <button type="button" id="btn_closeRejectionHeader" class="btn-close" data-bs-dismiss="modal" aria-label="Close rejection dialog"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-info-circle"></i>
                        You are about to reject <strong id="spn_rejectionCount">0</strong> client(s). Please provide a reason.
                    </div>
                    <form id="frm_rejection">
                        <div class="mb-3">
                            <label id="lbl_rejectionRemarks" for="txa_rejectionRemarks" class="form-label">Rejection Remarks <span class="text-danger">*</span></label>
                            <textarea id="txa_rejectionRemarks" class="form-control" rows="4" 
                                    placeholder="Enter reason for rejection (minimum 10 characters)" 
                                    minlength="10" required></textarea>
                            <div class="invalid-feedback">
                                Please provide a valid rejection reason (minimum 10 characters).
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" id="btn_cancelRejection" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x"></i> Cancel
                    </button>
                    <button type="button" class="btn btn-danger" id="btn_confirmReject">
                        <i class="bi bi-check"></i> Confirm Rejection
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript" src="~/js/modules/identities/client-approval/client-approval.js"></script>
}
