                            <div class="tab-pane fade show active" id="dv_tabPersonal" role="tabpanel">
                                <div class="p-3">
                                    <div class="form-row two-col">
                                        <div class="form-group"><label class="label-blue" id="lbl_clientId" for="txt_clientId">ClientID</label><input type="text" id="txt_clientId" class="form-control" readonly></div>
                                        <div class="form-group"><label class="label-blue" id="lbl_clientType" for="ddl_clientType">Client Type</label><select id="ddl_clientType" class="form-select" disabled asp-items="@(clientTypeOptions.Skip(1))"><option value=""></option></select></div>
                                    </div>
                                    <div class="form-row two-col">
                                        <div class="form-group"><label class="label-blue" id="lbl_title" for="ddl_title">Title</label><select id="ddl_title" class="form-select" disabled asp-items="@(titleOptions.Skip(1))"><option value=""></option></select></div>
                                        <div class="form-group"><label class="label-blue" id="lbl_firstName" for="txt_firstName">First Name</label><input type="text" id="txt_firstName" class="form-control" readonly></div>
