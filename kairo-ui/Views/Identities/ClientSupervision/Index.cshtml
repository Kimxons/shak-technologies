@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Client Supervision";
    Layout = "_ApplicationLayout";

    var clientTypeOptions = ViewData["SupervisionClientTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var titleOptions = ViewData["SupervisionTitleOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var genderOptions = ViewData["SupervisionGenderOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var residentOptions = ViewData["SupervisionResidentOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var countryOptions = ViewData["SupervisionCountryOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var literacyLevelOptions = ViewData["SupervisionLiteracyLevelOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var identificationTypeOptions = ViewData["SupervisionIdentificationTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var maritalStatusOptions = ViewData["SupervisionMaritalStatusOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var constitutionOptions = ViewData["SupervisionConstitutionOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var lineOfBusinessOptions = ViewData["SupervisionLineOfBusinessOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var addressTypeOptions = ViewData["SupervisionAddressTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var regionOptions = ViewData["SupervisionRegionOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var employmentStatusOptions = ViewData["SupervisionEmploymentStatusOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var companyTypeOptions = ViewData["SupervisionCompanyTypeOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var occupationOptions = ViewData["SupervisionOccupationOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var yesNoOptions = ViewData["SupervisionYesNoOptions"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

@section Styles {
    <style>
        .am-message-panel {
            display: none;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            border-radius: 0.375rem;
            border: 1px solid transparent;
        }

        .am-message-panel__content {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .am-message-panel--info {
            background-color: #cff4fc;
            border-color: #b6effb;
            color: #055160;
        }

        .am-message-panel--warning {
            background-color: #fff3cd;
            border-color: #ffecb5;
            color: #664d03;
        }

        .am-message-panel--danger {
            background-color: #f8d7da;
            border-color: #f5c2c7;
            color: #842029;
        }

        .am-message-panel--success {
            background-color: #d1e7dd;
            border-color: #badbcc;
            color: #0f5132;
        }

        .multi-select-dropdown {
            position: relative;
            width: 100%;
            z-index: 1;
        }

        .multi-select-dropdown.open {
            z-index: 99998 !important;
        }

        .multi-select-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-align: left;
            background-color: #fff;
            cursor: pointer;
            padding: 0.375rem 0.75rem;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            position: relative;
            z-index: 1;
        }

        .multi-select-btn:hover {
            background-color: #f8f9fa;
        }

        .multi-select-options {
            position: fixed;
            background: white;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            margin-top: 0.25rem;
            max-height: 400px;
            min-width: 300px;
            overflow-x: hidden;
            overflow-y: auto;
            z-index: 99999 !important;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            display: none;
        }

        .multi-select-header {
            padding: 0.5rem;
            border-bottom: 1px solid #dee2e6;
            background-color: #f8f9fa;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .multi-select-list {
            padding: 0.25rem 0;
        }

        .multi-select-option {
            display: flex;
            align-items: center;
            padding: 0.5rem 0.75rem;
            cursor: pointer;
            margin: 0;
            transition: background-color 0.15s;
            background-color: white;
            user-select: none;
        }

        .multi-select-option:hover {
            background-color: #f8f9fa;
        }

        .multi-select-option input[type="checkbox"] {
            margin-right: 0.5rem;
            cursor: pointer;
        }

        .preview-box {
            height: 200px;
        }

        .sv-hidden {
            display: none !important;
        }
    </style>
}

<div class="window">
    <div class="main-container main-container--with-panel">
        <main id="dv_clientSupervisionMain" class="form-content" role="region" aria-label="Client Supervision">
            <!-- Hidden fields for page context -->
            <input type="hidden" id="moduleId" value="@ViewData["ModuleId"]" />

            <div class="am-message-panel" id="dv_messagePanel">
                <div class="am-message-panel__content">
                    <i class="bi bi-info-circle" id="icn_messageIcon"></i>
                    <span id="spn_messageText"></span>
                </div>
            </div>

            <div class="form-card" id="dv_centralKycCard">
                <div class="form-section" id="dv_centralKycSection" data-section="central-kyc">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-shield-check"></i> Central KYC</span>
                        <button type="button" id="btn_toggleCentralKyc" class="section-toggle-btn" aria-label="Toggle Central KYC" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <form id="frm_supervisionFilters" autocomplete="off">
                            <div class="form-row two-col">
                                <div class="form-group">
                                    <label class="label-blue" id="lbl_branchList" for="btn_branchFilter">Branch List</label>
                                    <div class="multi-select-dropdown" id="dv_branchDropdown">
                                        <button type="button" class="form-select multi-select-btn" id="btn_branchFilter" aria-label="Select branches">
                                            <span id="spn_branchFilterText">--Select Branches--</span>
                                            <i class="bi bi-chevron-down ms-auto"></i>
                                        </button>
                                        <div class="multi-select-options" id="dv_branchFilterOptions">
                                            <div class="multi-select-header">
                                                <label class="multi-select-option" id="lbl_selectAllBranches" for="chk_selectAllBranches">
                                                    <input type="checkbox" id="chk_selectAllBranches">
                                                    <span>Select All</span>
                                                </label>
                                            </div>
                                            <div class="multi-select-list" id="dv_branchCheckboxList"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="label-blue" id="lbl_clientIdSearch" for="txt_clientIdSearch">Client ID</label>
                                    <div class="input-group">
                                        <input type="text" id="txt_clientIdSearch" class="form-control" />
                                        <button id="btn_searchClient" class="btn btn-outline-secondary" type="button" aria-label="Search client">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="form-card" id="dv_pendingSupervisionCard">
                <div class="form-section" id="dv_pendingSupervisionSection" data-section="pending-supervision">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-hourglass-split"></i> Pending Supervision <span id="spn_recordCount" class="badge bg-warning ms-2">0 records</span></span>
                        <button type="button" id="btn_togglePendingSupervision" class="section-toggle-btn" aria-label="Toggle Pending Supervision" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <div class="table-responsive">
                            <table class="table table-hover table-sm" id="tbl_supervision">
                                <thead class="table-light">
                                    <tr>
                                        <th></th>
                                        <th>Client ID</th>
                                        <th>Client Type</th>
                                        <th>Account ID</th>
                                        <th>Name</th>
                                        <th>Status</th>
                                        <th>Opening Date</th>
                                        <th>Branch</th>
                                        <th>Inputter</th>
                                    </tr>
                                </thead>
                                <tbody id="tbl_supervisionBody">
                                    <tr>
                                        <td colspan="9" class="text-center text-muted">
                                            <i class="bi bi-inbox"></i> No pending supervisions found
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-card" id="dv_clientDetailsSection">
                <div class="form-section" id="dv_clientDetailsWrapper" data-section="client-details">
                    <div class="section-header" data-section-toggle>
                        <span class="section-header__title"><i class="bi bi-person-badge"></i> Client Details</span>
                        <button type="button" id="btn_toggleClientDetails" class="section-toggle-btn" aria-label="Toggle Client Details" aria-expanded="true">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </div>
                    <div class="section-content" data-section-content>
                        <ul class="nav nav-tabs" id="tbl_clientDetailsTabs" role="tablist">
