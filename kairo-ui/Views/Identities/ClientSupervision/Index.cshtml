                                    </div>
                                    <div class="form-row two-col">
                                        <div class="form-group"><label class="label-blue" id="lbl_dataCleansed" for="ddl_dataCleansed">Data Cleansed</label><select id="ddl_dataCleansed" class="form-select" disabled asp-items="@(yesNoOptions.Skip(1))"><option value=""></option></select></div>
                                        <div class="form-group"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="dv_tabImages" role="tabpanel">
                                <div class="p-3">
                                    <div class="row mb-4">
                                        <div class="col-md-6 text-center">
                                            <label class="label-blue d-block mb-2" id="lbl_photoPreview" for="img_photoPreview">Photo</label>
                                            <div class="preview-box border rounded bg-light d-flex align-items-center justify-content-center">
                                                <img id="img_photoPreview" class="img-fluid sv-hidden" alt="Photo" style="max-height: 190px;">
                                                <div id="dv_noPhotoText" class="text-center p-3">
                                                    <i class="bi bi-person-bounding-box text-muted" style="font-size: 3rem;"></i>
                                                    <p class="text-muted small mt-2">No photo available</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 text-center">
                                            <label class="label-blue d-block mb-2" id="lbl_signaturePreview" for="img_signaturePreview">Signature</label>
                                            <div class="preview-box border rounded bg-light d-flex align-items-center justify-content-center">
                                                <img id="img_signaturePreview" class="img-fluid sv-hidden" alt="Signature" style="max-height: 190px;">
                                                <div id="dv_noSignatureText" class="text-center p-3">
                                                    <i class="bi bi-pen text-muted" style="font-size: 3rem;"></i>
                                                    <p class="text-muted small mt-2">No signature available</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="section-header py-1 mb-2 bg-light border">
                                        <span class="small fw-bold px-2">UPLOADED IMAGES</span>
                                    </div>
                                    <div class="table-responsive border rounded bg-white">
                                        <table class="table table-sm table-hover mb-0" id="tbl_photoSignature">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-2">#</th>
                                                    <th>Type</th>
                                                    <th>Description</th>
                                                    <th>Uploaded On</th>
                                                    <th class="text-center">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbl_photoSignatureBody">
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted py-3"><i class="bi bi-image"></i> No images found</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <aside id="dv_actionPanel" class="action-panel" role="complementary" aria-label="Client Supervision Actions">
            <div class="action-buttons">
                <button type="button" id="btn_view" class="btn-action" disabled data-action="view" aria-label="View selected client">
                    <i class="bi bi-eye"></i>
                    <span>View</span>
                </button>
                <button type="button" id="btn_approve" class="btn-action btn-action--success" disabled data-action="approve" aria-label="Approve selected supervision">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Approve</span>
                </button>
                <button type="button" id="btn_reject" class="btn-action btn-delete" disabled data-action="reject" aria-label="Reject selected supervision">
                    <i class="bi bi-x-circle-fill"></i>
                    <span>Reject</span>
                </button>
                <button type="button" id="btn_close" class="btn-action" data-action="close" aria-label="Close client supervision">
                    <i class="bi bi-door-open"></i>
                    <span>Close</span>
                </button>
            </div>
        </aside>
    </div>
</div>

<div class="modal fade" id="mdl_supervisionReject" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Reject Supervision</h5>
                <button type="button" id="btn_closeRejectModal" class="btn-close" data-bs-dismiss="modal" aria-label="Close rejection dialog"></button>
            </div>
            <div class="modal-body">
                <form id="frm_supervisionReject">
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i>
                        You are about to reject this supervision. Please provide a reason.
                    </div>
                    <div class="mb-3">
                        <label id="lbl_supervisionRejectRemarks" for="txa_supervisionRejectRemarks" class="form-label">Rejection Remarks <span class="text-danger">*</span></label>
                        <textarea id="txa_supervisionRejectRemarks" class="form-control" rows="4" required minlength="10" placeholder="Enter reason for rejection (minimum 10 characters)"></textarea>
                        <div class="invalid-feedback">Please provide a valid rejection reason (minimum 10 characters).</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="btn_cancelReject" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x"></i> Cancel</button>
                <button type="button" class="btn btn-danger" id="btn_confirmSupervisionReject"><i class="bi bi-check"></i> Confirm Rejection</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript" src="~/js/modules/identities/client-supervision/client-supervision.js"></script>
}
