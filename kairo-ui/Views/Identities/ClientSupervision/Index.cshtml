                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="btn_tabOther" data-bs-toggle="tab" data-bs-target="#dv_tabOther" type="button" role="tab">Other Details</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="btn_tabImages" data-bs-toggle="tab" data-bs-target="#dv_tabImages" type="button" role="tab">Images</button>
                            </li>
                        </ul>

