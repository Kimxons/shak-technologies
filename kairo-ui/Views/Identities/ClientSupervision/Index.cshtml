                                        <div class="form-group"><label class="label-blue" id="lbl_lastName" for="txt_lastName">Last Name</label><input type="text" id="txt_lastName" class="form-control" readonly></div>
                                    </div>
                                    <div class="form-row two-col">
                                        <div class="form-group"><label class="label-blue" id="lbl_dob" for="txt_dob">DOB</label><input type="text" id="txt_dob" class="form-control" readonly></div>
                                        <div class="form-group"><label class="label-blue" id="lbl_gender" for="ddl_gender">Gender</label><select id="ddl_gender" class="form-select" disabled asp-items="@(genderOptions.Skip(1))"><option value=""></option></select></div>
                                    </div>
                                    <div class="form-row two-col">
                                        <div class="form-group"><label class="label-blue" id="lbl_resident" for="ddl_resident">Resident</label><select id="ddl_resident" class="form-select" disabled asp-items="@(residentOptions.Skip(1))"><option value=""></option></select></div>
                                        <div class="form-group"><label class="label-blue" id="lbl_nationality" for="ddl_nationality">Nationality</label><select id="ddl_nationality" class="form-select" disabled asp-items="@(countryOptions.Skip(1))"><option value=""></option></select></div>
                                    </div>
                                    <div class="form-row two-col">
                                        <div class="form-group"><label class="label-blue" id="lbl_literacyLevel" for="ddl_literacyLevel">Literacy Level</label><select id="ddl_literacyLevel" class="form-select" disabled asp-items="@(literacyLevelOptions.Skip(1))"><option value=""></option></select></div>
                                        <div class="form-group"><label class="label-blue" id="lbl_issuedBy" for="txt_issuedBy">IssuedBy</label><input type="text" id="txt_issuedBy" class="form-control" readonly></div>
                                    </div>
                                    <div class="form-row two-col">
                                        <div class="form-group"><label class="label-blue" id="lbl_identificationType" for="ddl_identificationType">Identification Type</label><select id="ddl_identificationType" class="form-select" disabled asp-items="@(identificationTypeOptions.Skip(1))"><option value=""></option></select></div>
