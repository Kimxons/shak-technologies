@{
    Layout = null;

    var branchId = Context.Session.GetString("branch_code") ?? Context.Session.GetString("branch_id") ?? string.Empty;
    var branchName = Context.Session.GetString("branch_name") ?? string.Empty;
    var operatorId = Context.Session.GetString("user_name") ?? Context.Session.GetString("user_id") ?? string.Empty;
    var bankId = Context.Session.GetString("bank_id") ?? Context.Session.GetString("bank_code") ?? "00";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Merge Client Accounts</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <style>
            #mergeClientAccountsModule .window {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                overflow: hidden;
            }

            #mergeClientAccountsModule .am-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                min-height: 40px;
                padding: 0 10px;
                background: linear-gradient(180deg, #5b8ea8 0%, #4a7c95 100%) !important;
            }

            #mergeClientAccountsModule .am-header__left {
                display: flex;
                align-items: center;
                gap: 8px;
                min-width: 0;
            }

            #mergeClientAccountsModule .am-header__right {
                display: flex;
                align-items: center;
                gap: 4px;
                margin-left: auto;
            }

            #mergeClientAccountsModule .am-header__right .am-btn {
                width: 28px;
                height: 28px;
                border: 1px solid #d4dce4;
                background: #ffffff;
                color: #21475e;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 4px;
                line-height: 1;
            }

            #mergeClientAccountsModule .am-header__right .am-btn:hover {
                background: #f0f6fb;
                border-color: #b8c7d4;
            }

            #mergeClientAccountsModule .am-header__right .am-btn--close {
                background: #d84a43;
                border-color: #ba3a33;
                color: #ffffff;
            }

            #mergeClientAccountsModule .am-header__right .am-btn--close:hover {
                background: #bf3a33;
                border-color: #a9332e;
            }

            #mergeClientAccountsModule .main-container {
                flex: 1 1 auto;
                min-height: 0;
                overflow: hidden;
                gap: 10px;
                padding: 8px 10px 10px;
                height: calc(100vh - 40px);
            }

            #mergeClientAccountsModule .form-content {
                flex: 1 1 auto;
                min-height: 0;
                overflow-y: auto;
                margin-top: 0;
                padding-top: 0;
                padding-right: 4px;
            }

            #mergeClientAccountsModule .form-card {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            #mergeClientAccountsModule .action-panel {
                flex: 0 0 var(--action-panel-width);
                align-self: stretch;
                position: sticky;
                top: 6px;
                max-height: calc(100vh - 56px);
                overflow-y: auto;
                padding-top: 4px;
                z-index: 2;
            }

            #mergeClientAccountsModule .action-panel .d-flex {
                position: sticky;
                top: 0;
            }

            #mergeClientAccountsModule .parity-card .table-responsive {
                max-height: 230px;
                overflow-y: auto;
            }

            #mergeClientAccountsModule .form-section {
                margin-bottom: 0;
            }

            @@media (max-width: 992px) {
                #mergeClientAccountsModule .main-container {
                    height: auto;
                    overflow: auto;
                }

                #mergeClientAccountsModule .action-panel {
                    position: static;
                    max-height: none;
                    overflow: visible;
                }

                #mergeClientAccountsModule .action-panel .d-flex {
                    position: static;
                }
            }

            .parity-card {
                border: 1px solid #ccd6e0;
                border-radius: 6px;
                background: #fff;
                overflow: hidden;
                margin-bottom: 10px;
            }

            .parity-header {
                display: flex;
                align-items: center;
                justify-content: flex-start;
                gap: 8px;
                padding: 8px 12px;
                border-bottom: 1px solid #c8d4df;
                font-weight: 700;
                font-size: 0.9rem;
                line-height: 1.2;
                letter-spacing: 0.02em;
                text-transform: uppercase;
                text-align: left;
            }

            .parity-header .section-header__title {
                text-align: left;
            }

            .section-content {
                padding-top: 10px;
                padding-bottom: 10px;
            }

            .section-content .label-blue,
            .section-content .form-label {
                line-height: 1.15;
                margin-bottom: 0.3rem;
            }

            .parity-header--from {
                color: #7b2e2f;
                background: linear-gradient(180deg, #fbe3e3 0%, #f6cccc 100%);
            }

            .parity-header--to {
                color: #114061;
                background: linear-gradient(180deg, #dff3ff 0%, #c6e9ff 100%);
            }

            .parity-table thead th {
                background: linear-gradient(180deg, #f0f4f8 0%, #e2e8ef 100%);
                color: #1a3550;
                border-color: #c7d3df;
                font-size: 0.8rem;
                line-height: 1.15;
                white-space: nowrap;
                padding-top: 0.44rem;
                padding-bottom: 0.44rem;
            }

            .parity-table tbody td {
                border-color: #e0e7ee;
                background-color: #fff;
                vertical-align: middle;
                line-height: 1.18;
                padding-top: 0.34rem;
                padding-bottom: 0.34rem;
            }

            .parity-table tbody tr:hover td {
                background: #eef7ff;
            }

            .parity-table tbody tr.row-selected td,
            .parity-table tbody tr.selected td {
                background: #d6ecff;
                border-top-color: #8ec4e8;
                border-bottom-color: #8ec4e8;
            }

            .summary-strip {
                border: 1px solid #dae3ea;
                border-radius: 6px;
                background: linear-gradient(180deg, #fdfefe 0%, #f5f8fb 100%);
                padding: 7px 10px;
                line-height: 1.2;
            }

            .summary-strip__label {
                color: #2a4a63;
                font-weight: 700;
                margin-right: 6px;
            }

            .summary-strip__warning {
                color: #9a6800;
                font-size: 0.85rem;
                font-weight: 600;
                line-height: 1.2;
            }

            .summary-badge {
                min-width: 58px;
                padding: 0.3rem 0.5rem;
                font-size: 0.78rem;
                font-weight: 700;
                line-height: 1.05;
                letter-spacing: 0.01em;
                border: 1px solid transparent;
            }

            .summary-badge--count {
                color: #0c3b63;
                background: #d8eefe;
                border-color: #9fc6e3;
            }

            .summary-badge--balance {
                color: #0a4f47;
                background: #d9f5ef;
                border-color: #9ad1c6;
            }

            .modal-header-parity {
                border-bottom: 1px solid #b8c7d5;
                padding-top: 0.52rem;
                padding-bottom: 0.52rem;
                padding-left: 0.88rem;
                padding-right: 0.88rem;
            }

            .modal-header-parity .modal-title {
                font-size: 0.96rem;
                font-weight: 700;
                line-height: 1.2;
                letter-spacing: 0.01em;
            }

            .modal-header-parity--client {
                color: #ffffff;
                background: linear-gradient(180deg, #2f6e9a 0%, #265b83 100%);
            }

            .modal-header-parity--branch {
                color: #ffffff;
                background: linear-gradient(180deg, #2f7f73 0%, #256559 100%);
            }

            #clientSearchResultsTable thead th,
            #branchSearchResultsTable thead th {
                background: linear-gradient(180deg, #f2f6fa 0%, #e4ebf2 100%);
                color: #284760;
                border-color: #cbd6e0;
                font-size: 0.79rem;
                line-height: 1.14;
                padding-top: 0.43rem;
                padding-bottom: 0.43rem;
            }

            #clientSearchResultsTable tbody td,
            #branchSearchResultsTable tbody td {
                line-height: 1.16;
                padding-top: 0.35rem;
                padding-bottom: 0.35rem;
            }

            .modal-footer {
                padding-top: 0.5rem;
                padding-bottom: 0.5rem;
                padding-left: 0.75rem;
                padding-right: 0.75rem;
                line-height: 1.15;
            }

            .branch-results-shell {
                border: 1px solid #8ea6bb;
                border-top: none;
                margin: 0 8px 8px;
                background: #f4f7fb;
            }

            .branch-results-caption-wrap {
                padding: 0;
                border-bottom: 1px solid #b7c7d6;
                background: #edf2f8;
            }

            .branch-results-caption {
                display: inline-block;
                min-width: 155px;
                text-align: center;
                font-size: 0.82rem;
                line-height: 1.2;
                color: #1a2f43;
                background: #ffffff;
                border-top: 2px solid #f2a100;
                border-right: 1px solid #c6d1dc;
                padding: 6px 10px 5px;
            }

            #branchSearchResultsTable {
                margin-bottom: 0;
            }

            #branchSearchResultsTable thead th {
                background: #0f85cb;
                color: #ffffff;
                border-color: #0f85cb;
                font-weight: 700;
            }

            #branchSearchResultsTable tbody tr:nth-child(odd) td {
                background: #c4def0;
                color: #042842;
            }

            #branchSearchResultsTable tbody tr:nth-child(even) td {
                background: #a7cce7;
                color: #042842;
            }

            #branchSearchResultsTable tbody tr:hover td {
                background: #84b9de;
            }

            #branchSearchResultsTable tbody tr.selected td {
                background: #0b74b4;
                color: #ffffff;
            }
    </style>
</head>

<body>
    <form id="mergeClientAccountsRequestForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div id="mergeClientAccountsModule" data-branch-id="@branchId" data-branch-name="@branchName"
         data-operator-id="@operatorId" data-bank-id="@bankId">
        <div class="window">
            <main class="main-container" aria-label="Merge Client Accounts workspace">
                <div class="form-content" role="region" aria-label="Merge Client Accounts form">
                    <div class="form-card" data-main-form>
                        <div class="form-section">
                            <div class="section-header">
                                <i class="bi bi-building section-header__icon"></i>
                                <span class="section-header__title">Branch Selection</span>
                            </div>
                            <div class="section-content">
                                <div class="row g-2 align-items-end">
                                    <div class="col-12 col-lg-3">
                                        <label class="label-blue" for="branchId">Branch ID</label>
                                        <input type="text" id="branchId" class="form-control" value="@branchId" />
                                    </div>
                                    <div class="col-12 col-lg-7">
                                        <label class="label-blue" for="branchName">Branch Name</label>
                                        <input type="text" id="branchName" class="form-control" value="@branchName"
                                               readonly />
                                    </div>
                                    <div class="col-12 col-lg-2">
                                        <button type="button" class="btn btn-primary w-100" id="btnBranchLookup"
                                                aria-label="Search Branch">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-section parity-card">
                            <div class="section-header parity-header parity-header--from">
                                <i class="bi bi-box-arrow-right section-header__icon"></i>
                                <span class="section-header__title">Source Client (Move Accounts FROM)</span>
                            </div>
                            <div class="section-content">
                                <div class="row g-2 align-items-end mb-3">
                                    <div class="col-12 col-lg-3">
                                        <label class="label-blue" for="fromClientId">From Client/Account ID</label>
                                        <input type="text" id="fromClientId" class="form-control" />
                                    </div>
                                    <div class="col-12 col-lg-7">
                                        <label class="label-blue" for="fromClientName">Client Name</label>
                                        <input type="text" id="fromClientName" class="form-control" readonly />
                                    </div>
                                    <div class="col-12 col-lg-2">
                                        <button type="button" class="btn btn-primary w-100" id="btnFromClientLookup"
                                                aria-label="Search Source Client or Account">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0 parity-table">
                                        <thead>
                                            <tr>
                                                <th class="text-center" style="width: 40px;"><input type="checkbox"
                                                                                                        class="form-check-input" id="selectAllFrom"
                                                                                                        aria-label="Select all source accounts" /></th>
                                                    <th>Account Type</th>
                                                    <th>Our Branch ID</th>
                                                    <th>Product ID</th>
                                                    <th>Account ID</th>
                                                    <th class="text-end">Clear Balance</th>
                                                </tr>
                                            </thead>
                                            <tbody id="fromAccountsGrid">
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted py-3">No records to
                                                        display.</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section parity-card">
                                    <div class="section-header parity-header parity-header--to">
                                        <i class="bi bi-box-arrow-in-left section-header__icon"></i>
                                        <span class="section-header__title">Target Client (Merge Accounts TO)</span>
                                    </div>
                                    <div class="section-content">
                                        <div class="row g-2 align-items-end mb-3">
                                            <div class="col-12 col-lg-3">
                                                <label class="label-blue" for="toClientId">To Client/Account ID</label>
                                                <input type="text" id="toClientId" class="form-control" />
                                            </div>
                                            <div class="col-12 col-lg-7">
                                                <label class="label-blue" for="toClientName">Client Name</label>
                                                <input type="text" id="toClientName" class="form-control" readonly />
                                            </div>
                                            <div class="col-12 col-lg-2">
                                                <button type="button" class="btn btn-primary w-100" id="btnToClientLookup"
                                                        aria-label="Search Target Client or Account">
                                                    <i class="bi bi-search"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0 parity-table">
                                                <thead>
                                                    <tr>
                                                        <th>Account Type</th>
                                                        <th>Our Branch ID</th>
                                                        <th>Product ID</th>
                                                        <th>Account ID</th>
                                                        <th class="text-end">Clear Balance</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="toAccountsGrid">
                                                    <tr>
                                                        <td colspan="5" class="text-center text-muted py-3">No records to
                                                            display.</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-section">
                                        <div class="section-header">
                                            <i class="bi bi-info-circle section-header__icon"></i>
                                            <span class="section-header__title">Merge Summary</span>
                                        </div>
                                        <div class="section-content">
                                            <div class="row g-2">
                                                <div class="col-md-4">
                                                    <div
                                                        class="summary-strip h-100 d-flex align-items-center justify-content-between">
                                                        <span class="summary-strip__label">Accounts Selected</span>
                                                        <span id="selectedCountDisplay"
                                                              class="badge summary-badge summary-badge--count">0</span>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div
                                                        class="summary-strip h-100 d-flex align-items-center justify-content-between">
                                                        <span class="summary-strip__label">Total Balance to Move</span>
                                                        <span id="summaryBalance"
                                                              class="badge summary-badge summary-badge--balance">0.00</span>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="summary-strip h-100 d-flex align-items-center">
                                                        <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                                                        <span id="mergeReadyBadge" class="summary-strip__warning">Awaiting validated
                                                            selection</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mt-2 small text-muted">This action cannot be undone. Review source and
                                                    target details before merging.</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <aside class="action-panel" aria-label="Merge actions">
                                        <div class="d-flex flex-column gap-2 mt-auto">
                                            <button class="btn-action btn-view" type="button" id="btnView">
                                                <i class="bi bi-eye"></i><span>View</span>
                                            </button>
                                            <button class="btn-action btn-save" type="button" id="btnMerge" disabled>
                                                <i class="bi bi-arrow-left-right"></i><span>Merge</span>
                                            </button>
                                            <button class="btn-action" type="button" id="btnClear">
                                                <i class="bi bi-eraser"></i><span>Clear</span>
                                            </button>
                                            <button class="btn-action btn-cancel" type="button" id="btnCancel">
                                                <i class="bi bi-x-lg"></i><span>Cancel</span>
                                            </button>
                                        </div>
                                    </aside>
                                </main>

                                <footer class="de-status-bar" id="mergeClientAccountsStatus" role="status" aria-live="polite">Ready</footer>

                                <div class="am-message-panel" id="amMessagePanel" role="alert" aria-live="polite" hidden>
                                    <i class="bi bi-info-circle-fill am-message-panel__icon" id="messagePanelIcon" aria-hidden="true"></i>
                                    <span id="messagePanelText"></span>
                                    <button type="button" class="am-message-panel__close" id="messagePanelClose" aria-label="Close">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>

                                <div class="de-loading-overlay loading-overlay" id="loadingOverlay" hidden>
                                    <div class="de-loading-spinner loading-spinner">
                                        <i class="bi bi-arrow-repeat"></i>
                                        <span>Loading...</span>
                                    </div>
                                </div>

                                <input type="hidden" id="selectedCount" value="0" />
                                <input type="hidden" id="totalBalance" value="0.00" />
                                <span id="branchSummaryDisplay" class="d-none"></span>
                                <span id="sourceClientSummary" class="d-none"></span>
                                <span id="targetClientSummary" class="d-none"></span>
                                <span id="sourceAccountHelper" class="d-none"></span>
                                <span id="targetAccountHelper" class="d-none"></span>
                                <span id="summaryBranch" class="d-none"></span>
                                <span id="summarySourceClient" class="d-none"></span>
                                <span id="summaryTargetClient" class="d-none"></span>
                                <span id="fromAccountsCount" class="d-none"></span>
                                <span id="toAccountsCount" class="d-none"></span>
                                <span id="branchReviewText" class="d-none"></span>
                                <button class="d-none" type="button" id="btnViewMobile"></button>
                                <button class="d-none" type="button" id="btnMergeMobile"></button>
                                <button class="d-none" type="button" id="btnCancelMobile"></button>
                            </div>

                            <div class="modal fade" id="clientSearchModal" tabindex="-1" aria-labelledby="clientSearchModalLabel"
                                 aria-hidden="true">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header modal-header-parity modal-header-parity--client">
                                            <h5 class="modal-title" id="clientSearchModalLabel"><i
                                                class="bi bi-person-search me-2"></i>Client Search</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-0">
                                                <div class="p-3 bg-light border-bottom">
                                                    <div class="row g-2">
                                                        <div class="col-md-4"><label class="form-label small mb-1">Client ID</label><input
                                                            type="text" class="form-control form-control-sm" id="filterClientID" /></div>
                                                            <div class="col-md-4"><label class="form-label small mb-1">Name</label><input
                                                                type="text" class="form-control form-control-sm" id="filterName" /></div>
                                                                <div class="col-md-4"><label class="form-label small mb-1">ID Number</label><input
                                                                    type="text" class="form-control form-control-sm" id="filterIDNumber" /></div>
                                                                    <div class="col-md-4"><label class="form-label small mb-1">MobileNo</label><input
                                                                        type="text" class="form-control form-control-sm" id="filterMobileNo" /></div>
                                                                        <div class="col-md-4"><label class="form-label small mb-1">Client Application
                                                                            ID</label><input type="text" class="form-control form-control-sm"
                                                                                             id="filterClientApplicationID" /></div>
                                                                            <div class="col-md-4"><label class="form-label small mb-1">Account ID</label><input
                                                                                type="text" class="form-control form-control-sm" id="filterAccountID" /></div>
                                                                                <div class="col-md-4"><label class="form-label small mb-1">Mother Name</label><input
                                                                                    type="text" class="form-control form-control-sm" id="filterMotherName" /></div>
                                                                                </div>
                                                                                <div class="mt-2 text-end">
                                                                                    <button class="btn btn-outline-secondary btn-sm me-1" type="button"
                                                                                            id="btnClearFilters"><i class="bi bi-x-circle me-1"></i>Clear</button>
                                                                                    <button class="btn btn-primary btn-sm" type="button" id="btnSearchClients"><i
                                                                                        class="bi bi-search me-1"></i>Search</button>
                                                                                    </div>
                                                                                </div>
                                                                                <div style="max-height: 300px; overflow-y: auto;">
                                                                                    <table class="table table-sm table-hover mb-0" id="clientSearchResultsTable">
                                                                                        <thead class="table-light sticky-top">
                                                                                            <tr>
                                                                                                <th>Client ID</th>
                                                                                                <th>Name</th>
                                                                                                <th>ID Number</th>
                                                                                                <th>Application ID</th>
                                                                                                <th>Client Type</th>
                                                                                            </tr>
                                                                                        </thead>
                                                                                        <tbody id="clientSearchResultsBody">
                                                                                            <tr>
                                                                                                <td colspan="5" class="text-center text-muted py-4">Enter search criteria and
                                                                                                    click Search</td>
                                                                                                </tr>
                                                                                            </tbody>
                                                                                        </table>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="modal-footer">
                                                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                                    <button type="button" class="btn btn-primary btn-sm" id="btnSelectClient" disabled><i
                                                                                        class="bi bi-check-circle me-1"></i>Select</button>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="modal fade" id="branchSearchModal" tabindex="-1" aria-labelledby="branchSearchModalLabel"
                                                                             aria-hidden="true">
                                                                            <div class="modal-dialog">
                                                                                <div class="modal-content">
                                                                                    <div class="modal-header modal-header-parity modal-header-parity--branch">
                                                                                        <h5 class="modal-title" id="branchSearchModalLabel"><i class="bi bi-building me-2"></i>Branch
                                                                                            Search</h5>
                                                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                                                                                    aria-label="Close"></button>
                                                                                        </div>
                                                                                        <div class="modal-body p-0">
                                                                                            <div class="p-3 bg-light border-bottom">
