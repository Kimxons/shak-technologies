{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "kairo_ui.Services.ApiService": "Debug"
      }
    },
    "WriteTo": [
      //{
      //  "Name": "Console",
      //  "Args": {
      //    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
      //  }
      //},
      {
        "Name": "File",
        "Args": {
          "path": "logs/kairo-ui-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}",
          "shared": true
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "EnableDistributedCache": false,
    "RedisConnectionString": "localhost:6379,abortConnect=false",
    "RedisInstanceName": "KAIRO:DEV:",
    "EnableMemoryCache": true,
    "MemoryCacheSizeLimitMB": 256,
    "EnableCompression": false,
    "CompressionThresholdBytes": 1024,
    "DistributedCacheTimeoutMs": 500,
    "EnableCircuitBreaker": true,
    "CircuitBreakerThreshold": 2,
    "CircuitBreakerDurationSeconds": 15,
    "EnableCacheWarming": false,
    "EnableMetrics": true,
    "EnableKeyTracking": true,
    "DefaultExpirationMinutes": 30
  },
  "ApiSettings": {
    "IdentityAccessManagentBaseUrl": "http://localhost:5001/api",
    "SystemCoreBaseUrl": "https://localhost:7175/api",
    "ClientManagementBaseUrl": "https://localhost:7261/api",
    "AccountManagementBaseUrl": "http://localhost:5059",
    "HttpClientTimeoutSeconds": 120,
    "ApiLogPath": "ApplicationLogs"
  },
  "Session": {
    "IdleTimeoutMinutes": 5,
    "CookieTimeoutMinutes": 60
  },
  "OAuth": {
    "ClientId": "kairoUI",
    "ClientSecret": "WSh6nbAVPqd1g6ayUqZtvJ73Y4tgnGMliK5Q5pAppvw=",
    "AuthorizeEndpoint": "http://localhost:5001/authorize",
    "TokenEndpoint": "http://localhost:5001/api/auth/token",
    "RedirectUri": "http://localhost:5005/login/callback",
    "Scope": "openid profile email offline_access",
    "ResponseType": "code"
  }
}
