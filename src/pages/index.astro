---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import getSortedPosts from "@utils/getSortedPosts";
import getPostSlug from "@utils/getPostSlug";
import { CONSULT_BOOKING_LINKS, SITE } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const homeInsights = sortedPosts.slice(0, 4);

const impactStats = [
  {
    value: "Better Scope",
    label: "Avoid building the wrong thing first.",
  },
  {
    value: "Senior Delivery",
    label: "Keep technical decisions clean from scope to rollout.",
  },
  {
    value: "Clean Handover",
    label: "Launch with docs, review, and internal ownership in place.",
  },
];

const audiencePaths = [
  {
    title: "Startups and Product Teams",
    description:
      "Need a studio partner to scope, build, or stabilize a product, platform, API, or internal tool?",
    primaryLabel: "Book Product Strategy Call",
    primaryHref: CONSULT_BOOKING_LINKS.strategy30,
    secondaryLabel: "View Consultancy",
    secondaryHref: "/consultancy",
    external: true,
  },
  {
    title: "Organizations and Institutions",
    description:
      "Need to modernize workflows, digitize operations, or add AI-enabled services without overcomplicating delivery?",
    primaryLabel: "Book Delivery Planning Call",
    primaryHref: CONSULT_BOOKING_LINKS.quick15,
    secondaryLabel: "About the Studio",
    secondaryHref: "/about",
    external: true,
  },
];

const leadershipPillars = [
  {
    title: "Studio-Level Execution",
    description:
      "We stay close to architecture, implementation details, and rollout realities instead of stopping at recommendations.",
  },
  {
    title: "Business-Driven Engineering",
    description:
      "Product goals and operational needs are translated into delivery plans teams can actually execute.",
  },
  {
    title: "Systems That Hold Up",
    description:
      "Reliability, maintainability, and sensible architecture decisions are built in from the start.",
  },
  {
    title: "Clean Handover",
    description:
      "Documentation, reviews, and team enablement are part of delivery so internal ownership is realistic after launch.",
  },
];

const executionModel = [
  {
    phase: "Scope",
    detail:
      "Clarify the problem, users, constraints, and success metrics before build work starts.",
  },
  {
    phase: "Architect",
    detail:
      "Turn priorities into the right system shape, delivery phases, and technical decisions.",
  },
  {
    phase: "Ship",
    detail:
      "Build, review, integrate, and harden the system so rollout is practical and maintainable.",
  },
];

const expertiseBlocks = [
  {
    title: "Product and Platform Engineering",
    description:
      "Web apps, portals, dashboards, APIs, and internal systems built around how teams actually work.",
  },
  {
    title: "Workflow Automation and AI Systems",
    description:
      "Document flows, search, assistants, and AI-enabled automations added where they create real operational value.",
  },
  {
    title: "Technical Advisory and Team Enablement",
    description:
      "Architecture reviews, delivery rescue, implementation guidance, and capability transfer for in-house teams.",
  },
];

const coursePreview = [
  {
    title: "Applied Generative AI Engineering",
    format: "Live Cohort • 6 Weeks",
    description:
      "From prompt workflows to retrieval, evaluation, and production deployment with real case studies.",
  },
  {
    title: "Production NLP Systems",
    format: "Hands-on Bootcamp • 4 Weeks",
    description:
      "Design NLP pipelines for classification, extraction, and search with monitoring and quality feedback loops.",
  },
  {
    title: "Data Engineering for ML Teams",
    format: "Intensive • 5 Weeks",
    description:
      "Build reliable datasets, feature stores, and model-ready pipelines that scale with product demand.",
  },
];

const heroTrustSignals = [
  "Direct with engineering",
  "Fast fit check",
  "Clear next step",
];

const heroDecisionCards = [
  {
    title: "Scope is unclear",
    description:
      "You need sharper product, architecture, or rollout direction.",
    label: "Start with Strategy",
    href: CONSULT_BOOKING_LINKS.strategy30,
    external: true,
  },
  {
    title: "Build needs momentum",
    description: "You need a partner to design and ship the system properly.",
    label: "See Build Work",
    href: "/work",
    external: false,
  },
  {
    title: "Team needs backup",
    description:
      "You need senior guidance on architecture, review, or rollout.",
    label: "View Support Options",
    href: "/consultancy#embedded",
    external: false,
  },
] as const;

const ambientLine = (plain: string, html: string) => ({
  plain,
  html,
  chars: Math.max(plain.length, 2),
});

const heroAmbientScenes = [
  {
    key: "portal",
    label: "Portal Scene",
    columns: [
      [
        ambientLine(
          "const portal = buildPortal({",
          `<span class="token-keyword">const</span> portal = <span class="token-fn">buildPortal</span>({`
        ),
        ambientLine(
          '  users: ["ops", "vendors"],',
          `  <span class="token-property">users</span>: [<span class="token-string">"ops"</span>, <span class="token-string">"vendors"</span>],`
        ),
        ambientLine(
          "  approvals: true,",
          `  <span class="token-property">approvals</span>: <span class="token-boolean">true</span>,`
        ),
        ambientLine(
          '  reporting: "live",',
          `  <span class="token-property">reporting</span>: <span class="token-string">"live"</span>,`
        ),
        ambientLine("});", `});`),
      ],
      [
        ambientLine(
          "const intake = defineFlow({",
          `<span class="token-keyword">const</span> intake = <span class="token-fn">defineFlow</span>({`
        ),
        ambientLine(
          '  source: "requests",',
          `  <span class="token-property">source</span>: <span class="token-string">"requests"</span>,`
        ),
        ambientLine(
          '  visibility: "shared",',
          `  <span class="token-property">visibility</span>: <span class="token-string">"shared"</span>,`
        ),
        ambientLine(
          "  auditTrail: true,",
          `  <span class="token-property">auditTrail</span>: <span class="token-boolean">true</span>,`
        ),
        ambientLine("});", `});`),
        ambientLine(
          'ship(portal, { rollout: "guided" });',
          `<span class="token-fn">ship</span>(portal, { <span class="token-property">rollout</span>: <span class="token-string">"guided"</span> });`
        ),
      ],
    ],
  },
  {
    key: "internal-tool",
    label: "Internal Tool Scene",
    columns: [
      [
        ambientLine(
          "const queue = mapProcess({",
          `<span class="token-keyword">const</span> queue = <span class="token-fn">mapProcess</span>({`
        ),
        ambientLine(
          '  type: "internal-tool",',
          `  <span class="token-property">type</span>: <span class="token-string">"internal-tool"</span>,`
        ),
        ambientLine(
          '  owners: ["sales", "ops"],',
          `  <span class="token-property">owners</span>: [<span class="token-string">"sales"</span>, <span class="token-string">"ops"</span>],`
        ),
        ambientLine(
          '  status: "tracked",',
          `  <span class="token-property">status</span>: <span class="token-string">"tracked"</span>,`
        ),
        ambientLine("});", `});`),
      ],
      [
        ambientLine(
          "const handoff = assignWork({",
          `<span class="token-keyword">const</span> handoff = <span class="token-fn">assignWork</span>({`
        ),
        ambientLine(
          "  routing: true,",
          `  <span class="token-property">routing</span>: <span class="token-boolean">true</span>,`
        ),
        ambientLine(
          '  dashboard: "ops-view",',
          `  <span class="token-property">dashboard</span>: <span class="token-string">"ops-view"</span>,`
        ),
        ambientLine(
          "  exports: true,",
          `  <span class="token-property">exports</span>: <span class="token-boolean">true</span>,`
        ),
        ambientLine("});", `});`),
        ambientLine(
          'stabilize(handoff, { mode: "team-ready" });',
          `<span class="token-fn">stabilize</span>(handoff, { <span class="token-property">mode</span>: <span class="token-string">"team-ready"</span> });`
        ),
      ],
    ],
  },
  {
    key: "ai-workflow",
    label: "AI Workflow Scene",
    columns: [
      [
        ambientLine(
          "const docs = ingest({",
          `<span class="token-keyword">const</span> docs = <span class="token-fn">ingest</span>({`
        ),
        ambientLine(
          '  search: "semantic",',
          `  <span class="token-property">search</span>: <span class="token-string">"semantic"</span>,`
        ),
        ambientLine(
          '  review: "human-in-loop",',
          `  <span class="token-property">review</span>: <span class="token-string">"human-in-loop"</span>,`
        ),
        ambientLine(
          "  summaries: true,",
          `  <span class="token-property">summaries</span>: <span class="token-boolean">true</span>,`
        ),
        ambientLine("});", `});`),
      ],
      [
        ambientLine(
          "const assistant = enableAI({",
          `<span class="token-keyword">const</span> assistant = <span class="token-fn">enableAI</span>({`
        ),
        ambientLine(
          '  guardrails: "strict",',
          `  <span class="token-property">guardrails</span>: <span class="token-string">"strict"</span>,`
        ),
        ambientLine(
          "  retrieval: true,",
          `  <span class="token-property">retrieval</span>: <span class="token-boolean">true</span>,`
        ),
        ambientLine(
          '  mode: "assistive",',
          `  <span class="token-property">mode</span>: <span class="token-string">"assistive"</span>,`
        ),
        ambientLine("});", `});`),
        ambientLine(
          'ship(assistant, { rollout: "reviewed" });',
          `<span class="token-fn">ship</span>(assistant, { <span class="token-property">rollout</span>: <span class="token-string">"reviewed"</span> });`
        ),
      ],
    ],
  },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Software Engineering, AI, and Consultancy | ${SITE.title}`,
  description:
    "Shak Technologies Ltd provides software engineering services, AI implementation support, practical technical training, and implementation-focused consultancy.",
  url: SITE.website,
  mainEntity: [
    {
      "@type": "Service",
      name: "Software and AI Consultancy",
      serviceType:
        "Software product engineering, AI strategy, and implementation",
    },
    {
      "@type": "Course",
      name: "Software and AI Engineering Training",
      courseMode: "online",
    },
    {
      "@type": "Organization",
      name: SITE.title,
      description:
        "Execution-focused software engineering studio delivering consultancy, AI systems, training, and research.",
    },
  ],
};
---

<Layout
  title={`Software Engineering, AI, and Consultancy | ${SITE.title}`}
  description="Shak Technologies Ltd offers software engineering services, AI implementation support, practical technical training, and execution-first consultancy."
  keywords={[
    "software engineering studio",
    "software development consultancy",
    "ai courses online",
    "data science training",
    "machine learning consultancy",
    "generative ai engineering",
    "shak technologies",
  ]}
  schema={homeSchema}
>
  <Header />
  <main id="main-content">
    <section id="hero" data-reveal>
      <div class="hero-shell">
        <div class="hero-ambient-code" aria-hidden="true">
          {
            heroAmbientScenes.map((scene, sceneIndex) => (
              <div
                class={`ambient-scene scene-${scene.key}`}
                style={`--scene-delay:${sceneIndex * 6000}ms;`}
              >
                <span class="ambient-scene-label">{scene.label}</span>
                <div class="ambient-scene-grid">
                  {scene.columns.map((column, columnIndex) => (
                    <div
                      class="ambient-column"
                      style={`--ambient-column-offset:${columnIndex * 3.2}s;`}
                    >
                      {column.map((line, lineIndex) => (
                        <div
                          class="ambient-line"
                          style={`--ambient-chars:${line.chars}; --ambient-line-delay:${sceneIndex * 180 + columnIndex * 520 + lineIndex * 260}ms;`}
                        >
                          <span set:html={line.html} />
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <div class="hero-grid">
          <div class="hero-copy">
            <span class="chip">Software Engineering Studio</span>
            <h1>We build software that moves work forward.</h1>
            <p class="hero-lead">
              Products, portals, internal tools, and AI workflows scoped well,
              built cleanly, and ready for real teams to use.
            </p>
            <div class="hero-actions">
              <LinkButton
                href={CONSULT_BOOKING_LINKS.quick15}
                className="btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                Book 15-Min Intro
              </LinkButton>
              <LinkButton href="/work" className="btn-secondary">
                View Selected Work
              </LinkButton>
              <a href="/consultancy" class="hero-text-link">Explore Services</a>
            </div>
            <p class="hero-reassurance">
              15-minute intro. Direct with engineering. Clear next step.
            </p>
            <ul class="hero-trust-list" aria-label="Why teams start here">
              {heroTrustSignals.map(signal => <li>{signal}</li>)}
            </ul>
            <p class="hero-microcopy">
              Already shipping?
              <a
                href={CONSULT_BOOKING_LINKS.strategy30}
                target="_blank"
                rel="noopener noreferrer"
              >
                Book the 30-minute strategy session
              </a>
              .
            </p>
          </div>

          <aside class="hero-paths" data-reveal>
            <p class="hero-panel-kicker">Start Here</p>
            <h2>Start where the work is.</h2>
            <p class="hero-paths-intro">
              Most teams start in one of these three states.
            </p>

            <ol class="hero-decision-list">
              {
                heroDecisionCards.map((card, index) => (
                  <li class="hero-decision-item">
                    <span class="hero-decision-index">0{index + 1}</span>
                    <div class="hero-decision-copy">
                      <h3>{card.title}</h3>
                      <p>{card.description}</p>
                      {card.external ? (
                        <a
                          href={card.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hero-decision-link"
                        >
                          {card.label}
                        </a>
                      ) : (
                        <a href={card.href} class="hero-decision-link">
                          {card.label}
                        </a>
                      )}
                    </div>
                  </li>
                ))
              }
            </ol>

            <p class="hero-decision-note">
              If it is not a fit, we will say so quickly.
            </p>
          </aside>
        </div>
        <ul class="impact-track">
          {
            impactStats.map((stat, index) => (
              <li class="impact-item" data-reveal>
                <span class="impact-step">0{index + 1}</span>
                <span class="impact-value">{stat.value}</span>
                <span class="impact-label">{stat.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="entry-paths" class="section-block section-early" data-reveal>
      <div class="section-heading">
        <span class="chip">Starting Points</span>
        <h2>Choose the right way into the studio.</h2>
        <p>
          Different teams need different starting points. These are the two most
          common paths into delivery work with Shak Technologies.
        </p>
      </div>
      <div class="audience-split">
        {
          audiencePaths.map(path => (
            <article class="audience-path">
              <h3>{path.title}</h3>
              <p>{path.description}</p>
              <div class="audience-actions">
                {path.external ? (
                  <a
                    href={path.primaryHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="audience-primary"
                  >
                    {path.primaryLabel}
                  </a>
                ) : (
                  <a href={path.primaryHref} class="audience-primary">
                    {path.primaryLabel}
                  </a>
                )}
                <a href={path.secondaryHref} class="audience-secondary">
                  {path.secondaryLabel}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="leadership-proof" class="section-block" data-reveal>
      <div class="section-heading">
        <span class="chip">Why Teams Hire Us</span>
        <h2>Built for teams that need software shipped properly.</h2>
        <p>
          Our work sits between product thinking and deep implementation,
          helping teams make the right calls early and carry them through
          delivery.
        </p>
      </div>
      <ul class="pillar-list">
        {
          leadershipPillars.map(item => (
            <li class="pillar-row" data-reveal>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="execution-model" class="section-block" data-reveal>
      <div class="section-heading">
        <h2>How Engagements Move</h2>
        <p>
          A simple working model that reduces ambiguity and keeps delivery tied
          to real business and operational outcomes.
        </p>
      </div>
      <ol class="model-track">
        {
          executionModel.map((item, index) => (
            <li class="model-step" data-reveal>
              <span class="model-badge">0{index + 1}</span>
              <div class="model-copy">
                <h3>{item.phase}</h3>
                <p>{item.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="expertise" class="section-block" data-reveal>
      <div class="section-heading">
        <h2>What We Build</h2>
        <p>
          We focus on software that solves operational problems, supports
          product growth, and stays maintainable after launch.
        </p>
      </div>
      <div class="expertise-list">
        {
          expertiseBlocks.map(block => (
            <article class="expertise-row" data-reveal>
              <h3>{block.title}</h3>
              <p>{block.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    {
      homeInsights.length > 0 && (
        <section id="recent-posts" class="section-block" data-reveal>
          <div class="section-heading">
            <h2>Latest News Room Stories</h2>
            <p>
              Practical notes on software architecture, AI tooling, product
              engineering, and delivery for teams shipping in production.
            </p>
          </div>
          <ul class="insight-list">
            {homeInsights.map(post => (
              <li class="insight-row" data-reveal>
                <a href={`/posts/${getPostSlug(post)}`} class="insight-link">
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <span class="insight-meta">
                    {(post.data.tags ?? []).slice(0, 2).join(" • ")}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="all-posts-btn-wrapper">
            <LinkButton href="/posts" className="btn-secondary">
              View All News Room Stories
            </LinkButton>
          </div>
        </section>
      )
    }

    <section id="course-preview" class="section-block" data-reveal>
      <div class="section-heading">
        <h2>Training and Capability Building</h2>
        <p>
          Structured learning tracks for teams that want stronger software and
          AI engineering capability alongside delivery work.
        </p>
      </div>
      <div class="course-list">
        {
          coursePreview.map(course => (
            <article class="course-row" data-reveal>
              <span class="course-format">{course.format}</span>
              <div class="course-copy">
                <h3>{course.title}</h3>
                <p>{course.description}</p>
              </div>
              <a
                href="/courses"
                class="course-arrow"
                aria-label={`Learn more about ${course.title}`}
              >
                &#8594;
              </a>
            </article>
          ))
        }
      </div>
      <div class="all-posts-btn-wrapper">
        <LinkButton href="/courses" className="btn-primary">
          View Full Course Catalog
          <svg xmlns="http://www.w3.org/2000/svg">
            <path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
        <LinkButton
          href={CONSULT_BOOKING_LINKS.quick15}
          className="btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Book Consultancy
        </LinkButton>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const revealTargets = Array.from(
        document.querySelectorAll("[data-reveal]")
      );
      revealTargets.forEach((item, index) => {
        item.style.setProperty(
          "--reveal-delay",
          `${Math.min(index * 55, 700)}ms`
        );
      });

      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
      );

      revealTargets.forEach(item => observer.observe(item));
    })();
  </script>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto flex w-full max-w-7xl flex-col gap-16 px-4 pb-20 sm:px-6;
  }
  #hero {
    @apply relative py-8 sm:py-10;
  }
  #hero > * {
    @apply relative z-[1];
  }
  @media (min-width: 1100px) {
    #hero {
      min-height: calc(100svh - 6.75rem);
      display: grid;
      align-items: center;
    }
  }
  .hero-shell {
    @apply relative mx-auto w-full max-w-none;
    overflow: hidden;
    background: transparent;
  }
  .hero-shell::before,
  .hero-shell::after {
    content: "";
    @apply absolute left-0 right-0 h-px;
    background: rgba(var(--color-border), 0.85);
  }
  .hero-shell::before {
    top: 0;
  }
  .hero-shell::after {
    bottom: 0;
  }
  .hero-grid {
    @apply grid gap-7 py-5 sm:py-6;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 1100px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.28fr) minmax(24rem, 0.72fr);
      align-items: center;
      column-gap: clamp(2.5rem, 4vw, 4.5rem);
    }
  }
  .hero-copy {
    @apply min-w-0 self-center;
    padding-right: clamp(0rem, 1.4vw, 1rem);
  }
  .hero-ambient-code {
    position: absolute;
    inset: 1px 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.58;
    z-index: 0;
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.96) 10%,
      rgba(0, 0, 0, 0.96) 90%,
      transparent 100%
    );
  }
  .hero-ambient-code::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(var(--color-fill), 0.3),
        rgba(var(--color-fill), 0.48)
      ),
      radial-gradient(
        circle at center,
        transparent 16%,
        rgba(var(--color-fill), 0.24) 84%
      );
  }
  .ambient-scene {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: ambient-scene-cycle 18s linear infinite;
    animation-delay: var(--scene-delay);
  }
  .ambient-scene::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--scene-glow);
  }
  .ambient-scene-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    height: 100%;
    padding: 2.8rem 1.2rem 1.4rem;
