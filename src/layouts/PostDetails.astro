---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import { render, type CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import getPostSlug from "@utils/getPostSlug";
import ShareLinks from "@components/ShareLinks.astro";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content } = await render(post);

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${getPostSlug(post)}.png`,
  Astro.url.origin
).href;

const readTime = Math.max(
  3,
  Math.ceil((post.body ?? "").split(/\s+/).filter(Boolean).length / 220)
);

const articleSignals = [
  { label: "Written by", value: author },
  { label: "Read time", value: `${readTime} min` },
  { label: "Best for", value: "Leaders, builders, delivery teams" },
];

const advisoryHighlights = [
  "Translate technical insights into a realistic implementation path",
  "Pressure-test architecture decisions before build work compounds",
  "Clarify scope, sequencing, and delivery risks in one conversation",
];

const layoutProps = {
  title,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <!-- Add Katex Stylesheet to render Latex code correctly -->
  <head>
    <!-- Katex -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
      integrity="sha384-MlJdn/WNKDGXveldHDdyRP1R4CTHr3FeuDNfhsLPYrq2t0UBkUdK2jyTnXPEK1NQ"
      crossorigin="anonymous"
    />
  </head>

  <Header />
  <main id="main-content">
    <section class="post-shell">
      <div class="post-topbar">
        <a href="/posts" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg">
            <path
              d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
            ></path>
          </svg>
          News Room
        </a>
        <button class="history-link" onclick="history.back()"> Go back</button>
      </div>

      <section class="post-hero">
        <div class="hero-main">
          <p class="hero-kicker">News Room Story</p>
          <h1 transition:name={slugifyStr(title)} class="post-title">
            {title}
          </h1>
          <p class="hero-summary">{description}</p>

          <div class="hero-meta">
            <Datetime
              pubDatetime={pubDatetime}
              modDatetime={modDatetime}
              size="lg"
              className="hero-datetime"
            />
            <span class="meta-divider" aria-hidden="true"></span>
            <span class="hero-readtime">{readTime} min read</span>
          </div>

          <ul class="hero-tags">
            {tags.map(tag => <Tag tag={slugifyStr(tag)} />)}
          </ul>
        </div>

        <aside class="hero-rail">
          <div class="rail-card">
            <p class="rail-kicker">At a glance</p>
            <div class="signal-grid">
              {
                articleSignals.map(signal => (
                  <div class="signal-item">
                    <span>{signal.label}</span>
                    <strong>{signal.value}</strong>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="rail-card advisory-card">
            <p class="rail-kicker">Need senior delivery support?</p>
            <h2>Turn this story into a concrete implementation plan.</h2>
            <ul class="advisory-list">
              {advisoryHighlights.map(item => <li>{item}</li>)}
            </ul>
            <div class="advisory-actions">
              <a href="/consultancy" class="advisory-link">
                Explore consultancy
              </a>
            </div>
          </div>
        </aside>
      </section>

      <article id="article" role="article" class="article-panel prose">
        <Content />
      </article>

      <section class="post-footer">
        <div class="footer-card">
          <p class="footer-kicker">Share this story</p>
          <ShareLinks />
        </div>

        <div class="footer-card footer-actions">
          <div>
            <p class="footer-kicker">Keep reading</p>
            <p class="footer-copy">
              Explore more News Room stories, architecture notes, and practical
              engineering guidance.
            </p>
          </div>
          <div class="footer-links">
            <a href="/posts" class="back-link">Browse News Room</a>
            <button id="back-to-top" class="history-link">Back to Top</button>
          </div>
        </div>
      </section>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  main {
    @apply mx-auto w-full max-w-[108rem] px-4 pb-16 sm:px-6;
  }
  @media (min-width: 1200px) {
    main {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .post-shell {
    @apply flex flex-col gap-12 pt-5;
  }

  .post-topbar {
    @apply flex flex-wrap items-center justify-between gap-3;
  }
  @media (max-width: 639px) {
    .post-topbar {
      align-items: stretch;
    }
    .post-topbar > * {
      width: 100%;
      justify-content: center;
    }
  }
  .back-link,
  .history-link {
    @apply inline-flex items-center gap-2 rounded-full border border-skin-line bg-skin-card px-4 py-2 text-sm font-semibold no-underline transition;
  }
  .back-link:hover,
  .history-link:hover {
    border-color: hsl(var(--accent));
    color: hsl(var(--accent));
    transform: translateY(-1px);
  }
  .back-link svg {
    @apply h-5 w-5;
  }

  .post-hero {
    @apply grid gap-8 rounded-[2.2rem] border border-skin-line px-5 py-8 shadow-sm sm:px-8 sm:py-10;
    background:
      radial-gradient(
        circle at top left,
        rgba(var(--color-accent), 0.14),
        transparent 32%
      ),
      linear-gradient(
        150deg,
        rgba(var(--color-card), 0.98),
        rgba(var(--color-fill), 0.72)
      );
  }
  @media (max-width: 639px) {
    .post-hero {
      border-radius: 1.4rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
  @media (min-width: 1080px) {
    .post-hero {
      grid-template-columns: minmax(0, 1.42fr) minmax(20rem, 0.68fr);
      column-gap: 2.5rem;
      align-items: start;
    }
  }

  .hero-kicker,
  .rail-kicker,
  .footer-kicker {
    @apply text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-skin-accent;
  }
  .post-title {
    @apply mt-4 max-w-6xl text-4xl font-semibold leading-[0.96] text-skin-accent sm:text-6xl;
    text-wrap: balance;
  }
  .hero-summary {
    @apply mt-5 max-w-5xl text-[1.08rem] leading-8;
    opacity: 0.84;
  }
  @media (max-width: 639px) {
    .post-title {
      font-size: 2.2rem;
      line-height: 1;
    }
    .hero-summary {
      font-size: 1rem;
      line-height: 1.75;
    }
    .hero-meta {
      gap: 0.55rem;
      font-size: 0.82rem;
    }
  }
  .hero-meta {
    @apply mt-6 flex flex-wrap items-center gap-3 text-sm font-semibold;
  }
  .hero-datetime {
    @apply my-0;
  }
  .meta-divider {
    @apply h-1.5 w-1.5 rounded-full bg-skin-accent;
  }
  .hero-readtime {
    opacity: 0.72;
  }
  .hero-tags {
    @apply mt-6 flex flex-wrap gap-2;
  }
  .hero-tags :global(li) {
    @apply my-0;
  }

  .hero-rail {
    @apply grid gap-4;
  }
  .rail-card {
    @apply rounded-[1.6rem] border border-skin-line bg-skin-card p-5;
  }
  @media (max-width: 639px) {
    .rail-card {
      border-radius: 1.1rem;
      padding: 1rem;
    }
  }
  .signal-grid {
    @apply mt-4 grid gap-3;
  }
  .signal-item {
    @apply rounded-2xl border border-skin-line bg-skin-fill px-4 py-3;
  }
  .signal-item span {
    @apply block text-[0.68rem] font-semibold uppercase tracking-[0.16em] opacity-65;
  }
  .signal-item strong {
    @apply mt-1 block text-sm font-semibold leading-6;
  }
  .advisory-card h2 {
    @apply mt-3 text-2xl font-semibold leading-tight;
    text-wrap: balance;
  }
  .advisory-list {
    @apply mt-4 grid gap-3;
  }
  .advisory-list li {
    @apply rounded-2xl border border-skin-line bg-skin-fill px-4 py-3 text-sm leading-6;
  }
  .advisory-actions {
    @apply mt-5;
  }
  .advisory-link {
    @apply inline-flex items-center gap-2 text-sm font-semibold text-skin-accent no-underline;
  }
  .advisory-link::after {
    content: "\2192";
  }

  .article-panel {
    @apply mx-auto mt-0 w-full max-w-[78rem] rounded-[2.1rem] border border-skin-line bg-skin-card px-6 py-10 sm:px-10 sm:py-12;
    box-shadow: 0 18px 45px rgba(10, 15, 20, 0.05);
  }
  @media (max-width: 639px) {
    .article-panel {
      border-radius: 1.2rem;
      padding: 1rem;
    }
    .article-panel :global(pre) {
      font-size: 0.82rem;
    }
  }
  .article-panel :global(.astro-code) {
    overflow-x: auto;
  }
  .article-panel :global(h2),
  .article-panel :global(h3) {
    text-wrap: balance;
  }
  .article-panel :global(p),
  .article-panel :global(li) {
    line-height: 1.9;
  }
  .article-panel :global(pre) {
    border-radius: 1rem;
  }
  .article-panel :global(blockquote) {
    border-left-width: 3px;
  }

  .post-footer {
    @apply grid gap-4 pb-2;
  }
  @media (min-width: 960px) {
    .post-footer {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .footer-card {
    @apply rounded-[1.6rem] border border-skin-line bg-skin-card p-5;
  }
  @media (max-width: 639px) {
    .footer-card {
      border-radius: 1.1rem;
      padding: 1rem;
    }
  }
  .footer-copy {
    @apply mt-2 text-sm leading-7;
    opacity: 0.8;
  }
  .footer-actions {
    @apply flex flex-col justify-between gap-5;
  }
  .footer-links {
    @apply flex flex-wrap gap-3;
  }
</style>

<script is:inline>
  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    let headings = Array.from(document.querySelectorAll("h2, h3, h4, h5, h6"));
    for (let heading of headings) {
      heading.classList.add("group");
      let link = document.createElement("a");
      link.innerText = "#";
      link.className = "heading-link hidden group-hover:inline-block ml-2";
      link.href = "#" + heading.id;
      link.ariaHidden = true;
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    let copyButtonLabel = "Copy";
    let codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (let codeBlock of codeBlocks) {
      let wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      let copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-0 -top-0 rounded bg-skin-card px-2 py-1 text-xs leading-4 text-skin-base font-medium";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      codeBlock.parentNode.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      let code = block.querySelector("code");
      let text = code.innerText;

      await navigator.clipboard.writeText(text);

      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();
  document.addEventListener("astro:after-swap", attachCopyButtons);

  /** Scrolls the document to the top when
   * the "Back to Top" button is clicked. */
  function backToTop() {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  }
  backToTop();
  document.addEventListener("astro:after-swap", backToTop);
</script>
