}

body.client-maintenance .cm-top-identifiers__grid .input-group > .form-control,
body.client-maintenance .cm-top-identifiers__grid .input-group > .form-select,
body.client-maintenance .cm-top-identifiers__grid .input-group > .bs-input-text,
body.client-maintenance .cm-top-identifiers__grid .input-group > .bs-select,
body.client-maintenance .cm-top-identifiers__grid .input-group > [class^="bs-input-"] {
