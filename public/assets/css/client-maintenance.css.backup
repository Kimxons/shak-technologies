body.client-maintenance .cm-top-identifiers__grid .cbs-field > .bs-input-text,
body.client-maintenance .cm-top-identifiers__grid .cbs-field > .bs-input-date,
body.client-maintenance .cm-top-identifiers__grid .cbs-field > .bs-input-number,
body.client-maintenance .cm-top-identifiers__grid .cbs-field > .bs-input-email,
body.client-maintenance .cm-top-identifiers__grid .cbs-field > .bs-input-tel,
body.client-maintenance .cm-top-identifiers__grid .cbs-field > .bs-select {
