/* Compact header and form fields for denser UI */
body.client-maintenance .cm-header-window {
  min-height: 32px;
  height: 36px;
  padding-top: 0;
  padding-bottom: 0;
}
body.client-maintenance .cm-header-window-controls .btn {
  min-height: 24px;
  height: 28px;
  width: 28px;
  padding: 0 0.2rem;
  font-size: 1.1rem;
  line-height: 1;
}
body.client-maintenance input.form-control,
body.client-maintenance select.form-select,
body.client-maintenance textarea.form-control,
body.client-maintenance input.bs-input-text,
body.client-maintenance input.bs-input-date,
body.client-maintenance input.bs-input-number,
body.client-maintenance input.bs-input-email,
body.client-maintenance input.bs-input-tel,
body.client-maintenance select.bs-select,
body.client-maintenance textarea.bs-textarea {
  min-height: 22px;
  height: 26px;
  font-size: 0.93rem;
  padding-top: 1px;
  padding-bottom: 1px;
}

/* Page backdrop + inner panel (reduce “too white”) */
body.client-maintenance {
  background: #eef2f6;
  --cm-primary: var(--copilot-primary, #4A90E2);
  --cm-primary-dark: var(--copilot-primary-hover, #357ABD);
  --cm-border: var(--kairo-border-color, #DDE6ED);
  --cm-text-gray: var(--copilot-text-muted, #5A6C7D);
  --cm-text-dark: var(--copilot-text-main, #2C3E50);
  --cm-text-light: #8B98A5;
  --cm-success: #27AE60;
  --cm-warning: #F39C12;
  --cm-danger: #E74C3C;
  --cm-info: #3498DB;
}

body.client-maintenance .cm-workspace {
  padding: 0.6rem;
}

body.client-maintenance .cm-legacy-content {
  background: #f3f4f6;
  border: 1px solid rgba(15, 23, 42, 0.10);
  border-radius: 14px;
  padding: 0.6rem;
  overflow-y: auto;
  max-height: calc(100vh - 80px);
}

/* Fixed left/right panels with scrollable middle content */
body.client-maintenance .cm-shell-form {
  height: calc(100vh - 60px);
  max-height: calc(100vh - 60px);
}

body.client-maintenance .cm-legacy-nav {
  position: sticky;
  top: 0;
  align-self: start;
  max-height: calc(100vh - 80px);
  overflow-y: auto;
}

body.client-maintenance .cm-legacy-actions {
  position: sticky;
  top: 0;
  align-self: start;
  max-height: calc(100vh - 80px);
  overflow-y: auto;
}

body.client-maintenance .card-surface,
body.client-maintenance .cm-panel-card {
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(15, 23, 42, 0.04);
}
body.client-maintenance .form-label,
body.client-maintenance .cbs-label,
body.client-maintenance .bs-label {
  font-size: 0.78rem;
  margin-bottom: 1px;
  color: var(--copilot-text-muted, #5A6C7D);
}

/* Mandatory labels - preserve global styling with asterisk indicator */
body.client-maintenance .bs-label-mand {
  font-size: 0.78rem;
  margin-bottom: 1px;
  color: var(--copilot-primary, #4A90E2);
  font-weight: 700;
}

/* Keep workspace variables for any top-level fields that may need them */
body.client-maintenance .cm-workspace {
  --cm-label-width: 140px;
  --cm-label-gap: 10px;
}



@media (max-width: 720px) {
  body.client-maintenance .cm-workspace {
    --cm-label-width: 1fr;
    --cm-label-gap: 0;
  }

  body.client-maintenance .cm-workspace .cbs-field,
  body.client-maintenance .cm-workspace .cm-compact-field {
    grid-template-columns: 1fr;
    row-gap: 2px;
    align-items: start;
  }

  body.client-maintenance .cm-workspace .cbs-field > :not(.cbs-label):not(.form-label):not(.bs-label):not(.bs-label-mand),
  body.client-maintenance .cm-workspace .cm-compact-field > :not(.cbs-label):not(.form-label):not(.bs-label):not(.bs-label-mand) {
    grid-column: 1;
  }
}
body.client-maintenance .cm-stepper__trigger {
  min-height: 26px;
  height: 30px;
  font-size: 0.93rem;
  padding-top: 0.1rem;
  padding-bottom: 0.1rem;
}
/* Modern stepper navigation look */
body.client-maintenance .cm-stepper__nav {
  display: flex;
  gap: 0.5rem;
  padding: 0.5rem 0.5rem 0 0.5rem;
  background: transparent;
  border-bottom: 1.5px solid #e0e7ef;
  margin-bottom: 0.5rem;
}
body.client-maintenance .cm-stepper__trigger {
  background: none;
  border: none;
  border-radius: 1.5rem 1.5rem 0 0;
  padding: 0.5rem 1.2rem 0.45rem 1.2rem;
  font-size: 1rem;
  color: #334155;
  font-weight: 500;
  transition: background 0.18s, color 0.18s, box-shadow 0.18s;
  box-shadow: none;
  position: relative;
  outline: none;
}


body.client-maintenance .cm-stepper__trigger.is-active {
  background: #f5faff;
  color: #2563eb;
  font-weight: 700;
  box-shadow: 0 2px 8px 0 rgba(37,99,235,0.07);
  border-bottom: 2.5px solid #2563eb;
  z-index: 2;
}
body.client-maintenance .cm-stepper__trigger:not(.is-active):hover {
  background: #f1f5f9;
  color: #2563eb;
  cursor: pointer;
}
body.client-maintenance .cm-stepper__text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  font-weight: inherit;
}
/* Deepen input/select outlines for better visibility */
body.client-maintenance input.form-control,
body.client-maintenance select.form-select,
body.client-maintenance input.bs-input-text,
body.client-maintenance input.bs-input-date,
body.client-maintenance input.bs-input-number,
body.client-maintenance input.bs-input-email,
body.client-maintenance input.bs-input-tel,
body.client-maintenance select.bs-select {
  border: 2px solid #cbd5e1;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: border-color 0.2s, box-shadow 0.2s;
}
body.client-maintenance input.form-control:focus,
body.client-maintenance select.form-select:focus,
body.client-maintenance input.bs-input-text:focus,
body.client-maintenance input.bs-input-date:focus,
body.client-maintenance input.bs-input-number:focus,
body.client-maintenance input.bs-input-email:focus,
body.client-maintenance input.bs-input-tel:focus,
body.client-maintenance select.bs-select:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18);
}

/* Ensure TOP identifiers - see bottom of file for main styling */
body.client-maintenance .cm-top-identifiers__grid {
  align-items: center;
}

/* Left nav (Data Entry / View / Recent Activities) – closer to Role Maintenance */
body.client-maintenance .cm-legacy-nav {
  border-radius: 14px;
  border: 1px solid rgba(15, 23, 42, 0.10);
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(15, 23, 42, 0.04);
}

body.client-maintenance .cm-nav-section {
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 8px;
}

body.client-maintenance .cm-nav-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0;
  padding: 0;
  min-height: 30px;
  font-size: 11px;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(90deg, var(--cm-primary) 0%, var(--cm-primary-dark) 100%);
  border: 1px solid var(--cm-primary-dark);
  border-radius: 6px;
  box-shadow: 0 8px 18px rgba(53, 122, 189, 0.15);
}

body.client-maintenance .cm-nav-toggle:hover {
  filter: brightness(1.02);
}

body.client-maintenance .cm-nav-toggle__label {
  flex: 1;
  padding: 7px 10px;
  user-select: none;
  display: flex;
  align-items: center;
  font-size: 10px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
}

body.client-maintenance .cm-nav-toggle__label i.bi {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.80);
}

body.client-maintenance .cm-nav-toggle .cm-nav-toggle__chevron {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  margin-right: 0;
  border-left: 1px solid rgba(255, 255, 255, 0.28);
  border-top-right-radius: 6px;
  border-bottom-right-radius: 6px;
  color: rgba(255, 255, 255, 0.85);
  transition: transform 0.2s ease, background 0.2s ease;
}

body.client-maintenance .cm-nav-toggle .cm-nav-toggle__chevron:hover {
  background: rgba(255, 255, 255, 0.08);
}

body.client-maintenance .cm-nav-section.is-open .cm-nav-toggle {
  border-color: rgba(10, 107, 165, 0.65);
  box-shadow: 0 0 0 2px rgba(10, 107, 165, 0.10);
}

body.client-maintenance .cm-nav-section.is-open .cm-nav-toggle__label,
body.client-maintenance .cm-nav-section.is-open .cm-nav-toggle .cm-nav-toggle__chevron {
  color: rgba(255, 255, 255, 0.90);
}

body.client-maintenance .cm-nav-items {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0;
  margin-top: 6px;
  background: #ffffff;
  border: 1px solid var(--cm-border);
  border-radius: 6px;
  box-shadow: 0 8px 18px rgba(44, 62, 80, 0.06);
}

body.client-maintenance .cm-nav-items.is-collapsed {
  display: none !important;
}

body.client-maintenance .cm-legacy-nav__item {
  display: flex;
  align-items: center;
  flex-direction: row;
  justify-content: flex-start;
  gap: 8px;
  padding: 8px 10px;
  cursor: pointer;
  font-size: 11px;
  color: var(--cm-text-gray);
  white-space: nowrap;
  background: transparent;
  border: none;
  border-bottom: 1px solid rgba(10, 107, 165, 0.10);
  border-radius: 0;
  transition: all 0.2s ease;
}

/* Force modern sidebar rows (override shared styles.css “tiles”) */
body.client-maintenance[data-page="client-maintenance"] .cm-nav-items .cm-legacy-nav__item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  width: 100%;
  text-align: left;
  padding: 8px 10px;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.2;

  background: #ffffff;
  border: none;
  border-bottom: 1px solid rgba(10, 107, 165, 0.10);
  border-radius: 0;
  box-shadow: none;
  transform: none;
}

body.client-maintenance .cm-nav-items .cm-legacy-nav__item:last-child {
  border-bottom: none;
}

body.client-maintenance .cm-legacy-nav__item i.bi {
  font-size: 13px;
  color: var(--cm-text-light);
}

body.client-maintenance[data-page="client-maintenance"] .cm-nav-items .cm-legacy-nav__item i.bi {
  font-size: 14px;
  color: rgba(55, 65, 81, 0.65);
}

body.client-maintenance .cm-legacy-nav__item:hover {
  color: var(--cm-primary);
  background: rgba(10, 107, 165, 0.06);
  transform: none;
}

body.client-maintenance[data-page="client-maintenance"] .cm-nav-items .cm-legacy-nav__item:hover {
  background: rgba(10, 107, 165, 0.06);
  color: var(--cm-primary);
  box-shadow: none;
  transform: none;
}

body.client-maintenance .cm-legacy-nav__item.is-active {
  background: linear-gradient(90deg, var(--cm-primary) 0%, var(--cm-primary-dark) 100%);
  color: #ffffff;
  border-color: transparent;
  transform: none;
}

body.client-maintenance[data-page="client-maintenance"] .cm-nav-items .cm-legacy-nav__item.is-active {
  background: rgba(10, 107, 165, 0.10);
  color: var(--cm-primary);
  border-left: 3px solid var(--cm-primary);
}

body.client-maintenance .cm-legacy-nav__item.is-active i.bi {
  color: rgba(255, 255, 255, 0.90);
}

body.client-maintenance[data-page="client-maintenance"] .cm-nav-items .cm-legacy-nav__item.is-active i.bi {
  color: var(--cm-primary);
}

/* Layout tweak (only): give left menu more room by narrowing right actions. */
body.client-maintenance[data-page="client-maintenance"] .cm-shell-form {
  grid-template-columns: clamp(180px, 16vw, 260px) minmax(0, 1fr) clamp(96px, 7.5vw, 120px);
}

/* Right workflow buttons – more like Role Maintenance action bar */
body.client-maintenance .cm-legacy-actions {
  border-radius: 14px;
  border: 1px solid rgba(15, 23, 42, 0.10);
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(15, 23, 42, 0.04);
  background: #ffffff;
}

/* Keep the right panel compact so the left submenu labels don't wrap. */
body.client-maintenance[data-page="client-maintenance"] .cm-legacy-actions {
  padding: 10px 8px;
}

body.client-maintenance .cm-shell__action {
  padding: 6px 8px;
  border: 1px solid var(--cm-primary);
  background: #ffffff;
  color: var(--cm-primary);
  border-radius: 4px;
  cursor: pointer;
  font-size: 11px;
  font-family: inherit;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  white-space: nowrap;
}

body.client-maintenance[data-page="client-maintenance"] .cm-shell__action {
  padding: 5px 6px;
  font-size: 10px;
  gap: 0.35rem;
}

body.client-maintenance .cm-shell__action i.bi {
  font-size: 1rem;
  line-height: 1;
}

body.client-maintenance[data-page="client-maintenance"] .cm-shell__action i.bi {
  font-size: 0.95rem;
}

body.client-maintenance .cm-shell__action:hover {
  background: var(--cm-primary);
  color: #ffffff;
  transform: none;
  box-shadow: none;
}

/* Neutralize global filled button variants from styles.css for Client Maintenance */
body.client-maintenance[data-page="client-maintenance"] .cm-shell__action,
body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--ghost,
body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--success,
body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--accent,
body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--danger {
  background: #ffffff;
  box-shadow: none;
}

body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--success,
body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--danger {
  border: 1px solid currentColor;
}

body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--success:hover {
  background: var(--cm-success);
  border-color: var(--cm-success);
  color: #ffffff;
  filter: none;
}

body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--danger:hover {
  background: var(--cm-danger);
  border-color: var(--cm-danger);
  color: #ffffff;
  filter: none;
}

body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--accent:hover {
  background: var(--cm-info);
  border-color: var(--cm-info);
  color: #ffffff;
  filter: none;
}

body.client-maintenance[data-page="client-maintenance"] .cm-shell__action--ghost:hover {
  background: rgba(91, 159, 217, 0.08);
  border-color: rgba(91, 159, 217, 0.35);
  color: #1f2937;
  filter: none;
}

body.client-maintenance .cm-shell__action:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

body.client-maintenance .cm-shell__action--underline {
  text-decoration: underline;
  box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.16);
}

/* Mode switch (match modern-account-maintenance mapping) */
body.client-maintenance .cm-shell__action[data-shell-mode="View"] {
  border-color: var(--cm-info);
  color: var(--cm-info);
}

body.client-maintenance .cm-shell__action[data-shell-mode="Add"] {
  border-color: var(--cm-success);
  color: var(--cm-success);
}

body.client-maintenance .cm-shell__action[data-shell-mode="Update"] {
  border-color: var(--cm-warning);
  color: var(--cm-warning);
}

body.client-maintenance .cm-shell__action[data-shell-mode="View"]:hover,
body.client-maintenance .cm-shell__action[data-shell-mode="Add"]:hover,
body.client-maintenance .cm-shell__action[data-shell-mode="Update"]:hover {
  border-color: currentColor;
}

body.client-maintenance .cm-shell__action[data-shell-mode="View"]:hover { background: var(--cm-info); }
body.client-maintenance .cm-shell__action[data-shell-mode="Add"]:hover { background: var(--cm-success); }
body.client-maintenance .cm-shell__action[data-shell-mode="Update"]:hover { background: var(--cm-warning); }

body.client-maintenance .cm-shell__action--ghost {
  border-color: var(--cm-primary);
  color: var(--cm-primary);
}

body.client-maintenance .cm-shell__action--ghost:hover {
  background: var(--cm-primary);
  color: #ffffff;
}

body.client-maintenance .cm-shell__action--success {
  border-color: var(--cm-primary);
  color: var(--cm-primary);
}

body.client-maintenance .cm-shell__action--accent {
  border-color: var(--cm-success);
  color: var(--cm-success);
}

body.client-maintenance .cm-shell__action--danger {
  border-color: var(--cm-danger);
  color: var(--cm-danger);
}

body.client-maintenance .cm-shell__action--accent:hover {
  background: var(--cm-success);
}

body.client-maintenance .cm-shell__action--danger:hover {
  background: var(--cm-danger);
}

body.client-maintenance .cm-shell__action[data-submit-action="clear"] {
  border-color: var(--cm-warning);
  color: var(--cm-warning);
}

body.client-maintenance .cm-shell__action[data-submit-action="clear"]:hover {
  background: var(--cm-warning);
}

/* Behind the scenes – card header like Role Maintenance */
body.client-maintenance .cm-collapsible-head {
  background: linear-gradient(90deg, var(--cm-primary) 0%, var(--cm-primary-dark) 100%);
  color: #ffffff;
  padding: 4px 8px;
  font-weight: 700;
  font-size: 10.5px;
  border: 1px solid var(--cm-primary-dark);
  border-radius: 4px;
  box-shadow: 0 6px 16px rgba(44, 62, 80, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

body.client-maintenance .cm-collapsible-head .section-title {
  color: #ffffff;
  background: transparent;
  border: 0;
  padding: 0;
  margin: 0;
  border-radius: 0;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 10.5px;
}

body.client-maintenance .cm-collapsible-toggle {
  color: #ffffff;
  background: transparent;
  border: none;
  width: 28px;
  height: 28px;
  border-radius: 4px;
}

body.client-maintenance .cm-collapsible-toggle:hover {
  background: rgba(255, 255, 255, 0.10);
}

/* Behind the scenes cards: override global audit-card styles for this page */
body.client-maintenance[data-page="client-maintenance"] .cm-audit__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 10px;
  overflow: visible;
  padding-bottom: 0;
}

body.client-maintenance[data-page="client-maintenance"] .audit-card {
  flex: initial;
  background: #ffffff;
  border: 1px solid var(--cm-border);
  border-radius: 4px;
  padding: 8px 10px;
  box-shadow: 0 6px 16px rgba(44, 62, 80, 0.06);
}

body.client-maintenance[data-page="client-maintenance"] .audit-card .card-label {
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 0.08em;
  color: var(--cm-text-gray);
  margin: 0 0 4px;
  font-weight: 700;
}

body.client-maintenance[data-page="client-maintenance"] .audit-card .card-value {
  font-weight: 700;
  font-size: 11px;
  margin: 0;
  color: var(--cm-text-dark);
}
/* Client Maintenance specific styling.
   Scoped under body.client-maintenance to avoid global conflicts. */

body.client-maintenance .cm-other-details__title {
  font-weight: 700;
  letter-spacing: 0.2px;
}

body.client-maintenance .cm-other-details__grid {
  align-items: start;
}

body.client-maintenance .cm-other-details__card {
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  padding: 12px;
}

body.client-maintenance .cm-other-details__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 6px 0;
  border-bottom: 1px dashed rgba(0, 0, 0, 0.08);
}

body.client-maintenance .cm-other-details__row:last-of-type {
  border-bottom: none;
}

body.client-maintenance .cm-other-details__label {
  margin: 0;
  font-weight: 600;
  color: #1f2a37;
  font-size: 0.9rem;
}

body.client-maintenance .cm-other-details__field {
  margin-top: 10px;
}

body.client-maintenance .cm-other-details__toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 10px;
}

body.client-maintenance .cm-other-details__toggle-label {
  font-weight: 700;
  color: #0d6efd;
  font-size: 0.9rem;
}

body.client-maintenance .cm-other-details__card .btn-group .btn {
  border-radius: 10px;
  padding: 0.25rem 0.6rem;
}

body.client-maintenance .cm-other-details__card .btn-check:checked + .btn {
  box-shadow: 0 6px 16px rgba(13, 110, 253, 0.25);
}

body.client-maintenance .cm-other-details__cond-label {
  font-weight: 700;
  color: #0d6efd;
  font-size: 0.9rem;
  margin-bottom: 0.25rem;
}

/* Conditional blocks: match legacy positioning (left field(s) + right field(s) on same row) */
body.client-maintenance .cm-other-details__cond-grid {
  display: grid;
  grid-template-columns: minmax(180px, 260px) minmax(180px, 1fr) minmax(140px, 240px) minmax(180px, 1fr);
  column-gap: 14px;
  row-gap: 8px;
  align-items: center;
}

body.client-maintenance .cm-other-details__inline {
  margin-top: 8px;
  padding-left: 2px;
}

body.client-maintenance .cm-other-details__inline .cm-other-details__cond-grid {
  /* Keep it compact when nested under toggles */
  row-gap: 6px;
}

body.client-maintenance .cm-other-details__cond-grid .cm-other-details__cond-label {
  margin: 0;
  white-space: nowrap;
}

body.client-maintenance .cm-other-details__cond-spacer {
  display: block;
}

@media (max-width: 991.98px) {
  body.client-maintenance .cm-other-details__cond-grid {
    grid-template-columns: minmax(160px, 240px) 1fr;
  }

  body.client-maintenance .cm-other-details__cond-spacer {
    display: none;
  }
}

/* Keep form controls compact within the Other Details tab */
body.client-maintenance .cm-other-details__card .form-control,
body.client-maintenance .cm-other-details__card .form-select,
body.client-maintenance .cm-other-details__card .bs-input-text,
body.client-maintenance .cm-other-details__card .bs-input-date,
body.client-maintenance .cm-other-details__card .bs-input-number,
body.client-maintenance .cm-other-details__card .bs-input-email,
body.client-maintenance .cm-other-details__card .bs-input-tel,
body.client-maintenance .cm-other-details__card .bs-select {
  font-size: 0.9rem;
}

/* Reduce vertical footprint for conditional blocks */
body.client-maintenance .cm-other-details__card--cond {
  padding-top: 10px;
  padding-bottom: 10px;
}

/* Client Relations step */
body.client-maintenance .cm-relations__actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 10px;
}

body.client-maintenance [data-table="relations"] th,
body.client-maintenance [data-table="relations"] td {
  vertical-align: middle;
  white-space: nowrap;
}

body.client-maintenance [data-table="relations"] tbody tr.is-selected {
  background: rgba(13, 110, 253, 0.08);
}

/* ============================================================
   STEPPER PERSONAL/ADDRESS: Label | Input | Label | Input layout
   Using 2-column grid where each field has internal label-left layout
   ============================================================ */

/* Parent grid: 2 equal columns (each column holds one field with label|input) */
body.client-maintenance .cm-stepper__panels .cm-personal-grid {
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  column-gap: 20px !important;
  row-gap: 6px !important;
  align-items: center !important;
}

/* Column wrappers become transparent */
body.client-maintenance .cm-stepper__panels .cm-personal-grid > .cm-personal-column {
  display: contents !important;
}

/* Each field: internal 2-column grid (label | input) */
body.client-maintenance .cm-stepper__panels .cm-personal-grid .cbs-field,
body.client-maintenance .cm-stepper__panels .cm-personal-grid .cm-compact-field {
  display: grid !important;
  grid-template-columns: 140px minmax(0, 1fr) !important;
  column-gap: 8px !important;
  align-items: center !important;
}

/* Labels */
body.client-maintenance .cm-stepper__panels .cm-personal-grid .cbs-label,
body.client-maintenance .cm-stepper__panels .cm-personal-grid .form-label,
body.client-maintenance .cm-stepper__panels .cm-personal-grid .bs-label {
  margin: 0 !important;
  padding: 0 !important;
  grid-column: 1 !important;
  color: var(--copilot-text-muted, #5A6C7D) !important;
}

body.client-maintenance .cm-stepper__panels .cm-personal-grid .bs-label-mand {
  margin: 0 !important;
  padding: 0 !important;
  grid-column: 1 !important;
  color: var(--copilot-primary, #4A90E2) !important;
  font-weight: 700 !important;
}

/* Inputs */
body.client-maintenance .cm-stepper__panels .cm-personal-grid input,
body.client-maintenance .cm-stepper__panels .cm-personal-grid select,
body.client-maintenance .cm-stepper__panels .cm-personal-grid .input-group {
  grid-column: 2 !important;
  width: 100% !important;
  min-width: 0 !important;
}

/* Same for cbs-grid--four (Address tab, etc.) */
body.client-maintenance .cm-stepper__panels .cbs-grid--four {
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  column-gap: 20px !important;
  row-gap: 6px !important;
  align-items: center !important;
}

body.client-maintenance .cm-stepper__panels .cbs-grid--four > .cbs-field,
body.client-maintenance .cm-stepper__panels .cbs-grid--four > .cm-compact-field {
  display: grid !important;
  grid-template-columns: 140px minmax(0, 1fr) !important;
  column-gap: 8px !important;
  align-items: center !important;
}

body.client-maintenance .cm-stepper__panels .cbs-grid--four .cbs-label,
body.client-maintenance .cm-stepper__panels .cbs-grid--four .form-label,
body.client-maintenance .cm-stepper__panels .cbs-grid--four .bs-label {
  margin: 0 !important;
  padding: 0 !important;
  grid-column: 1 !important;
  color: var(--copilot-text-muted, #5A6C7D) !important;
}

body.client-maintenance .cm-stepper__panels .cbs-grid--four .bs-label-mand {
  margin: 0 !important;
  padding: 0 !important;
  grid-column: 1 !important;
  color: var(--copilot-primary, #4A90E2) !important;
  font-weight: 700 !important;
}

body.client-maintenance .cm-stepper__panels .cbs-grid--four input,
body.client-maintenance .cm-stepper__panels .cbs-grid--four select,
body.client-maintenance .cm-stepper__panels .cbs-grid--four .input-group {
  grid-column: 2 !important;
  width: 100% !important;
  min-width: 0 !important;
}

/* Responsive: single column on narrow screens */
@media (max-width: 900px) {
  body.client-maintenance .cm-stepper__panels .cm-personal-grid,
  body.client-maintenance .cm-stepper__panels .cbs-grid--four {
    grid-template-columns: 1fr !important;
  }
}

/* ============================================================
   TAB PADDING FIXES: Client Relations, Employment, Products
   ============================================================ */

/* ============================================
   UNIFORM PANEL STYLING FOR ALL STEPPER TABS
   ============================================ */

/* Base panel styling for all tabs */
body.client-maintenance .cm-stepper__panel {
  padding: 0.75rem !important;
}

body.client-maintenance .cm-stepper__panel .cm-panel-card {
  padding: 1rem !important;
  border-radius: 8px;
  background: #fff;
}

/* Uniform grid styling across all tabs */
body.client-maintenance .cm-stepper__panel .cbs-grid--four .cbs-field.cbs-full {
  grid-column: span 1 !important;
}

/* ============================================
   INPUT-GROUP FIX (lookup buttons inline)
   ============================================ */

/* Fix all input-groups across all panels to display inline */
body.client-maintenance .cm-stepper__panel .input-group {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: stretch !important;
}

body.client-maintenance .cm-stepper__panel .input-group > .form-control,
body.client-maintenance .cm-stepper__panel .input-group > .bs-input-text,
body.client-maintenance .cm-stepper__panel .input-group > [class^="bs-input-"] {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  border-top-right-radius: 0 !important;
  border-bottom-right-radius: 0 !important;
}

body.client-maintenance .cm-stepper__panel .input-group > .btn {
  flex: 0 0 auto !important;
  border-top-left-radius: 0 !important;
  border-bottom-left-radius: 0 !important;
  margin-left: -1px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 0.5rem !important;
  min-width: 36px !important;
}

/* Ensure input-group doesn't break to column in nested grid */
body.client-maintenance .cm-stepper__panel .cbs-field .input-group,
body.client-maintenance .cm-stepper__panel .cm-compact-field .input-group {
  grid-column: 2 !important;
  width: 100% !important;
}

/* ============================================
   UNIVERSAL 2-COLUMN FORM ROW LAYOUT
   ============================================ */
body.client-maintenance .cm-form-row {
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  gap: 0.3rem 1.5rem !important;
  margin-bottom: 0.25rem !important;
}

body.client-maintenance .cm-form-row .cbs-field {
  display: grid !important;
  grid-template-columns: minmax(120px, auto) 180px !important;
  column-gap: 0.4rem !important;
  align-items: center !important;
  justify-content: end !important;
}

body.client-maintenance .cm-form-row .cbs-field > .cbs-label,
body.client-maintenance .cm-form-row .cbs-field > .bs-label {
  margin: 0 !important;
  white-space: nowrap !important;
  text-align: right !important;
  font-size: 0.72rem !important;
  justify-self: end !important;
  color: var(--copilot-text-muted, #5A6C7D) !important;
}

body.client-maintenance .cm-form-row .cbs-field > .bs-label-mand {
  margin: 0 !important;
  white-space: nowrap !important;
  text-align: right !important;
  font-size: 0.72rem !important;
  justify-self: end !important;
  color: var(--copilot-primary, #4A90E2) !important;
  font-weight: 700 !important;
}

body.client-maintenance .cm-form-row .cbs-field > .form-control,
body.client-maintenance .cm-form-row .cbs-field > .form-select,
body.client-maintenance .cm-form-row .cbs-field > .bs-input-text,
body.client-maintenance .cm-form-row .cbs-field > .bs-input-date,
body.client-maintenance .cm-form-row .cbs-field > .bs-input-number,
body.client-maintenance .cm-form-row .cbs-field > .bs-input-email,
body.client-maintenance .cm-form-row .cbs-field > .bs-input-tel,
body.client-maintenance .cm-form-row .cbs-field > .bs-select {
  width: 180px !important;
  min-width: 180px !important;
  max-width: 180px !important;
}

body.client-maintenance .cm-form-row .cbs-field > .input-group {
  width: 180px !important;
  min-width: 180px !important;
  max-width: 180px !important;
  display: flex !important;
  flex-wrap: nowrap !important;
}

body.client-maintenance .cm-form-row .cbs-field > .input-group > .form-control,
body.client-maintenance .cm-form-row .cbs-field > .input-group > .bs-input-text,
body.client-maintenance .cm-form-row .cbs-field > .input-group > [class^="bs-input-"] {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  width: auto !important;
}

body.client-maintenance .cm-form-row .cbs-field > .input-group > .btn {
  flex: 0 0 auto !important;
}

body.client-maintenance .cm-form-row .cbs-field > .form-check {
  justify-self: start !important;
}

/* Checkbox field styling */
body.client-maintenance .cm-form-row .cbs-field--checkbox .form-check {
  margin: 0 !important;
  padding-left: 0 !important;
}

body.client-maintenance .cm-form-row .cbs-field--checkbox .form-check-input {
  margin-left: 0 !important;
}

/* Input group inline */
body.client-maintenance .cm-form-row .input-group {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
}

body.client-maintenance .cm-form-row .input-group > .form-control,
body.client-maintenance .cm-form-row .input-group > .bs-input-text,
body.client-maintenance .cm-form-row .input-group > [class^="bs-input-"] {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  border-top-right-radius: 0 !important;
  border-bottom-right-radius: 0 !important;
}

body.client-maintenance .cm-form-row .input-group > .btn {
  flex: 0 0 auto !important;
  border-top-left-radius: 0 !important;
  border-bottom-left-radius: 0 !important;
  margin-left: -1px !important;
}

/* Responsive - single column on narrow screens */
@media (max-width: 768px) {
  body.client-maintenance .cm-form-row {
    grid-template-columns: 1fr !important;
  }
}

/* Full width row modifier */
body.client-maintenance .cm-form-row--full {
  grid-template-columns: 1fr !important;
}

body.client-maintenance .cm-form-row--full .cbs-field {
  display: grid !important;
