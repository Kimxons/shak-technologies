body.client-maintenance .cm-form-row--full .cbs-field > .form-select,
body.client-maintenance .cm-form-row--full .cbs-field > .bs-input-text,
body.client-maintenance .cm-form-row--full .cbs-field > .bs-input-date,
body.client-maintenance .cm-form-row--full .cbs-field > .bs-input-number,
body.client-maintenance .cm-form-row--full .cbs-field > .bs-input-email,
body.client-maintenance .cm-form-row--full .cbs-field > .bs-input-tel,
body.client-maintenance .cm-form-row--full .cbs-field > .bs-select {
  width: 100% !important;
  min-width: 0 !important;
  max-width: none !important;
}

body.client-maintenance .cm-form-row--full .cbs-field > .input-group {
  width: 100% !important;
  min-width: 0 !important;
  max-width: none !important;
}

