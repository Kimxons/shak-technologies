<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Loan Application Projection - Loan Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="../../assets/css/styles.css">
</head>
<body>
    <div class="window">
        <div class="main-container">
            <!-- Form Content -->
            <div class="form-content">
                <div class="form-card" data-main-form>

                    <!-- Identification Section -->
                    <div class="form-section" data-section="identification">
                        <div class="section-header" data-section-toggle>
                            <span class="section-header__title"><i class="bi bi-card-checklist"></i>Identification</span>
                            <button type="button" class="section-toggle-btn" aria-label="Toggle Identification" aria-expanded="true">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>
                        <div class="section-content" data-section-content>
                            <div class="form-row two-col">
                                <div class="col">
                                    <label class="label-blue">Branch</label>
                                    <div class="kairo-branch-control" data-kairo-branch-control>
                                        <input type="text" id="BranchID" value="0101" class="kairo-branch-control__id" aria-label="Branch ID">
                                        <input type="text" id="BranchName" value="Head Office" class="kairo-branch-control__name" aria-label="Branch Name" placeholder="Branch Name" readonly>
                                        <button type="button" class="btn-lookup kairo-branch-control__lookup" data-target-input="BranchID" aria-label="Search Branch"><i class="bi bi-search"></i></button>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="label-blue">Center ID</label>
                                    <div class="kairo-client-control" data-kairo-client-control>
                                        <input type="text" id="CenterID" class="kairo-client-control__id" aria-label="Center ID">
                                        <input type="text" id="CenterName" class="kairo-client-control__name" aria-label="Center Name" placeholder="Center Name" readonly>
                                        <button type="button" class="btn-lookup kairo-client-control__lookup" data-target-input="CenterID" aria-label="Search Center"><i class="bi bi-search"></i></button>
                                    </div>
                                </div>
                            </div>

              <!-- Center ID -->
              <div class="cbs-field">
                <label class="cbs-label required" for="centerId">Center ID</label>
                <div class="input-group">
                  <input type="text" class="form-control" id="centerId" name="centerId" style="flex: 0 0 80px;" />
                  <input type="text" class="form-control" id="centerName" name="centerName" readonly />
                  <button class="btn btn-outline-primary" type="button" aria-label="Search center">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
              </div>

              <!-- Group ID -->
              <div class="cbs-field">
                <label class="cbs-label required" for="groupId">Group ID</label>
                <div class="input-group">
                  <input type="text" class="form-control" id="groupId" name="groupId" style="flex: 0 0 80px;" />
                  <input type="text" class="form-control" id="groupName" name="groupName" readonly />
                  <button class="btn btn-outline-primary" type="button" aria-label="Search group">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
              </div>

              <!-- Scheme ID -->
              <div class="cbs-field">
                <label class="cbs-label" for="schemeId">Scheme ID</label>
                <div class="input-group">
                  <input type="text" class="form-control" id="schemeId" name="schemeId" style="flex: 0 0 80px;" />
                  <input type="text" class="form-control" id="schemeName" name="schemeName" readonly />
                  <button class="btn btn-outline-primary" type="button" aria-label="Search scheme">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
              </div>

              <!-- Product ID -->
              <div class="cbs-field">
                <label class="cbs-label required" for="productId">Product ID</label>
                <div class="input-group">
                  <input type="text" class="form-control" id="productId" name="productId" style="flex: 0 0 80px;" />
                  <input type="text" class="form-control" id="productName" name="productName" readonly />
                  <button class="btn btn-outline-primary" type="button" aria-label="Search product">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
              </div>

              <!-- Donor ID -->
              <div class="cbs-field">
                <label class="cbs-label" for="donorId">Donor ID</label>
                <div class="input-group">
                  <input type="text" class="form-control" id="donorId" name="donorId" style="flex: 0 0 80px;" />
                  <input type="text" class="form-control" id="donorName" name="donorName" readonly />
                  <button class="btn btn-outline-primary" type="button" aria-label="Search donor">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
              </div>

              <!-- Disbursement Date -->
              <div class="cbs-field">
                <label class="cbs-label" for="disbursementDate">Disbursement Date</label>
                <select class="form-select" id="disbursementDate" name="disbursementDate">
                  <option value="">--Select--</option>
                </select>
              </div>

              <!-- Advance Type -->
              <div class="cbs-field">
                <label class="cbs-label" for="advanceType">Advance Type</label>
                <input type="text" class="form-control" id="advanceType" name="advanceType" />
              </div>

              <!-- Mode Of Disbursement -->
              <div class="cbs-field">
                <label class="cbs-label" for="modeOfDisbursement">Mode Of Disbursement</label>
                <select class="form-select" id="modeOfDisbursement" name="modeOfDisbursement">
                  <option value="">--Select--</option>
                  <option value="cash">Cash</option>
                  <option value="cheque">Cheque</option>
                  <option value="transfer">Transfer</option>
                </select>
              </div>

              <!-- Credit Officer -->
              <div class="cbs-field">
                <label class="cbs-label" for="creditOfficer">Credit Officer</label>
                <input type="text" class="form-control" id="creditOfficer" name="creditOfficer" />
              </div>

              <!-- File Number -->
              <div class="cbs-field">
                <label class="cbs-label" for="fileNumber">File Number</label>
                <input type="text" class="form-control" id="fileNumber" name="fileNumber" />
              </div>

              <!-- Currency ID -->
              <div class="cbs-field">
                <label class="cbs-label" for="currencyId">Currency ID</label>
                <input type="text" class="form-control" id="currencyId" name="currencyId" />
              </div>

              <!-- Loan Purpose -->
              <div class="cbs-field">
                <label class="cbs-label" for="loanPurpose">Loan Purpose</label>
                <select class="form-select" id="loanPurpose" name="loanPurpose">
                  <option value="">--Select--</option>
                </select>
              </div>

              <!-- Line Of Business -->
              <div class="cbs-field">
                <label class="cbs-label" for="lineOfBusiness">Line Of Business</label>
                <select class="form-select" id="lineOfBusiness" name="lineOfBusiness">
                  <option value="">--Select--</option>
                </select>
              </div>
            </div>
            </div>
          </div>

          <!-- Client & Loan Details Section - Collapsible -->
          <div class="form-section">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title">Client & Loan Details</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Client & Loan Details" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
              <div class="cbs-grid cbs-grid--two">
              <!-- Client ID -->
              <div class="cbs-field">
                <label class="cbs-label" for="clientId">Client ID</label>
                <input type="text" class="form-control" id="clientId" name="clientId" />
              </div>

              <!-- Main Repayment Account -->
              <div class="cbs-field">
                <label class="cbs-label" for="mainRepaymentAccount">Main Repayment Account</label>
                <div class="input-group">
                  <input type="text" class="form-control" id="mainRepaymentAccount" name="mainRepaymentAccount" />
                  <button class="btn btn-outline-primary" type="button" aria-label="Search account">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
              </div>

              <!-- Loan Amount -->
              <div class="cbs-field">
                <label class="cbs-label" for="loanAmount">Loan Amount</label>
                <input type="text" class="form-control" id="loanAmount" name="loanAmount" />
              </div>

              <!-- Loan Cycle -->
              <div class="cbs-field">
                <label class="cbs-label" for="loanCycle">Loan Cycle</label>
                <input type="text" class="form-control" id="loanCycle" name="loanCycle" />
              </div>

              <!-- Loan Level -->
              <div class="cbs-field">
                <label class="cbs-label" for="loanLevel">Loan Level</label>
                <input type="text" class="form-control" id="loanLevel" name="loanLevel" />
              </div>

              <!-- Group Class -->
              <div class="cbs-field">
                <label class="cbs-label" for="groupClass">Group Class</label>
                <input type="text" class="form-control" id="groupClass" name="groupClass" />
              </div>

              <!-- Term -->
              <div class="cbs-field">
                <label class="cbs-label" for="term">Term</label>
                <input type="text" class="form-control" id="term" name="term" />
              </div>

              <!-- Repayment Term -->
              <div class="cbs-field">
                <label class="cbs-label" for="repaymentTerm">Repayment Term</label>
                <input type="text" class="form-control" id="repaymentTerm" name="repaymentTerm" />
              </div>

              <!-- Interest Rate -->
              <div class="cbs-field">
                <label class="cbs-label" for="interestRate">Interest Rate</label>
                <input type="text" class="form-control" id="interestRate" name="interestRate" />
              </div>

              <!-- Grace Period -->
              <div class="cbs-field">
                <label class="cbs-label" for="gracePeriod">Grace Period</label>
                <input type="text" class="form-control" id="gracePeriod" name="gracePeriod" />
              </div>

              <!-- Loan Period -->
              <div class="cbs-field">
                <label class="cbs-label" for="loanPeriod">Loan Period</label>
                <input type="text" class="form-control" id="loanPeriod" name="loanPeriod" />
              </div>
            </div>

            <!-- Inline Action Buttons -->
            <div class="d-flex gap-2 mt-3">
              <button type="button" class="btn btn-outline-secondary btn-sm" id="btnAlter">
                <i class="bi bi-arrow-repeat me-1"></i>Alter
              </button>
              <button type="button" class="btn btn-outline-primary btn-sm" id="btnUpdate">
                <i class="bi bi-check-circle me-1"></i>Update
              </button>
              <button type="button" class="btn btn-outline-danger btn-sm" id="btnClear">
                <i class="bi bi-x-circle me-1"></i>Clear
              </button>
            </div>
            </div>
          </div>

          <!-- Application Details Table - Collapsible -->
          <div class="form-section">
            <div class="section-header" data-section-toggle>
              <span class="section-header__title">Application Details</span>
              <button type="button" class="section-toggle-btn" aria-label="Toggle Application Details" aria-expanded="true">
                <i class="bi bi-chevron-up"></i>
              </button>
            </div>
            <div class="section-content" data-section-content>
            <div class="table-responsive">
              <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th style="width: 40px;"></th>
                    <th>Group ID</th>
                    <th>Client ID</th>
                    <th>Name</th>
                    <th>Loan Cycle No.</th>
                    <th>Loan Level No</th>
                    <th>Loan Amount</th>
                    <th>Loan Term</th>
                    <th>Loan Period</th>
                    <th>Repayment Term</th>
                    <th>Repayment Frequency</th>
                    <th>Interest Rate</th>
                    <th>Penalty Rate</th>
                    <th>Total Savings Balance</th>
                  </tr>
                </thead>
                <tbody id="applicationTableBody">
                  <tr>
                    <td colspan="14" class="text-center text-muted py-3">No records to display.</td>
                  </tr>
                </tbody>
              </table>
            </div>
            </div>
          </div>

        </div>

        <!-- RIGHT PANEL: Actions (Modernized) -->
        <div class="action-panel">
        <!-- Quick Links -->
        <div class="nav-group">
          <span>Quick Links</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <button type="button" class="btn-action" data-action="group-detail">
            <i class="bi bi-people-fill me-1"></i>Group Detail
          </button>
          <button type="button" class="btn-action" data-action="image">
            <i class="bi bi-card-image me-1"></i>Image
          </button>
        </div>

        <div class="action-buttons">
          <div class="nav-group border-0 mb-1 mt-2">
             <span>Actions</span>
          </div>
          <!-- View/Add/Edit Group -->
          <button type="button" class="btn-action btn-view" data-shell-mode="View">
            <i class="bi bi-eye-fill me-1"></i>View
          </button>
          <button type="button" class="btn-action" data-shell-mode="Add" disabled>
            <i class="bi bi-plus-lg me-1"></i>Add
          </button>
          <button type="button" class="btn-action" data-shell-mode="Update" disabled>
            <i class="bi bi-pencil-fill me-1"></i>Edit
          </button>

          <hr style="margin: 4px 0; border-color: #e2e8f0; opacity: 0.5;">

          <!-- Save/Cancel Group -->
          <button type="button" class="btn-action btn-save" data-submit-action="save" disabled>
            <i class="bi bi-check-lg me-1"></i>Done
          </button>
          <button type="button" class="btn-action btn-cancel" data-submit-action="cancel" disabled>
            <i class="bi bi-x-lg me-1"></i>Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="../../assets/js/environment.js"></script>
  <script src="../../assets/js/auth/auth.config.js"></script>
  <script src="../../assets/js/auth/auth.service.js"></script>
  <script src="../../assets/js/app.js"></script>
  <script src="group-loan-projection.js"></script>
</body>
</html>
