<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loan Appraisal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="loan-appraisal.css">
</head>
<body>
    <div class="appraisal-container">
        <!-- Main Content -->
        <div class="appraisal-content">
            <div class="content-scroll">
                <!-- Header Section -->
                <div class="header-section">
                    <div class="header-grid">
                        <div class="form-group">
                            <label for="branchId"><i class="bi bi-building"></i> Branch ID</label>
                            <div class="input-display-group">
                                <input type="text" id="branchId" class="form-input-segment-id" placeholder="Enter Branch ID">
                                <span class="segment-divider"></span>
                                <input type="text" id="branchName" class="form-input-segment-name" placeholder="Branch Name" readonly>
                                <button class="search-icon-btn-inline" title="Search Branch">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="workflowTypeId"><i class="bi bi-diagram-3"></i> WorkFlow Type ID</label>
                            <div class="input-display-group">
                                <input type="text" id="workflowTypeId" class="form-input-segment-id" readonly>
                                <span class="segment-divider"></span>
                                <input type="text" id="workflowTypeName" class="form-input-segment-name" readonly>
                                <button class="search-icon-btn-inline" title="Search Workflow Type">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="applicationId"><i class="bi bi-file-text"></i> Application ID</label>
                            <div class="input-display-group">
                                <input type="text" id="applicationId" class="form-input-segment-id" placeholder="Enter Application ID">
                                <span class="segment-divider"></span>
                                <input type="text" id="applicationName" class="form-input-segment-name" placeholder="Application Name" readonly>
                                <button class="search-icon-btn-inline" title="Search Application">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="applicationDate"><i class="bi bi-calendar-event"></i> Application Date</label>
                            <input type="date" id="applicationDate" class="form-input" readonly>
                        </div>
                    </div>
                </div>

                <!-- Recommendation Details -->
                <div class="form-card">
                    <div class="card-header">
                        <h3><i class="bi bi-clipboard-check"></i> Recommendation Details</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-grid-recommendation">
                            <div class="form-group checkbox-group">
                                <label>
                                    <input type="checkbox" id="createNewAccount">
                                    Create New Account
                                </label>
                            </div>

                            <div class="form-group full-width">
                                <label for="existingAccountId"><i class="bi bi-wallet2"></i> Existing Account ID</label>
                                <div class="input-display-group">
                                    <input type="text" id="existingAccountId" class="form-input-segment-id" readonly>
                                    <span class="segment-divider"></span>
                                    <input type="text" id="existingAccountName" class="form-input-segment-name" readonly>
                                    <button class="search-icon-btn-inline" title="Search Account">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="amount-comparison">
                                <div class="comparison-header">
                                    <span></span>
                                    <span class="col-label">Applied</span>
                                    <span class="col-label">Recommended</span>
                                </div>

                                <div class="comparison-row">
                                    <label><i class="bi bi-cash-stack"></i> Loan Amount</label>
                                    <input type="number" id="loanAmountApplied" class="form-input" placeholder="0.00" step="0.01" readonly>
                                    <input type="number" id="loanAmountRecommended" class="form-input" placeholder="0.00" step="0.01">
                                </div>

                                <div class="comparison-row">
                                    <label><i class="bi bi-clock-history"></i> Term</label>
                                    <input type="number" id="termApplied" class="form-input" placeholder="0" readonly>
                                    <input type="number" id="termRecommended" class="form-input" placeholder="0">
                                </div>

                                <div class="comparison-row">
                                    <label><i class="bi bi-calendar-range"></i> Repayment Frequency</label>
                                    <input type="text" id="repaymentFrequencyApplied" class="form-input" readonly>
                                    <select id="repaymentFrequencyRecommended" class="form-input">
                                        <option value="">--Select--</option>
                                        <option value="daily">Daily</option>
                                        <option value="weekly">Weekly</option>
                                        <option value="bi-weekly">Bi-Weekly</option>
                                        <option value="monthly">Monthly</option>
                                        <option value="quarterly">Quarterly</option>
                                        <option value="semi-annually">Semi-Annually</option>
                                        <option value="yearly">Yearly</option>
                                    </select>
                                </div>

                                <div class="comparison-row">
                                    <label><i class="bi bi-calendar3"></i> Repayment Term</label>
                                    <input type="text" id="repaymentTermApplied" class="form-input" readonly>
                                    <input type="number" id="repaymentTermRecommended" class="form-input" placeholder="0">
                                </div>

                                <div class="comparison-row">
                                    <label><i class="bi bi-wallet"></i> Approved Amount</label>
                                    <input type="number" id="approvedAmountApplied" class="form-input" placeholder="0.00" step="0.01" readonly>
                                    <input type="number" id="approvedAmountRecommended" class="form-input" placeholder="0.00" step="0.01">
                                </div>

                                <div class="comparison-row">
                                    <label><i class="bi bi-percent"></i> Marking Rate</label>
                                    <input type="number" id="markingRateApplied" class="form-input" placeholder="0.00" step="0.01" readonly>
                                    <div class="input-with-spinner">
                                        <input type="number" id="markingRateRecommended" class="form-input" placeholder="0.00" step="0.01">
                                        <div class="spinner-controls">
                                            <button class="spinner-btn" onclick="incrementMarkingRate()">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                            <button class="spinner-btn" onclick="decrementMarkingRate()">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="comparison-row">
                                    <label><i class="bi bi-percent"></i> Interest Rate</label>
                                    <input type="number" id="interestRateApplied" class="form-input" placeholder="0.00" step="0.01" readonly>
                                    <input type="number" id="interestRateRecommended" class="form-input" placeholder="0.00" step="0.01">
                                </div>

                                <div class="comparison-row">
                                    <label><i class="bi bi-tag"></i> Account Class</label>
                                    <input type="text" id="accountClassApplied" class="form-input" readonly>
                                    <select id="accountClassRecommended" class="form-input">
                                        <option value="">--Select--</option>
                                        <option value="normal">Normal</option>
                                        <option value="special">Special Mention</option>
                                        <option value="substandard">Substandard</option>
                                        <option value="doubtful">Doubtful</option>
                                        <option value="loss">Loss</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group full-width">
                                <label for="remarks"><i class="bi bi-chat-left-text"></i> Remarks</label>
                                <textarea id="remarks" class="form-textarea" rows="3" placeholder="Enter remarks"></textarea>
                            </div>

                            <div class="form-grid-recommendation">
                                <div class="form-group">
                                    <label for="interestRateType"><i class="bi bi-sliders"></i> Interest Rate Type</label>
                                    <input type="text" id="interestRateType" class="form-input" readonly>
                                </div>

                                <div class="form-group">
                                    <label for="baseRate"><i class="bi bi-bar-chart"></i> Base Rate</label>
                                    <input type="number" id="baseRate" class="form-input" placeholder="0.00" step="0.01" readonly>
                                </div>

                                <div class="form-group">
                                    <label for="loanType"><i class="bi bi-file-earmark-check"></i> Loan Type</label>
                                    <input type="text" id="loanType" class="form-input" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Behind The Scene -->
                <div class="form-card">
                    <div class="card-header">
                        <h3><i class="bi bi-eye-slash"></i> Behind The Scene</h3>
                    </div>
                    <div class="card-body">
                        <div class="scene-grid">
                            <div class="form-group">
                                <label for="clientId"><i class="bi bi-person"></i> Client ID</label>
                                <input type="text" id="clientId" class="form-input" readonly>
                            </div>

                            <div class="form-group full-width">
                                <label for="mailingAddress"><i class="bi bi-envelope"></i> Mailing Address</label>
                                <input type="text" id="mailingAddress" class="form-input" readonly>
                            </div>

                            <div class="form-group">
                                <label for="city"><i class="bi bi-geo-alt"></i> City</label>
                                <input type="text" id="city" class="form-input" readonly>
                            </div>

                            <div class="form-group">
                                <label for="phone"><i class="bi bi-telephone"></i> Phone</label>
                                <input type="text" id="phone" class="form-input" readonly>
                            </div>

                            <div class="form-group">
                                <label for="productId"><i class="bi bi-box"></i> Product ID</label>
                                <input type="text" id="productId" class="form-input" readonly>
                            </div>

                            <div class="form-group">
                                <label for="currencyId"><i class="bi bi-currency-exchange"></i> Currency ID</label>
                                <input type="text" id="currencyId" class="form-input" readonly>
                            </div>

                            <div class="form-group">
                                <label for="collateralValue"><i class="bi bi-shield-check"></i> Collateral Value</label>
                                <input type="number" id="collateralValue" class="form-input" placeholder="0.00" step="0.01" readonly>
                            </div>

                            <div class="form-group">
                                <label for="noOfGuarantors"><i class="bi bi-people"></i> No Of Guarantors</label>
                                <input type="number" id="noOfGuarantors" class="form-input" readonly>
                            </div>

                            <div class="form-group">
                                <label for="calculationMethod"><i class="bi bi-calculator"></i> Calculation Method</label>
                                <input type="text" id="calculationMethod" class="form-input" readonly>
                            </div>

                            <div class="form-group">
                                <label for="applicationStatus"><i class="bi bi-info-circle"></i> Application Status</label>
                                <input type="text" id="applicationStatus" class="form-input" readonly>
                            </div>

                            <div class="form-group">
                                <label for="appraisedBy"><i class="bi bi-person-check"></i> Appraised By</label>
                                <input type="text" id="appraisedBy" class="form-input" readonly>
                            </div>

                            <div class="form-group">
                                <label for="appraisedOn"><i class="bi bi-calendar-check"></i> Appraised On</label>
                                <input type="text" id="appraisedOn" class="form-input" readonly>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Action Sidebar -->
        <div class="action-sidebar">
            <button class="btn-sidebar btn-primary" id="viewBtn" title="View">
                <i class="bi bi-eye"></i> View
            </button>
            <button class="btn-sidebar btn-warning" id="editBtn" title="Edit">
                <i class="bi bi-pencil"></i> Edit
            </button>
            <button class="btn-sidebar btn-danger" id="rejectBtn" title="Reject">
                <i class="bi bi-x-circle"></i> Reject
            </button>
            <button class="btn-sidebar btn-success" id="approveBtn" title="Approve">
                <i class="bi bi-check-circle"></i> Approve
            </button>
            <button class="btn-sidebar btn-secondary" id="cancelBtn" title="Cancel">
                <i class="bi bi-x-circle"></i> Cancel
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/environment.js"></script>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/services/shared/coreApi.js"></script>
    <script src="../../assets/js/services/shared/serviceLoader.js"></script>
    <script src="loan-appraisal.js"></script>
</body>
</html>
